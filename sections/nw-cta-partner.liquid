{{ 'nw-cta-partner.css' | asset_url | stylesheet_tag }}

<style>
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    {% if section.settings.text_color != blank %}
      color: {{ section.settings.text_color }};
    {% endif %}
    {% if section.settings.bg_type == 'color' %}
      background-color: {{ section.settings.bg_color }};
    {% endif %}
    {% if section.settings.bg_type == 'gradient' %}
      background: {{ section.settings.bg_gradient }};
    {% endif %}
    {% if section.settings.bg_type == 'image' and section.settings.background_image != blank %}
      background-image: url('{{ section.settings.background_image | image_url: width: auto }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    {% endif %}
    --nw-cta-partner-text: {{ section.settings.text_color | default: '#ffffff' }};
  }
  @media screen and (max-width: 749px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      {% if section.settings.bg_type == 'image' and section.settings.background_image_mobile != blank %}
        background-image: url('{{ section.settings.background_image_mobile | image_url: width: auto }}');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
      {% endif %}
    }
  }
</style>

{%- liquid
  if section.settings.button_style == 'secondary'
    assign button_class = 'button button--secondary'
  else
    assign button_class = 'button'
  endif
-%}

<div class="nw-main-section nw-cta-partner-main section-{{ section.id }}">
  <div class="page-width">
    <div class="nw-cta-partner">
      {% if section.settings.heading != blank %}
        <h2 class="nw-cta-partner__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          class="{{ button_class }} nw-cta-partner__button"
          href="{{ section.settings.button_link | default: '#' }}"
          {% if section.settings.button_link == blank %}aria-disabled="true"{% endif %}
        >
          {{- section.settings.button_label | escape -}}
          <span class="nw-cta-partner__button-icon">{{ 'iw-cta-right.svg' | inline_asset_content }}</span>
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "NW CTA Partner",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to lead the organic sleep category in your market?"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Book a Discovery Call →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "secondary",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        }
      ]
    },
    {
      "type": "header",
      "content": "Section settings"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background type",
      "default": "color",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "color",
          "label": "Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#3f2b04",
      "alpha": true,
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Background image mobile",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff",
      "alpha": true
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top desktop",
      "default": 40,
      "min": 0,
      "max": 120,
      "step": 4
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom desktop",
      "default": 40,
      "min": 0,
      "max": 120,
      "step": 4
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top mobile",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 4
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 4
    }
  ],
  "presets": [
    {
      "name": "NW CTA Partner",
      "category": "NW Sections"
    }
  ]
}
{% endschema %}
