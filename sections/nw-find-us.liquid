{{ 'nw-find-us.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-find-us.js' | asset_url }}" defer="defer"></script>

{%- assign nw_shell_selector = '#NwFindUs-' | append: section.id -%}

{% capture nw_shell_extra %}
  --nw-fu-inner-max: {{ section.settings.content_max_width | default: 960 }}px;
  --nw-fu-desc-max: {{ section.settings.description_max_width | default: 560 }}px;
  --nw-fu-card-max: {{ section.settings.search_card_max_width | default: 720 }}px;
  --nw-fu-eyebrow: {{ section.settings.eyebrow_color | default: '#A86F45' }};
  --nw-fu-heading: {{ section.settings.heading_color | default: '#2E2A26' }};
  --nw-fu-desc: {{ section.settings.description_color | default: '#6F655C' }};
  --nw-fu-card-bg: {{ section.settings.card_bg_color | default: '#FFFFFF' }};
  --nw-fu-card-border: {{ section.settings.card_border_color | default: '#E5DBCF' }};
  --nw-fu-search-label: {{ section.settings.search_label_color | default: '#2E2A26' }};
  --nw-fu-field-bg: {{ section.settings.field_bg_color | default: '#FAF6F1' }};
  --nw-fu-field-border: {{ section.settings.field_border_color | default: '#E5DBCF' }};
  --nw-fu-field-icon: {{ section.settings.field_icon_color | default: '#A86F45' }};
  --nw-fu-input: {{ section.settings.input_text_color | default: '#2E2A26' }};
  --nw-fu-placeholder: {{ section.settings.input_placeholder_color | default: '#6F655C' }};
  --nw-fu-submit-bg: {{ section.settings.submit_bg_color | default: '#C68B5F' }};
  --nw-fu-submit-text: {{ section.settings.submit_text_color | default: '#FFFFFF' }};
  --nw-fu-location-dot: {{ section.settings.location_dot_color | default: '#7C8A4E' }};
  --nw-fu-location-text: {{ section.settings.location_text_color | default: '#2E2A26' }};
  --nw-fu-location-text-hover: {{ section.settings.location_text_hover_color | default: '#1A1816' }};
  --nw-fu-submit-bg-hover: {{ section.settings.submit_bg_hover_color | default: '#B37A4B' }};
  --nw-fu-submit-text-hover: {{ section.settings.submit_text_hover_color | default: '#FFFFFF' }};
  --nw-fu-results-max: {{ section.settings.results_max_width | default: 1280 }}px;
  --nw-fu-map-height: {{ section.settings.map_height_desktop | default: 730 }}px;
  --nw-fu-map-height-mobile: {{ section.settings.map_height_mobile | default: 300 }}px;
  --nw-fu-map-bg: {{ section.settings.map_bg_color | default: '#EFEAE2' }};
  --nw-fu-map-border: {{ section.settings.map_border_color | default: '#E5DBCF' }};
  --nw-fu-filter-chip-bg: {{ section.settings.filter_chip_bg_color | default: '#F2EBE2' }};
  --nw-fu-link: {{ section.settings.link_color | default: '#A86F45' }};
  --nw-fu-store-title: {{ section.settings.store_title_color | default: '#2E2A26' }};
  --nw-fu-store-muted: {{ section.settings.store_muted_color | default: '#6F655C' }};
  --nw-fu-store-active-border: {{ section.settings.store_active_border_color | default: '#C68B5F' }};
  --nw-fu-pin: {{ section.settings.pin_color | default: '#C68B5F' }};
  --nw-fu-pin-active: {{ section.settings.pin_active_color | default: '#6A3D1E' }};
{% endcapture %}

{% render 'nw-section-shell', selector: nw_shell_selector, mode: 'direct', default_bg: '#FAF6F1', extra: nw_shell_extra %}
{% render 'nw-section-text-colors', selector: nw_shell_selector %}

<section id="NwFindUs-{{ section.id }}" class="nw-find-us section-{{ section.id }}">
  <div class="nw-find-us__inner{%- render 'nw-scroll-animation' -%}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="nw-eyebrow nw-find-us__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <div class="nw-find-us__heading">
      {% render 'nw-section-heading',
        text: section.settings.heading,
        section_index: section.index
      %}
    </div>

    {% render 'nw-section-description',
      text: section.settings.description,
      class: 'nw-find-us__description'
    %}

    {%- if section.settings.show_search_card -%}
      <div class="nw-find-us__search-card">
        {%- if section.settings.search_label != blank -%}
          <p class="nw-find-us__search-label">{{ section.settings.search_label }}</p>
        {%- endif -%}

        <div class="nw-find-us__search-row">
          <label class="nw-find-us__field">
            <span class="nw-find-us__field-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="2"/>
              </svg>
            </span>
            <input
              type="text"
              class="nw-find-us__input"
              placeholder="{{ section.settings.input_placeholder | escape }}"
              autocomplete="postal-code"
              aria-label="{{ section.settings.input_aria_label | escape }}"
              
            >
          </label>

          {%- if section.settings.submit_button_text != blank -%}
            <button type="button" class="nw-find-us__submit nw-button-primary">
              <span class="nw-find-us__submit-text">{{ section.settings.submit_button_text }}</span>
            </button>
          {%- endif -%}
        </div>

        {%- if section.settings.show_location_button and section.settings.location_button_text != blank -%}
          <button type="button" class="nw-find-us__location">
            <span class="nw-find-us__location-dot" aria-hidden="true"></span>
            <span class="nw-find-us__location-text">{{ section.settings.location_button_text }}</span>
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- assign store_blocks = section.blocks | where: 'type', 'store' -%}
  {%- if section.settings.show_store_results and store_blocks.size > 0 -%}
    <div
      class="nw-find-us__results"
      data-nw-find-us-locator
      data-api-key="{{ section.settings.google_maps_api_key | escape }}"
      data-results-all-label="{{ section.settings.results_all_label | escape }}"
      data-results-filtered-label="{{ section.settings.results_filtered_label | escape }}"
      data-pin-color="{{ section.settings.pin_color | default: '#C68B5F' }}"
      data-pin-active-color="{{ section.settings.pin_active_color | default: '#6A3D1E' }}"
    >
      <div class="nw-find-us__results-header">
        <div class="nw-find-us__results-meta">
          <p class="nw-find-us__results-count" data-nw-fu-count>
            {{- section.settings.results_all_label | replace: '[[count]]', store_blocks.size | replace: '[[place]]', '' | strip -}}
          </p>
          <button type="button" class="nw-find-us__filter-chip" data-nw-fu-chip hidden>
            <span class="nw-find-us__filter-chip-label" data-nw-fu-chip-label></span>
            <span class="nw-find-us__filter-chip-clear" aria-hidden="true">✕</span>
            <span class="visually-hidden">{{ section.settings.clear_filter_label | escape }}</span>
          </button>
        </div>
        <button type="button" class="nw-find-us__view-all" data-nw-fu-view-all hidden>
          <span class="nw-find-us__view-all-desktop">{{ section.settings.view_all_label_desktop }}</span>
          <span class="nw-find-us__view-all-mobile">{{ section.settings.view_all_label_mobile }}</span>
        </button>
      </div>

      <p class="nw-find-us__empty" data-nw-fu-empty hidden>{{ section.settings.empty_results_message }}</p>

      <div class="nw-find-us__layout">
        <div class="nw-find-us__map-wrap">
          <div
            class="nw-find-us__map"
            data-nw-fu-map
            role="region"
            aria-label="{{ section.settings.map_aria_label | escape }}"
          ></div>
          <div class="nw-find-us__map-zoom" aria-hidden="true">
            <button type="button" class="nw-find-us__map-zoom-btn" data-nw-fu-zoom="in">+</button>
            <button type="button" class="nw-find-us__map-zoom-btn" data-nw-fu-zoom="out">−</button>
          </div>
        </div>

        <div class="nw-find-us__stores">
          {%- for block in store_blocks -%}
            {%- liquid
              assign store_index = forloop.index
              assign directions_url = block.settings.directions_url
              if directions_url == blank and block.settings.lat != blank and block.settings.lng != blank
                assign directions_url = 'https://www.google.com/maps/dir/?api=1&destination=' | append: block.settings.lat | append: ',' | append: block.settings.lng
              endif
              assign website_label = block.settings.website_label
              if website_label == blank and block.settings.website_url != blank
                assign website_label = block.settings.website_url | remove: 'https://' | remove: 'http://' | remove: 'www.'
              endif
            -%}
            <article
              class="nw-find-us__store-card"
              data-nw-fu-store-card
              data-store-id="{{ block.id }}"
              aria-current="false"
              {{ block.shopify_attributes }}
            >
              <div class="nw-find-us__store-media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 720
                    | image_tag:
                      loading: 'lazy',
                      class: 'nw-find-us__store-image',
                      widths: '360, 540, 720',
                      sizes: '(min-width: 750px) 348px, 100vw',
                      alt: block.settings.title
                  }}
                {%- else -%}
                  <div class="nw-find-us__store-media-placeholder" aria-hidden="true"></div>
                {%- endif -%}
                <span class="nw-find-us__store-badge">{{ store_index }}</span>
              </div>
              <div class="nw-find-us__store-body">
                {%- if block.settings.title != blank -%}
                  <h3 class="nw-find-us__store-title">{{ block.settings.title }}</h3>
                {%- endif -%}
                <div class="nw-find-us__store-address">
                  {%- if block.settings.address_line_1 != blank -%}
                    <p>{{ block.settings.address_line_1 }}</p>
                  {%- endif -%}
                  {%- if block.settings.city != blank or block.settings.state_code != blank or block.settings.postal_code != blank -%}
                    <p>
                      {{- block.settings.city -}}
                      {%- if block.settings.city != blank and block.settings.state_code != blank -%}, {% endif -%}
                      {{- block.settings.state_code -}}
                      {%- if block.settings.postal_code != blank -%} {{ block.settings.postal_code }}{%- endif -%}
                    </p>
                  {%- endif -%}
                </div>
                {%- if block.settings.phone != blank -%}
                  <a class="nw-find-us__store-phone" href="tel:{{ block.settings.phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}">
                    {{ block.settings.phone }}
                  </a>
                {%- endif -%}
                <div class="nw-find-us__store-footer">
                  {%- if block.settings.website_url != blank -%}
                    <a class="nw-find-us__store-link" href="{{ block.settings.website_url }}" target="_blank" rel="noopener noreferrer">
                      {{ website_label }}
                    </a>
                  {%- endif -%}
                  {%- if directions_url != blank -%}
                    <a class="nw-find-us__store-directions" href="{{ directions_url }}" target="_blank" rel="noopener noreferrer">
                      {{ section.settings.directions_label }}
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </article>
          {%- endfor -%}
        </div>
      </div>

      <script type="application/json" class="nw-find-us__data">
        [
          {%- for block in store_blocks -%}
            {
              "id": {{ block.id | json }},
              "index": {{ forloop.index }},
              "title": {{ block.settings.title | json }},
              "address_line_1": {{ block.settings.address_line_1 | json }},
              "city": {{ block.settings.city | json }},
              "state_name": {{ block.settings.state_name | json }},
              "state_code": {{ block.settings.state_code | json }},
              "postal_code": {{ block.settings.postal_code | json }},
              "phone": {{ block.settings.phone | json }},
              "hours_text": {{ block.settings.hours_text | json }},
              "website_url": {{ block.settings.website_url | json }},
              "directions_url": {{ directions_url | json }},
              "search_keywords": {{ block.settings.search_keywords | json }},
              "lat": {{ block.settings.lat | json }},
              "lng": {{ block.settings.lng | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      </script>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:sections.nw-find-us.name",
  "tag": "section",
  "class": "section-nw-find-us",
  "settings": [
    {
      "type": "header",
      "content": "CONTENT"
    },
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Find Us In Person"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Find A Store Near You"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Feel the difference of certified organic sleep at one of our retail partners.</p>"
    },
    {
      "type": "header",
      "content": "LAYOUT"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content Max Width",
      "min": 640,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 960
    },
    {
      "type": "range",
      "id": "description_max_width",
      "label": "Description Max Width",
      "min": 320,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "search_card_max_width",
      "label": "Search Card Max Width",
      "min": 480,
      "max": 960,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    {
      "type": "header",
      "content": "SEARCH"
    },
    {
      "type": "checkbox",
      "id": "show_search_card",
      "label": "Show Search Card",
      "default": true
    },
    {
      "type": "text",
      "id": "search_label",
      "label": "Search Label",
      "default": "Type your ZIP code or state below",
      "visible_if": "{{ section.settings.show_search_card == true }}"
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Input Placeholder",
      "default": "e.g. 80202 or Colorado",
      "visible_if": "{{ section.settings.show_search_card == true }}"
    },
    {
      "type": "text",
      "id": "input_aria_label",
      "label": "Input Accessibility Label",
      "default": "ZIP code or state",
      "visible_if": "{{ section.settings.show_search_card == true }}"
    },
    {
      "type": "text",
      "id": "submit_button_text",
      "label": "Submit Button Label",
      "default": "Find Stores",
      "visible_if": "{{ section.settings.show_search_card == true }}"
    },
    {
      "type": "checkbox",
      "id": "show_location_button",
      "label": "Show Location Link",
      "default": true,
      "visible_if": "{{ section.settings.show_search_card == true }}"
    },
    {
      "type": "text",
      "id": "location_button_text",
      "label": "Location Link Label",
      "default": "Use my current location",
      "visible_if": "{{ section.settings.show_search_card == true and section.settings.show_location_button == true }}"
    },
    {
      "type": "header",
      "content": "MAP & RESULTS"
    },
    {
      "type": "checkbox",
      "id": "show_store_results",
      "label": "Show Map And Store Results",
      "default": true
    },
    {
      "type": "text",
      "id": "google_maps_api_key",
      "label": "Google Maps API Key",
      "info": "Required for the interactive map. Enable Maps JavaScript API and Geocoding API.",
      "visible_if": "{{ section.settings.show_store_results == true }}"
    },
    {
      "type": "range",
      "id": "results_max_width",
      "label": "Results Max Width",
      "min": 960,
      "max": 1440,
      "step": 20,
      "unit": "px",
      "default": 1280,
      "visible_if": "{{ section.settings.show_store_results == true }}"
    },
    {
      "type": "range",
      "id": "map_height_desktop",
      "label": "Map Height (Desktop)",
      "min": 400,
      "max": 900,
      "step": 5,
      "unit": "px",
      "default": 730,
      "visible_if": "{{ section.settings.show_store_results == true }}"
    },
    {
      "type": "range",
      "id": "map_height_mobile",
      "label": "Map Height (Mobile)",
      "min": 220,
      "max": 480,
      "step": 4,
      "unit": "px",
      "default": 300,
      "visible_if": "{{ section.settings.show_store_results == true }}"
    },
    {
      "type": "text",
      "id": "map_aria_label",
      "label": "Map Accessibility Label",
      "default": "Store locations map",
      "visible_if": "{{ section.settings.show_store_results == true }}"
    },
    {
      "type": "text",
      "id": "results_all_label",
      "label": "All Locations Count Label",
      "default": "[[count]] store locations",
      "info": "Use [[count]] for the number of stores.",
      "visible_if": "{{ section.settings.show_store_results == true }}"
    },
    {
      "type": "text",
      "id": "results_filtered_label",
      "label": "Filtered Count Label",
      "default": "[[count]] stores in [[place]]",
      "info": "Use [[count]] and [[place]].",
      "visible_if": "{{ section.settings.show_store_results == true }}"
    },
    {
      "type": "text",
      "id": "view_all_label_desktop",
      "label": "View All Label (Desktop)",
      "default": "View all locations",
      "visible_if": "{{ section.settings.show_store_results == true }}"
    },
    {
      "type": "text",
      "id": "view_all_label_mobile",
      "label": "View All Label (Mobile)",
      "default": "View all",
      "visible_if": "{{ section.settings.show_store_results == true }}"
    },
    {
      "type": "text",
      "id": "clear_filter_label",
      "label": "Clear Filter Accessibility Label",
      "default": "Clear location filter",
      "visible_if": "{{ section.settings.show_store_results == true }}"
    },
    {
      "type": "text",
      "id": "directions_label",
      "label": "Directions Link Label",
      "default": "Directions →",
      "visible_if": "{{ section.settings.show_store_results == true }}"
    },
    {
      "type": "text",
      "id": "empty_results_message",
      "label": "No Results Message",
      "default": "No stores match your search. Try another ZIP code or state.",
      "visible_if": "{{ section.settings.show_store_results == true }}"
    },
    {
      "type": "header",
      "content": "TEXT COLORS"
