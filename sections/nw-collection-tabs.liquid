{{ 'nw-swiper-bundle.min.css' | asset_url | stylesheet_tag }}
{{ 'nw-collection-tabs.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'nw-collection-tabs.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign sidebar_block = nil
  assign tab_blocks = section.blocks | where: 'type', 'tab'
  for block in section.blocks
    if block.type == 'sidebar'
      assign sidebar_block = block
    endif
  endfor

  assign default_tab_index = 0
  assign tab_index_scan = 0
  for block in section.blocks
    if block.type == 'tab'
      if block.settings.default_selected
        assign default_tab_index = tab_index_scan
        break
      endif
      assign tab_index_scan = tab_index_scan | plus: 1
    endif
  endfor
-%}

{%- assign nw_shell_selector = '#NwCollectionTabs-' | append: section.id -%}
{% render 'nw-section-shell', selector: nw_shell_selector, mode: 'direct' %}
<style>
  {% if section.settings.hide_shadow == ture %}
  .nw-collection-tabs__slider-wrap::after{
    display: none !important;
  }
  {% endif %}
  {% if section.settings.product_card_bg != blank or section.settings.product_card_text != blank %}
    .nw-product-card__body{
      background-color: {{ section.settings.product_card_bg }};
      --nw-brown: {{ section.settings.product_card_text }};
      --nw-pcard-text: {{ section.settings.product_card_text }};
      {% if section.settings.product_card_bg != blank %}
        padding: 10px;
        border-radius: 4px;
      {% endif %}
    }
  {% endif %}
</style>
<nw-collection-tabs
  id="NwCollectionTabs-{{ section.id }}"
  class="nw-collection-tabs"
  data-show-arrows="{{ section.settings.show_arrows }}"
  data-show-pagination="{{ section.settings.show_pagination }}"
  style="
    --nw-collection-tabs-tab-bg: {{ section.settings.tab_bg }};
    --nw-collection-tabs-tab-text: {{ section.settings.tab_text }};
    --nw-collection-tabs-tab-border: {{ section.settings.tab_border }};
    --nw-collection-tabs-tab-active-bg: {{ section.settings.tab_active_bg }};
    --nw-collection-tabs-tab-active-text: {{ section.settings.tab_active_text }};
    --nw-collection-tabs-sidebar-bg: {{ section.settings.sidebar_bg }};
    --nw-collection-tabs-sidebar-text: {{ section.settings.sidebar_text }};
    --nw-collection-tabs-quote-bg: {{ section.settings.quote_bg }};
    --nw-collection-tabs-quote-border: {{ section.settings.quote_border }};
    --nw-collection-tabs-quote-icon: {{ section.settings.quote_icon_color }};
    --nw-collection-tabs-verified-color: {{ section.settings.verified_color }};
    --nw-collection-tabs-trust-icon: {{ section.settings.trust_icon_color }};
    --nw-collection-tabs-fade-color: {{ section.settings.slider_fade_color }};
    --nw-swiper-arrow-bg: {{ section.settings.swiper_arrow_bg }};
    --nw-swiper-arrow-color: {{ section.settings.swiper_arrow_color }};
    --nw-swiper-bullet: {{ section.settings.swiper_bullet_color }};
    --nw-collection-tabs-promo-bg: {{ section.settings.promo_bg }};
    --nw-collection-tabs-promo-border: {{ section.settings.promo_border }};
    --nw-collection-tabs-promo-status-bg: {{ section.settings.promo_status_bg }};
    --nw-collection-tabs-promo-timer-bg: {{ section.settings.promo_timer_bg }};
    --nw-collection-tabs-promo-sep: {{ section.settings.promo_sep_color }};
    --nw-pcard-firmness-bg: {{ section.settings.firmness_bg }};
    --nw-pcard-firmness-text: {{ section.settings.firmness_text }};
    --nw-pcard-firmness-border: {{ section.settings.firmness_border }};
    --nw-pcard-firmness-active-bg: {{ section.settings.firmness_active_bg }};
    --nw-pcard-firmness-active-text: {{ section.settings.firmness_active_text }};
    --nw-pcard-firmness-active-border: {{ section.settings.firmness_active_border }};
  "
>

  <div class="{% if section.settings.full_width == false %}page-width {% else %} nw-collection-full-width {% endif %}">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="nw-collection-tabs__header">
        {% render 'nw-section-header',
          show_rating: section.settings.show_rating_header,
          rating: section.settings.star_rating,
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          description: section.settings.subheading,
          section_index: section.index
        %}
      </div>
    {%- endif -%}
    <div class="nw-collection-tabs__inner">
      {%- if sidebar_block -%}
        <div class="nw-collection-tabs__mobile-heading">
          {%- if sidebar_block.settings.heading != blank -%}
            <div class="nw-heading">{{ sidebar_block.settings.heading }}</div>
          {%- endif -%}
          {%- if sidebar_block.settings.subheading != blank -%}
            <div class="nw-collection-tabs__sidebar-subheading rte">{{ sidebar_block.settings.subheading }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if tab_blocks.size > 0 -%}
        <div class="nw-collection-tabs__tabs-wrap">
          <div class="nw-collection-tabs__tabs" role="tablist" aria-label="Collection categories">
            {%- assign tab_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'tab' -%}
                <button
                  type="button"
                  class="nw-collection-tabs__tab{% if tab_index == default_tab_index %} is-active{% endif %}"
                  id="NwCollectionTabsBtn-{{ section.id }}-{{ tab_index }}"
                  role="tab"
                  aria-selected="{% if tab_index == default_tab_index %}true{% else %}false{% endif %}"
                  aria-controls="NwCollectionTabsPanel-{{ section.id }}-{{ tab_index }}"
                  tabindex="{% if tab_index == default_tab_index %}0{% else %}-1{% endif %}"
                  data-nw-tab="{{ tab_index }}"
                  data-collection-url="{% if block.settings.collection != blank %}{{ block.settings.collection.url }}{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.label | escape }}
                </button>
                {%- assign tab_index = tab_index | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <div class="nw-collection-tabs__main {% if sidebar_block == blank %}nw-collection-tabs__main--without-sidebar{% endif %}">
        {%- if sidebar_block -%}
          <aside class="nw-collection-tabs__sidebar" {{ sidebar_block.shopify_attributes }}>
            {% render 'nw-collection-tabs-sidebar', block: sidebar_block %}
          </aside>
        {%- endif -%}

        <div class="nw-collection-tabs__slider-col">
          {%- assign panel_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'tab' -%}
              <div
                class="nw-collection-tabs__panel"
                id="NwCollectionTabsPanel-{{ section.id }}-{{ panel_index }}"
                data-nw-panel="{{ panel_index }}"
                role="tabpanel"
                aria-labelledby="NwCollectionTabsBtn-{{ section.id }}-{{ panel_index }}"
                {% unless panel_index == default_tab_index %}hidden{% endunless %}
              >
                <div class="nw-collection-tabs__slider-wrap">
                  {%- if block.settings.collection != blank and block.settings.collection.products_count > 0 -%}
                    <div class="swiper nw-collection-tabs__swiper" id="NwCollectionSwiper-{{ section.id }}-{{ panel_index }}">
                      <div class="swiper-wrapper">
                        {%- assign tab_products_limit = block.settings.products_to_show | default: 8 -%}
                        {%- for product in block.settings.collection.products limit: tab_products_limit -%}
                          <div class="swiper-slide">
                            {% render 'nw-product-card',
                              product: product,
                              section_id: section.id,
                              show_rating: section.settings.show_rating,
                              show_firmness: section.settings.show_firmness,
                              show_best_for: section.settings.show_best_for,
                              firmness_label_soft: section.settings.firmness_label_soft,
                              firmness_label_firm: section.settings.firmness_label_firm,
                              button_text: section.settings.pcard_button_text,
                              lazy_load: true
                            %}
                          </div>
                        {%- endfor -%}
                      </div>
                    </div>
                    {%- if section.settings.show_arrows -%}
                      {% render 'nw-swiper-arrows' %}
                    {%- endif -%}
                  {%- else -%}
                    <div class="nw-collection-tabs__empty">Select a collection for this tab.</div>
                  {%- endif -%}
                </div>
                {%- if section.settings.show_pagination and block.settings.collection != blank and block.settings.collection.products_count > 0 -%}
                  <div class="nw-swiper-pagination" id="NwCollectionPagination-{{ section.id }}-{{ panel_index }}" data-nw-panel-pagination="{{ panel_index }}"></div>
                {%- endif -%}
              </div>
              {%- assign panel_index = panel_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- if section.settings.show_shop_all and section.settings.shop_all_text != blank -%}
        <div class="nw-collection-tabs__footer nw-collection-tabs__shop-all">
          {%- liquid
            assign shop_all_link = section.settings.shop_all_link
            if shop_all_link == blank and tab_blocks.size > 0
              assign default_tab_block = nil
              assign shop_all_tab_scan = 0
              for block in section.blocks
                if block.type == 'tab'
                  if shop_all_tab_scan == default_tab_index
                    assign default_tab_block = block
                    break
                  endif
                  assign shop_all_tab_scan = shop_all_tab_scan | plus: 1
                endif
              endfor
              if default_tab_block == nil
                assign default_tab_block = tab_blocks | first
              endif
              if default_tab_block.settings.collection != blank
                assign shop_all_link = default_tab_block.settings.collection.url
              endif
            endif
          -%}
          {% render 'nw-button',
            text: section.settings.shop_all_text,
            link: shop_all_link,
            style: section.settings.shop_all_style,
          %}
        </div>
      {%- endif -%}
    </div>
  </div>
</nw-collection-tabs>
{% schema %}
{
  "name": "t:sections.nw-collection-tabs.name",
  "tag": "section",
  "class": "section-nw-collection-tabs",
  "settings": [
    {
      "type": "header",
      "content": "SECTION HEADER"
    },
    {
      "type": "checkbox",
      "id": "show_rating_header",
      "label": "Show Rating Stars",
      "default": false
    },
    {
      "type": "range",
      "id": "star_rating",
      "label": "Star Rating (Active Stars)",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "star_color",
      "label": "Active Star Color",
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "star_color_inactive",
      "label": "Inactive Star Color",
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow Text"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "TEXT COLORS"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "heading_color",
      "label": "Heading Color"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "description_color",
      "label": "Description Color"
    },
    {
      "type": "header",
      "content": "PRODUCT SLIDER"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_shadow",
      "label": "Hide Slider Shadow",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Slider Arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show Slider Pagination",
      "default": true
    },
    {
      "type": "header",
      "content": "PRODUCT CARD"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Product Rating",
      "default": true,
      "info": "Requires a product reviews app."
    },
    {
      "type": "checkbox",
      "id": "show_firmness",
      "label": "Show Firmness Scale",
      "default": false,
      "info": "Only displays when the product custom.firmness metafield is set."
    },
    {
      "type": "checkbox",
      "id": "show_best_for",
      "label": "Show Best For",
      "default": false,
      "info": "Only displays when the product custom.best_for metafield is set."
    },
    {
      "type": "text",
      "id": "firmness_label_soft",
      "label": "Firmness Left Label",
      "default": "Soft",
      "visible_if": "{{ section.settings.show_firmness == true }}"
    },
    {
      "type": "text",
      "id": "firmness_label_firm",
      "label": "Firmness Right Label",
      "default": "Firm",
      "visible_if": "{{ section.settings.show_firmness == true }}"
    },
    {
      "type": "text",
      "id": "pcard_button_text",
      "label": "Product Card Button Text",
      "default": "Shop Now"
    },
    {
      "type": "header",
      "content": "SHOP ALL BUTTON"
    },
    {
      "type": "checkbox",
      "id": "show_shop_all",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "text",
      "id": "shop_all_text",
      "label": "Button Label",
      "default": "Shop All",
      "visible_if": "{{ section.settings.show_shop_all == true }}"
    },
    {
      "type": "url",
      "id": "shop_all_link",
      "label": "Button Link",
      "info": "Defaults to the active tab collection when empty.",
      "visible_if": "{{ section.settings.show_shop_all == true }}"
    },
    {
      "type": "select",
      "id": "shop_all_style",
      "label": "Button Style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "outline",
      "visible_if": "{{ section.settings.show_shop_all == true }}"
    },
    {
      "type": "header",
      "content": "TAB COLORS"
