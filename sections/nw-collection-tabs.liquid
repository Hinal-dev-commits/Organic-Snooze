{{ 'nw-swiper-bundle.min.css' | asset_url | stylesheet_tag }}
{{ 'nw-collection-tabs.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'nw-collection-tabs.js' | asset_url }}" defer="defer"></script>

{%- assign tab_blocks = section.blocks | where: 'type', 'tab' -%}

{%- assign nw_shell_selector = '#NwCollectionTabs-' | append: section.id -%}
{% render 'nw-section-shell', selector: nw_shell_selector, mode: 'direct' %}
<style>
  
</style>
<nw-collection-tabs
  id="NwCollectionTabs-{{ section.id }}"
  class="nw-collection-tabs"
  data-show-arrows="{{ section.settings.show_arrows }}"
  data-show-pagination="{{ section.settings.show_pagination }}"
  style="
    --nw-collection-tabs-tab-bg: {{ section.settings.tab_bg }};
    --nw-collection-tabs-tab-text: {{ section.settings.tab_text }};
    --nw-collection-tabs-tab-border: {{ section.settings.tab_border }};
    --nw-collection-tabs-tab-active-bg: {{ section.settings.tab_active_bg }};
    --nw-collection-tabs-tab-active-text: {{ section.settings.tab_active_text }};
    --nw-collection-tabs-sidebar-bg: {{ section.settings.sidebar_bg }};
    --nw-collection-tabs-sidebar-text: {{ section.settings.sidebar_text }};
    --nw-collection-tabs-quote-bg: {{ section.settings.quote_bg }};
    --nw-collection-tabs-quote-border: {{ section.settings.quote_border }};
    --nw-collection-tabs-quote-icon: {{ section.settings.quote_icon_color }};
    --nw-collection-tabs-verified-color: {{ section.settings.verified_color }};
    --nw-collection-tabs-trust-icon: {{ section.settings.trust_icon_color }};
    --nw-collection-tabs-fade-color: {{ section.settings.slider_fade_color }};
    --nw-swiper-arrow-bg: {{ section.settings.swiper_arrow_bg }};
    --nw-swiper-arrow-color: {{ section.settings.swiper_arrow_color }};
    --nw-swiper-bullet: {{ section.settings.swiper_bullet_color }};
    --nw-collection-tabs-promo-bg: {{ section.settings.promo_bg }};
    --nw-collection-tabs-promo-border: {{ section.settings.promo_border }};
    --nw-collection-tabs-promo-status-bg: {{ section.settings.promo_status_bg }};
    --nw-collection-tabs-promo-timer-bg: {{ section.settings.promo_timer_bg }};
    --nw-collection-tabs-promo-sep: {{ section.settings.promo_sep_color }};
  "
  data-products-limit="{{ section.settings.products_to_show }}"
>
  <div class="page-width">
    <div class="nw-collection-tabs__inner">
      {%- if tab_blocks.size > 0 -%}
        <div class="nw-collection-tabs__tabs-wrap">
          <div class="nw-collection-tabs__tabs" role="tablist" aria-label="Collection categories">
            {%- assign tab_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'tab' -%}
                <button
                  type="button"
                  class="nw-collection-tabs__tab{% if tab_index == 0 %} is-active{% endif %}"
                  id="NwCollectionTabsBtn-{{ section.id }}-{{ tab_index }}"
                  role="tab"
                  aria-selected="{% if tab_index == 0 %}true{% else %}false{% endif %}"
                  aria-controls="NwCollectionTabsPanel-{{ section.id }}-{{ tab_index }}"
                  tabindex="{% if tab_index == 0 %}0{% else %}-1{% endif %}"
                  data-nw-tab="{{ tab_index }}"
                  data-collection-url="{% if block.settings.collection != blank %}{{ block.settings.collection.url }}{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.label | escape }}
                </button>
                {%- assign tab_index = tab_index | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <div class="nw-collection-tabs__main">
        <div class="nw-collection-tabs__slider-col">
          {%- assign panel_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'tab' -%}
              {%- liquid
                assign has_sidebar = false
                if block.settings.heading != blank or block.settings.subheading != blank
                  assign has_sidebar = true
                endif
                if block.settings.quote != blank or block.settings.author_name != blank or block.settings.author_title != blank or block.settings.author_image != blank
                  assign has_sidebar = true
                endif
                if block.settings.show_promo
                  if block.settings.promo_title != blank or block.settings.status_text != blank or block.settings.promo_subtext != blank or block.settings.countdown_label != blank
                    assign has_sidebar = true
                  endif
                endif
                if block.settings.badge_1_text != blank or block.settings.badge_2_text != blank or block.settings.badge_3_text != blank or block.settings.badge_4_text != blank
                  assign has_sidebar = true
                endif
              -%}
              <div
                class="nw-collection-tabs__panel{% unless has_sidebar %} nw-collection-tabs__panel--no-sidebar{% endunless %}{% if block.settings.show_sidebar == false %} nw-collection-tabs__panel--with-sidebar{% endif %}"
                id="NwCollectionTabsPanel-{{ section.id }}-{{ panel_index }}"
                data-nw-panel="{{ panel_index }}"
                data-show-sidebar="{% if block.settings.show_sidebar %}true{% else %}false{% endif %}"
                role="tabpanel"
                aria-labelledby="NwCollectionTabsBtn-{{ section.id }}-{{ panel_index }}"
                {% unless panel_index == 0 %}hidden{% endunless %}
              >
                {%- if block.settings.heading != blank or block.settings.subheading != blank -%}
                  <div class="nw-collection-tabs__mobile-heading">
                    {%- if block.settings.heading != blank -%}
                      <div class="nw-heading">{{ block.settings.heading }}</div>
                    {%- endif -%}
                    {%- if block.settings.subheading != blank -%}
                      <div class="nw-collection-tabs__sidebar-subheading rte">{{ block.settings.subheading }}</div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
                {%- if block.settings.show_sidebar -%}
                  {%- if has_sidebar -%}
                    <aside class="nw-collection-tabs__sidebar">
                      {% render 'nw-collection-tabs-sidebar', block: block %}
                    </aside>
                  {%- endif -%}
                {%- endif -%}
                <div class="nw-collection-tabs__slider-wrap">
                  {%- if block.settings.collection != blank and block.settings.collection.products_count > 0 -%}
                    <div class="swiper nw-collection-tabs__swiper" id="NwCollectionSwiper-{{ section.id }}-{{ panel_index }}">
                      <div class="swiper-wrapper">
                        {%- for product in block.settings.collection.products limit: section.settings.products_to_show -%}
                          <div class="swiper-slide">
                            {% render 'nw-product-card',
                              product: product,
                              section_id: section.id,
                              show_rating: section.settings.show_rating,
                              show_firmness: section.settings.show_firmness,
                              firmness_label_soft: section.settings.firmness_label_soft,
                              firmness_label_firm: section.settings.firmness_label_firm,
                              button_text: section.settings.pcard_button_text,
                              lazy_load: true
                            %}
                          </div>
                        {%- endfor -%}
                      </div>
                    </div>
                    {%- if section.settings.show_arrows -%}
                      {% render 'nw-swiper-arrows' %}
                    {%- endif -%}
                  {%- else -%}
                    <div class="nw-collection-tabs__empty">Select a collection for this tab.</div>
                  {%- endif -%}
                </div>
                {%- if section.settings.show_pagination and block.settings.collection != blank and block.settings.collection.products_count > 0 -%}
                  <div class="nw-swiper-pagination" id="NwCollectionPagination-{{ section.id }}-{{ panel_index }}" data-nw-panel-pagination="{{ panel_index }}"></div>
                {%- endif -%}
              </div>
              {%- assign panel_index = panel_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- if section.settings.show_shop_all and section.settings.shop_all_text != blank -%}
        <div class="nw-collection-tabs__footer nw-collection-tabs__shop-all">
          {%- liquid
            assign shop_all_link = section.settings.shop_all_link
            if shop_all_link == blank and tab_blocks.size > 0
              assign first_tab = tab_blocks | first
              if first_tab.settings.collection != blank
                assign shop_all_link = first_tab.settings.collection.url
              endif
            endif
          -%}
          {% render 'nw-button',
            text: section.settings.shop_all_text,
            link: shop_all_link,
            style: section.settings.shop_all_style,
          %}
        </div>
      {%- endif -%}
    </div>
  </div>
</nw-collection-tabs>
{% schema %}
{
