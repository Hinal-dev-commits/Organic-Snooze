    },
    {
      "type": "header",
      "content": "TAB COLORS"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "tab_bg",
      "label": "Tab Background",
      "default": "#FFFCF0"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "tab_text",
      "label": "Tab Text",
      "default": "#613916"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "tab_border",
      "label": "Tab Border",
