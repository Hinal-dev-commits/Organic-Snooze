    },
    {
      "type": "color",
      "alpha": true,
      "id": "cta_text_color",
      "label": "CTA Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "table_border_color",
      "label": "Table Border Color",
      "default": "#F0EFF2"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "table_stripe_color",
      "label": "Table Stripe Color",
      "default": "#6139160D"
    },
    {
      "type": "header",
      "content": "BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "color",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "color",
          "label": "Color"
        },
        {
          "value": "image",
