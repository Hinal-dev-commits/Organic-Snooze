{{ 'nw-shipping-content.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-shipping-content.js' | asset_url }}" defer="defer"></script>

{%- assign nw_shell_selector = '#NwShippingContent-' | append: section.id -%}
{%- assign nw_heading_color = section.settings.heading_color | default: '#613916' -%}
{%- assign nw_body_color = section.settings.body_color | default: '#613916' -%}
{%- assign nw_badge_bg = section.settings.badge_bg_color | default: '#878735' -%}
{%- assign nw_badge_text = section.settings.badge_text_color | default: '#FFFFFF' -%}
{%- assign nw_callout_bg = section.settings.callout_bg_color | default: '#FFFCF0' -%}
{%- assign nw_callout_heading_color = section.settings.callout_heading_color | default: '#878735' -%}
{%- assign nw_cta_bg = section.settings.cta_bg_color | default: '#878735' -%}
{%- assign nw_cta_text = section.settings.cta_text_color | default: '#FFFFFF' -%}
{%- assign nw_table_border = section.settings.table_border_color | default: '#F0EFF2' -%}
{%- assign nw_table_stripe = section.settings.table_stripe_color | default: 'rgba(97, 57, 22, 0.05)' -%}
{%- assign nw_divider_light = section.settings.divider_light_color | default: 'rgba(97, 57, 22, 0.12)' -%}
{%- assign nw_divider_heavy = section.settings.divider_heavy_color | default: 'rgba(97, 57, 22, 0.35)' -%}
{%- assign nw_blocks_gap_desktop = section.settings.blocks_gap_desktop | default: 48 -%}
{%- assign nw_blocks_gap_mobile = section.settings.blocks_gap_mobile | default: 48 -%}

{% render 'nw-section-shell', selector: nw_shell_selector, mode: 'direct', default_bg: '#FFFFFF' %}

<style>
  {{ nw_shell_selector }} {
    --nw-sc-blocks-gap: {{ nw_blocks_gap_desktop }}px;
    --nw-sc-blocks-gap-mobile: {{ nw_blocks_gap_mobile }}px;
    --nw-sc-divider-light: {{ nw_divider_light }};
    --nw-sc-divider-heavy: {{ nw_divider_heavy }};
    --nw-sc-table-border-color: {{ nw_table_border }};
    --nw-sc-table-stripe-color: {{ nw_table_stripe }};
    --nw-sc-scrollbar-thumb: {{ nw_body_color }};
  }

  @media screen and (max-width: 749px) {
    {{ nw_shell_selector }} {
      --nw-sc-blocks-gap-mobile: {{ nw_blocks_gap_mobile }}px;
    }
  }

  {{ nw_shell_selector }} .nw-shipping-content__heading,
  {{ nw_shell_selector }} .nw-shipping-content__body,
  {{ nw_shell_selector }} .nw-shipping-content__body p,
  {{ nw_shell_selector }} .nw-shipping-content__body li,
  {{ nw_shell_selector }} .nw-shipping-content__intro,
  {{ nw_shell_selector }} .nw-shipping-content__intro p,
  {{ nw_shell_selector }} .nw-shipping-content__intro li,
  {{ nw_shell_selector }} .nw-shipping-content__table td,
  {{ nw_shell_selector }} .nw-shipping-content__callout-body,
  {{ nw_shell_selector }} .nw-shipping-content__callout-body p {
    color: {{ nw_body_color }};
  }

  {{ nw_shell_selector }} .nw-shipping-content__heading {
    color: {{ nw_heading_color }};
  }

  {{ nw_shell_selector }} .nw-shipping-content__badge {
    background-color: {{ nw_badge_bg }};
    color: {{ nw_badge_text }};
  }

  {{ nw_shell_selector }} .nw-shipping-content__callout {
    background-color: {{ nw_callout_bg }};
  }

  {{ nw_shell_selector }} .nw-shipping-content__callout-heading {
    color: {{ nw_callout_heading_color }};
  }

  {{ nw_shell_selector }} .nw-shipping-content__cta {
    background-color: {{ nw_cta_bg }};
  }

  {{ nw_shell_selector }} .nw-shipping-content__cta-heading,
  {{ nw_shell_selector }} .nw-shipping-content__cta-description,
  {{ nw_shell_selector }} .nw-shipping-content__cta-footer,
  {{ nw_shell_selector }} .nw-shipping-content__cta-footer p {
    color: {{ nw_cta_text }};
  }

  @media screen and (max-width: 749px) {
    {{ nw_shell_selector }} .nw-shipping-content__table-scroll {
      width: calc(100% + 32px) !important;
      margin-left: -16px !important;
      margin-right: -16px !important;
      padding-left: 16px !important;
      padding-right: 16px !important;
      box-sizing: border-box !important;
      overflow-x: auto !important;
      -webkit-overflow-scrolling: touch !important;
      scrollbar-width: none !important;
    }

    {{ nw_shell_selector }} .nw-shipping-content__table-scroll::-webkit-scrollbar {
      display: none !important;
    }

    {{ nw_shell_selector }} .nw-shipping-content__scrollbar-track {
      display: block !important;
      position: relative !important;
      width: 100% !important;
      height: 8px !important;
      min-height: 8px !important;
      background-color: rgba(97, 57, 22, 0.1) !important;
      border-radius: 100px !important;
      overflow: hidden !important;
      box-sizing: border-box !important;
    }

    {{ nw_shell_selector }} .nw-shipping-content__scrollbar-thumb {
      display: block !important;
      position: absolute !important;
      top: 0 !important;
      bottom: 0 !important;
      left: 0 !important;
      height: 8px !important;
      min-height: 8px !important;
      width: 35%;
      min-width: 20px !important;
      background-color: #613916 !important;
      border-radius: 100px !important;
      pointer-events: none !important;
      z-index: 2 !important;
      transition: width 0.15s cubic-bezier(0.25, 1, 0.5, 1);
    }
  }

  @media screen and (min-width: 750px) {
    {{ nw_shell_selector }} .nw-shipping-content__scrollbar-track {
      display: none !important;
    }
  }
</style>

<nw-shipping-content
  id="NwShippingContent-{{ section.id }}"
  class="nw-shipping-content section-{{ section.id }}"
>
  <div class="page-width">
    {%- if section.blocks.size > 0 -%}
      <div class="nw-shipping-content__wrapper{%- render 'nw-scroll-animation' -%}">
        {%- liquid
          assign nw_table_open = false
          assign nw_table_layout = 'two_column'
          assign nw_table_show_scrollbar = false
          assign nw_text_group_open = false
          assign nw_table_section_open = false
          assign nw_table_group_open = false
        -%}

        {%- for block in section.blocks -%}
          {%- if block.type != 'table_row' -%}
            {%- if nw_table_open -%}
              </tbody>
              </table>
              </div>
              {%- if nw_table_show_scrollbar -%}
                <div class="nw-shipping-content__scrollbar-track" aria-hidden="true">
                  <div class="nw-shipping-content__scrollbar-thumb"></div>
                </div>
              {%- endif -%}
              {%- assign nw_table_open = false -%}
            {%- endif -%}

            {%- if nw_table_group_open -%}
              </div>
              {%- assign nw_table_group_open = false -%}
            {%- endif -%}
          {%- endif -%}

          {%- liquid
            assign nw_divider_before = block.settings.divider_before | default: 'none'
            assign nw_starts_major_section = false
            if nw_divider_before == 'heavy'
              assign nw_starts_major_section = true
            endif
            if block.type == 'table_group' or block.type == 'cta'
              assign nw_starts_major_section = true
            endif
          -%}

          {%- if nw_text_group_open and nw_starts_major_section -%}
            </div>
            {%- assign nw_text_group_open = false -%}
          {%- endif -%}

          {%- if nw_table_section_open and nw_starts_major_section -%}
            </div>
            {%- assign nw_table_section_open = false -%}
          {%- endif -%}

          {%- if nw_divider_before != 'none' and forloop.first == false -%}
            <hr
              class="nw-shipping-content__divider nw-shipping-content__divider--{{ nw_divider_before }}"
              aria-hidden="true"
            >
          {%- endif -%}

          {%- case block.type -%}
            {%- when 'content_item' -%}
              {%- if block.settings.heading != blank or block.settings.content != blank -%}
                {%- unless nw_text_group_open or nw_table_section_open -%}
                  <div class="nw-shipping-content__text-group">
                    {%- assign nw_text_group_open = true -%}
                {%- endunless -%}
                <article
                  class="nw-shipping-content__item{% if block.settings.heading_size == 'medium' %} nw-shipping-content__item--medium{% else %} nw-shipping-content__item--large{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.heading != blank -%}
                    <h2 class="nw-shipping-content__heading{% if block.settings.heading_size == 'medium' %} nw-shipping-content__heading--medium{% endif %}">
                      {{ block.settings.heading | escape }}
                    </h2>
                  {%- endif -%}

                  {%- if block.settings.content != blank -%}
                    <div class="nw-shipping-content__body rte">
                      {{ block.settings.content }}
                    </div>
                  {%- endif -%}
                </article>
              {%- endif -%}

            {%- when 'table_group' -%}
              {%- unless nw_table_section_open -%}
                <div class="nw-shipping-content__table-section">
                  {%- assign nw_table_section_open = true -%}
              {%- endunless -%}
              <div class="nw-shipping-content__table-group" {{ block.shopify_attributes }}>
                <div class="nw-shipping-content__table-group-header">
                  {%- if block.settings.heading != blank or block.settings.badge != blank -%}
                    <div class="nw-shipping-content__heading-row">
                      {%- if block.settings.heading != blank -%}
                        <h2 class="nw-shipping-content__heading">{{ block.settings.heading | escape }}</h2>
                      {%- endif -%}
                      {%- if block.settings.badge != blank -%}
                        <span class="nw-shipping-content__badge">{{ block.settings.badge | escape }}</span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.intro != blank -%}
                    <div class="nw-shipping-content__intro rte">{{ block.settings.intro }}</div>
                  {%- endif -%}
                </div>

                {%- assign nw_table_layout = block.settings.table_layout | default: 'two_column' -%}
                {%- assign nw_table_show_scrollbar = block.settings.show_scrollbar | default: false -%}
                {%- assign nw_table_group_open = true -%}
                {%- unless nw_table_layout == 'hidden' -%}
                  {%- assign nw_table_open = true -%}
                  <div class="nw-shipping-content__table-scroll">
                    <table class="nw-shipping-content__table nw-shipping-content__table--{{ nw_table_layout | replace: '_', '-' }}">
                      <tbody>
                {%- endunless -%}
            {%- when 'table_row' -%}
              {%- if nw_table_open -%}
                <tr class="nw-shipping-content__table-row" {{ block.shopify_attributes }}>
                  {%- if nw_table_layout == 'four_column' -%}
                    <td>{{ block.settings.column_1 | escape }}</td>
                    <td>{{ block.settings.column_2 | escape }}</td>
                    <td>{{ block.settings.column_3 | escape }}</td>
                    <td>{{ block.settings.column_4 | escape }}</td>
                  {%- else -%}
                    <td>{{ block.settings.column_1 | escape }}</td>
                    <td>{{ block.settings.column_2 | escape }}</td>
                  {%- endif -%}
                </tr>
              {%- endif -%}

            {%- when 'callout' -%}
              {%- if block.settings.heading != blank or block.settings.content != blank -%}
                {%- unless nw_table_section_open -%}
                  <div class="nw-shipping-content__table-section">
                    {%- assign nw_table_section_open = true -%}
                {%- endunless -%}
                <aside class="nw-shipping-content__callout" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <h3 class="nw-shipping-content__callout-heading">{{ block.settings.heading | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.content != blank -%}
                    <div class="nw-shipping-content__callout-body rte">{{ block.settings.content }}</div>
                  {%- endif -%}
                </aside>
              {%- endif -%}

            {%- when 'cta' -%}
              {%- if block.settings.heading != blank
                or block.settings.description != blank
                or block.settings.button_text != blank
              -%}
                <aside class="nw-shipping-content__cta" {{ block.shopify_attributes }}>
                  <div class="nw-shipping-content__cta-copy">
                    {%- if block.settings.heading != blank -%}
                      <h2 class="nw-shipping-content__cta-heading">{{ block.settings.heading | escape }}</h2>
                    {%- endif -%}
                    {%- if block.settings.description != blank -%}
                      <p class="nw-shipping-content__cta-description">{{ block.settings.description | escape }}</p>
                    {%- endif -%}
                  </div>

                  <div class="nw-shipping-content__cta-actions">
                    {%- if block.settings.button_text != blank -%}
                      {% render 'nw-button', text: block.settings.button_text, link: block.settings.button_link, default: '#', style: 'primary', btn_class: 'nw-shipping-content__cta-btn' %}
                    {%- endif -%}

                    {%- if block.settings.footer_note != blank -%}
                      <div class="nw-shipping-content__cta-footer rte">{{ block.settings.footer_note }}</div>
                    {%- endif -%}
                  </div>
                </aside>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}

        {%- if nw_table_open -%}
          </tbody>
          </table>
          </div>
          {%- if nw_table_show_scrollbar -%}
            <div class="nw-shipping-content__scrollbar-track" aria-hidden="true">
              <div class="nw-shipping-content__scrollbar-thumb"></div>
            </div>
          {%- endif -%}
        {%- endif -%}

        {%- if nw_table_group_open -%}
          </div>
        {%- endif -%}

        {%- if nw_text_group_open -%}
          </div>
        {%- endif -%}

        {%- if nw_table_section_open -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</nw-shipping-content>

{% schema %}
{
  "name": "NW Shipping Content",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "LAYOUT"
    },
    {
      "type": "range",
      "id": "blocks_gap_desktop",
      "label": "Space Between Blocks (Desktop)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "blocks_gap_mobile",
      "label": "Space Between Blocks (Mobile)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "color",
      "alpha": true,
      "id": "divider_light_color",
      "label": "Light Divider Color",
      "default": "#6139161F"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "divider_heavy_color",
      "label": "Heavy Divider Color",
      "default": "#61391659"
    },
    {
      "type": "header",
      "content": "TEXT COLORS"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#613916"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "body_color",
      "label": "Body Text Color",
      "default": "#613916"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "badge_bg_color",
      "label": "Badge Background Color",
      "default": "#878735"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "badge_text_color",
      "label": "Badge Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "alpha": true,
