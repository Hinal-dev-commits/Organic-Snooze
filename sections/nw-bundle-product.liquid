{{ 'nw-bundle-product.css' | asset_url | stylesheet_tag }}

{%- assign nw_shell_selector = '#NwBundleProduct-' | append: section.id -%}
{% render 'nw-section-shell', selector: nw_shell_selector, mode: 'direct', default_bg: '#FFFAF3' %}

<div id="NwBundleProduct-{{ section.id }}" class="nw-bundle-product section-{{ section.id }}">
  <div class="page-width">
    <div class="nw-bundle-product__wrapper{%- render 'nw-scroll-animation' -%}">
      <div class="nw-bundle-product__header">
        {%- if section.settings.badge_text != blank -%}
          <div class="nw-bundle-product__tag">{{ section.settings.badge_text }}</div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          {% render 'nw-section-header',
            heading: section.settings.heading,
            section_index: section.index
          %}
        {%- endif -%}

        {%- assign feature_blocks = section.blocks | where: 'type', 'feature' -%}
        {%- if feature_blocks.size > 0 -%}
          <div class="nw-bundle-product__features">
            {%- for block in feature_blocks -%}
              <div class="nw-bundle-product__feature-item" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != 'none' -%}
                  <span class="nw-bundle-product__feature-icon">
                    {% render 'nw-icon',
                      icon: block.settings.icon,
                      custom_icon: block.settings.custom_icon,
                      img_class: 'nw-bundle-product__feature-img'
                    %}
                  </span>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <span class="nw-bundle-product__feature-text">{{ block.settings.text }}</span>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="nw-bundle-product__main{% if section.settings.image_position == 'right' %} nw-bundle-product__main--image-right{% endif %}">
        <div class="nw-bundle-product__image-col">
          {%- liquid
            assign prod_img = section.settings.image_desktop
            if prod_img == blank and section.settings.product != blank and section.settings.product.featured_image != blank
              assign prod_img = section.settings.product.featured_image
            endif
            assign prod_img_mobile = section.settings.image_mobile
          -%}
          {%- if prod_img != blank -%}
            <picture>
              {%- if prod_img_mobile != blank -%}
                <source media="(max-width: 749px)" srcset="{{ prod_img_mobile | image_url: width: 750 }}">
              {%- endif -%}
              <img
                src="{{ prod_img | image_url: width: 1100 }}"
                alt="{{ section.settings.heading | default: 'Product' | escape }}"
                width="520"
                height="436"
                loading="lazy"
                class="nw-bundle-product__img"
              >
            </picture>
          {%- else -%}
            <div class="nw-bundle-product__placeholder"></div>
          {%- endif -%}
        </div>

        <div class="nw-bundle-product__content-col">
          {%- assign accordion_blocks = section.blocks | where: 'type', 'accordion' -%}
          {%- if accordion_blocks.size > 0 -%}
            <div class="nw-bundle-product__accordion-list">
              {%- for block in accordion_blocks -%}
                <details
                  class="nw-bundle-product__accordion-item"
                  {% if block.settings.open_by_default %}open{% endif %}
                  {{ block.shopify_attributes }}
                >
                  <summary class="nw-bundle-product__accordion-summary">
                    <span class="nw-bundle-product__accordion-title">{{ block.settings.title }}</span>
                    <span class="nw-bundle-product__accordion-toggle" aria-hidden="true">
                      <span class="nw-bundle-product__toggle-icon">
                        <span class="nw-bundle-product__toggle-line nw-bundle-product__toggle-line--h"></span>
                        <span class="nw-bundle-product__toggle-line nw-bundle-product__toggle-line--v"></span>
                      </span>
                    </span>
                  </summary>
                  <div class="nw-bundle-product__accordion-content">
                    <div class="nw-bundle-product__accordion-body">
                      {{ block.settings.content }}
                    </div>
                  </div>
                </details>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- assign trust_badge_blocks = section.blocks | where: 'type', 'trust_badge' -%}
          {% render 'nw-cta-badges',
            settings: section.settings,
            blocks: trust_badge_blocks,
            class: 'nw-bundle-product__cta-wrap'
          %}
        </div>
      </div>
    </div>
  </div>
</div>

