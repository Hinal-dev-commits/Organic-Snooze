            { "value": "check", "label": "Checkmark (Green Default)" },
            { "value": "cross", "label": "Cross (Red)" },
            { "value": "custom", "label": "Custom Icon Image" },
            { "value": "none", "label": "None" }
          ]
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image",
          "visible_if": "{{ block.settings.icon == 'custom' }}"
        },
        {
          "type": "inline_richtext",
          "id": "feature_text",
          "label": "Feature / Benefit Text",
          "default": "soft, breathable surface"
        }
      ]
    },
    {
      "type": "leave_out_item",
      "name": "Leave Out Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Item Icon",
          "default": "cross",
          "options": [
            { "value": "cross", "label": "Cross (Red Default)" },
            { "value": "check", "label": "Checkmark (Green)" },
            { "value": "custom", "label": "Custom Icon Image" },
            { "value": "none", "label": "None" }
          ]
        },
