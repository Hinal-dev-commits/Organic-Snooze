{{ 'nw-section-banner.css' | asset_url | stylesheet_tag }}
{{ 'nw-cta-badges.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-section-banner.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign nw_shell_selector = '#NwSectionBanner-' | append: section.id
  assign trust_badge_blocks = section.blocks | where: 'type', 'trust_badge'
  assign banner_bg_type = section.settings.bg_type | default: 'image'
  assign banner_desktop_image = section.settings.bg_image
  assign banner_mobile_image = section.settings.bg_image_mobile
  if banner_mobile_image == blank
    assign banner_mobile_image = banner_desktop_image
  endif

  if banner_bg_type == 'image' and section.settings.bg_color_image != blank
    assign banner_overlay = section.settings.bg_color_image
    assign banner_overlay_opacity = 1
  else
    assign banner_overlay = 'transparent'
    assign banner_overlay_opacity = 0
  endif
-%}

{% render 'nw-section-shell', selector: nw_shell_selector, mode: 'direct', default_bg: '#8B5E3C' %}

{%- if banner_bg_type == 'image' -%}
  <style>
    {{ nw_shell_selector }} {
      background-image: none !important;
    }

    @media screen and (max-width: 750px) {
      {{ nw_shell_selector }} {
        padding-top: 0 !important;
        padding-bottom: 0 !important;
      }
    }
  </style>
{%- endif -%}

<nw-section-banner
  id="NwSectionBanner-{{ section.id }}"
  class="nw-section-banner section-{{ section.id }}"
  style="
    --nw-sb-heading-color: {{ section.settings.heading_color }};
    --nw-sb-desc-color: {{ section.settings.description_color }};
    --nw-sb-tag-bg: {{ section.settings.tag_bg_color }};
    --nw-sb-tag-text: {{ section.settings.tag_text_color }};
    --nw-sb-rating-text: {{ section.settings.rating_text_color }};
    --nw-sb-star-color: {{ section.settings.star_color }};
    --nw-sb-star-inactive: {{ section.settings.star_inactive_color }};
    --nw-sb-btn-bg: {{ section.settings.button_bg_color }};
    --nw-sb-btn-text: {{ section.settings.button_text_color }};
    --nw-sb-overlay: {{ banner_overlay }};
    --nw-sb-overlay-opacity: {{ banner_overlay_opacity }};
  "
>
  {%- if banner_bg_type == 'image' -%}
    <div class="nw-section-banner__media" aria-hidden="true">
      {%- if banner_desktop_image != blank or banner_mobile_image != blank -%}
        {%- if banner_desktop_image != blank
          and banner_mobile_image != blank
          and banner_desktop_image != banner_mobile_image
        -%}
          <img
            src="{{ banner_mobile_image | image_url: width: 1200 }}"
            class="nw-section-banner__image nw-section-banner__image--mobile"
            loading="eager"
            fetchpriority="high"
            width=""
            height=""
            alt=""
          >
          <img
            src="{{ banner_desktop_image | image_url: width: 2880 }}"
            class="nw-section-banner__image nw-section-banner__image--desktop"
            loading="eager"
            fetchpriority="high"
            width=""
            height=""
            alt=""
          >
        {%- elsif banner_desktop_image != blank -%}
          <img
            src="{{ banner_desktop_image | image_url: width: 2880 }}"
            class="nw-section-banner__image"
            loading="eager"
            fetchpriority="high"
            width=""
            height=""
            alt=""
          >
        {%- else -%}
          <img
            src="{{ banner_mobile_image | image_url: width: 1200 }}"
            class="nw-section-banner__image"
            loading="eager"
            fetchpriority="high"
            width=""
            height=""
            alt=""
          >
        {%- endif -%}
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'nw-section-banner__image nw-section-banner__image--placeholder' }}
      {%- endif -%}
    </div>

    <div class="nw-section-banner__overlay"></div>
  {%- endif -%}

  <div class="page-width">
    <div class="nw-section-banner__layout nw-section-banner__layout--{{ section.settings.text_position_mobile }}">
      <div class="nw-section-banner__inner{%- render 'nw-scroll-animation' -%}">
        <div class="nw-section-banner__content">
          {%- if section.settings.tag_text != blank -%}
            <p class="nw-section-banner__tag">{{ section.settings.tag_text }}</p>
          {%- endif -%}

          <div class="nw-section-banner__copy">
            {%- liquid
              assign header_eyebrow = blank
              if section.settings.show_rating
                assign header_eyebrow = section.settings.rating_text
              endif
            -%}
            {% render 'nw-section-header',
              show_rating: section.settings.show_rating,
              rating: section.settings.star_rating,
              eyebrow: header_eyebrow,
              heading: section.settings.heading,
              description: section.settings.description,
              section_index: section.index,
              heading_class: 'nw-section-banner__heading',
              star_class: 'nw-section-banner__star'
            %}
          </div>

          <div class="nw-section-banner__actions">
            {%- if section.settings.button_text != blank -%}
              <div class="nw-section-banner__cta">
                {% render 'nw-button',
                  text: section.settings.button_text,
                  link: section.settings.button_link,
                  style: section.settings.button_style,
                  btn_class: 'nw-section-banner__btn'
                %}
              </div>
            {%- endif -%}

            {%- if trust_badge_blocks.size > 0 -%}
              {% render 'nw-cta-badges',
                settings: section.settings,
                blocks: trust_badge_blocks,
                class: 'nw-section-banner__badges',
                show_cta_button: false
              %}
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>

    <div class="nw-section-banner__aside" aria-hidden="true"></div>
  </div>
</nw-section-banner>
<script>
  function setBannerLayoutHeight() {
    const layout = document.querySelector('.nw-section-banner__layout');

    if (!layout) return;

    const height = layout.offsetHeight;

    document.documentElement.style.setProperty('--nw-section-banne-content', `${height}px`);
  }

  setBannerLayoutHeight();

  window.addEventListener('resize', setBannerLayoutHeight);
</script>
{% schema %}
{
  "name": "t:sections.nw-section-banner.name",
  "tag": "section",
  "class": "section-nw-section-banner",
  "settings": [
    {
      "type": "header",
      "content": "CONTENT"
    },
    {
      "type": "text",
      "id": "tag_text",
      "label": "Tag Text",
      "default": "The Ultimate Human Collection | By Gary Brecka"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "The Organic Sleep System Gary Brecka Built For Recovery"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Chemical-free, science-backed sleep, engineered for the recovery and performance your body is built for</p>"
    },
    {
      "type": "select",
      "id": "text_position_mobile",
      "label": "Text Position (Mobile)",
      "default": "bottom",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "EXPLORE THE COLLECTION"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "default": "primary",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ]
    },
    {
      "type": "header",
      "content": "RATING"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating",
      "default": false
    },
    {
      "type": "range",
      "id": "star_rating",
      "label": "Star Rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text"
    },
    {
      "type": "header",
      "content": "BACKGROUND SETTINGS"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "image",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "image", "label": "Image" },
        { "value": "gradient", "label": "Gradient" }
      ]
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#8B5E3C",
      "alpha": true
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile Optional)",
      "info": "Uses desktop image when empty."
    },
    {
      "type": "color",
      "id": "bg_color_image",
      "label": "Overlay Color",
      "default": "#00000000",
      "alpha": true
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient"
    },
    {
      "type": "header",
      "content": "TEXT COLORS"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#FFFFFF",
      "alpha": true
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#FFFFFF",
      "alpha": true
    },
    {
      "type": "color",
      "id": "tag_text_color",
      "label": "Tag Text Color",
      "default": "#FFFCF0",
      "alpha": true
    },
    {
      "type": "color",
      "id": "tag_bg_color",
      "label": "Tag Background",
      "default": "rgba(255, 255, 255, 0.2)",
      "alpha": true
    },
    {
      "type": "color",
      "id": "rating_text_color",
      "label": "Rating Text Color",
      "default": "#FFFFFF",
      "alpha": true
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#E57B1E",
      "alpha": true
    },
    {
      "type": "color",
      "id": "star_inactive_color",
      "label": "Empty Star Color",
      "default": "rgba(255, 255, 255, 0.3)",
      "alpha": true
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background",
      "default": "#A96B3E",
      "alpha": true
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF",
      "alpha": true
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "checkbox",
          "id": "use_custom_icon",
          "label": "Use Custom Icon Image",
          "default": false
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Badge Icon",
          "default": "none",
          "visible_if": "{{ block.settings.use_custom_icon == false }}",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "moneyback", "label": "100-Night Trial / Moneyback" },
            { "value": "warranty", "label": "Warranty" },
            { "value": "shipping", "label": "Shipping / Truck" },
            { "value": "financing", "label": "Financing / Offer" },
            { "value": "shield", "label": "Shield" }
          ]
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image",
          "visible_if": "{{ block.settings.use_custom_icon == true }}"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Badge Text",
          "default": "100-Night Risk-Free Trial"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.nw-section-banner.name",
      "category": "NW Sections",
      "blocks": [
        {
          "type": "trust_badge",
          "settings": {
            "icon": "none",
            "text": "100-Night Risk-Free Trial"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "none",
            "text": "30-Year Warranty"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "none",
            "text": "Free Shipping"
          }
        }
      ]
    }
  ]
}
{% endschema %}
