{{ 'nw-never-use.css' | asset_url | stylesheet_tag }}

<style>
  #NwNeverUse-{{ section.id }} {
    display: block;
    position: relative;
    width: 100%;
    box-sizing: border-box;
    isolation: isolate;
    overflow: hidden;
    padding-top: {{ section.settings.padding_top_desktop | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop | default: 80 }}px;
    {% case section.settings.bg_type %}
      {% when 'color' %}
        background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
      {% when 'gradient' %}
        background: {{ section.settings.bg_gradient }};
      {% when 'image' %}
        background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
      {% when 'none' %}
        background: transparent;
      {% else %}
        background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
    {% endcase %}
  }

  {%- if section.settings.bg_type == 'image' and section.settings.bg_image != blank -%}
    #NwNeverUse-{{ section.id }}::before {
      content: '';
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background-image: url('{{ section.settings.bg_image | image_url: width: 2880 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      z-index: 0;
      pointer-events: none;
    }
  {%- endif -%}

  {%- if section.settings.bg_type == 'image' and section.settings.bg_color_image != blank -%}
    #NwNeverUse-{{ section.id }}::after {
      content: '';
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background-color: {{ section.settings.bg_color_image | default: '#FFFFFF29' }};
      z-index: 0;
      pointer-events: none;
    }
  {%- endif -%}

  #NwNeverUse-{{ section.id }} > * {
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 749px) {
    #NwNeverUse-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile | default: 48 }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile | default: 48 }}px;
    }

    {%- if section.settings.bg_type == 'image' and section.settings.bg_image_mobile != blank -%}
      #NwNeverUse-{{ section.id }}::before {
        background-image: url('{{ section.settings.bg_image_mobile | image_url: width: 1200 }}');
      }
    {%- endif -%}
  }
</style>

<div id="NwNeverUse-{{ section.id }}" class="nw-never-use section-{{ section.id }}">
  <div class="page-width">
    <div class="nw-never-use__wrapper{%- render 'nw-scroll-animation' -%}">
      <div class="nw-never-use__header">
        {% render 'nw-section-header',
          show_rating: section.settings.show_rating,
          rating: section.settings.star_rating,
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          description: section.settings.subheading,
          section_index: section.index
        %}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="nw-never-use__grid">
          {%- for block in section.blocks -%}
            <div class="nw-never-use__card" {{ block.shopify_attributes }}>
              <div class="nw-never-use__card-media">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 128 }}"
                    alt="{{ block.settings.title | default: 'Prohibited item' | escape }}"
                    width="64"
                    height="64"
                    loading="lazy"
                    class="nw-never-use__card-img"
                  >
                {%- else -%}
                  <span class="nw-never-use__card-placeholder" aria-hidden="true"></span>
                {%- endif -%}
              </div>

              <div class="nw-never-use__card-content">
                {%- if block.settings.title != blank -%}
                  <h3 class="nw-never-use__card-title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="nw-never-use__card-text">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_button and section.settings.btn_text != blank -%}
        <div class="nw-never-use__btn-wrap">
          {% render 'nw-button',
            text: section.settings.btn_text,
            link: section.settings.btn_link,
            style: section.settings.btn_style,
            btn_class: 'nw-never-use__btn'
          %}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "NW Never Use",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "SECTION HEADER"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Star Rating",
      "default": false
    },
    {
      "type": "range",
      "id": "star_rating",
      "label": "Star Rating",
      "min": 1,
      "max": 5,
      "step": 0.5,
      "default": 5,
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow Text"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "What We Never Use"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Description",
      "default": "<p>A cleaner mattress is what we refuse. Most beds hide chemicals. We build without them and let labs prove it.</p>"
    },
    {
      "type": "header",
      "content": "BUTTON"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Label",
      "default": "VERIFY OUR CERTIFICATIONS",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "select",
      "id": "btn_style",
      "label": "Button Style",
      "default": "primary",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ],
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "header",
      "content": "BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "color",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "image", "label": "Image" },
        { "value": "gradient", "label": "Gradient" }
      ]
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile Optional)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color_image",
      "label": "Overlay Color",
      "default": "#FFFFFF29",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon / Image"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "default": "No Fiberglass"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Description",
          "default": "A hidden fire barrier that can escape into your home. We use natural wool."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NW Never Use",
      "category": "NW Sections",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "No Fiberglass",
            "text": "A hidden fire barrier that can escape into your home. We use natural wool."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "No Plastic Fibers",
            "text": "Petroleum-based and heat-trapping. We use natural latex."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "No toxic glues",
            "text": "The adhesives that off-gas in most beds. Ours are hand-tufted."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "No formaldehyde",
            "text": "A known irritant hiding in mattress adhesives. Never ours."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "No synthetic flame retardants",
            "text": "Replaced by naturally flame-resistant wool."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "No off-gassing",
            "text": "That \"new mattress smell\" is VOCs. Ours has none."
          }
        }
      ]
    }
  ]
}
{% endschema %}
