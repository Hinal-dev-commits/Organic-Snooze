{{ 'nw-natural-layers-v2.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-natural-layers-v2.js' | asset_url }}" defer="defer"></script>

<style>
  #NwNaturalLayersV2-{{ section.id }},
  .nw-natural-layers-v2.section-{{ section.id }} {
    display: block;
    width: 100%;
    box-sizing: border-box;
    --nw-nl-star-active: {{ section.settings.star_color | default: '#E57B1E' }};
    --nw-nl-star-inactive: {{ section.settings.star_color_inactive | default: '#D1D5DB' }};
    --nw-star-active: {{ section.settings.star_color | default: '#E57B1E' }};
    --nw-star-inactive: {{ section.settings.star_color_inactive | default: '#D1D5DB' }};
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: {{ section.settings.padding_top_desktop | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop | default: 80 }}px;
    {% case section.settings.bg_type %}
      {% when 'color' %}
        background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
      {% when 'gradient' %}
        background: {{ section.settings.bg_gradient }};
      {% when 'image' %}
        background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
      {% when 'none' %}
        background: transparent;
      {% else %}
        background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
    {% endcase %}
  }

  {%- if section.settings.bg_type == 'image' and section.settings.bg_image != blank -%}
    #NwNaturalLayersV2-{{ section.id }}::before,
    .nw-natural-layers-v2.section-{{ section.id }}::before {
      content: '';
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background-image: url('{{ section.settings.bg_image | image_url: width: 1920 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      z-index: 0;
      pointer-events: none;
    }
  {%- endif -%}

  {%- if section.settings.bg_type == 'image' and section.settings.bg_color_image != blank -%}
    #NwNaturalLayersV2-{{ section.id }}::after,
    .nw-natural-layers-v2.section-{{ section.id }}::after {
      content: '';
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background-color: {{ section.settings.bg_color_image | default: '#FFFFFF29' }};
      z-index: 0;
      pointer-events: none;
    }
  {%- endif -%}

  #NwNaturalLayersV2-{{ section.id }} > *,
  .nw-natural-layers-v2.section-{{ section.id }} > * {
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 749px) {
    #NwNaturalLayersV2-{{ section.id }},
    .nw-natural-layers-v2.section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile | default: 48 }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile | default: 48 }}px;
      {%- if section.settings.enable_slider_mobile and section.settings.enable_slider_desktop == false and section.settings.show_dots_mobile -%}
        --nw-swiper-bullet: {{ section.settings.pagination_color_mobile | default: '#613916' }};
      {%- endif -%}
    }

    {%- if section.settings.bg_type == 'image' and section.settings.bg_image_mobile != blank -%}
      #NwNaturalLayersV2-{{ section.id }}::before,
      .nw-natural-layers-v2.section-{{ section.id }}::before {
        background-image: url('{{ section.settings.bg_image_mobile | image_url: width: 1200 }}');
      }
    {%- endif -%}
  }
</style>

<nw-natural-layers-v2
  id="NwNaturalLayersV2-{{ section.id }}"
  class="nw-natural-layers-v2 section-{{ section.id }}{% if section.settings.enable_slider_desktop %} nw-natural-layers-v2--slider-desktop{% endif %}{% if section.settings.enable_slider_mobile and section.settings.enable_slider_desktop == false %} nw-natural-layers-v2--mobile-slider{% endif %}"
  data-enable-slider="{{ section.settings.enable_slider_desktop }}"
  data-enable-slider-mobile="{{ section.settings.enable_slider_mobile }}"
  data-show-arrows="{{ section.settings.show_arrows }}"
  data-show-dots="{{ section.settings.show_dots }}"
  data-show-arrows-mobile="{{ section.settings.show_arrows_mobile }}"
  data-show-dots-mobile="{{ section.settings.show_dots_mobile }}"
>
  <div class="page-width">
    <div class="nw-natural-layers-v2__wrapper{%- render 'nw-scroll-animation' -%}">
      <div class="nw-natural-layers-v2__header">
        {% render 'nw-section-header',
          show_rating: section.settings.show_rating,
          rating: section.settings.star_rating,
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          description: section.settings.subheading,
          section_index: section.index
        %}
      </div>

      <div class="nw-natural-layers-v2__main">
        {%- assign layer_cards = section.blocks | where: 'type', 'layer_card' -%}
        {%- liquid
          assign use_slider_markup = false
          if section.settings.enable_slider_desktop or section.settings.enable_slider_mobile
            assign use_slider_markup = true
          endif
        -%}
        {%- if layer_cards.size > 0 -%}
          {%- if use_slider_markup -%}
            <div class="nw-natural-layers-v2__slider-wrap{% if section.settings.enable_slider_mobile and section.settings.enable_slider_desktop == false %} nw-natural-layers-v2__slider-wrap--mobile{% endif %}">
              <div class="swiper nw-natural-layers-v2__swiper" id="NwNaturalLayersSwiper-{{ section.id }}">
                <div class="swiper-wrapper nw-natural-layers-v2__cards">
                  {%- for block in layer_cards -%}
                    {% render 'nw-natural-layers-v2-card',
                      block: block,
                      swiper_slide: true,
                      image_width: 700
                    %}
                  {%- endfor -%}
                </div>
              </div>

              {%- if section.settings.enable_slider_desktop and section.settings.show_arrows -%}
                {% render 'nw-swiper-arrows' %}
              {%- elsif section.settings.enable_slider_mobile
                and section.settings.enable_slider_desktop == false
                and section.settings.show_arrows_mobile
              -%}
                <div class="nw-natural-layers-v2__arrows-mobile">
                  {% render 'nw-swiper-arrows' %}
                </div>
              {%- endif -%}

              {%- if section.settings.enable_slider_desktop and section.settings.show_dots and layer_cards.size > 1 -%}
                <div class="nw-swiper-pagination" id="NwNaturalLayersPagination-{{ section.id }}"></div>
              {%- elsif section.settings.enable_slider_mobile
                and section.settings.enable_slider_desktop == false
                and section.settings.show_dots_mobile
                and layer_cards.size > 1
              -%}
                <div
                  class="nw-swiper-pagination nw-natural-layers-v2__pagination-mobile"
                  id="NwNaturalLayersPaginationMobile-{{ section.id }}"
                ></div>
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="nw-natural-layers-v2__cards">
              {%- for block in layer_cards -%}
                {% render 'nw-natural-layers-v2-card', block: block, image_width: 600 %}
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endif -%}

        {%- assign leave_out_items = section.blocks | where: 'type', 'leave_out_item' -%}
        {%- if section.settings.show_leave_out_box
          and leave_out_items.size > 0
          or section.settings.leave_out_title != blank
        -%}
          <div class="nw-natural-layers-v2__leave-out">
            {%- if section.settings.leave_out_title != blank -%}
              <h3 class="nw-natural-layers-v2__leave-out-title">{{ section.settings.leave_out_title }}</h3>
            {%- endif -%}
            {%- if leave_out_items.size > 0 -%}
              <div class="nw-natural-layers-v2__leave-out-grid">
                {%- for block in leave_out_items -%}
                  <div class="nw-natural-layers-v2__leave-out-item" {{ block.shopify_attributes }}>
                    {%- if block.settings.icon == 'custom' and block.settings.custom_icon != blank -%}
                      <span class="nw-natural-layers-v2__feature-icon" aria-hidden="true">
                        {% render 'nw-icon',
                          icon: 'none',
                          custom_icon: block.settings.custom_icon,
                          img_class: 'nw-natural-layers-v2__feature-icon-img',
                          img_width: 48
                        %}
                      </span>
                    {%- elsif block.settings.icon != 'none' -%}
                      <span class="nw-natural-layers-v2__feature-icon" aria-hidden="true">
                        {%- if block.settings.icon == 'check' -%}
                          {% render 'nw-icon', icon: 'check-circle' %}
                        {%- else -%}
                          {% render 'nw-icon', icon: 'cross-circle' %}
                        {%- endif -%}
                      </span>
                    {%- endif -%}
                    <span class="nw-natural-layers-v2__leave-out-text">{{ block.settings.text }}</span>
                  </div>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- assign trust_badges = section.blocks | where: 'type', 'trust_badge' -%}
        {% render 'nw-cta-badges',
          settings: section.settings,
          blocks: trust_badges,
          class: 'nw-natural-layers-v2__cta-wrap'
        %}
      </div>
    </div>
  </div>
</nw-natural-layers-v2>

{% schema %}
{
  "name": "NW Natural Layers V2",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "SECTION HEADER"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating Stars",
      "default": true
    },
    {
      "type": "range",
      "id": "star_rating",
      "label": "Star Rating (Active Stars)",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "star_color",
      "label": "Active Star Color",
      "default": "#E57B1E",
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "star_color_inactive",
      "label": "Inactive Star Color",
      "default": "#D1D5DB",
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Real sleepers, real mornings"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "The Natural Layers Behind Better Rest"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "SLIDER SETTINGS"
    },
    {
      "type": "checkbox",
      "id": "enable_slider_desktop",
      "label": "Enable Slider On Desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Arrows",
      "default": true,
      "visible_if": "{{ section.settings.enable_slider_desktop == true }}"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show Dots",
      "default": true,
      "visible_if": "{{ section.settings.enable_slider_desktop == true }}"
    },
    {
      "type": "header",
      "content": "MOBILE SLIDER"
    },
    {
      "type": "checkbox",
      "id": "enable_slider_mobile",
      "label": "Enable Slider On Mobile",
      "default": false,
      "info": "Swiper carousel on mobile when desktop slider is off. When desktop slider is enabled, these mobile settings are ignored."
    },
    {
      "type": "checkbox",
      "id": "show_arrows_mobile",
      "label": "Show Arrows On Mobile",
      "default": false,
      "visible_if": "{{ section.settings.enable_slider_mobile == true and section.settings.enable_slider_desktop == false }}"
    },
    {
      "type": "checkbox",
      "id": "show_dots_mobile",
      "label": "Show Dots On Mobile",
      "default": true,
      "visible_if": "{{ section.settings.enable_slider_mobile == true and section.settings.enable_slider_desktop == false }}"
    },
    {
      "type": "color",
      "id": "pagination_color_mobile",
      "label": "Pagination Color",
      "default": "#613916",
      "alpha": true,
      "visible_if": "{{ section.settings.enable_slider_mobile == true and section.settings.show_dots_mobile == true and section.settings.enable_slider_desktop == false }}"
    },
    {
      "type": "header",
      "content": "LEAVE OUT BOX"
    },
    {
      "type": "checkbox",
      "id": "show_leave_out_box",
      "label": "Show Leave Out Box",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "leave_out_title",
      "label": "Leave Out Title",
      "default": "What We Leave Out Matters Too",
      "visible_if": "{{ section.settings.show_leave_out_box == true }}"
    },
    {
      "type": "header",
      "content": "CTA BUTTON"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Label",
      "default": "SHOP MATTRESSES",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "select",
      "id": "btn_style",
      "label": "Button Style",
      "default": "primary",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ],
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "header",
      "content": "BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "image",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "image", "label": "Image" },
        { "value": "gradient", "label": "Gradient" }
      ]
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile Optional)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color_image",
      "label": "Overlay Color",
      "default": "#FFFFFF29",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "layer_card",
      "name": "Natural Layer Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Layer Image"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Layer Title",
          "default": "Organic Cotton"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Feature Icon",
          "default": "check",
          "options": [
            { "value": "check", "label": "Checkmark (Green Default)" },
            { "value": "cross", "label": "Cross (Red)" },
            { "value": "custom", "label": "Custom Icon Image" },
            { "value": "none", "label": "None" }
          ]
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image",
          "visible_if": "{{ block.settings.icon == 'custom' }}"
        },
        {
          "type": "inline_richtext",
          "id": "feature_text",
          "label": "Feature / Benefit Text",
          "default": "soft, breathable surface"
        }
      ]
    },
    {
      "type": "leave_out_item",
      "name": "Leave Out Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Item Icon",
          "default": "cross",
          "options": [
            { "value": "cross", "label": "Cross (Red Default)" },
            { "value": "check", "label": "Checkmark (Green)" },
            { "value": "custom", "label": "Custom Icon Image" },
            { "value": "none", "label": "None" }
          ]
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image",
          "visible_if": "{{ block.settings.icon == 'custom' }}"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Item Text",
          "default": "No Fiberglass"
        }
      ]
    },
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Badge Icon",
          "default": "moneyback",
          "options": [
            { "value": "moneyback", "label": "Moneyback Shield" },
            { "value": "truck", "label": "Truck Shipping" },
            { "value": "shield", "label": "Shield" },
            { "value": "custom", "label": "Custom Icon Image" }
          ]
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image",
          "visible_if": "{{ block.settings.icon == 'custom' }}"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Badge Text",
          "default": "100-Night Risk-Free Trial"
        }
      ]
    }
  ],
  "presets": [
    {
