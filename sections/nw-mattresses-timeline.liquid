{{ 'nw-mattresses-timeline.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-mattresses-timeline.js' | asset_url }}" defer="defer"></script>
{% comment %} Shared padding and background styles come from nw-section-shell. {% endcomment %}

{%- liquid
  assign nw_shell_selector = '.nw-mattresses-timeline.section-' | append: section.id
  assign timeline_main_alt = section.settings.main_image.alt | default: section.settings.heading
  assign timeline_main_mobile_alt = section.settings.main_image_mobile.alt | default: section.settings.heading
-%}
{% render 'nw-section-shell', selector: nw_shell_selector, mode: 'direct' %}
<style>
  .nw-mattresses-timeline.section-{{ section.id }} .nw-mattresses-timeline__card {
    {% if section.settings.card_wrap_bg != blank %}
      background-color: {{ section.settings.card_wrap_bg }};
    {% endif %}
  }

  .nw-mattresses-timeline.section-{{ section.id }} .nw-mattresses-timeline__card-title {
    {% if section.settings.card_heading_color != blank %}
      color: {{ section.settings.card_heading_color }};
    {% endif %}
  }

  .nw-mattresses-timeline.section-{{ section.id }} .nw-mattresses-timeline__card-desc {
    {% if section.settings.card_desc_color != blank %}
      color: {{ section.settings.card_desc_color }};
    {% endif %}
  }
</style>

<nw-mattresses-timeline class="nw-mattresses-timeline section-{{ section.id }}">
    <div class="nw-mattresses-timeline__wrapper{%- render 'nw-scroll-animation' -%}">
      <div class="nw-mattresses-timeline__grid">
        <div class="nw-mattresses-timeline__media-col">
          <div class="nw-mattresses-timeline__main-media">
            {%- if section.settings.main_image != blank or section.settings.main_image_mobile != blank -%}
              {%- if section.settings.main_image != blank and section.settings.main_image_mobile != blank -%}
                {{
                  section.settings.main_image_mobile
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    class: 'nw-mattresses-timeline__main-img nw-mattresses-timeline__main-img--mobile',
                    widths: '375, 550, 750, 800',
                    sizes: '100vw',
                    alt: timeline_main_mobile_alt
                }}
                {{
                  section.settings.main_image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    class: 'nw-mattresses-timeline__main-img nw-mattresses-timeline__main-img--desktop',
                    widths: '550, 750, 900, 1100, 1200',
                    sizes: '(min-width: 990px) 802px, 50vw',
                    alt: timeline_main_alt
                }}
              {%- elsif section.settings.main_image != blank -%}
                {{
                  section.settings.main_image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    class: 'nw-mattresses-timeline__main-img',
                    widths: '550, 750, 900, 1100, 1200',
                    sizes: '(min-width: 990px) 802px, 100vw',
                    alt: timeline_main_alt
                }}
              {%- else -%}
                {{
                  section.settings.main_image_mobile
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    class: 'nw-mattresses-timeline__main-img',
                    widths: '375, 550, 750, 800',
                    sizes: '100vw',
                    alt: timeline_main_mobile_alt
                }}
              {%- endif -%}
            {%- else -%}
              <div class="nw-mattresses-timeline__main-placeholder" aria-hidden="true">
                {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>
        </div>

        <div class="nw-mattresses-timeline__content-col">
          {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
            <div class="nw-mattresses-timeline__header">
              {%- if section.settings.heading != blank -%}
                {% render 'nw-section-heading', text: section.settings.heading, class: 'nw-mattresses-timeline__heading' %}
              {%- endif -%}
              {%- if section.settings.subheading != blank -%}
                {% render 'nw-section-description', text: section.settings.subheading, class: 'nw-mattresses-timeline__subheading' %}
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if section.blocks.size > 0 -%}
            <div class="nw-mattresses-timeline__timeline">
              {%- for block in section.blocks -%}
                <div class="nw-mattresses-timeline__layer-item" {{ block.shopify_attributes }}>
                  <div class="nw-mattresses-timeline__stepper" aria-hidden="true">
                    {%- unless forloop.first -%}
                      <div class="nw-mattresses-timeline__line-top"></div>
                    {%- endunless -%}
                    <div class="nw-mattresses-timeline__dot"></div>
                    {%- unless forloop.last -%}
                      <div class="nw-mattresses-timeline__line-bottom"></div>
                    {%- endunless -%}
                  </div>

                  <div class="nw-mattresses-timeline__card-wrap">
                    <div class="nw-mattresses-timeline__card">
                      {%- if block.settings.tag != blank -%}
                        <span
                          class="nw-mattresses-timeline__tag"
                          style="{% if section.settings.tag_bg != blank %}background-color: {{ section.settings.tag_bg }};{% endif %}"
                        >
                          {{ block.settings.tag }}
                        </span>
                      {%- endif -%}

                      <div class="nw-mattresses-timeline__card-content">
                        {%- if block.settings.title != blank -%}
                          <h3 class="nw-mattresses-timeline__card-title">{{ block.settings.title }}</h3>
                        {%- endif -%}
                        {%- if block.settings.subtitle != blank -%}
                          <p class="nw-mattresses-timeline__card-desc">{{ block.settings.subtitle }}</p>
                        {%- endif -%}
                      </div>

                      {%- if block.settings.image != blank -%}
                        {%- assign cutout_alt = block.settings.title | escape -%}
                        <div class="nw-mattresses-timeline__card-cutout{% if forloop.first %} nw-mattresses-timeline__card-cutout--first{% endif %}">
                          {{
                            block.settings.image
                            | image_url: width: 444
                            | image_tag:
                              loading: 'lazy',
                              class: 'nw-mattresses-timeline__cutout-img',
                              widths: '160, 222, 320, 444',
                              sizes: '(max-width: 749px) 222px, 160px',
                              alt: cutout_alt
                          }}
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if section.settings.show_comparison -%}
            <div class="nw-mattresses-timeline__comparison">
              {%- if section.settings.comparison_title != blank -%}
                <h3 class="nw-mattresses-timeline__comparison-title">{{ section.settings.comparison_title }}</h3>
              {%- endif -%}

              <div class="nw-mattresses-timeline__comparison-grid">
                <div class="nw-mattresses-timeline__compare-card nw-mattresses-timeline__compare-card--foam">
                  {%- if section.settings.foam_brand != blank -%}
                    <p class="nw-mattresses-timeline__foam-brand">{{ section.settings.foam_brand }}</p>
                  {%- endif -%}
                  <div class="nw-mattresses-timeline__compare-price-group">
                    {%- if section.settings.foam_price != blank -%}
                      <p class="nw-mattresses-timeline__foam-price">{{ section.settings.foam_price }}</p>
                    {%- endif -%}
                    {%- if section.settings.foam_note != blank -%}
                      <p class="nw-mattresses-timeline__foam-note">{{ section.settings.foam_note }}</p>
                    {%- endif -%}
                  </div>
                </div>

                <div
                  class="nw-mattresses-timeline__compare-card nw-mattresses-timeline__compare-card--snooze"
                  style="{% if section.settings.snooze_bg != blank %}background-color: {{ section.settings.snooze_bg }};{% endif %}"
                >
                  <div class="nw-mattresses-timeline__snooze-logo-wrap">
                    {%- if section.settings.snooze_logo != blank -%}
                      <img
                        src="{{ section.settings.snooze_logo | image_url: width: 400 }}"
                        alt="{{ section.settings.snooze_brand | default: 'Organic Snooze' | escape }}"
                        class="nw-mattresses-timeline__snooze-logo-img"
                        width=""
                        height=""
                        loading="lazy"
                      >
                     
                    {%- else -%}
                      <span class="nw-mattresses-timeline__snooze-logo-text">{{ section.settings.snooze_brand | default: 'ORGANIC SNOOZE' }}</span>
                    {%- endif -%}
                  </div>

                  <div class="nw-mattresses-timeline__compare-price-group">
                    {%- if section.settings.snooze_price != blank -%}
                      <p class="nw-mattresses-timeline__snooze-price">{{ section.settings.snooze_price }}</p>
                    {%- endif -%}
                    {%- if section.settings.snooze_note != blank -%}
                      <p class="nw-mattresses-timeline__snooze-note">{{ section.settings.snooze_note }}</p>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
</nw-mattresses-timeline>

{% schema %}
{
  "name": "t:sections.nw-mattresses-timeline.name",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "SECTION CONTENT"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Every Layer Has a Purpose"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "Four layers, zero compromises. See exactly what you're sleeping on."
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Mattress Render (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "main_image_mobile",
      "label": "Mattress Render (Mobile)",
      "info": "Optional. Uses desktop image when empty."
    },
    {
      "type": "header",
      "content": "LAYER CARD COLORS"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "tag_bg",
      "label": "Tag Background Color",
      "default": "#613916"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "card_wrap_bg",
      "label": "Card Background"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "card_heading_color",
      "label": "Card Heading Color"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "card_desc_color",
      "label": "Card Description Color"
    },
    {
      "type": "header",
      "content": "VALUE COMPARISON"
    },
    {
      "type": "checkbox",
      "id": "show_comparison",
      "label": "Show Comparison Module",
      "default": true
    },
    {
      "type": "text",
      "id": "comparison_title",
      "label": "Comparison Title",
      "default": "Long-Term Value Comparison"
    },
    {
      "type": "text",
      "id": "foam_brand",
      "label": "Competitor Brand Name",
      "default": "Popular Foam Brands"
    },
    {
      "type": "text",
      "id": "foam_price",
      "label": "Competitor Price Per Night",
      "default": "$1.02 / night"
    },
    {
      "type": "text",
      "id": "foam_note",
      "label": "Competitor Note",
      "default": "Replaced every 10 years"
    },
    {
      "type": "image_picker",
      "id": "snooze_logo",
      "label": "Snooze Logo (Optional Image)"
    },
    {
      "type": "text",
      "id": "snooze_brand",
      "label": "Snooze Brand Name",
      "default": "ORGANIC SNOOZE"
    },
    {
      "type": "text",
      "id": "snooze_price",
      "label": "Snooze Price Per Night",
      "default": "$0.16 / night"
    },
    {
      "type": "text",
      "id": "snooze_note",
      "label": "Snooze Note",
      "default": "Built to last 30 years"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "snooze_bg",
      "label": "Snooze Card Background",
      "default": "#878735"
    },
    {
      "type": "header",
      "content": "BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "color",
          "label": "Color"
        },
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ]
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "layer",
      "name": "Mattress Layer",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Layer Tag",
          "default": "LAYER 1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Layer Title",
          "default": "Organic Cover"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Layer Description",
          "default": "Breathable GOTS cotton"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Layer Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.nw-mattresses-timeline.name",
      "category": "NW Sections",
      "blocks": [
        {
          "type": "layer",
          "settings": {
            "tag": "LAYER 1",
            "title": "Organic Cover",
            "subtitle": "Breathable GOTS cotton"
          }
        },
        {
          "type": "layer",
          "settings": {
            "tag": "LAYER 2",
            "title": "CloudWool",
            "subtitle": "Temperature Regulating Fire Barrier"
          }
        },
        {
          "type": "layer",
          "settings": {
            "tag": "LAYER 3",
            "title": "Perforated Latex",
            "subtitle": "Perforated breathable design for max airflow"
          }
        },
        {
          "type": "layer",
          "settings": {
            "tag": "LAYER 4",
            "title": "Steel Coils",
            "subtitle": "Provide stable support and limits motion transfer"
          }
        }
      ]
    }
  ]
}
{% endschema %}
