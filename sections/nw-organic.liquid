{{ 'nw-organic.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-organic.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign layout_width = section.settings.layout_width | default: 'page_width'
  assign nw_shell_selector = '#NwOrganic-' | append: section.id
  assign col1_head_alt = section.settings.col1_head_title | default: 'Organic Snooze' | escape
  assign col2_head_alt = section.settings.col2_head_title | default: 'Conventional Foam' | escape
-%}
{% render 'nw-section-shell', selector: nw_shell_selector, mode: 'direct' %}

{%- if layout_width == 'full_width' -%}
  <style>
    {{ nw_shell_selector }}.nw-organic--full-width {
      padding-top: 0;
      padding-bottom: 0;
      background: transparent;
    }
  </style>
{%- endif -%}

<nw-organic
  id="NwOrganic-{{ section.id }}"
  class="nw-organic nw-organic--{{ layout_width }} section-{{ section.id }}"
  style="
    --nw-organic-brand-bg: {{ section.settings.brand_column_bg }};
    --nw-organic-border-color: {{ section.settings.table_border_color }};
    --nw-organic-cell-text-color: {{ section.settings.cell_text_color }};
    --nw-organic-table-bg: {{ section.settings.table_bg }};
    {%- if layout_width == 'full_width' -%}
      --nw-organic-content-panel-bg: {{ section.settings.content_panel_bg }};
      --nw-organic-heading-color: {{ section.settings.content_panel_heading_color }};
      --nw-organic-desc-color: {{ section.settings.content_panel_description_color }};
    {%- else -%}
      --nw-organic-heading-color: {{ section.settings.heading_color }};
      --nw-organic-desc-color: {{ section.settings.description_color }};
    {%- endif -%}
    --nw-organic-comparison-title-color: {{ section.settings.comparison_title_color }};
    --nw-organic-foam-card-bg: {{ section.settings.foam_card_bg }};
    --nw-organic-foam-card-border: {{ section.settings.foam_card_border_color }};
    --nw-organic-foam-brand-color: {{ section.settings.foam_brand_color }};
    --nw-organic-foam-price-color: {{ section.settings.foam_price_color }};
    --nw-organic-foam-note-color: {{ section.settings.foam_note_color }};
    --nw-organic-snooze-card-bg: {{ section.settings.snooze_bg }};
    --nw-organic-snooze-brand-color: {{ section.settings.snooze_brand_color }};
    --nw-organic-snooze-price-color: {{ section.settings.snooze_price_color }};
    --nw-organic-snooze-note-color: {{ section.settings.snooze_note_color }};
  "
>
  <div class="nw-organic__inner{% if layout_width == 'page_width' %} page-width {% else %} full-width{% endif %}">
    <div class="nw-organic__wrapper{% if section.settings.image_position == 'left' %} nw-organic__wrapper--image-left{% endif %}{%- render 'nw-scroll-animation' -%}">
      <div class="nw-organic__header">
        {%- if layout_width == 'page_width' -%}
        {% render 'nw-section-header',
          heading: section.settings.heading,
          description: section.settings.description,
          section_index: section.index
        %}
        {%- endif -%}
      </div>

      <div class="nw-organic__main{% if section.settings.image_position == 'left' %} nw-organic__main--image-left{% endif %}">
        <div class="nw-organic__table-col">
          <div class="nw-organic__header">
            {%- if layout_width == 'full_width' -%}
            {% render 'nw-section-header',
              heading: section.settings.heading,
                description: section.settings.description,
                section_index: section.index
              %}
            {%- endif -%}
          </div>
          <div class="nw-organic__table">
            <div class="nw-organic__table-row nw-organic__table-row--head">
              <div class="nw-organic__cell nw-organic__cell--feature"></div>
              
              <div class="nw-organic__cell nw-organic__cell--head-brand">
                {%- if section.settings.col1_head_image != blank -%}
                  {{
                    section.settings.col1_head_image
                    | image_url: width: 240
                    | image_tag:
                      alt: col1_head_alt,
                      class: 'nw-organic__head-floating-img',
                      loading: 'lazy',
                      widths: '120, 180, 240',
                      sizes: '120px'
                  }}
                {%- endif -%}

                {%- if section.settings.col1_head_logo != blank -%}
                  {{
                    section.settings.col1_head_logo
                    | image_url: width: 320
                    | image_tag:
                      alt: col1_head_alt,
                      class: 'nw-organic__brand-logo',
                      loading: 'lazy',
                      widths: '160, 240, 320',
                      sizes: '160px'
                  }}
                {%- elsif section.settings.col1_head_title != blank -%}
                  <span class="nw-organic__brand-text">{{ section.settings.col1_head_title }}</span>
                {%- endif -%}
              </div>

              <div class="nw-organic__cell nw-organic__cell--head-other">
                {%- if section.settings.col2_head_image != blank -%}
                  {{
                    section.settings.col2_head_image
                    | image_url: width: 240
                    | image_tag:
                      alt: col2_head_alt,
                      class: 'nw-organic__head-floating-img nw-organic__head-floating-img--other',
                      loading: 'lazy',
                      widths: '120, 180, 240',
                      sizes: '120px'
                  }}
                {%- endif -%}

                {%- if section.settings.col2_head_title != blank -%}
                  <span class="nw-organic__other-title">{{ section.settings.col2_head_title }}</span>
                {%- endif -%}
              </div>
            </div>

            {%- assign row_blocks = section.blocks | where: 'type', 'table_row' -%}
            {%- for block in row_blocks -%}
              <div class="nw-organic__table-row" {{ block.shopify_attributes }}>
                <div class="nw-organic__cell nw-organic__cell--feature">
                  <span>{{ block.settings.feature_name }}</span>
                </div>

                <div class="nw-organic__cell nw-organic__cell--brand">
                  {%- if block.settings.col1_use_custom_icon and block.settings.col1_custom_icon != blank -%}
                    <span class="nw-organic__icon">
                      {{
                        block.settings.col1_custom_icon
                        | image_url: width: 80
                        | image_tag:
                          alt: '',
                          class: 'nw-organic__icon-img',
                          loading: 'lazy',
                          widths: '40, 60, 80',
                          sizes: '24px'
                      }}
                    </span>
                  {%- elsif block.settings.col1_icon != 'none' -%}
                    <span
                      class="nw-organic__icon{% if block.settings.col1_icon == 'verified-3' or block.settings.col1_icon == 'solar-check' %} nw-organic__icon--verified-3{% endif %}"
                      style="{% if block.settings.col1_icon_color != blank %}color: {{ block.settings.col1_icon_color }};{% endif %}"
                    >
                      {% render 'nw-icon',
                        icon: block.settings.col1_icon,
                        img_class: 'nw-organic__icon-img'
                      %}
                    </span>
                  {%- endif -%}
                  {%- if block.settings.col1_text != blank -%}
                    <span class="nw-organic__cell-text">{{ block.settings.col1_text }}</span>
                  {%- endif -%}
                </div>

                <div class="nw-organic__cell nw-organic__cell--other">
                  {%- if block.settings.col2_use_custom_icon and block.settings.col2_custom_icon != blank -%}
                    <span class="nw-organic__icon">
                      {{
                        block.settings.col2_custom_icon
                        | image_url: width: 80
                        | image_tag:
                          alt: '',
                          class: 'nw-organic__icon-img',
                          loading: 'lazy',
                          widths: '40, 60, 80',
                          sizes: '24px'
                      }}
                    </span>
                  {%- elsif block.settings.col2_icon != 'none' -%}
                    <span
                      class="nw-organic__icon{% if block.settings.col2_icon == 'cross' or block.settings.col2_icon == 'red-cross' %} nw-organic__icon--cross{% endif %}"
                      style="{% if block.settings.col2_icon_color != blank %}color: {{ block.settings.col2_icon_color }};{% endif %}"
                    >
                      {% render 'nw-icon',
                        icon: block.settings.col2_icon,
                        img_class: 'nw-organic__icon-img'
                      %}
                    </span>
                  {%- endif -%}
                  {%- if block.settings.col2_text != blank -%}
                    <span class="nw-organic__cell-text">{{ block.settings.col2_text }}</span>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>

        <div
          class="nw-organic__image-col{% if section.settings.media_type == 'video' %} nw-organic__image-col--video{% if section.settings.video_autoplay %} is-autoplay{% endif %}{% endif %}"
          {% if section.settings.media_type == 'video' and section.settings.video != blank %}
            data-nw-organic-media
            data-autoplay="{{ section.settings.video_autoplay }}"
          {% endif %}
        >
          {%- if section.settings.media_type == 'video' and section.settings.video != blank -%}
            {%- liquid
              assign media_poster = section.settings.video_poster
              assign media_poster_mobile = section.settings.video_poster_mobile
              if media_poster == blank and section.settings.video.preview_image != blank
                assign media_poster = section.settings.video.preview_image
              endif
              if media_poster_mobile == blank and media_poster != blank
                assign media_poster_mobile = media_poster
              endif
            -%}

            {{
              section.settings.video
              | video_tag:
                autoplay: section.settings.video_autoplay,
                loop: section.settings.video_autoplay,
                muted: section.settings.video_autoplay,
                controls: false,
                playsinline: true,
                preload: 'metadata',
                tabindex: -1,
                class: 'nw-organic__video',
                image_size: '1200x'
            }}

            {%- if media_poster != blank or media_poster_mobile != blank -%}
              {%- liquid
                assign organic_poster_alt = section.settings.heading | default: 'Organic Snooze comparison' | escape
              -%}
              {%- if media_poster != blank and media_poster_mobile != blank and media_poster != media_poster_mobile -%}
                {{
                  media_poster
                  | image_url: width: 1200
                  | image_tag:
                    alt: organic_poster_alt,
                    class: 'nw-organic__img nw-organic__img--desktop nw-organic__poster',
                    loading: 'lazy',
                    widths: '600, 900, 1200',
                    sizes: '(min-width: 750px) 712px, 100vw'
                }}
                {{
                  media_poster_mobile
                  | image_url: width: 800
                  | image_tag:
                    alt: organic_poster_alt,
                    class: 'nw-organic__img nw-organic__img--mobile nw-organic__poster',
                    loading: 'lazy',
                    widths: '400, 600, 800',
                    sizes: '100vw'
                }}
              {%- elsif media_poster != blank -%}
                {{
                  media_poster
                  | image_url: width: 1200
                  | image_tag:
                    alt: organic_poster_alt,
                    class: 'nw-organic__img nw-organic__poster',
                    loading: 'lazy',
                    widths: '600, 900, 1200',
                    sizes: '(min-width: 750px) 712px, 100vw'
                }}
              {%- else -%}
                {{
                  media_poster_mobile
                  | image_url: width: 800
                  | image_tag:
                    alt: organic_poster_alt,
                    class: 'nw-organic__img nw-organic__poster',
                    loading: 'lazy',
                    widths: '400, 600, 800',
                    sizes: '100vw'
                }}
              {%- endif -%}
            {%- endif -%}

            {%- if section.settings.show_play_icon and section.settings.video_autoplay == false -%}
              <div class="nw-organic__video-controls">
                <button type="button" class="nw-organic__play" data-nw-organic-play aria-label="Play video">
                  <span class="nw-organic__control-icon" aria-hidden="true">
                    {{ 'play-v2.svg' | inline_asset_content }}
                  </span>
                </button>
                <button type="button" class="nw-organic__pause" data-nw-organic-pause aria-label="Pause video" hidden>
                  <span class="nw-organic__control-icon" aria-hidden="true">
                    {{ 'icon-pause.svg' | inline_asset_content }}
                  </span>
                </button>
              </div>
            {%- endif -%}
          {%- else -%}
            {%- liquid
              assign img_dt = section.settings.image_desktop
              assign img_mb = section.settings.image_mobile
            -%}
            {%- if img_dt != blank or img_mb != blank -%}
              {%- liquid
                assign organic_image_alt = section.settings.heading | default: 'Organic Snooze comparison' | escape
              -%}
              {%- if img_dt != blank and img_mb != blank -%}
                {{
                  img_dt
                  | image_url: width: 1200
                  | image_tag:
                    alt: organic_image_alt,
                    class: 'nw-organic__img nw-organic__img--desktop',
                    loading: 'lazy',
                    widths: '600, 900, 1200',
                    sizes: '(min-width: 750px) 712px, 100vw'
                }}
                {{
                  img_mb
                  | image_url: width: 800
                  | image_tag:
                    alt: organic_image_alt,
                    class: 'nw-organic__img nw-organic__img--mobile',
                    loading: 'lazy',
                    widths: '400, 600, 800',
                    sizes: '100vw'
                }}
              {%- elsif img_dt != blank -%}
                {{
                  img_dt
                  | image_url: width: 1200
                  | image_tag:
                    alt: organic_image_alt,
                    class: 'nw-organic__img',
                    loading: 'lazy',
                    widths: '600, 900, 1200',
                    sizes: '(min-width: 750px) 712px, 100vw'
                }}
              {%- else -%}
                {{
                  img_mb
                  | image_url: width: 800
                  | image_tag:
                    alt: organic_image_alt,
                    class: 'nw-organic__img',
                    loading: 'lazy',
                    widths: '400, 600, 800',
                    sizes: '100vw'
                }}
              {%- endif -%}
            {%- else -%}
              <div class="nw-organic__placeholder"></div>
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>

      {%- if section.settings.show_comparison -%}
        <div class="nw-organic__comparison">
          {%- if section.settings.comparison_title != blank -%}
            <h3 class="nw-organic__comparison-title">{{ section.settings.comparison_title }}</h3>
          {%- endif -%}

          <div class="nw-organic__comparison-grid">
            <div class="nw-organic__compare-card nw-organic__compare-card--foam">
              {%- if section.settings.foam_brand != blank -%}
                <p class="nw-organic__foam-brand">{{ section.settings.foam_brand }}</p>
              {%- endif -%}
              <div class="nw-organic__compare-price-group">
                {%- if section.settings.foam_price != blank -%}
                  <p class="nw-organic__foam-price">{{ section.settings.foam_price }}</p>
                {%- endif -%}
                {%- if section.settings.foam_note != blank -%}
                  <p class="nw-organic__foam-note">{{ section.settings.foam_note }}</p>
                {%- endif -%}
              </div>
            </div>

            <div class="nw-organic__compare-card nw-organic__compare-card--snooze">
              <div class="nw-organic__snooze-logo-wrap">
                {%- if section.settings.snooze_logo != blank -%}
                  <img
                    src="{{ section.settings.snooze_logo | image_url: width: 400 }}"
                    alt="{{ section.settings.snooze_brand | default: 'Organic Snooze' | escape }}"
                    class="nw-organic__snooze-logo-img"
                    width=""
                    height=""
                    loading="lazy"
                  >
                {%- elsif section.settings.col1_head_image != blank -%}
                  <img
                    src="{{ section.settings.col1_head_image | image_url: width: 400 }}"
                    alt="{{ section.settings.snooze_brand | default: col1_head_alt | escape }}"
                    class="nw-organic__snooze-logo-img"
                    width=""
                    height=""
                    loading="lazy"
                  >
                {%- else -%}
                  <span class="nw-organic__snooze-logo-text">{{ section.settings.snooze_brand | default: 'ORGANIC SNOOZE' }}</span>
                {%- endif -%}
              </div>

              <div class="nw-organic__compare-price-group">
                {%- if section.settings.snooze_price != blank -%}
                  <p class="nw-organic__snooze-price">{{ section.settings.snooze_price }}</p>
                {%- endif -%}
                {%- if section.settings.snooze_note != blank -%}
                  <p class="nw-organic__snooze-note">{{ section.settings.snooze_note }}</p>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      {%- endif -%}

      {%- assign trust_badge_blocks = section.blocks | where: 'type', 'trust_badge' -%}
      {%- if trust_badge_blocks != blank or section.settings.show_button -%}
        <div class="nw-organic__footer">
          {% render 'nw-cta-badges',
            settings: section.settings,
              blocks: trust_badge_blocks,
              class: 'nw-organic__cta'
            %}
        </div>
      {%- endif -%}
    </div>
  </div>
</nw-organic>

{% schema %}
{
  "name": "t:sections.nw-organic.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "HEADER CONTENT"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "How the Organic Snooze Compares"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>An organic, biologically aligned sleep environment. No toxins. No shortcuts.</p>"
    },
    {
      "type": "header",
      "content": "TABLE COLORS"
    },
    {
      "type": "color",
      "id": "brand_column_bg",
      "label": "Brand Column Background",
      "default": "#FFFCF0",
      "alpha": true
    },
    {
      "type": "color",
      "id": "table_border_color",
      "label": "Table Border Color",
      "default": "rgba(97, 57, 22, 0.2)",
      "alpha": true
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "cell_text_color",
      "label": "Table Text Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "table_bg",
      "label": "Table Background Color",
      "alpha": true
    },
    {
      "type": "header",
      "content": "PRODUCT IMAGE & LAYOUT"
    },
    {
      "type": "select",
      "id": "layout_width",
      "label": "t:sections.nw-organic.settings.layout_width.label",
      "default": "page_width",
      "options": [
        {
          "value": "page_width",
          "label": "t:sections.nw-organic.settings.layout_width.options__1.label"
        },
        {
          "value": "full_width",
          "label": "t:sections.nw-organic.settings.layout_width.options__2.label"
        }
      ]
    },
    {
      "type": "color_background",
      "id": "content_panel_bg",
      "label": "t:sections.nw-organic.settings.content_panel_bg.label",
      "default": "linear-gradient(132deg, rgba(169, 107, 62, 1) 0.9%, rgba(78, 47, 20, 1) 57.786%)",
      "visible_if": "{{ section.settings.layout_width == 'full_width' }}"
    },
    {
      "type": "color",
      "id": "content_panel_heading_color",
      "label": "t:sections.nw-organic.settings.content_panel_heading_color.label",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.layout_width == 'full_width' }}"
    },
    {
      "type": "color",
      "id": "content_panel_description_color",
      "label": "t:sections.nw-organic.settings.content_panel_description_color.label",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.layout_width == 'full_width' }}"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media Type",
      "default": "image",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ]
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "Autoplay Video",
      "default": false,
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "show_play_icon",
      "label": "Show Play/Pause Controls",
      "default": true,
      "visible_if": "{{ section.settings.media_type == 'video' and section.settings.video_autoplay == false }}"
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Video Poster (Desktop)",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "image_picker",
      "id": "video_poster_mobile",
      "label": "Video Poster (Mobile)",
      "info": "Optional. Uses desktop poster when empty.",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position (Desktop)",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "right"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Product Image (Desktop)",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Product Image (Mobile)",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "header",
      "content": "TABLE HEADERS"
    },
    {
      "type": "image_picker",
      "id": "col1_head_image",
      "label": "Brand Column Floating Image"
    },
    {
      "type": "image_picker",
      "id": "col1_head_logo",
      "label": "Brand Logo Image"
    },
    {
      "type": "inline_richtext",
      "id": "col1_head_title",
      "label": "Brand Column Fallback Text",
      "default": "Organic Snooze"
    },
    {
      "type": "image_picker",
      "id": "col2_head_image",
      "label": "Competitor Column Floating Image"
    },
    {
      "type": "inline_richtext",
      "id": "col2_head_title",
      "label": "Competitor Column Title",
      "default": "Conventional Foam"
    },
    {
      "type": "header",
      "content": "VALUE COMPARISON"
    },
    {
      "type": "checkbox",
      "id": "show_comparison",
      "label": "Show Comparison Module",
      "default": false
    },
    {
      "type": "text",
      "id": "comparison_title",
      "label": "Comparison Title",
      "default": "Long-Term Value Comparison",
      "visible_if": "{{ section.settings.show_comparison == true }}"
    },
    {
      "type": "text",
      "id": "foam_brand",
      "label": "Competitor Brand Name",
      "default": "Popular Foam Brands",
      "visible_if": "{{ section.settings.show_comparison == true }}"
    },
    {
      "type": "text",
      "id": "foam_price",
      "label": "Competitor Price Per Night",
      "default": "$1.02 / night",
      "visible_if": "{{ section.settings.show_comparison == true }}"
    },
    {
      "type": "text",
      "id": "foam_note",
      "label": "Competitor Note",
      "default": "Replaced every 10 years",
      "visible_if": "{{ section.settings.show_comparison == true }}"
    },
    {
      "type": "image_picker",
