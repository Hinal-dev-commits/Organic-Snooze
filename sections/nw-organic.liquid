{{ 'nw-organic.css' | asset_url | stylesheet_tag }}

{%- assign nw_shell_selector = '#NwOrganic-' | append: section.id -%}
{% render 'nw-section-shell', selector: nw_shell_selector, mode: 'direct' %}

<div
  id="NwOrganic-{{ section.id }}"
  class="nw-organic section-{{ section.id }}"
  style="
    --nw-organic-brand-bg: {{ section.settings.brand_column_bg }};
    --nw-organic-border-color: {{ section.settings.table_border_color }};
    --nw-organic-heading-color: {{ section.settings.heading_color }};
    --nw-organic-desc-color: {{ section.settings.description_color }};
    --nw-organic-cell-text-color: {{ section.settings.cell_text_color }};
  "
>
  <div class="page-width">
    <div class="nw-organic__wrapper{%- render 'nw-scroll-animation' -%}">
      <div class="nw-organic__header">
        {% render 'nw-section-header',
          heading: section.settings.heading,
          description: section.settings.description,
          section_index: section.index
        %}
      </div>

      <div class="nw-organic__main{% if section.settings.image_position == 'left' %} nw-organic__main--image-left{% endif %}">
        <div class="nw-organic__table-col">
          <div class="nw-organic__table">
            <div class="nw-organic__table-row nw-organic__table-row--head">
              <div class="nw-organic__cell nw-organic__cell--feature"></div>
              
              <div class="nw-organic__cell nw-organic__cell--head-brand">
                {%- if section.settings.col1_head_image != blank -%}
                  <img
                    src="{{ section.settings.col1_head_image | image_url }}"
                    alt="{{ section.settings.col1_head_title | default: 'Organic Snooze' | escape }}"
                    class="nw-organic__head-floating-img"
                    width=""
                    height=""
                    loading="lazy"
                  >
                {%- endif -%}

                {%- if section.settings.col1_head_logo != blank -%}
                  <img
                    src="{{ section.settings.col1_head_logo | image_url }}"
                    alt="{{ section.settings.col1_head_title | default: 'Organic Snooze' | escape }}"
                    class="nw-organic__brand-logo"
                    width=""
                    height=""
                    loading="lazy"
                  >
                {%- elsif section.settings.col1_head_title != blank -%}
                  <span class="nw-organic__brand-text">{{ section.settings.col1_head_title }}</span>
                {%- endif -%}
              </div>

              <div class="nw-organic__cell nw-organic__cell--head-other">
                {%- if section.settings.col2_head_image != blank -%}
                  <img
                    src="{{ section.settings.col2_head_image | image_url }}"
                    alt="{{ section.settings.col2_head_title | default: 'Conventional Foam' | escape }}"
                    class="nw-organic__head-floating-img nw-organic__head-floating-img--other"
                    width=""
                    height=""
                    loading="lazy"
                  >
                {%- endif -%}

                {%- if section.settings.col2_head_title != blank -%}
                  <span class="nw-organic__other-title">{{ section.settings.col2_head_title }}</span>
                {%- endif -%}
              </div>
            </div>

            {%- assign row_blocks = section.blocks | where: 'type', 'table_row' -%}
            {%- for block in row_blocks -%}
              <div class="nw-organic__table-row" {{ block.shopify_attributes }}>
                <div class="nw-organic__cell nw-organic__cell--feature">
                  <span>{{ block.settings.feature_name }}</span>
                </div>

                <div class="nw-organic__cell nw-organic__cell--brand">
                  {%- if block.settings.col1_use_custom_icon and block.settings.col1_custom_icon != blank -%}
                    <span class="nw-organic__icon">
                      <img
                        src="{{ block.settings.col1_custom_icon | image_url }}"
                        alt=""
                        class="nw-organic__icon-img"
                        width=""
                        height=""
                        loading="lazy"
                      >
                    </span>
                  {%- elsif block.settings.col1_icon != 'none' -%}
                    <span
                      class="nw-organic__icon{% if block.settings.col1_icon == 'verified-3' or block.settings.col1_icon == 'solar-check' %} nw-organic__icon--verified-3{% endif %}"
                      style="{% if block.settings.col1_icon_color != blank %}color: {{ block.settings.col1_icon_color }};{% endif %}"
                    >
                      {% render 'nw-icon',
                        icon: block.settings.col1_icon,
                        img_class: 'nw-organic__icon-img'
                      %}
                    </span>
                  {%- endif -%}
                  {%- if block.settings.col1_text != blank -%}
                    <span class="nw-organic__cell-text">{{ block.settings.col1_text }}</span>
                  {%- endif -%}
                </div>

                <div class="nw-organic__cell nw-organic__cell--other">
                  {%- if block.settings.col2_use_custom_icon and block.settings.col2_custom_icon != blank -%}
                    <span class="nw-organic__icon">
                      <img
                        src="{{ block.settings.col2_custom_icon | image_url }}"
                        alt=""
                        class="nw-organic__icon-img"
                        width=""
                        height=""
                        loading="lazy"
                      >
                    </span>
                  {%- elsif block.settings.col2_icon != 'none' -%}
                    <span
                      class="nw-organic__icon{% if block.settings.col2_icon == 'cross' or block.settings.col2_icon == 'red-cross' %} nw-organic__icon--cross{% endif %}"
                      style="{% if block.settings.col2_icon_color != blank %}color: {{ block.settings.col2_icon_color }};{% endif %}"
                    >
                      {% render 'nw-icon',
                        icon: block.settings.col2_icon,
                        img_class: 'nw-organic__icon-img'
                      %}
                    </span>
                  {%- endif -%}
                  {%- if block.settings.col2_text != blank -%}
                    <span class="nw-organic__cell-text">{{ block.settings.col2_text }}</span>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>

        <div class="nw-organic__image-col">
          {%- liquid
            assign img_dt = section.settings.image_desktop
            assign img_mb = section.settings.image_mobile
          -%}
          {%- if img_dt != blank or img_mb != blank -%}
            {%- if img_dt != blank and img_mb != blank -%}
              <img
                src="{{ img_dt | image_url }}"
                alt="{{ section.settings.heading | default: 'Organic Snooze comparison' | escape }}"
                class="nw-organic__img nw-organic__img--desktop"
                width=""
                height=""
                loading="lazy"
              >
              <img
                src="{{ img_mb | image_url }}"
                alt="{{ section.settings.heading | default: 'Organic Snooze comparison' | escape }}"
                class="nw-organic__img nw-organic__img--mobile"
                width=""
                height=""
                loading="lazy"
              >
            {%- elsif img_dt != blank -%}
              <img
                src="{{ img_dt | image_url }}"
                alt="{{ section.settings.heading | default: 'Organic Snooze comparison' | escape }}"
                class="nw-organic__img"
                width=""
                height=""
                loading="lazy"
              >
            {%- else -%}
              <img
                src="{{ img_mb | image_url }}"
                alt="{{ section.settings.heading | default: 'Organic Snooze comparison' | escape }}"
                class="nw-organic__img"
                width=""
                height=""
                loading="lazy"
              >
            {%- endif -%}
          {%- else -%}
            <div class="nw-organic__placeholder"></div>
          {%- endif -%}
        </div>
      </div>

      {%- assign trust_badge_blocks = section.blocks | where: 'type', 'trust_badge' -%}
      {%- if trust_badge_blocks != blank or section.settings.show_button -%}
        <div class="nw-organic__footer">
          {% render 'nw-cta-badges',
            settings: section.settings,
              blocks: trust_badge_blocks,
              class: 'nw-organic__cta'
            %}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
