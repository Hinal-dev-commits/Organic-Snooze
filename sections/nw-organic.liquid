{{ 'nw-organic.css' | asset_url | stylesheet_tag }}

<style>
  #NwOrganic-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_desktop | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop | default: 80 }}px;
    {% if section.settings.bg_type == 'color' and section.settings.bg_color != blank %}
      background-color: {{ section.settings.bg_color }};
    {% elsif section.settings.bg_type == 'gradient' and section.settings.bg_gradient != blank %}
      background: {{ section.settings.bg_gradient }};
    {% elsif section.settings.bg_type == 'image' and section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 2880 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    {% elsif section.settings.bg_type == 'none' %}
      background: transparent;
    {% else %}
      background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    #NwOrganic-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile | default: 48 }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile | default: 48 }}px;
      {% if section.settings.bg_type == 'image' and section.settings.bg_image_mobile != blank %}
        background-image: url('{{ section.settings.bg_image_mobile | image_url: width: 1200 }}');
      {% endif %}
    }
  }
</style>

<div id="NwOrganic-{{ section.id }}" class="nw-organic section-{{ section.id }}">
  <div class="page-width">
    <div class="nw-organic__wrapper{%- render 'nw-scroll-animation' -%}">
      <div class="nw-organic__header">
        {%- if section.settings.heading != blank -%}
          {% render 'nw-section-heading', text: section.settings.heading, section_index: section.index %}
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          {% render 'nw-section-description', text: section.settings.description %}
        {%- endif -%}
      </div>

      <div class="nw-organic__main{% if section.settings.image_position == 'left' %} nw-organic__main--image-left{% endif %}">
        <div class="nw-organic__table-col">
          <div class="nw-organic__table">
            <div class="nw-organic__table-row nw-organic__table-row--head">
              <div class="nw-organic__cell nw-organic__cell--feature"></div>
              
              <div class="nw-organic__cell nw-organic__cell--head-brand">
                {%- if section.settings.col1_head_image != blank -%}
                  <img
                    src="{{ section.settings.col1_head_image | image_url: width: 300 }}"
                    alt="{{ section.settings.col1_head_title | default: 'Organic Snooze' | escape }}"
                    width="120"
                    height="80"
                    loading="lazy"
                    class="nw-organic__head-floating-img"
                  >
                {%- endif -%}

                {%- if section.settings.col1_head_logo != blank -%}
                  <img
                    src="{{ section.settings.col1_head_logo | image_url: width: 240 }}"
                    alt="{{ section.settings.col1_head_title | default: 'Organic Snooze' | escape }}"
                    width="120"
                    height="20"
                    loading="lazy"
                    class="nw-organic__brand-logo"
                  >
                {%- elsif section.settings.col1_head_title != blank -%}
                  <span class="nw-organic__brand-text">{{ section.settings.col1_head_title }}</span>
                {%- endif -%}
              </div>

              <div class="nw-organic__cell nw-organic__cell--head-other">
                {%- if section.settings.col2_head_image != blank -%}
                  <img
                    src="{{ section.settings.col2_head_image | image_url: width: 300 }}"
                    alt="{{ section.settings.col2_head_title | default: 'Typical Bedroom Setup' | escape }}"
                    width="127"
                    height="75"
                    loading="lazy"
                    class="nw-organic__head-floating-img nw-organic__head-floating-img--other"
                  >
                {%- endif -%}

                {%- if section.settings.col2_head_title != blank -%}
                  <span class="nw-organic__other-title">{{ section.settings.col2_head_title }}</span>
                {%- endif -%}
              </div>
            </div>

            {%- assign row_blocks = section.blocks | where: 'type', 'table_row' -%}
            {%- for block in row_blocks -%}
              <div class="nw-organic__table-row" {{ block.shopify_attributes }}>
                <div class="nw-organic__cell nw-organic__cell--feature">
                  <span>{{ block.settings.feature_name }}</span>
                </div>

                <div class="nw-organic__cell nw-organic__cell--brand">
                  {%- if block.settings.col1_icon != 'none' -%}
                    <span class="nw-organic__icon">
                      {% render 'nw-icon',
                        icon: block.settings.col1_icon,
                        custom_icon: block.settings.col1_custom_icon,
                        img_class: 'nw-organic__icon-img'
                      %}
                    </span>
                  {%- endif -%}
                  {%- if block.settings.col1_text != blank -%}
                    <span class="nw-organic__cell-text">{{ block.settings.col1_text }}</span>
                  {%- endif -%}
                </div>

                <div class="nw-organic__cell nw-organic__cell--other">
                  {%- if block.settings.col2_icon != 'none' -%}
                    <span class="nw-organic__icon{% if block.settings.col2_icon == 'cross' or block.settings.col2_icon == 'red-cross' %} nw-organic__icon--cross{% endif %}">
                      {% render 'nw-icon',
                        icon: block.settings.col2_icon,
                        custom_icon: block.settings.col2_custom_icon,
                        img_class: 'nw-organic__icon-img'
                      %}
                    </span>
                  {%- endif -%}
                  {%- if block.settings.col2_text != blank -%}
                    <span class="nw-organic__cell-text">{{ block.settings.col2_text }}</span>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>

        <div class="nw-organic__image-col">
          {%- liquid
            assign img_dt = section.settings.image_desktop
            assign img_mb = section.settings.image_mobile
          -%}
          {%- if img_dt != blank or img_mb != blank -%}
            <picture>
              {%- if img_mb != blank -%}
                <source media="(max-width: 749px)" srcset="{{ img_mb | image_url: width: 750 }}">
              {%- endif -%}
              <img
                src="{{ img_dt | default: img_mb | image_url: width: 1200 }}"
                alt="{{ section.settings.heading | default: 'Organic Snooze Recovery System' | escape }}"
                width="616"
                height="606"
                loading="lazy"
                class="nw-organic__img"
              >
            </picture>
          {%- else -%}
            <div class="nw-organic__placeholder"></div>
          {%- endif -%}
        </div>
      </div>

      {%- assign trust_badge_blocks = section.blocks | where: 'type', 'trust_badge' -%}
      <div class="nw-organic__footer">
        {% render 'nw-cta-badges',
          settings: section.settings,
          blocks: trust_badge_blocks,
          class: 'nw-organic__cta'
        %}
      </div>
    </div>
  </div>
</div>

