{{ 'nw-collection-tab.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-collection-tab.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign sidebar_block = nil
  assign tab_blocks = section.blocks | where: 'type', 'tab'
  for block in section.blocks
    if block.type == 'sidebar'
      assign sidebar_block = block
    endif
  endfor
-%}

<style>
  #NwCollectionTab-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    {% if section.settings.bg_type == 'color' and section.settings.bg_color != blank %}
      background-color: {{ section.settings.bg_color }};
    {% elsif section.settings.bg_type == 'gradient' and section.settings.bg_gradient != blank %}
      background: {{ section.settings.bg_gradient }};
    {% elsif section.settings.bg_type == 'image' and section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 2400 }}');
      background-size: cover;
      background-position: center;
    {% elsif section.settings.bg_type == 'none' %}
      background: transparent;
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    #NwCollectionTab-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      {% if section.settings.bg_type == 'image' and section.settings.bg_image_mobile != blank %}
        background-image: url('{{ section.settings.bg_image_mobile | image_url: width: 1200 }}');
      {% endif %}
    }
  }
</style>

<nw-collection-tab
  id="NwCollectionTab-{{ section.id }}"
  class="nw-collection-tab"
  data-show-arrows="{{ section.settings.show_arrows }}"
  data-show-pagination="{{ section.settings.show_pagination }}"
  style="
    --nw-collection-tab-tab-bg: {{ section.settings.tab_bg }};
    --nw-collection-tab-tab-text: {{ section.settings.tab_text }};
    --nw-collection-tab-tab-border: {{ section.settings.tab_border }};
    --nw-collection-tab-tab-active-bg: {{ section.settings.tab_active_bg }};
    --nw-collection-tab-tab-active-text: {{ section.settings.tab_active_text }};
    --nw-collection-tab-sidebar-bg: {{ section.settings.sidebar_bg }};
    --nw-collection-tab-sidebar-text: {{ section.settings.sidebar_text }};
    --nw-collection-tab-quote-bg: {{ section.settings.quote_bg }};
    --nw-collection-tab-quote-border: {{ section.settings.quote_border }};
    --nw-collection-tab-quote-icon: {{ section.settings.quote_icon_color }};
    --nw-collection-tab-verified-color: {{ section.settings.verified_color }};
    --nw-collection-tab-trust-icon: {{ section.settings.trust_icon_color }};
    --nw-collection-tab-fade-color: {{ section.settings.slider_fade_color }};
    --nw-swiper-arrow-bg: {{ section.settings.swiper_arrow_bg }};
    --nw-swiper-arrow-color: {{ section.settings.swiper_arrow_color }};
    --nw-swiper-bullet: {{ section.settings.swiper_bullet_color }};
    --nw-collection-tab-promo-bg: {{ section.settings.promo_bg }};
    --nw-collection-tab-promo-border: {{ section.settings.promo_border }};
    --nw-collection-tab-promo-status-bg: {{ section.settings.promo_status_bg }};
    --nw-collection-tab-promo-timer-bg: {{ section.settings.promo_timer_bg }};
    --nw-collection-tab-promo-sep: {{ section.settings.promo_sep_color }};
  "
  data-products-limit="{{ section.settings.products_to_show }}"
>
  <div class="page-width">
    <div class="nw-collection-tab__inner">
      {%- if sidebar_block -%}
        <div class="nw-collection-tab__mobile-heading">
          {%- if sidebar_block.settings.heading != blank -%}
            <div class="nw-heading">{{ sidebar_block.settings.heading }}</div>
          {%- endif -%}
          {%- if sidebar_block.settings.subheading != blank -%}
            <div class="nw-collection-tab__sidebar-subheading rte">{{ sidebar_block.settings.subheading }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if tab_blocks.size > 0 -%}
        <div class="nw-collection-tab__tabs-wrap">
          <div class="nw-collection-tab__tabs" role="tablist" aria-label="Collection categories">
            {%- assign tab_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'tab' -%}
                <button
                  type="button"
                  class="nw-collection-tab__tab{% if tab_index == 0 %} is-active{% endif %}"
                  role="tab"
                  aria-selected="{% if tab_index == 0 %}true{% else %}false{% endif %}"
                  data-nw-tab="{{ tab_index }}"
                  data-collection-url="{% if block.settings.collection != blank %}{{ block.settings.collection.url }}{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.label | escape }}
                </button>
                {%- assign tab_index = tab_index | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <div class="nw-collection-tab__main">
        {%- if sidebar_block -%}
          <aside class="nw-collection-tab__sidebar" {{ sidebar_block.shopify_attributes }}>
            <div class="nw-collection-tab__sidebar-heading">
              {%- if sidebar_block.settings.heading != blank -%}
                <div class="nw-heading">{{ sidebar_block.settings.heading }}</div>
              {%- endif -%}
              {%- if sidebar_block.settings.subheading != blank -%}
                <div class="nw-collection-tab__sidebar-subheading rte">{{ sidebar_block.settings.subheading }}</div>
              {%- endif -%}
            </div>

            {%- if sidebar_block.settings.quote != blank or sidebar_block.settings.author_name != blank -%}
              <div class="nw-collection-tab__quote">
                <span class="nw-collection-tab__quote-mark" aria-hidden="true">
                  {% render 'nw-icon', icon: 'quote' %}
                </span>
                {%- if sidebar_block.settings.quote != blank -%}
                  <div class="nw-collection-tab__quote-text">{{ sidebar_block.settings.quote }}</div>
                {%- endif -%}
                <div class="nw-collection-tab__quote-author-wrap">
                  <div class="nw-collection-tab__quote-author">
                    {%- if sidebar_block.settings.author_name != blank -%}
                      <div class="nw-collection-tab__quote-name-row">
                        <div class="nw-collection-tab__quote-name">{{ sidebar_block.settings.author_name }}</div>
                        {%- if sidebar_block.settings.show_verified -%}
                          <span class="nw-collection-tab__quote-verified" aria-hidden="true">
                            {% render 'nw-icon', icon: 'verified' %}
                          </span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                    {%- if sidebar_block.settings.author_title != blank -%}
                      <div class="nw-collection-tab__quote-title">{{ sidebar_block.settings.author_title }}</div>
                    {%- endif -%}
                  </div>
                  {%- if sidebar_block.settings.author_image != blank -%}
                    <div class="nw-collection-tab__quote-image">
                      {{
                        sidebar_block.settings.author_image
                        | image_url: width: 360
                        | image_tag: loading: 'lazy', alt: sidebar_block.settings.author_name | escape
                      }}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}

            {%- if sidebar_block.settings.show_promo -%}
              <div
                class="nw-collection-tab__promo"
                data-countdown-date="{{ sidebar_block.settings.countdown_end_date }}"
                data-hide-on-end="{{ sidebar_block.settings.hide_after_timer_end }}"
              >
                <div class="nw-collection-tab__promo-content">
                  <div class="nw-collection-tab__promo-header">
                    {%- if sidebar_block.settings.promo_title != blank -%}
                      <div class="nw-collection-tab__promo-title">{{ sidebar_block.settings.promo_title }}</div>
                    {%- endif -%}
                    {%- if sidebar_block.settings.status_text != blank -%}
                      <div class="nw-collection-tab__promo-status">
                        <span class="nw-collection-tab__promo-status-dot"></span>
                        <div class="nw-collection-tab__promo-status-text">{{ sidebar_block.settings.status_text }}</div>
                      </div>
                    {%- endif -%}
                  </div>
                  {%- if sidebar_block.settings.promo_subtext != blank -%}
                    <div class="nw-collection-tab__promo-subtext">{{ sidebar_block.settings.promo_subtext }}</div>
                  {%- endif -%}
                </div>
                <div class="nw-collection-tab__promo-countdown">
                  {%- if sidebar_block.settings.countdown_label != blank -%}
                    <div class="nw-collection-tab__promo-countdown-label">{{ sidebar_block.settings.countdown_label }}</div>
                  {%- endif -%}
                  <div class="nw-collection-tab__promo-timer">
                    <div class="nw-collection-tab__promo-timer-unit">
                      <span class="nw-collection-tab__promo-timer-num nw-collection-tab-countdown-days">00</span>
                      <span class="nw-collection-tab__promo-timer-txt">Days</span>
                    </div>
                    <span class="nw-collection-tab__promo-timer-sep">:</span>
                    <div class="nw-collection-tab__promo-timer-unit">
                      <span class="nw-collection-tab__promo-timer-num nw-collection-tab-countdown-hours">00</span>
                      <span class="nw-collection-tab__promo-timer-txt">Hrs</span>
                    </div>
                    <span class="nw-collection-tab__promo-timer-sep">:</span>
                    <div class="nw-collection-tab__promo-timer-unit">
                      <span class="nw-collection-tab__promo-timer-num nw-collection-tab-countdown-mins">00</span>
                      <span class="nw-collection-tab__promo-timer-txt">Mins</span>
                    </div>
                  </div>
                </div>
              </div>
            {%- endif -%}

            <div class="nw-collection-tab__trust-badges">
              {%- for i in (1..4) -%}
                {%- liquid
                  case i
                    when 1
                      assign badge_text = sidebar_block.settings.badge_1_text
                      assign badge_icon = sidebar_block.settings.badge_1_icon
                      assign badge_custom_icon = sidebar_block.settings.badge_1_custom_icon
                    when 2
                      assign badge_text = sidebar_block.settings.badge_2_text
                      assign badge_icon = sidebar_block.settings.badge_2_icon
                      assign badge_custom_icon = sidebar_block.settings.badge_2_custom_icon
                    when 3
                      assign badge_text = sidebar_block.settings.badge_3_text
                      assign badge_icon = sidebar_block.settings.badge_3_icon
                      assign badge_custom_icon = sidebar_block.settings.badge_3_custom_icon
                    when 4
                      assign badge_text = sidebar_block.settings.badge_4_text
                      assign badge_icon = sidebar_block.settings.badge_4_icon
                      assign badge_custom_icon = sidebar_block.settings.badge_4_custom_icon
                  endcase
                -%}
                {%- if badge_text != blank -%}
                  <div class="nw-collection-tab__trust-item">
                    <span class="nw-collection-tab__trust-icon">
                      {%- if badge_custom_icon != blank -%}
                        {% render 'nw-icon', icon: badge_icon, custom_icon: badge_custom_icon, img_class: 'nw-collection-tab__trust-img' %}
                      {%- elsif badge_icon != blank and badge_icon != 'none' -%}
                        {% render 'nw-icon', icon: badge_icon %}
                      {%- endif -%}
                    </span>
                    <div class="nw-collection-tab__trust-text">{{ badge_text }}</div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </aside>
        {%- endif -%}

        <div class="nw-collection-tab__slider-col">
          {%- assign panel_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'tab' -%}
              <div
                class="nw-collection-tab__panel"
                data-nw-panel="{{ panel_index }}"
                role="tabpanel"
                {% unless panel_index == 0 %}hidden{% endunless %}
              >
                <div class="nw-collection-tab__slider-wrap">
                  {%- if block.settings.collection != blank and block.settings.collection.products_count > 0 -%}
                    <div class="swiper nw-collection-tab__swiper" id="NwCollectionSwiper-{{ section.id }}-{{ panel_index }}">
                      <div class="swiper-wrapper">
                        {%- for product in block.settings.collection.products limit: section.settings.products_to_show -%}
                          <div class="swiper-slide">
                            {% render 'nw-product-card',
                              product: product,
                              section_id: section.id,
                              show_rating: section.settings.show_rating,
                              show_firmness: section.settings.show_firmness,
                              firmness_label_soft: section.settings.firmness_label_soft,
                              firmness_label_firm: section.settings.firmness_label_firm,
                              button_text: section.settings.pcard_button_text,
                              lazy_load: true
                            %}
                          </div>
                        {%- endfor -%}
                      </div>
                    </div>
                    {%- if section.settings.show_arrows -%}
                      {% render 'nw-swiper-arrows' %}
                    {%- endif -%}
                  {%- else -%}
                    <div class="nw-collection-tab__empty">{{ section.settings.empty_text }}</div>
                  {%- endif -%}
                </div>
                {%- if section.settings.show_pagination and block.settings.collection != blank and block.settings.collection.products_count > 0 -%}
                  <div class="nw-swiper-pagination" id="NwCollectionPagination-{{ section.id }}-{{ panel_index }}" data-nw-panel-pagination="{{ panel_index }}"></div>
                {%- endif -%}
              </div>
              {%- assign panel_index = panel_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- if section.settings.show_shop_all and section.settings.shop_all_text != blank -%}
        <div class="nw-collection-tab__footer nw-collection-tab__shop-all">
          {%- liquid
            assign shop_all_link = section.settings.shop_all_link
            if shop_all_link == blank and tab_blocks.size > 0
              assign first_tab = tab_blocks | first
              if first_tab.settings.collection != blank
                assign shop_all_link = first_tab.settings.collection.url
              endif
            endif
          -%}
          {% render 'nw-button',
            text: section.settings.shop_all_text,
            link: shop_all_link,
            style: section.settings.shop_all_style,
          %}
        </div>
      {%- endif -%}
    </div>
  </div>
</nw-collection-tab>

{% schema %}
{
  "name": "NW Collection Tab",
  "tag": "section",
  "class": "section-nw-collection-tab",
  "settings": [
    {
      "type": "header",
      "content": "PRODUCT SLIDER"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 24,
      "step": 1,
      "label": "Products To Show Per Tab",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Slider Arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show Slider Pagination",
      "default": true
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty Collection Message",
      "default": "Select a collection for this tab."
    },
    {
      "type": "header",
      "content": "PRODUCT CARD"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Product Rating",
      "default": true,
      "info": "Requires a product reviews app."
    },
    {
      "type": "checkbox",
      "id": "show_firmness",
      "label": "Show Firmness Scale",
      "default": false,
      "info": "Only displays when the product custom.firmness metafield is set."
    },
    {
      "type": "text",
      "id": "firmness_label_soft",
      "label": "Firmness Left Label",
      "default": "Soft",
      "visible_if": "{{ section.settings.show_firmness == true }}"
    },
    {
      "type": "text",
      "id": "firmness_label_firm",
      "label": "Firmness Right Label",
      "default": "Firm",
      "visible_if": "{{ section.settings.show_firmness == true }}"
    },
    {
      "type": "text",
      "id": "pcard_button_text",
      "label": "Product Card Button Text",
      "default": "Shop Now"
    },
    {
      "type": "header",
      "content": "SHOP ALL BUTTON"
    },
    {
      "type": "checkbox",
      "id": "show_shop_all",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "text",
      "id": "shop_all_text",
      "label": "Button Label",
      "default": "Shop All",
      "visible_if": "{{ section.settings.show_shop_all == true }}"
    },
    {
      "type": "url",
      "id": "shop_all_link",
      "label": "Button Link",
      "info": "Defaults to the active tab collection when empty.",
      "visible_if": "{{ section.settings.show_shop_all == true }}"
    },
    {
      "type": "select",
      "id": "shop_all_style",
      "label": "Button Style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "outline",
      "visible_if": "{{ section.settings.show_shop_all == true }}"
    },
    {
      "type": "header",
      "content": "TAB COLORS"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "tab_bg",
      "label": "Tab Background",
      "default": "#FFFCF0"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "tab_text",
      "label": "Tab Text",
      "default": "#613916"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "tab_border",
      "label": "Tab Border",
      "default": "#E8DDD4"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "tab_active_bg",
      "label": "Active Tab Background",
      "default": "#CC926A"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "tab_active_text",
      "label": "Active Tab Text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "SIDEBAR COLORS"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "sidebar_bg",
      "label": "Sidebar Background",
      "default": "#F4EFE8"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "sidebar_text",
      "label": "Sidebar Text",
      "default": "#613916"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "quote_bg",
      "label": "Quote Card Background",
      "default": "#FFFCF0"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "quote_border",
      "label": "Quote Card Border",
      "default": "#F0EBE3"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "quote_icon_color",
      "label": "Quote Icon Color",
      "default": "#878735"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "verified_color",
      "label": "Verified Badge Color",
      "default": "#878735"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "trust_icon_color",
      "label": "Trust Badge Icon Color",
      "default": "#613916"
    },
    {
      "type": "header",
      "content": "SLIDER COLORS"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "slider_fade_color",
      "label": "Slider Edge Fade",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "swiper_arrow_bg",
      "label": "Arrow Background",
      "default": "#613916"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "swiper_arrow_color",
      "label": "Arrow Icon",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "swiper_bullet_color",
      "label": "Pagination Bullet",
      "default": "#613916"
    },
    {
      "type": "header",
      "content": "PROMO COLORS (MOBILE)"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "promo_bg",
      "label": "Promo Background",
      "default": "#613916"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "promo_border",
      "label": "Promo Border",
      "default": "#CC926A"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "promo_status_bg",
      "label": "Status Badge Background",
      "default": "#CC926A"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "promo_timer_bg",
      "label": "Timer Unit Background",
      "default": "#CC926A"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "promo_sep_color",
      "label": "Timer Separator",
      "default": "#CC926A"
    },
    {
      "type": "header",
      "content": "SECTION BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "gradient", "label": "Gradient" },
        { "value": "image", "label": "Image" }
      ],
      "default": "color"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "header",
      "content": "SECTION PADDING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding (Desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding (Desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top Padding (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding (Mobile)",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Collection Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab Label",
          "default": "Mattress"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    },
    {
      "type": "sidebar",
      "name": "Sidebar Content",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Shop Organic Mattresses and Bedding"
        },
        {
          "type": "richtext",
          "id": "subheading",
          "label": "Subheading",
