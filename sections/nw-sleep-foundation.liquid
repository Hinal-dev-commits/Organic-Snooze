{{ 'nw-sleep-foundation.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-sleep-foundation.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign nw_shell_selector = '#NwSleepFoundation-' | append: section.id
-%}

{% render 'nw-section-shell', selector: nw_shell_selector, mode: 'direct' %}
{% render 'nw-section-text-colors', selector: nw_shell_selector %}

<nw-sleep-foundation
  id="NwSleepFoundation-{{ section.id }}"
  class="nw-sleep-foundation section-{{ section.id }}"
  style="
    --nw-sf-label-color: {{ section.settings.label_color }};
    --nw-sf-title-color: {{ section.settings.card_title_color }};
    --nw-sf-desc-color: {{ section.settings.card_desc_color }};
    --nw-sf-card-bg: {{ section.settings.card_bg_color }};
    --nw-sf-gift-bg: {{ section.settings.gift_card_bg_color }};
    --nw-sf-gift-title-color: {{ section.settings.gift_title_color }};
    --nw-sf-gift-header-color: {{ section.settings.gift_header_color }};
    --nw-sf-badge-bg: {{ section.settings.badge_bg_color }};
    --nw-sf-badge-text: {{ section.settings.badge_text_color }};
    --nw-sf-arrow-bg: {{ section.settings.arrow_bg_color }};
    --nw-sf-arrow-color: {{ section.settings.arrow_icon_color }};
  "
>
  <div class="page-width">
    <div class="nw-sleep-foundation__wrapper{%- render 'nw-scroll-animation' -%}">
      <div class="nw-sleep-foundation__header">
        {% render 'nw-section-header',
          show_rating: section.settings.show_rating,
          rating: section.settings.star_rating,
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          description: section.settings.subheading,
          section_index: section.index
        %}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="nw-sleep-foundation__grid">
          {%- for block in section.blocks -%}
            {%- liquid
              assign card_style = block.settings.card_style | default: 'standard'
              assign media_type = block.settings.media_type | default: 'video'
              assign card_label = block.settings.label
              assign card_title = block.settings.title
              assign card_description = block.settings.description
              assign card_link = block.settings.link
              assign poster = block.settings.poster
              if poster == blank and block.settings.video != blank and block.settings.video.preview_image != blank
                assign poster = block.settings.video.preview_image
              endif
              assign desktop_image = block.settings.image
              assign mobile_image = block.settings.image_mobile
              if mobile_image == blank
                assign mobile_image = desktop_image
              endif
            -%}

            {%- if card_style == 'gift' -%}
              <article
                class="nw-sleep-foundation__card nw-sleep-foundation__card--gift"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.gift_header != blank -%}
                  <p class="nw-sleep-foundation__gift-header">{{ block.settings.gift_header }}</p>
                {%- endif -%}

                <div class="nw-sleep-foundation__gift-inner">
                  <div class="nw-sleep-foundation__media">
                    {%- if media_type == 'video' and block.settings.video != blank -%}
                      {{
                        block.settings.video
                        | video_tag:
                          autoplay: false,
                          loop: false,
                          muted: false,
                          controls: true,
                          playsinline: true,
                          preload: 'none',
                          class: 'nw-sleep-foundation__video',
                          image_size: '900x'
                      }}
                      {%- if poster != blank -%}
                        {{
                          poster
                          | image_url: width: 900
                          | image_tag:
                            alt: card_title | default: card_label | escape,
                            class: 'nw-sleep-foundation__poster',
                            loading: 'lazy',
                            sizes: '(min-width: 750px) 400px, 100vw'
                        }}
                      {%- endif -%}
                      {%- if block.settings.show_play_button -%}
                        <button type="button" class="nw-sleep-foundation__play" data-nw-sf-play aria-label="Play video">
                          <span class="nw-sleep-foundation__play-icon">
                            {% render 'nw-icon', icon: 'play' %}
                          </span>
                        </button>
                      {%- endif -%}
                    {%- elsif desktop_image != blank -%}
                      {{
                        desktop_image
                        | image_tag:
                          alt: desktop_image.alt | default: card_title | escape,
                          class: 'nw-sleep-foundation__img nw-sleep-foundation__img--desktop',
                          loading: 'lazy',
                          sizes: '(min-width: 750px) 400px, 100vw'
                      }}
                      {{
                        mobile_image
                        | image_tag:
                          alt: mobile_image.alt | default: card_title | escape,
                          class: 'nw-sleep-foundation__img nw-sleep-foundation__img--mobile',
                          loading: 'lazy',
                          sizes: '100vw'
                      }}
                    {%- else -%}
                      <div class="nw-sleep-foundation__placeholder" aria-hidden="true">
                        {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      </div>
                    {%- endif -%}

                    {%- if block.settings.show_badge and block.settings.badge_text != blank -%}
                      <span class="nw-sleep-foundation__badge">
                        {%- if block.settings.badge_icon != blank -%}
                          {{
                            block.settings.badge_icon
                            | image_url: width: 28
                            | image_tag:
                              alt: '',
                              class: 'nw-sleep-foundation__badge-icon',
                              loading: 'lazy',
                              width: 28,
                              sizes: '28px'
                          }}
                        {%- else -%}
                          {% render 'nw-icon', icon: 'gift' %}
                        {%- endif -%}
                        {{ block.settings.badge_text }}
                      </span>
                    {%- endif -%}
                  </div>

                  <div class="nw-sleep-foundation__body">
                    {%- if card_title != blank -%}
                      <h3 class="nw-sleep-foundation__title">{{ card_title }}</h3>
                    {%- endif -%}
                    {%- if card_description != blank -%}
                      <div class="nw-sleep-foundation__description rte">{{ card_description }}</div>
                    {%- endif -%}
                  </div>
                </div>
              </article>
            {%- else -%}
              <article
                class="nw-sleep-foundation__card nw-sleep-foundation__card--standard"
                {{ block.shopify_attributes }}
              >
                <div class="nw-sleep-foundation__media">
                  {%- if media_type == 'video' and block.settings.video != blank -%}
                    {{
                      block.settings.video
                      | video_tag:
                        autoplay: false,
                        loop: false,
                        muted: false,
                        controls: true,
                        playsinline: true,
                        preload: 'none',
                        class: 'nw-sleep-foundation__video',
                        image_size: '900x'
                    }}
                    {%- if poster != blank -%}
                      <img
                        src="{{ poster | image_url: width: 900 }}"
                        alt="{{ card_title | default: card_label | escape }}"
                        class="nw-sleep-foundation__poster"
                        loading="lazy"
                        width=""
                        height=""
                      >
                    {%- endif -%}
                    {%- if block.settings.show_play_button -%}
                      <button type="button" class="nw-sleep-foundation__play" data-nw-sf-play aria-label="Play video">
                        <span class="nw-sleep-foundation__play-icon">
                          {% render 'nw-icon', icon: 'play' %}
                        </span>
                      </button>
                    {%- endif -%}
                  {%- elsif desktop_image != blank -%}
                    <img
                      src="{{ desktop_image | image_url }}"
                      alt="{{ desktop_image.alt | default: card_title | escape }}"
                      class="nw-sleep-foundation__img nw-sleep-foundation__img--desktop"
                      loading="lazy"
                      width=""
                      height=""
                    >
                    <img
                      src="{{ mobile_image | image_url }}"
                      alt="{{ mobile_image.alt | default: card_title | escape }}"
                      class="nw-sleep-foundation__img nw-sleep-foundation__img--mobile"
                      loading="lazy"
                      width=""
                      height=""
                    >
                  {%- else -%}
                    <div class="nw-sleep-foundation__placeholder" aria-hidden="true">
                      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {%- endif -%}
                </div>

                {%- if card_link != blank -%}
                  <a href="{{ card_link }}" class="nw-sleep-foundation__card-link">
                {%- endif -%}
                <div class="nw-sleep-foundation__body">
                  {%- if card_label != blank -%}
                    <p class="nw-sleep-foundation__label">{{ card_label }}</p>
                  {%- endif -%}

                  {%- if card_label != blank and card_title != blank -%}
                    <hr class="nw-sleep-foundation__divider">
                  {%- endif -%}

                  {%- if card_title != blank or block.settings.show_arrow -%}
                    <div class="nw-sleep-foundation__title-row">
                      {%- if card_title != blank -%}
                        <h3 class="nw-sleep-foundation__title">{{ card_title }}</h3>
                      {%- endif -%}
                      {%- if block.settings.show_arrow -%}
                        <span class="nw-sleep-foundation__arrow" aria-hidden="true">
                          {% render 'nw-icon', icon: 'arrow-right' %}
                        </span>
                      {%- endif -%}
                      </div>
                    {%- endif -%}
                    </div>
                    {%- if card_link != blank -%}
                      </a>
                    {%- endif -%}
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</nw-sleep-foundation>

{% schema %}
{
  "name": "t:sections.nw-sleep-foundation.name",
  "tag": "section",
  "class": "section-nw-sleep-foundation",
  "settings": [
    {
      "type": "header",
      "content": "SECTION HEADER"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating Stars",
      "default": true
    },
    {
      "type": "range",
      "id": "star_rating",
      "label": "Star Rating (Active Stars)",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Real sleepers, real mornings"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Sleep Is the Foundation. Gary Explains Why."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>For Gary, better sleep starts with the fundamentals: light, timing, nutrition, and environment. When those align, your body finally does what it was built to do. Recover.</p>"
    },
    {
      "type": "header",
      "content": "TEXT COLORS"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#FFFCF0"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "description_color",
      "label": "Description Color",
      "default": "#FFFCF0"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#FFFCF0"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "text_color",
      "label": "Body Text Color",
      "default": "#FFFCF0"
    },
    {
      "type": "header",
      "content": "CARD COLORS"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "card_bg_color",
      "label": "Standard Card Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "label_color",
      "label": "Card Label Color",
      "default": "#4E2F14"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "card_title_color",
      "label": "Card Title Color",
      "default": "#613916"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "card_desc_color",
      "label": "Card Description Color",
      "default": "#4E2F14"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "gift_card_bg_color",
      "label": "Gift Card Background",
      "default": "#FFFCF0"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "gift_title_color",
      "label": "Gift Card Title Color",
      "default": "#4E2F14"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "gift_header_color",
      "label": "Gift Card Mobile Header Color",
      "default": "#613916"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "badge_bg_color",
      "label": "Badge Background",
      "default": "#878735"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "badge_text_color",
      "label": "Badge Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "arrow_bg_color",
      "label": "Arrow Button Background",
      "default": "#613916"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "arrow_icon_color",
      "label": "Arrow Icon Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "image",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "image", "label": "Image" },
        { "value": "gradient", "label": "Gradient" }
      ]
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color",
      "label": "Background Color",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile Optional)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "card_style",
          "label": "Card Style",
          "default": "standard",
          "options": [
            { "value": "standard", "label": "Standard" },
            { "value": "gift", "label": "Gift" }
          ]
        },
        {
          "type": "select",
          "id": "media_type",
          "label": "Media Type",
          "default": "video",
          "options": [
            { "value": "video", "label": "Video" },
            { "value": "image", "label": "Image" }
          ]
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Video Poster (Optional)",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "checkbox",
          "id": "show_play_button",
          "label": "Show Play Button",
          "default": true,
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (Desktop)",
          "visible_if": "{{ block.settings.media_type == 'image' }}"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Image (Mobile Optional)",
          "visible_if": "{{ block.settings.media_type == 'image' }}"
        },
        {
          "type": "header",
          "content": "CONTENT"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Gary Brecka Sleep Challenge, Day 1:",
          "visible_if": "{{ block.settings.card_style == 'standard' }}"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "default": "Reset Your Sleep Naturally. Full-width player."
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>18 pages from Gary Brecka on how to fall asleep faster, sleep deeper, and wake up recovered.</p>",
          "visible_if": "{{ block.settings.card_style == 'gift' }}"
        },
        {
          "type": "text",
          "id": "gift_header",
          "label": "Gift Card Mobile Header",
          "default": "A Free Gift With Every Order",
          "visible_if": "{{ block.settings.card_style == 'gift' }}"
        },
        {
          "type": "checkbox",
          "id": "show_badge",
          "label": "Show Badge",
          "default": true,
          "visible_if": "{{ block.settings.card_style == 'gift' }}"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text",
          "default": "FREE",
          "visible_if": "{{ block.settings.card_style == 'gift' and block.settings.show_badge == true }}"
        },
        {
          "type": "image_picker",
          "id": "badge_icon",
          "label": "Badge Icon (Optional)",
          "info": "Overrides the default gift icon.",
          "visible_if": "{{ block.settings.card_style == 'gift' and block.settings.show_badge == true }}"
        },
        {
          "type": "checkbox",
          "id": "show_arrow",
          "label": "Show Arrow Button",
          "default": true,
          "visible_if": "{{ block.settings.card_style == 'standard' }}"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card Link (Optional)",
          "visible_if": "{{ block.settings.card_style == 'standard' }}"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.nw-sleep-foundation.name",
      "category": "NW Sections",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "card_style": "standard",
            "media_type": "video",
            "label": "Gary Brecka Sleep Challenge, Day 1:",
            "title": "Reset Your Sleep Naturally. Full-width player."
          }
        },
        {
          "type": "card",
          "settings": {
            "card_style": "standard",
            "media_type": "video",
            "label": "Gary Brecka Sleep Challenge, Day 2:",
            "title": "How to Deepen Sleep and Improve Recovery"
          }
        },
        {
          "type": "card",
          "settings": {
            "card_style": "gift",
            "media_type": "image",
            "title": "The Ultimate Human Guide to Better Sleep",
            "description": "<p>18 pages from Gary Brecka on how to fall asleep faster, sleep deeper, and wake up recovered.</p>",
            "gift_header": "A Free Gift With Every Order",
            "show_badge": true,
            "badge_text": "FREE"
          }
        }
      ]
    }
  ]
}
{% endschema %}
