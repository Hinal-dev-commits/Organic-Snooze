{{ 'nw-breezeline-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-breezeline-collection.js' | asset_url }}" defer="defer"></script>

{%- assign nw_shell_selector = '#NwBreezelineCollection-' | append: section.id -%}
{% render 'nw-section-shell', selector: nw_shell_selector, mode: 'direct', default_bg: '#FFFAF3' %}

<nw-breezeline-collection
  id="NwBreezelineCollection-{{ section.id }}"
  class="nw-breezeline-collection section-{{ section.id }}"
  data-show-arrows="{{ section.settings.show_arrows }}"
  data-show-pagination="{{ section.settings.show_pagination }}"
  data-pagination-id="NwBreezelinePagination-{{ section.id }}"
  style="
    --nw-bc-heading-color: {{ section.settings.heading_color }};
    --nw-bc-desc-color: {{ section.settings.description_color }};
    --nw-bc-card-bg: {{ section.settings.card_bg_color }};
    --nw-bc-card-text: {{ section.settings.card_text_color }};
    --nw-bc-title-color: {{ section.settings.card_title_color }};
    --nw-bc-label-color: {{ section.settings.label_color }};
    --nw-bc-value-color: {{ section.settings.value_color }};
    --nw-bc-value-color-strong: {{ section.settings.value_color_strong }};
    --nw-bc-cta-color: {{ section.settings.cta_color }};
    --nw-bc-tag-bg: {{ section.settings.tag_bg_color }};
    --nw-bc-tag-text: {{ section.settings.tag_text_color }};
    --nw-bc-scale-active: {{ section.settings.scale_active_color }};
    --nw-bc-scale-inactive: {{ section.settings.scale_inactive_color }};
    --nw-swiper-bullet: {{ section.settings.pagination_color }};
    --nw-swiper-arrow-bg: {{ section.settings.swiper_arrow_bg }};
    --nw-swiper-arrow-color: {{ section.settings.swiper_arrow_color }};
  "
>
  <div class="page-width">
    <div class="nw-breezeline-collection__wrapper{%- render 'nw-scroll-animation' -%}">
      {%- if section.settings.heading != blank or section.settings.description != blank -%}
        <div class="nw-breezeline-collection__header">
          {% render 'nw-section-header',
            heading: section.settings.heading,
            description: section.settings.description,
            section_index: section.index
          %}
        </div>
      {%- endif -%}

      {%- assign product_blocks = section.blocks | where: 'type', 'product' -%}
      {%- if product_blocks.size > 0 -%}
        <div class="nw-breezeline-collection__slider-wrap">
          <div class="swiper nw-breezeline-collection__swiper" id="NwBreezelineSwiper-{{ section.id }}">
            <div class="swiper-wrapper">
              {%- for block in product_blocks -%}
                {%- if block.settings.product != blank -%}
                  <div class="swiper-slide" data-slide-index="{{ forloop.index0 }}">
                    {% render 'nw-breezeline-card',
                      product: block.settings.product,
                      block: block,
                      show_feel: section.settings.show_feel,
                      show_best_for: section.settings.show_best_for,
                      show_breathable: section.settings.show_breathable,
                      breathable_label_1: section.settings.breathable_label_1,
                      breathable_label_2: section.settings.breathable_label_2,
                      breathable_label_3: section.settings.breathable_label_3,
                      cta_text: section.settings.cta_text
                    %}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

          {%- if section.settings.show_arrows -%}
            {% render 'nw-swiper-arrows' %}
          {%- endif -%}

          {%- if section.settings.show_pagination -%}
            {%- assign bc_pagination_id = 'NwBreezelinePagination-' | append: section.id -%}
            {% render 'nw-swiper-pagination', id: bc_pagination_id %}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</nw-breezeline-collection>

<style>
  #NwBreezelineCollection-{{ section.id }} .nw-breezeline-card__title,
  #NwBreezelineCollection-{{ section.id }} .nw-breezeline-card__title a {
    color: var(--nw-bc-title-color, var(--nw-bc-card-text, #613916));
  }

  #NwBreezelineCollection-{{ section.id }} .nw-breezeline-card__label {
    color: var(--nw-bc-label-color, var(--nw-bc-card-text, #613916));
  }

  #NwBreezelineCollection-{{ section.id }} .nw-breezeline-card__value,
  #NwBreezelineCollection-{{ section.id }} .nw-breezeline-card__feel .rte,
  #NwBreezelineCollection-{{ section.id }} .nw-breezeline-card__best-for .rte {
    color: var(--nw-bc-value-color, var(--nw-bc-card-text, #613916));
  }

  #NwBreezelineCollection-{{ section.id }} .nw-breezeline-card__cta {
    color: var(--nw-bc-cta-color, var(--secondary-color, #CC926A));
  }

  #NwBreezelineCollection-{{ section.id }} .nw-breezeline-card__cta svg {
    color: var(--nw-bc-cta-color, var(--secondary-color, #CC926A));
  }
</style>

{% schema %}
{
  "name": "t:sections.nw-breezeline-collection.name",
  "tag": "section",
  "class": "section-nw-breezeline-collection",
  "settings": [
    {
      "type": "header",
      "content": "SECTION HEADER"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the Breezeline Collection"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>The right pillow height depends on how you sleep. Here's your starting point.</p>"
    },
    {
      "type": "header",
      "content": "PRODUCT METAFIELDS"
    },
    {
      "type": "checkbox",
      "id": "show_feel",
      "label": "Show Feel (Custom.feel_Text)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_best_for",
      "label": "Show Best For (Custom.best_For)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_breathable",
      "label": "Show Breathable Scale (Custom.breathable)",
      "default": true
    },
    {
      "type": "header",
      "content": "SLIDER SETTINGS"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Slider Arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show Slider Pagination",
      "default": true
    },
    {
      "type": "color",
      "id": "swiper_arrow_bg",
      "label": "Arrow Background",
      "default": "#613916",
      "alpha": true,
      "visible_if": "{{ section.settings.show_arrows == true }}"
    },
    {
      "type": "color",
      "id": "swiper_arrow_color",
      "label": "Arrow Icon Color",
      "default": "#FFFFFF",
      "alpha": true,
      "visible_if": "{{ section.settings.show_arrows == true }}"
    },
    {
      "type": "color",
      "id": "pagination_color",
      "label": "Pagination Color",
      "default": "#613916",
      "alpha": true,
      "visible_if": "{{ section.settings.show_pagination == true }}"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Card Link Label",
      "default": "Shop Now"
    },
    {
      "type": "header",
      "content": "COLORS"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#FFFFFF",
      "alpha": true
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card Text Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card Title Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Feel / Best For Label Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "value_color",
      "label": "Feel / Best For Text Color",
      "default": "#61391699",
      "alpha": true
    },
    {
      "type": "color",
      "id": "value_color_strong",
      "label": "Highlighted Text Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "cta_color",
      "label": "Shop Now Link Color",
      "default": "#CC926A",
      "alpha": true
    },
    {
      "type": "color",
      "id": "tag_bg_color",
      "label": "Tag Background",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "tag_text_color",
      "label": "Tag Text Color",
      "default": "#FFFFFF",
      "alpha": true
    },
    {
      "type": "color",
      "id": "scale_active_color",
      "label": "Breathable Scale Active Color",
      "default": "#613916",
      "alpha": true,
      "visible_if": "{{ section.settings.show_breathable == true }}"
    },
    {
      "type": "color",
      "id": "scale_inactive_color",
      "label": "Breathable Scale Inactive Color",
      "default": "rgba(97, 57, 22, 0.35)",
      "alpha": true,
      "visible_if": "{{ section.settings.show_breathable == true }}"
    },
    {
      "type": "header",
      "content": "BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "color",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "image", "label": "Image" },
        { "value": "gradient", "label": "Gradient" }
      ]
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFAF3",
      "alpha": true,
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "inline_richtext",
          "id": "custom_title",
          "label": "Custom Title",
          "info": "Leave blank to use the product title."
        },
        {
          "type": "header",
          "content": "PRODUCT IMAGE"
        },
        {
          "type": "checkbox",
          "id": "use_custom_image",
          "label": "Use Custom Product Image",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Product Image",
          "info": "Overrides the product featured image when enabled.",
          "visible_if": "{{ block.settings.use_custom_image == true }}"
        },
        {
          "type": "header",
          "content": "IMAGE TAG"
        },
        {
          "type": "text",
          "id": "tag_text",
          "label": "Tag Text",
          "info": "Text badge shown on the product image."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.nw-breezeline-collection.name",
      "category": "NW Sections",
      "blocks": [
        { "type": "product", "settings": { "tag_text": "100% COTTON" } },
        { "type": "product", "settings": { "tag_text": "LINEN + COTTON" } },
        { "type": "product", "settings": { "tag_text": "LINEN + COTTON" } }
      ]
    }
  ]
}
{% endschema %}
