{{ 'nw-swiper-bundle.min.css' | asset_url | stylesheet_tag }}
{{ 'nw-button.css' | asset_url | stylesheet_tag }}
{{ 'nw-cta-badges.css' | asset_url | stylesheet_tag }}
{{ 'nw-review-video.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-review-video.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign video_blocks = section.blocks | where: 'type', 'review'
  assign trust_badge_blocks = section.blocks | where: 'type', 'trust_badge'
  assign card_style = section.settings.card_style | default: 'style-1' | replace: '_', '-'
-%}

{%- assign nw_shell_selector = '.nw-review-video.section-' | append: section.id -%}
{% capture nw_shell_extra %}
  {% if section.settings.bg_type == 'color' and section.settings.bg_color != blank %}
    --nw-rv-bg-color: {{ section.settings.bg_color }};
  {% endif %}
  {% render 'nw-section-color-var', name: '--nw-rv-star-active', value: section.settings.star_color %}
  {% render 'nw-section-color-var', name: '--nw-rv-star-inactive', value: section.settings.star_color_inactive %}
  {% render 'nw-section-color-var', name: '--nw-star-active', value: section.settings.star_color %}
  {% render 'nw-section-color-var', name: '--nw-star-inactive', value: section.settings.star_color_inactive %}
{% endcapture %}
{% render 'nw-section-shell', selector: nw_shell_selector, mode: 'direct', extra: nw_shell_extra %}
{% render 'nw-section-text-colors', selector: nw_shell_selector %}

<nw-review-video
  class="nw-review-video nw-review-video--{{ card_style }} section-{{ section.id }}{%- render 'nw-scroll-animation' -%}"
  style="
    --nw-cta-badge-text: {{ section.settings.badge_text_color }};
    --nw-cta-badge-icon: {{ section.settings.badge_icon_color }};
  "
  data-block-count="{{ video_blocks.size | default: 1 }}"
  data-enable-autoplay="{{ section.settings.enable_autoplay }}"
  data-autoplay-delay="{{ section.settings.autoplay_delay | default: 3 | times: 1000 }}"
  data-show-arrows="{{ section.settings.show_arrows }}"
  data-show-dots="{{ section.settings.show_dots }}"
  data-card-style="{{ card_style }}"
  data-enable-video-loop="{{ section.settings.enable_video_loop }}"
  {% unless section.settings.enable_video_loop %}data-no-loop{% endunless %}
>
  <div class="page-width"> 
    <div class="nw-review-video__wrapper">
      <div class="nw-review-video__header">
        {% render 'nw-section-header',
          show_rating: section.settings.show_rating,
          rating: section.settings.star_rating,
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          description: section.settings.subheading,
          section_index: section.index
        %}
      </div>
    </div>
  </div>

  {%- if video_blocks.size > 0 -%}
    {%- liquid
      assign repeat_times = 1
      if section.settings.enable_video_loop
        if video_blocks.size == 1
          assign repeat_times = 8
        elsif video_blocks.size == 2
          assign repeat_times = 5
        elsif video_blocks.size == 3
          assign repeat_times = 4
        elsif video_blocks.size == 4
          assign repeat_times = 3
        elsif video_blocks.size <= 7
          assign repeat_times = 2
        endif
      endif
    -%}
    <div class="nw-review-video__slider-wrap{% unless section.settings.enable_video_loop %} nw-review-video__slider-wrap--no-loop{% endunless %}">
      {%- if section.settings.show_arrows -%}
        {% render 'nw-swiper-arrows', prev_label: 'Previous video', next_label: 'Next video' %}
      {%- endif -%}

      <div class="swiper" id="nw-review-videos-{{ section.id }}" data-nw-review-slider>
        <div class="swiper-wrapper">
          {%- for r in (1..repeat_times) -%}
            {%- for block in video_blocks -%}
              {%- liquid
                assign review_product = block.settings.product
                assign product_image = block.settings.custom_image
                if product_image == blank and review_product != blank and review_product.featured_image != blank
                  assign product_image = review_product.featured_image
                endif
                assign product_title = block.settings.custom_title
                if product_title == blank and review_product != blank
                  assign product_title = review_product.title
                endif
                assign product_url = block.settings.custom_link
                if product_url == blank and review_product != blank
                  assign product_url = review_product.url
                endif
                assign poster = block.settings.poster
                if poster == blank and block.settings.video != blank and block.settings.video.preview_image != blank
                  assign poster = block.settings.video.preview_image
                endif
                assign video_loop = section.settings.enable_video_loop
              -%}
              <div class="swiper-slide" data-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                <article class="nw-review-video__card{% if card_style == 'style-2' %} nw-review-video__card--style-2{% endif %}">
                  <div class="nw-review-video__media">
                    {%- if block.settings.video != blank -%}
                      {{
                        block.settings.video
                        | video_tag:
                          autoplay: false,
                          loop: video_loop,
                          muted: false,
                          controls: true,
                          playsinline: true,
                          preload: 'none',
                          class: 'nw-review-video__video'
                      }}
                    {%- endif -%}

                    {%- if poster != blank -%}
                      <img
                        src="{{ poster | image_url: width: 800 }}"
                        alt="{{ block.settings.author | escape }}"
                        width="400"
                        height="520"
                        loading="lazy"
                        class="nw-review-video__poster"
                      >
                    {%- else -%}
                      <div class="nw-review-video__placeholder" aria-hidden="true"></div>
                    {%- endif -%}

                    {%- if block.settings.overlay_text != blank -%}
                      <span class="nw-review-video__overlay-text">{{ block.settings.overlay_text }}</span>
                    {%- endif -%}

                    <button type="button" class="nw-review-video__play" aria-label="Play video">
                      <span class="nw-review-video__play-icon">
                        {% render 'nw-icon', icon: 'play' %}
                      </span>
                    </button>
                  </div>

                  <div class="nw-review-video__body">
                    {%- if block.settings.review_text != blank -%}
                      <div class="nw-review-video__quote rte">{{ block.settings.review_text }}</div>
                    {%- endif -%}

                    {%- if block.settings.author != blank or block.settings.show_verified -%}
                      <div class="nw-review-video__author-row">
                        {%- if block.settings.author != blank -%}
                          <span class="nw-review-video__author">{{ block.settings.author }}</span>
                        {%- endif -%}
                        {%- if block.settings.show_verified -%}
                          <span class="nw-review-video__verified">
                            {% render 'nw-icon', icon: 'verified' %}
                            <span>{{ block.settings.verified_text | default: 'Verified Customer' }}</span>
                          </span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}

                    {%- if card_style != 'style-2' and product_title != blank -%}
                      <hr class="nw-review-video__divider">

                      {%- if product_url != blank -%}
                        <a href="{{ product_url }}" class="nw-review-video__product">
                      {%- else -%}
                        <div class="nw-review-video__product">
                      {%- endif -%}
                        <div class="nw-review-video__product-info">
                          {%- if product_image != blank -%}
                            <img
                              src="{{ product_image | image_url: width: 120 }}"
                              alt="{{ product_title | escape }}"
                              width="58"
                              height="31"
                              loading="lazy"
                              class="nw-review-video__product-img"
                            >
                          {%- else -%}
                            <span class="nw-review-video__product-placeholder" aria-hidden="true"></span>
                          {%- endif -%}
                          <span class="nw-review-video__product-title">{{ product_title }}</span>
                        </div>
                        <span class="nw-review-video__product-arrow" aria-hidden="true">
                          {% render 'nw-icon', icon: 'arrow-right' %}
                        </span>
                      {%- if product_url != blank -%}
                        </a>
                      {%- else -%}
                        </div>
                      {%- endif -%}
                    {%- endif -%}
                  </div>

                  {%- if card_style == 'style-2' and product_title != blank -%}
                    {%- if product_url != blank -%}
                      <a href="{{ product_url }}" class="nw-review-video__product-footer">
                    {%- else -%}
                      <div class="nw-review-video__product-footer">
                    {%- endif -%}
                      <div class="nw-review-video__product-info">
                        {%- if product_image != blank -%}
                          <img
                            src="{{ product_image | image_url: width: 120 }}"
                            alt="{{ product_title | escape }}"
                            width="58"
                            height="31"
                            loading="lazy"
                            class="nw-review-video__product-img"
                          >
                        {%- else -%}
                          <span class="nw-review-video__product-placeholder" aria-hidden="true"></span>
                        {%- endif -%}
                        <span class="nw-review-video__product-title">{{ product_title }}</span>
                      </div>
                      <span class="nw-review-video__product-arrow" aria-hidden="true">
                        {% render 'nw-icon', icon: 'arrow-right' %}
                      </span>
                    {%- if product_url != blank -%}
                      </a>
                    {%- else -%}
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                </article>
              </div>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>

      {%- if section.settings.show_dots and video_blocks.size > 1 and section.settings.enable_video_loop -%}
        <div class="nw-swiper-pagination" id="nw-review-videos-pagination-{{ section.id }}" data-nw-review-pagination>
          {%- for block in video_blocks -%}
            <button
              type="button"
              class="swiper-pagination-bullet{% if forloop.first %} swiper-pagination-bullet-active{% endif %}"
              data-bullet-index="{{ forloop.index0 }}"
              aria-label="Go to slide {{ forloop.index }}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="page-width">
    {% render 'nw-cta-badges',
      settings: section.settings,
      blocks: trust_badge_blocks,
      class: 'nw-review-video__footer'
    %}
  </div>
</nw-review-video>

{% schema %}
{
  "name": "t:sections.nw-review-video.name",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "SECTION HEADER"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating Stars",
      "default": true
    },
    {
      "type": "range",
      "id": "star_rating",
      "label": "Star Rating (Active Stars)",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "star_color",
      "label": "Active Star Color",
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "star_color_inactive",
      "label": "Inactive Star Color",
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Real sleepers, real mornings"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Hear It From People Who Sleep On It"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Real customers. Real sleep. See what changed when they switched to organic.</p>"
    },
    {
      "type": "header",
      "content": "TEXT COLORS"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "heading_color",
      "label": "Heading Color"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "description_color",
      "label": "Description Color"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "eyebrow_color",
      "label": "Eyebrow Color"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "text_color",
      "label": "Body Text Color"
    },
    {
      "type": "header",
      "content": "CARD SETTINGS"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card Style",
      "default": "style-1",
      "options": [
        { "value": "style-1", "label": "Style 1" },
        { "value": "style-2", "label": "Style 2" }
      ]
    },
    {
      "type": "header",
      "content": "SLIDER SETTINGS"
    },
    {
      "type": "checkbox",
      "id": "enable_video_loop",
      "label": "Loop Videos",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Slider Arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show Slider Pagination Dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay Delay (Seconds)",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 3,
      "visible_if": "{{ section.settings.enable_autoplay == true }}"
    },
    {
      "type": "header",
      "content": "BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "color",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "image", "label": "Image" },
        { "value": "gradient", "label": "Gradient" }
      ]
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color",
      "label": "Background Color",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile Optional)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "GLOBAL CTA"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Footer CTA",
      "default": false
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "SHOP NOW",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "default": "primary",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ],
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "header",
      "content": "TRUST BADGES"
    },
    {
      "type": "color",
      "id": "badge_icon_color",
      "label": "Badge Icon Color",
      "default": "#CC926A",
      "alpha": true
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge Text Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Video",
      "settings": [
        {
          "type": "header",
          "content": "VIDEO"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Shopify-hosted Video"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Video Poster / Placeholder Image"
        },
        {
          "type": "text",
          "id": "overlay_text",
          "label": "Overlay Text (Optional)"
        },
        {
          "type": "header",
          "content": "REVIEW"
        },
        {
          "type": "richtext",
          "id": "review_text",
          "label": "Review Text"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name"
        },
        {
          "type": "checkbox",
          "id": "show_verified",
          "label": "Show Verified Badge",
          "default": true
        },
        {
          "type": "text",
          "id": "verified_text",
          "label": "Verified Text",
          "default": "Verified Customer"
        },
        {
          "type": "header",
          "content": "PRODUCT"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Product Image (Overrides Product Image)"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Product Title (Overrides Product Title)"
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom Product Link (Overrides Product URL)"
        }
      ]
    },
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "limit": 4,
      "settings": [
        {
          "type": "checkbox",
          "id": "use_custom_icon",
          "label": "Use Custom Icon Image",
          "default": false
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Badge Icon",
          "default": "none",
          "visible_if": "{{ block.settings.use_custom_icon == false }}",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "moneyback", "label": "100-Night Trial / Moneyback" },
            { "value": "warranty", "label": "Warranty" },
            { "value": "shipping", "label": "Shipping / Truck" },
            { "value": "financing", "label": "Financing / Offer" },
            { "value": "shield", "label": "Shield" }
          ]
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image",
          "visible_if": "{{ block.settings.use_custom_icon == true }}"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Badge Text",
          "default": "100-Night Risk-Free Trial"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.nw-review-video.name",
      "category": "NW Sections",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
