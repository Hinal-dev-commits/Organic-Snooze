{{ 'nw-cta-badges.css' | asset_url | stylesheet_tag }}
{{ 'nw-testimonial-v2.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-testimonial-v2.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign nw_shell_selector = '#NwTestimonialV2-' | append: section.id
  assign tab_blocks = section.blocks | where: 'type', 'tab'
  assign trust_badge_blocks = section.blocks | where: 'type', 'trust_badge'

  assign default_tab_index = 0
  assign tab_index_scan = 0
  for block in tab_blocks
    if block.settings.default_selected
      assign default_tab_index = tab_index_scan
      break
    endif
    assign tab_index_scan = tab_index_scan | plus: 1
  endfor
-%}

{% render 'nw-section-shell', selector: nw_shell_selector, mode: 'direct', default_bg: '#FFFCF0' %}
{% render 'nw-section-text-colors', selector: nw_shell_selector %}

<nw-testimonial-v2
  id="NwTestimonialV2-{{ section.id }}"
  class="nw-testimonial-v2 section-{{ section.id }}"
  data-show-slider-arrows="{{ section.settings.show_slider_arrows }}"
  data-show-slider-pagination="{{ section.settings.show_slider_pagination }}"
  data-slides-desktop="{{ section.settings.slides_desktop | default: 3 }}"
  style="
    --nw-tv2-tab-bg: {{ section.settings.tab_bg_color }};
    --nw-tv2-tab-text: {{ section.settings.tab_text_color }};
    --nw-tv2-tab-border: {{ section.settings.tab_border_color }};
    --nw-tv2-tab-active-bg: {{ section.settings.tab_active_bg_color }};
    --nw-tv2-tab-active-text: {{ section.settings.tab_active_text_color }};
    --nw-tv2-tab-active-border: {{ section.settings.tab_active_border_color }};
    --nw-tv2-card-bg: {{ section.settings.card_bg_color }};
    --nw-tv2-card-border: {{ section.settings.card_border_color }};
    --nw-tv2-card-text: {{ section.settings.card_text_color }};
    --nw-tv2-card-product-text: {{ section.settings.product_text_color }};
    --nw-tv2-star-color: {{ section.settings.card_star_color }};
    --nw-tv2-star-inactive: {{ section.settings.card_star_empty_color }};
    --nw-tv2-tag-bg: {{ section.settings.tag_bg_color }};
    --nw-tv2-tag-text: {{ section.settings.tag_text_color }};
    --nw-tv2-tag-border: {{ section.settings.tag_border_color }};
    --nw-tv2-verified-color: {{ section.settings.verified_icon_color }};
    --nw-tv2-verified-text: {{ section.settings.verified_text_color }};
    --nw-tv2-product-bg: {{ section.settings.product_bg_color }};
    --nw-tv2-product-border: {{ section.settings.product_border_color }};
    --nw-tv2-add-bg: {{ section.settings.add_button_bg_color }};
    --nw-tv2-add-text: {{ section.settings.add_button_text_color }};
    --nw-cta-badge-text: {{ section.settings.badge_text_color }};
    --nw-cta-badge-icon: {{ section.settings.badge_icon_color }};
  "
>
  <div class="page-width">
    <div class="nw-testimonial-v2__wrapper{%- render 'nw-scroll-animation' -%}">
      {%- if section.settings.show_rating
        or section.settings.eyebrow != blank
        or section.settings.heading != blank
        or section.settings.subheading != blank
      -%}
        <div class="nw-testimonial-v2__header">
          {% render 'nw-section-header',
            show_rating: section.settings.show_rating,
            rating: section.settings.star_rating,
            eyebrow: section.settings.eyebrow,
            heading: section.settings.heading,
            description: section.settings.subheading,
            section_index: section.index
          %}
        </div>
      {%- endif -%}

      {%- if tab_blocks.size > 0 -%}
        <div class="nw-testimonial-v2__tabs-wrap">
          <div
            class="nw-testimonial-v2__tabs"
            role="tablist"
            aria-label="{{ section.settings.tabs_aria_label | default: 'Review categories' | escape }}"
            data-nw-tv2-tablist
          >
            {%- assign tab_index = 0 -%}
            {%- for block in tab_blocks -%}
              <button
                type="button"
                class="nw-testimonial-v2__tab{% if tab_index == default_tab_index %} is-active{% endif %}"
                id="NwTestimonialV2TabBtn-{{ section.id }}-{{ tab_index }}"
                role="tab"
                aria-selected="{% if tab_index == default_tab_index %}true{% else %}false{% endif %}"
                aria-controls="NwTestimonialV2TabPanel-{{ section.id }}-{{ tab_index }}"
                tabindex="{% if tab_index == default_tab_index %}0{% else %}-1{% endif %}"
                data-nw-tv2-tab="{{ tab_index }}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.tab_label | escape }}
              </button>
              {%- assign tab_index = tab_index | plus: 1 -%}
            {%- endfor -%}
          </div>
        </div>

        <div class="nw-testimonial-v2__panels">
          {%- assign panel_index = 0 -%}
          {%- for block in tab_blocks -%}
            {%- liquid
              assign cards_to_show = block.settings.cards_to_show | default: 3
              if cards_to_show > 15
                assign cards_to_show = 15
              elsif cards_to_show < 1
                assign cards_to_show = 1
              endif
              assign category_tag = block.settings.category_tag
              if category_tag == blank
                assign category_tag = block.settings.tab_label
              endif
            -%}
            <div
              class="nw-testimonial-v2__panel{% if panel_index == default_tab_index %} is-active{% endif %}"
              id="NwTestimonialV2TabPanel-{{ section.id }}-{{ panel_index }}"
              data-nw-tv2-panel="{{ panel_index }}"
              role="tabpanel"
              aria-labelledby="NwTestimonialV2TabBtn-{{ section.id }}-{{ panel_index }}"
              aria-hidden="{% if panel_index == default_tab_index %}false{% else %}true{% endif %}"
            >
              {%- if block.settings.enable_slider -%}
                {%- assign slider_pagination_id = 'NwTestimonialV2Pagination-' | append: section.id | append: '-' | append: panel_index -%}
                <div class="nw-testimonial-v2__panel-slider-wrap">
                  {%- if section.settings.show_slider_arrows -%}
                    {% render 'nw-swiper-arrows', arrow_style: section.settings.slider_arrow_style %}
                  {%- endif -%}

                  <div
                    class="swiper nw-testimonial-v2__swiper"
                    id="NwTestimonialV2Swiper-{{ section.id }}-{{ panel_index }}"
                    data-nw-tv2-swiper
                  >
                    <div class="swiper-wrapper">
                      {%- for card_index in (1..cards_to_show) -%}
                        <div class="swiper-slide">
                          {% render 'nw-testimonial-v2-card',
                            block: block,
                            card_index: card_index,
                            category_tag: category_tag
                          %}
                        </div>
                      {%- endfor -%}
                    </div>
                  </div>

                  {%- if section.settings.show_slider_pagination -%}
                    {% render 'nw-swiper-pagination',
                      id: slider_pagination_id,
                      class: 'nw-testimonial-v2__pagination'
                    %}
                  {%- endif -%}
                </div>
              {%- else -%}
                <div class="nw-testimonial-v2__cards">
                  {%- for card_index in (1..cards_to_show) -%}
                    {% render 'nw-testimonial-v2-card',
                      block: block,
                      card_index: card_index,
                      category_tag: category_tag
                    %}
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
            {%- assign panel_index = panel_index | plus: 1 -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_button -%} 
      {% render 'nw-cta-badges',
        settings: section.settings,
          blocks: trust_badge_blocks,
          class: 'nw-testimonial-v2__footer'
        %}
      {%- endif -%}
    </div>
  </div>
</nw-testimonial-v2>

{% schema %}
{
  "name": "t:sections.nw-testimonial-v2.name",
  "tag": "section",
  "class": "section-nw-testimonial-v2",
  "settings": [
    {
      "type": "header",
      "content": "SECTION HEADER"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating",
      "default": true
    },
    {
      "type": "range",
      "id": "star_rating",
      "label": "Star Rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Rating Text",
      "default": "98% Satisfactory rating among sleepers",
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Shop By What Sleepers Notice Most"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Description",
      "default": "<p>Explore reviews grouped by comfort, support, materials, couples, and cooler sleep.</p>"
    },
    {
      "type": "text",
      "id": "tabs_aria_label",
      "label": "Tabs Accessibility Label",
      "default": "Review categories"
    },
    {
      "type": "header",
      "content": "TAB COLORS"
    },
    {
      "type": "color",
      "id": "tab_bg_color",
      "label": "Tab Background",
      "default": "#FFFFFF",
      "alpha": true
    },
    {
      "type": "color",
      "id": "tab_text_color",
      "label": "Tab Text Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "tab_border_color",
      "label": "Tab Border Color",
      "default": "rgba(97, 57, 22, 0.2)",
      "alpha": true
    },
    {
      "type": "color",
      "id": "tab_active_bg_color",
      "label": "Active Tab Background",
      "default": "#F4EFE8",
      "alpha": true
    },
    {
      "type": "color",
      "id": "tab_active_text_color",
      "label": "Active Tab Text Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "tab_active_border_color",
      "label": "Active Tab Border Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "header",
      "content": "TAB SLIDER"
    },
    {
      "type": "paragraph",
      "content": "Enable slider on individual tab blocks. These settings apply when a tab has slider enabled."
    },
    {
      "type": "checkbox",
      "id": "show_slider_arrows",
      "label": "Show Slider Arrows",
      "default": true
    },
    {
      "type": "select",
      "id": "slider_arrow_style",
      "label": "Slider Arrow Style",
      "default": "style_1",
      "options": [
        { "value": "style_1", "label": "Style 1" },
        { "value": "style_2", "label": "Style 2" }
      ],
      "visible_if": "{{ section.settings.show_slider_arrows == true }}"
    },
    {
      "type": "checkbox",
      "id": "show_slider_pagination",
      "label": "Show Slider Pagination",
      "default": false
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "label": "Slides Per View (Desktop)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "CARD COLORS"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#F4EFE8",
      "alpha": true
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color",
      "default": "rgba(97, 57, 22, 0.12)",
      "alpha": true
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card Text Color",
      "default": "#4E2F14",
      "alpha": true
    },
    {
      "type": "color",
      "id": "card_star_color",
      "label": "Star Color",
      "default": "#E57B1E",
      "alpha": true
    },
    {
      "type": "color",
      "id": "card_star_empty_color",
      "label": "Empty Star Color",
      "default": "rgba(97, 57, 22, 0.25)",
      "alpha": true
    },
    {
      "type": "color",
      "id": "tag_bg_color",
      "label": "Category Tag Background",
      "default": "#FFFFFF",
      "alpha": true
    },
    {
      "type": "color",
      "id": "tag_text_color",
      "label": "Category Tag Text Color",
      "default": "#A96B3E",
      "alpha": true
    },
    {
      "type": "color",
      "id": "tag_border_color",
      "label": "Category Tag Border Color",
      "default": "rgba(97, 57, 22, 0.15)",
      "alpha": true
    },
    {
      "type": "color",
      "id": "verified_icon_color",
      "label": "Verified Icon Color",
      "default": "#878735",
      "alpha": true
    },
    {
      "type": "color",
      "id": "verified_text_color",
      "label": "Verified Text Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "product_bg_color",
      "label": "Product Box Background",
      "default": "#FFFFFF",
      "alpha": true
    },
    {
      "type": "color",
      "id": "product_text_color",
      "label": "Product Box Text Color",
      "default": "#000",
      "alpha": true
    },
    {
      "type": "color",
      "id": "product_border_color",
      "label": "Product Box Border Color",
      "default": "rgba(97, 57, 22, 0.12)",
      "alpha": true
    },
    {
      "type": "color",
      "id": "add_button_bg_color",
      "label": "Add Button Background",
      "default": "#A96B3E",
      "alpha": true
    },
    {
      "type": "color",
      "id": "add_button_text_color",
      "label": "Add Button Text Color",
      "default": "#FFFFFF",
      "alpha": true
    },
    {
      "type": "header",
      "content": "TEXT COLORS"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Rating Text Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "header",
      "content": "BUTTON"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "SHOW ALL REVIEWS",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "default": "primary",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ],
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "header",
      "content": "TRUST BADGES"
    },
    {
      "type": "color",
      "id": "badge_icon_color",
      "label": "Badge Icon Color",
      "default": "#CC926A",
      "alpha": true
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge Text Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "header",
      "content": "BACKGROUND SETTINGS"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "color",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "color",
          "label": "Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFCF0",
      "alpha": true,
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile Optional)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
