        },
        {
          "type": "checkbox",
          "id": "card_1_show_verified",
          "label": "Show Verified Badge",
          "default": true,
          "visible_if": "{{ block.settings.cards_to_show >= 1 }}"
        },
        {
          "type": "text",
          "id": "card_1_verified_text",
          "label": "Verified Text",
          "default": "Verified Customer",
          "visible_if": "{{ block.settings.card_1_show_verified == true and block.settings.cards_to_show >= 1 }}"
        },
        {
          "type": "header",
          "content": "REVIEW CARD 1 PRODUCT FOOTER",
          "visible_if": "{{ block.settings.cards_to_show >= 1 }}"
        },
        {
          "type": "checkbox",
          "id": "card_1_show_product",
          "label": "Show Product Footer",
