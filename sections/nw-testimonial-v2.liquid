          "type": "text",
          "id": "card_1_category_tag",
          "label": "Category Tag",
          "visible_if": "{{ block.settings.cards_to_show >= 1 }}"
        },
        {
          "type": "image_picker",
          "id": "card_1_avatar",
          "label": "Reviewer Avatar",
          "visible_if": "{{ block.settings.cards_to_show >= 1 }}"
