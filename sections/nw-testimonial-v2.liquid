        },
        {
          "type": "header",
          "content": "REVIEW CARD 2",
          "visible_if": "{{ block.settings.cards_to_show >= 2 }}"
        },
        {
          "type": "range",
          "id": "card_2_rating",
          "label": "Star Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "visible_if": "{{ block.settings.cards_to_show >= 2 }}"
        },
        {
          "type": "richtext",
          "id": "card_2_quote",
          "label": "Review Quote",
          "default": "<p>\"The pillow holds my neck in place without collapsing, and I wake up feeling more rested and clear-headed.\"</p>",
          "visible_if": "{{ block.settings.cards_to_show >= 2 }}"
        },
        {
          "type": "text",
          "id": "card_2_category_tag",
          "label": "Category Tag",
          "visible_if": "{{ block.settings.cards_to_show >= 2 }}"
        },
        {
          "type": "image_picker",
          "id": "card_2_avatar",
          "label": "Reviewer Avatar",
          "visible_if": "{{ block.settings.cards_to_show >= 2 }}"
        },
        {
