  "tag": "section",
  "class": "section-nw-blog-banner",
  "settings": [
    {
      "type": "header",
      "content": "HEADER INTEGRATION"
    },
    {
      "type": "checkbox",
      "id": "enable_transparent_header",
      "label": "Enable Transparent Header Over Hero",
      "default": true
    },
    {
      "type": "header",
      "content": "CONTENT"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Text",
      "default": "THE SLEEP LAB"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Blog"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Insights on sleep, biology, and clean technology – created to help you understand your body and improve the way you rest.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "header",
      "content": "REVIEWS / RATING"
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show Reviews / Rating",
      "default": false
    },
    {
      "type": "range",
      "id": "rating_stars",
      "label": "Rating Stars Count",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.show_reviews == true }}"
    },
    {
      "type": "richtext",
      "id": "rating_text",
      "label": "Review Text",
      "default": "<p>4.9/5 (10,000+ happy sleepers)</p>",
      "visible_if": "{{ section.settings.show_reviews == true }}"
    },
    {
      "type": "header",
      "content": "BUTTON"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": false
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "SHOP MATTRESSES",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "default": "primary",
