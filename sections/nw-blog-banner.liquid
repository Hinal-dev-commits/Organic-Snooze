        { "value": "moneyback", "label": "Moneyback / Shield" },
        { "value": "truck", "label": "Truck / Free Shipping" },
        { "value": "warranty", "label": "Warranty / Ribbon" },
        { "value": "financing", "label": "0% Financing" },
        { "value": "checkmark", "label": "Checkmark" },
        { "value": "leaf", "label": "Organic / Leaf" },
        { "value": "shield", "label": "Shield" },
