{{ 'nw-button.css' | asset_url | stylesheet_tag }}
{{ 'nw-cta-badges.css' | asset_url | stylesheet_tag }}
{{ 'nw-blog-banner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-blog-banner.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign banner_desktop_image = section.settings.bg_image
  assign banner_mobile_image = section.settings.bg_image_mobile
  if banner_mobile_image == blank
    assign banner_mobile_image = banner_desktop_image
  endif
-%}

<style>
  #NwBlogBanner-{{ section.id }} {
    {% case section.settings.bg_type %}
      {% when 'color' %}
        background-color: {{ section.settings.bg_color }};
        background-image: none;
      {% when 'gradient' %}
        background: {{ section.settings.bg_gradient }};
        background-image: none;
      {% when 'none' %}
        background: transparent;
        background-image: none;
    {% endcase %}
    {% if section.settings.enable_transparent_header %}
      margin-top: calc(-1 * var(--header-height, 76px));
      min-height: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
    {% else %}
      min-height: 0;
      padding-top: {{ section.settings.padding_top_desktop  }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop  }}px;
    {% endif %}
  }

  #NwBlogBanner-{{ section.id }} .nw-blog-banner__overlay {
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }

  @media screen and (max-width: 749px) {
    #NwBlogBanner-{{ section.id }} {
      {% if section.settings.enable_transparent_header %}
        margin-top: calc(-1 * var(--header-height, 60px) - 2px);
        min-height: 0;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
      {% else %}
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      {% endif %}
    }

    #NwBlogBanner-{{ section.id }} .nw-blog-banner__media {
      min-height: 0;
    }
  }
</style>

<nw-blog-banner
  id="NwBlogBanner-{{ section.id }}"
  class="nw-blog-banner section-{{ section.id }}{% if section.settings.enable_transparent_header %} nw-blog-banner--transparent-header{% endif %}{%- render 'nw-scroll-animation', type: 'fade-in' -%}"
  {% if section.settings.enable_transparent_header %}data-nw-transparent-header{% endif %}
  style="
    --nw-bb-kicker-color: {{ section.settings.kicker_color }};
    --nw-bb-heading-color: {{ section.settings.heading_color }};
    --nw-bb-desc-color: {{ section.settings.description_color }};
    --nw-bb-rating-text-color: {{ section.settings.rating_text_color }};
    --nw-star-active: {{ section.settings.star_color }};
    --nw-star-inactive: {{ section.settings.star_inactive_color }};
    --nw-cta-badge-text: {{ section.settings.badge_text_color }};
    --nw-cta-badge-icon: {{ section.settings.badge_icon_color }};
    --nw-bb-media-height-desktop: {{ section.settings.banner_height_desktop | default: 544 }}px;
    --nw-bb-media-height-mobile: {{ section.settings.banner_height_mobile | default: 380 }}px;
    --nw-bb-pt-dt: {{ section.settings.padding_top_desktop | default: 0 }}px;
    --nw-bb-pb-dt: {{ section.settings.padding_bottom_desktop | default: 0 }}px;
    --nw-bb-pt-mb: {{ section.settings.padding_top_mobile | default: 0 }}px;
    --nw-bb-pb-mb: {{ section.settings.padding_bottom_mobile | default: 48 }}px;
  "
>
  <div class="nw-blog-banner__media" aria-hidden="true">
    {%- if section.settings.show_banner_image -%}
      {%- if banner_desktop_image != blank or banner_mobile_image != blank -%}
      {%- if banner_desktop_image != blank and banner_mobile_image != blank and banner_desktop_image != banner_mobile_image -%}
        <img
          src="{{ banner_mobile_image | image_url: width: 1200 }}"
          class="nw-blog-banner__image nw-blog-banner__image--mobile"
          loading="eager"
          fetchpriority="high"
          width=""
          height=""
          alt=""
        >
        <img
          src="{{ banner_desktop_image | image_url: width: 2880 }}"
          class="nw-blog-banner__image nw-blog-banner__image--desktop"
          loading="eager"
          fetchpriority="high"
          width=""
          height=""
          alt=""
        >
      {%- elsif banner_desktop_image != blank -%}
        <img
          src="{{ banner_desktop_image | image_url: width: 2880 }}"
          class="nw-blog-banner__image"
          loading="eager"
          fetchpriority="high"
          width=""
          height=""
          alt=""
        >
      {%- else -%}
        <img
          src="{{ banner_mobile_image | image_url: width: 1200 }}"
          class="nw-blog-banner__image"
          loading="eager"
          fetchpriority="high"
          width=""
          height=""
          alt=""
        >
      {%- endif -%}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'nw-blog-banner__image nw-blog-banner__image--placeholder' }}
    {%- endif -%}
    {%- endif -%}
  </div>

  {%- if section.settings.show_banner_image -%}
    <div class="nw-blog-banner__overlay"></div>
  {%- endif -%}

  <div class="page-width">
    <div class="nw-blog-banner__layout nw-blog-banner__layout--align-{{ section.settings.text_alignment }}">
      <div class="nw-blog-banner__content">
        <div class="nw-blog-banner__copy">
          {%- if section.settings.kicker != blank -%}
            <p class="nw-blog-banner__kicker">{{ section.settings.kicker }}</p>
          {%- endif -%}

          {%- if section.settings.show_reviews -%}
            <div class="nw-rating nw-blog-banner__rating">
              {% render 'nw-stars', rating: section.settings.rating_stars %}
              {%- if section.settings.rating_text != blank -%}
                <div class="nw-eyebrow nw-blog-banner__rating-text rte">{{ section.settings.rating_text }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            {% render 'nw-section-heading',
              text: section.settings.heading,
              section_index: section.index,
              class: 'nw-blog-banner__heading'
            %}
          {%- endif -%}

          {%- if section.settings.description != blank -%}
            {% render 'nw-section-description',
              text: section.settings.description,
              class: 'nw-blog-banner__description'
            %}
          {%- endif -%}
        </div>

        {% render 'nw-cta-badges',
          settings: section.settings,
          class: 'nw-blog-banner__actions'
        %}
      </div>
    </div>
  </div>
</nw-blog-banner>

{% schema %}
{
