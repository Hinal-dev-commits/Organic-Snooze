{{ 'nw-button.css' | asset_url | stylesheet_tag }}
{{ 'nw-return-policy.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-return-policy.js' | asset_url }}" defer="defer"></script>

<style>
  #NwReturnPolicy-{{ section.id }} {
    display: block;
    position: relative;
    isolation: isolate;
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    {% case section.settings.bg_type %}
      {% when 'color' %}
        background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
      {% when 'gradient' %}
        background: {{ section.settings.bg_gradient }};
      {% when 'image' %}
        background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
      {% when 'none' %}
        background: transparent;
      {% else %}
        background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
    {% endcase %}
  }

  {%- if section.settings.bg_type == 'image' and section.settings.bg_image != blank -%}
    #NwReturnPolicy-{{ section.id }}::before {
      content: '';
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background-image: url('{{ section.settings.bg_image | image_url: width: 2880 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      z-index: 0;
      pointer-events: none;
    }
  {%- endif -%}

  {%- if section.settings.bg_type == 'image' and section.settings.bg_color_image != blank -%}
    #NwReturnPolicy-{{ section.id }}::after {
      content: '';
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background-color: {{ section.settings.bg_color_image | default: '#FFFFFF29' }};
      z-index: 0;
      pointer-events: none;
    }
  {%- endif -%}

  #NwReturnPolicy-{{ section.id }} > * {
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 749px) {
    #NwReturnPolicy-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    {%- if section.settings.bg_type == 'image' and section.settings.bg_image_mobile != blank -%}
      #NwReturnPolicy-{{ section.id }}::before {
        background-image: url('{{ section.settings.bg_image_mobile | image_url: width: 1200 }}');
      }
    {%- endif -%}
  }
</style>

<div
  id="NwReturnPolicy-{{ section.id }}"
  class="nw-return-policy section-{{ section.id }}{% if section.settings.image_position == 'right' %} nw-return-policy--image-right{% endif %}{% if section.settings.image_position_mobile == 'bottom' %} nw-return-policy--mobile-image-bottom{% elsif section.settings.image_position_mobile == 'none' %} nw-return-policy--mobile-image-none{% endif %}"
>
  <div class="page-width">
    <div class="nw-return-policy__wrapper">
      {%- if section.settings.heading != blank
        or section.settings.subheading != blank
        or section.settings.eyebrow != blank
      -%}
        <div class="nw-return-policy__header">
          {% render 'nw-section-header',
            show_rating: section.settings.show_rating,
            rating: section.settings.star_rating,
            eyebrow: section.settings.eyebrow,
            heading: section.settings.heading,
            description: section.settings.subheading,
            section_index: section.index
          %}
        </div>
      {%- endif -%}

      <nw-return-policy class="nw-return-policy__main">
        <div class="nw-return-policy__media-col">
          {%- if section.settings.image != blank or section.settings.image_mobile != blank -%}
            {%- if section.settings.image_mobile != blank -%}
              <picture>
                <source
                  media="(max-width: 749px)"
                  srcset="{{ section.settings.image_mobile | image_url: width: 800 }}"
                >
                <img
                  src="{{ section.settings.image | default: section.settings.image_mobile | image_url: width: 1200 }}"
                  alt="{{ section.settings.image.alt | default: section.settings.heading | strip_html | escape }}"
                  width="514"
                  height="594"
                  loading="lazy"
                  class="nw-return-policy__img"
                >
              </picture>
            {%- else -%}
              <img
                src="{{ section.settings.image | image_url: width: 1200 }}"
                alt="{{ section.settings.image.alt | default: section.settings.heading | strip_html | escape }}"
                width="514"
                height="594"
                loading="lazy"
                class="nw-return-policy__img"
              >
            {%- endif -%}
          {%- else -%}
            <div class="nw-return-policy__img-placeholder">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <div class="nw-return-policy__accordion-col">
            {%- for block in section.blocks -%}
              <details
                class="nw-return-policy__item"
                {{ block.shopify_attributes }}
                {% if block.settings.open_by_default %}
                  open
                {% endif %}
              >
                <summary class="nw-return-policy__summary">
                  <div class="nw-return-policy__icon-wrap">
                    {%- if block.settings.use_custom_image and block.settings.custom_image != blank -%}
                      <img
                        src="{{ block.settings.custom_image | image_url: width: 120 }}"
                        alt="{{ block.settings.title | strip_html | escape }}"
                        width="28"
                        height="28"
                        loading="lazy"
                      >
                    {%- else -%}
                      {% render 'nw-icon', icon: block.settings.icon %}
                    {%- endif -%}
                  </div>

                  <div class="nw-return-policy__title-wrap">
                    {%- if block.settings.title != blank -%}
                      <h3 class="nw-return-policy__title">{{ block.settings.title }}</h3>
                    {%- endif -%}
                  </div>

                  <span class="nw-return-policy__toggle-btn" aria-hidden="true"></span>
                </summary>

                {%- if block.settings.content != blank -%}
                  <div class="nw-return-policy__content">
                    <div class="nw-return-policy__content-inner">
                      {{ block.settings.content }}
                    </div>
                  </div>
                {%- endif -%}
              </details>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </nw-return-policy>

      <div class="nw-return-policy__bottom">
        {%- if section.settings.show_highlight
          and section.settings.highlight_title != blank
          or section.settings.highlight_text != blank
        -%}
          <div class="nw-return-policy__highlight-box">
            {%- if section.settings.highlight_title != blank -%}
              <h4 class="nw-return-policy__highlight-title">{{ section.settings.highlight_title }}</h4>
            {%- endif -%}

            {%- if section.settings.highlight_text != blank -%}
              <div class="nw-return-policy__highlight-text">{{ section.settings.highlight_text }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_button and section.settings.button_text != blank -%}
          <div class="nw-return-policy__btn-wrap">
            {% render 'nw-button',
              text: section.settings.button_text,
              link: section.settings.button_link,
              style: section.settings.button_style,
              btn_class: 'nw-btn'
            %}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "NW Return Policy",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "SECTION HEADER"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating Stars in Header",
      "default": false
    },
    {
      "type": "range",
      "id": "star_rating",
      "label": "Star Rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow Text"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Everything You Need To Know Before You Return"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "MEDIA SETTINGS"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image (Mobile Optional)"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop Image Position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "image_position_mobile",
      "label": "Mobile Image Position",
      "default": "top",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "none", "label": "Hide Image on Mobile" }
      ]
    },
    {
      "type": "header",
      "content": "HIGHLIGHT BOX"
    },
    {
      "type": "checkbox",
      "id": "show_highlight",
      "label": "Show Highlight Box",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "highlight_title",
      "label": "Highlight Title",
      "default": "Toppers, Bedding & Bases",
      "visible_if": "{{ section.settings.show_highlight == true }}"
    },
    {
      "type": "richtext",
      "id": "highlight_text",
      "label": "Highlight Text",
      "default": "<p>Mattress toppers follow the same trial as mattresses. Sheets, pillows, and protectors are returnable within 30 days, free if unopened, or with a 20% restocking fee if opened. Adjustable bases and frames are final sale (non-returnable), but they're backed by a 20-year warranty.</p>",
      "visible_if": "{{ section.settings.show_highlight == true }}"
    },
    {
      "type": "header",
      "content": "BUTTON"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "START A RETURN OR EXCHANGE",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "default": "primary",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ],
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "header",
      "content": "BACKGROUND SETTINGS"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "color",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "image", "label": "Image" },
        { "value": "gradient", "label": "Gradient" }
      ]
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile Optional)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color_image",
      "label": "Overlay Color",
      "default": "#FFFFFF29",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "accordion_item",
      "name": "Accordion Item",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "default": "Return window"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Any time between night 31 and night 100, after the break-in period</p>"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Preset Icon",
          "default": "offer",
          "options": [
            { "value": "offer", "label": "Offer / Tag" },
            { "value": "money", "label": "Money / Refund" },
            { "value": "shield", "label": "Shield / Condition" },
            { "value": "truck", "label": "Truck / Delivery" },
            { "value": "checkmark", "label": "Checkmark" },
            { "value": "check-circle", "label": "Check Circle" },
            { "value": "verified", "label": "Verified Badge" },
            { "value": "guards", "label": "Guards" },
            { "value": "preserve", "label": "Preserve" },
            { "value": "handcrafted", "label": "Handcrafted" },
            { "value": "breathable", "label": "Breathable" },
            { "value": "silent", "label": "Silent" }
          ]
        },
        {
          "type": "checkbox",
          "id": "use_custom_image",
          "label": "Use Custom Icon Image",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Icon Image",
          "visible_if": "{{ block.settings.use_custom_image == true }}"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by Default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NW Return Policy",
      "category": "NW Sections",
      "blocks": [
        {
          "type": "accordion_item",
          "settings": {
            "title": "Return window",
            "content": "<p>Any time between night 31 and night 100, after the break-in period</p>",
            "icon": "offer"
          }
        },
        {
          "type": "accordion_item",
          "settings": {
            "title": "Free exchanges",
            "content": "<p>Swap size or firmness free. Upgrades cost the price difference; downgrades return it as store credit</p>",
            "icon": "offer"
          }
        },
        {
          "type": "accordion_item",
          "settings": {
            "title": "Return fee",
            "content": "<p>One flat $199 for freight, handling, and removal. Choose store credit and we waive it</p>",
            "icon": "money"
          }
        },
        {
          "type": "accordion_item",
          "settings": {
            "title": "Your refund",
            "content": "<p>Purchase price minus the fee, back to you in 3–5 business days. Shipping isn't refundable</p>",
            "icon": "money"
          }
        },
        {
          "type": "accordion_item",
          "settings": {
            "title": "Store credit",
            "content": "<p>Waives the $199 fee, valid for 12 months, redeemable store-wide</p>",
            "icon": "offer"
          }
        },
        {
          "type": "accordion_item",
          "settings": {
            "title": "Condition",
            "content": "<p>Must be clean and sanitary, free of stains, odors, pet damage or burns, with the law tag attached</p>",
            "icon": "shield"
          }
        },
        {
          "type": "accordion_item",
          "settings": {
            "title": "No reboxing",
            "content": "<p>Approved returns go through local pickup or donation where available, never landfilled</p>",
            "icon": "truck"
          }
        },
        {
          "type": "accordion_item",
          "settings": {
            "title": "One per order",
            "content": "<p>One return or exchange per mattress. An exchange keeps your original 100 nights</p>",
            "icon": "verified"
          }
        }
      ]
    }
  ]
}
{% endschema %}
