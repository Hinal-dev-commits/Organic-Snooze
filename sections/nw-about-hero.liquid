{{ 'nw-button.css' | asset_url | stylesheet_tag }}
{{ 'nw-cta-badges.css' | asset_url | stylesheet_tag }}
{{ 'nw-about-hero.css' | asset_url | stylesheet_tag }}

<style>
  #NwAboutHero-{{ section.id }} {
    --nw-star-active: {{ section.settings.star_color | default: '#E57B1E' }};
    --nw-star-inactive: {{ section.settings.star_color_inactive | default: '#D1D5DB' }};
    --nw-about-hero-blend: {{ section.settings.gradient_blend_color | default: section.settings.bg_color | default: '#DDD6CD' }};
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: {{ section.settings.padding_top_desktop | default: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop | default: 0 }}px;
    {% case section.settings.bg_type %}
      {% when 'color' %}
        background-color: {{ section.settings.bg_color | default: '#DDD6CD' }};
      {% when 'gradient' %}
        background: {{ section.settings.bg_gradient }};
      {% when 'image' %}
        background-color: {{ section.settings.bg_color | default: '#DDD6CD' }};
      {% when 'none' %}
        background: transparent;
      {% else %}
        background-color: {{ section.settings.bg_color | default: '#DDD6CD' }};
    {% endcase %}
  }

  {%- if section.settings.bg_type == 'image' and section.settings.bg_image != blank -%}
    #NwAboutHero-{{ section.id }}::before {
      content: '';
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background-image: url('{{ section.settings.bg_image | image_url: width: 2880 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      z-index: 0;
      pointer-events: none;
    }
  {%- endif -%}

  {%- if section.settings.bg_type == 'image' and section.settings.bg_color_image != blank -%}
    #NwAboutHero-{{ section.id }}::after {
      content: '';
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background-color: {{ section.settings.bg_color_image | default: '#FFFFFF29' }};
      z-index: 0;
      pointer-events: none;
    }
  {%- endif -%}

  #NwAboutHero-{{ section.id }} > * {
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 749px) {
    #NwAboutHero-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile | default: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile | default: 0 }}px;
    }

    {%- if section.settings.bg_type == 'image' and section.settings.bg_image_mobile != blank -%}
      #NwAboutHero-{{ section.id }}::before {
        background-image: url('{{ section.settings.bg_image_mobile | image_url: width: 1200 }}');
      }
    {%- endif -%}
  }
</style>

<div
  id="NwAboutHero-{{ section.id }}"
  class="nw-about-hero section-{{ section.id }} scroll-trigger animate--fade-in"
>
  <div class="nw-about-hero__container{% if section.settings.show_image == false %} nw-about-hero__container--no-image{% elsif section.settings.image_position == 'left' %} nw-about-hero__container--image-left{% endif %}">
    <div class="nw-about-hero__content-col nw-about-hero__content-col--{{ section.settings.content_position | default: 'center' }} nw-about-hero__content-col--mobile-{{ section.settings.content_position_mobile | default: 'center' }}">
      <div class="nw-about-hero__content-wrap">
        <div class="nw-about-hero__header">
          {% render 'nw-section-header',
            show_rating: section.settings.show_rating,
            rating: section.settings.star_rating,
            eyebrow: section.settings.eyebrow,
            heading: section.settings.heading,
            description: section.settings.subheading,
            section_index: section.index
          %}
        </div>

        {%- assign trust_badges = section.blocks | where: 'type', 'trust_badge' -%}
        {% render 'nw-cta-badges',
          settings: section.settings,
          blocks: trust_badges,
          class: 'nw-about-hero__cta'
        %}
      </div>
    </div>

    {%- if section.settings.show_image != false -%}
      <div class="nw-about-hero__media-col">
        {%- if section.settings.show_gradient_blend -%}
          <div class="nw-about-hero__media-blend" aria-hidden="true"></div>
        {%- endif -%}
        {%- liquid
          assign desktop_img = section.settings.image_desktop
          assign mobile_img = section.settings.image_mobile
          if desktop_img == blank and mobile_img != blank
            assign desktop_img = mobile_img
          endif
        -%}
        {%- if desktop_img != blank -%}
          <picture>
            {%- if mobile_img != blank -%}
              <source
                media="(max-width: 749px)"
                srcset="{{ mobile_img | image_url: width: 750 }}"
              >
            {%- endif -%}
            <img
              src="{{ desktop_img | image_url: width: 1440 }}"
              alt="{{ desktop_img.alt | default: section.settings.heading | strip_html | escape }}"
              width="720"
              height="479"
              loading="eager"
              fetchpriority="high"
              class="nw-about-hero__img"
            >
          </picture>
        {%- else -%}
          <div class="nw-about-hero__placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "NW About Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "RATINGS & EYEBROW"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating Stars",
      "default": true
    },
    {
      "type": "range",
      "id": "star_rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Star Rating",
      "default": 5
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Active Star Color",
      "default": "#E57B1E"
    },
    {
      "type": "color",
      "id": "star_color_inactive",
      "label": "Inactive Star Color",
      "default": "#D1D5DB"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow / Rating Text",
      "default": "4.8/5 from 100'S sleepers"
    },
    {
      "type": "header",
      "content": "CONTENT"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content Vertical Position (Desktop)",
      "default": "center",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "select",
      "id": "content_position_mobile",
      "label": "Content Vertical Position (Mobile)",
      "default": "center",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Certified Organic. Not Just Called It."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>GOTS textiles, GOLS latex, made in the USA. Every claim on this page is backed by proof you can verify.</p>"
    },
    {
      "type": "header",
      "content": "BUTTON"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP THE MATTRESS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "default": "primary",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ]
    },
    {
      "type": "header",
      "content": "MEDIA"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show Image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Image",
      "visible_if": "{{ section.settings.show_image == true }}"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image (Optional)",
      "visible_if": "{{ section.settings.show_image == true }}"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "default": "right",
      "visible_if": "{{ section.settings.show_image == true }}",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_gradient_blend",
      "label": "Show Gradient Blend Overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "gradient_blend_color",
      "label": "Gradient Blend Color",
      "default": "#DDD6CD"
    },
    {
      "type": "header",
      "content": "BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "color",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "image", "label": "Image" },
        { "value": "gradient", "label": "Gradient" }
      ]
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color",
      "label": "Background Color",
      "default": "#DDD6CD",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile Optional)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color_image",
      "label": "Overlay Color",
      "default": "#FFFFFF29",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Badge Text",
          "default": "30-Year Warranty"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "shield",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "shield", "label": "Shield" },
            { "value": "moneyback", "label": "Money Back / Trial" },
            { "value": "warranty-2", "label": "Warranty" },
            { "value": "checkmark", "label": "Checkmark" },
            { "value": "check-circle", "label": "Check Circle" },
            { "value": "truck", "label": "Truck" },
            { "value": "verified", "label": "Verified" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "us-flag", "label": "US Flag" },
            { "value": "offer", "label": "Offer" }
          ]
        },
        {
          "type": "checkbox",
          "id": "use_custom_icon",
          "label": "Use Custom Icon Image",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image",
          "visible_if": "{{ block.settings.use_custom_icon == true }}"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon Color",
          "default": "#613916"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NW About Hero",
      "category": "NW Sections",
      "blocks": [
        {
          "type": "trust_badge",
          "settings": {
            "text": "30-Year Warranty",
            "icon": "shield"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "text": "100-Night Risk-Free Trial",
            "icon": "moneyback"
          }
        }
      ]
    }
  ]
}
{% endschema %}
