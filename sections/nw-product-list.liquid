      "id": "firmness_label_firm",
      "label": "Firmness label (firm)",
      "default": "Firm",
      "visible_if": "{{ section.settings.show_firmness == true }}"
    },
    {
      "type": "header",
      "content": "Product card colors"
    },
    {
      "type": "color",
      "id": "pcard_text",
      "label": "Text color",
      "alpha": true,
      "default": "#613916"
    },
    {
      "type": "color",
      "id": "pcard_star_color",
      "label": "Star color",
      "alpha": true,
      "default": "#E57B1E"
    },
    {
      "type": "color",
      "id": "pcard_star_empty_color",
      "label": "Empty star color",
      "alpha": true,
      "default": "#D9CFC4"
    },
    {
      "type": "color",
      "id": "pcard_save_bg",
      "label": "Save tag background",
      "alpha": true,
      "default": "#FFFCF0"
    },
    {
      "type": "color",
      "id": "pcard_save_text",
      "label": "Save tag text",
      "alpha": true,
      "default": "#613916"
    },
    {
      "type": "color",
      "id": "pcard_seller_bg",
      "label": "Seller tag background",
      "alpha": true,
      "default": "#70804A"
    },
    {
      "type": "color",
      "id": "pcard_seller_text",
      "label": "Seller tag text",
      "alpha": true,
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "pcard_btn_bg",
      "label": "Button background",
      "alpha": true,
      "default": "#CC926A"
    },
    {
      "type": "color",
      "id": "pcard_btn_bg_hover",
      "label": "Button background hover",
      "alpha": true,
      "default": "#B57D57"
    },
    {
      "type": "color",
      "id": "pcard_btn_text",
      "label": "Button text",
      "alpha": true,
      "default": "#FFFFFF"
