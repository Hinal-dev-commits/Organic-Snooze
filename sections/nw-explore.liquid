{{ 'nw-explore.css' | asset_url | stylesheet_tag }}

<style>
  #NwExplore-{{ section.id }} {
    display: block;
    position: relative;
    isolation: isolate;
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    {% case section.settings.bg_type %}
      {% when 'color' %}
        background-color: {{ section.settings.bg_color | default: '#F7F5F3' }};
      {% when 'gradient' %}
        background: {{ section.settings.bg_gradient }};
      {% when 'image' %}
        background-color: {{ section.settings.bg_color | default: '#F7F5F3' }};
      {% when 'none' %}
        background: transparent;
      {% else %}
        background-color: {{ section.settings.bg_color | default: '#F7F5F3' }};
    {% endcase %}
  }

  {%- if section.settings.bg_type == 'image' and section.settings.bg_image != blank -%}
    #NwExplore-{{ section.id }}::before {
      content: '';
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background-image: url('{{ section.settings.bg_image | image_url: width: 1920 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      z-index: 0;
      pointer-events: none;
    }
  {%- endif -%}

  {%- if section.settings.bg_type == 'image' and section.settings.bg_color_image != blank -%}
    #NwExplore-{{ section.id }}::after {
      content: '';
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background-color: {{ section.settings.bg_color_image | default: '#FFFFFF29' }};
      z-index: 0;
      pointer-events: none;
    }
  {%- endif -%}

  #NwExplore-{{ section.id }} > * {
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 749px) {
    #NwExplore-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    {%- if section.settings.bg_type == 'image' and section.settings.bg_image_mobile != blank -%}
      #NwExplore-{{ section.id }}::before {
        background-image: url('{{ section.settings.bg_image_mobile | image_url: width: 1200 }}');
      }
    {%- endif -%}
  }
</style>

<div
  id="NwExplore-{{ section.id }}"
  class="nw-explore section-{{ section.id }}"
>
  <div class="page-width">
    <div class="nw-explore__wrapper scroll-trigger animate--slide-in">
      {%- if section.settings.heading != blank
        or section.settings.subheading != blank
        or section.settings.eyebrow != blank
      -%}
        <div class="nw-explore__header">
          {% render 'nw-section-header',
            show_rating: section.settings.show_rating,
            rating: section.settings.star_rating,
            eyebrow: section.settings.eyebrow,
            heading: section.settings.heading,
            description: section.settings.subheading,
            section_index: section.index
          %}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="nw-explore__grid">
          {%- for block in section.blocks -%}
            <div class="nw-explore__card" {{ block.shopify_attributes }}>
              <div class="nw-explore__icon-wrap">
                {%- if block.settings.use_custom_image and block.settings.custom_image != blank -%}
                  <img
                    src="{{ block.settings.custom_image | image_url: width: 160 }}"
                    alt="{{ block.settings.title | strip_html | escape }}"
                    width="70"
                    height="70"
                    loading="lazy"
                    class="nw-explore__icon-img"
                  >
                {%- else -%}
                  {% render 'nw-icon', icon: block.settings.icon, class: 'nw-explore__icon-svg' %}
                {%- endif -%}
              </div>

              <div class="nw-explore__card-info">
                {%- if block.settings.title != blank -%}
                  <h3 class="nw-explore__card-title">{{ block.settings.title }}</h3>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <div class="nw-explore__card-text">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>

              {%- if block.settings.button_text != blank -%}
                {%- assign card_btn_style = block.settings.button_style | default: 'outline' -%}
                {% render 'nw-button',
                  text: block.settings.button_text,
                  link: block.settings.button_link,
                  style: card_btn_style,
                  btn_class: 'nw-explore__card-btn'
                %}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "NW Explore",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "SECTION HEADER"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating Stars In Header",
      "default": false
    },
    {
      "type": "range",
      "id": "star_rating",
      "label": "Star Rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow Text"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Keep Exploring"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "BACKGROUND SETTINGS"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "color",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "image", "label": "Image" },
        { "value": "gradient", "label": "Gradient" }
      ]
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F7F5F3",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile Optional)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color_image",
      "label": "Overlay Color",
      "default": "#FFFFFF29",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Benefit Card",
      "settings": [
        {
          "type": "checkbox",
          "id": "use_custom_image",
          "label": "Use Custom Icon Image",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Icon Image",
          "visible_if": "{{ block.settings.use_custom_image == true }}"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Preset Icon",
          "default": "offer",
          "options": [
            { "value": "offer", "label": "Offer / Financing" },
            { "value": "truck", "label": "Truck / Delivery" },
            { "value": "shield", "label": "Shield / Warranty" },
            { "value": "money", "label": "Money Back" },
            { "value": "verified", "label": "Verified" },
            { "value": "checkmark", "label": "Checkmark" },
            { "value": "leaf", "label": "Leaf / Organic" },
            { "value": "award", "label": "Award / Sparkle" },
            { "value": "heart", "label": "Heart" },
            { "value": "star", "label": "Star" },
            { "value": "us-flag", "label": "US Flag" }
          ],
          "visible_if": "{{ block.settings.use_custom_image == false }}"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "default": "Payment Options & Financing"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Description",
          "default": "Affirm, HSA/FSA, and more ways to pay"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Label",
          "default": "LEARN ABOUT FINANCING"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button Style",
          "default": "outline",
          "options": [
            { "value": "primary", "label": "Primary" },
            { "value": "secondary", "label": "Secondary" },
            { "value": "outline", "label": "Outline" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NW Explore",
      "category": "NW Sections",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "use_custom_image": false,
            "icon": "offer",
            "title": "Payment Options & Financing",
            "text": "Affirm, HSA/FSA, and more ways to pay",
            "button_text": "LEARN ABOUT FINANCING"
          }
        },
        {
          "type": "card",
          "settings": {
            "use_custom_image": false,
            "icon": "truck",
            "title": "White Glove Delivery",
            "text": "Let us set it up in your bedroom",
            "button_text": "DELIVERY & SETUP DETAILS"
          }
        },
        {
          "type": "card",
          "settings": {
            "use_custom_image": false,
            "icon": "shield",
            "title": "Shipping & Returns",
            "text": "Delivery times and how returns work",
            "button_text": "READ SHIPPING POLICY"
          }
        }
      ]
    }
  ]
}
{% endschema %}
