{{ 'nw-benefits.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-benefits.js' | asset_url }}" defer="defer"></script>

{%- assign nw_shell_selector = '#NwBenefits-' | append: section.id -%}
{% render 'nw-section-shell', selector: nw_shell_selector, mode: 'overlay', default_bg: '#FFFFFF' %}

<nw-benefits
  id="NwBenefits-{{ section.id }}"
  class="nw-benefits{% if section.settings.card_style == 'style_2' %} nw-benefits--style-2{% endif %}"
  data-card-style="{{ section.settings.card_style }}"
  data-show-arrows="{{ section.settings.show_arrows }}"
  data-show-pagination="{{ section.settings.show_pagination }}"
  data-pagination-id="NwBenefitsPagination-{{ section.id }}"
  style="
    --nw-benefits-heading-color: {{ section.settings.heading_color }};
    --nw-benefits-desc-color: {{ section.settings.description_color }};
    --nw-benefits-card-bg: {{ section.settings.card_bg_color }};
    --nw-benefits-card-border: {{ section.settings.card_border_color }};
    --nw-benefits-card-title-color: {{ section.settings.card_title_color }};
    --nw-benefits-card-desc-color: {{ section.settings.card_desc_color }};
    --nw-swiper-bullet: {{ section.settings.pagination_color }};
    --nw-cta-badge-text: {{ section.settings.badge_text_color }};
    --nw-cta-badge-icon: {{ section.settings.badge_icon_color }};
  "
>
  <div class="page-width">
    <div class="nw-benefits__wrapper{%- render 'nw-scroll-animation' -%}">
      <div class="nw-benefits__header">
        {% render 'nw-section-header',
          heading: section.settings.heading,
          description: section.settings.description,
          section_index: section.index
        %}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="nw-benefits__slider-wrap">
          <div class="swiper nw-benefits__swiper" id="NwBenefitsSwiper-{{ section.id }}">
            <div class="swiper-wrapper">
              {%- for block in section.blocks -%}
                {%- if block.type == 'benefit' -%}
                  <div class="swiper-slide" {{ block.shopify_attributes }}>
                    <article class="nw-benefits__card">
                      <div class="nw-benefits__card-media">
                        {%- if block.settings.media_type == 'video' and block.settings.video != blank -%}
                          {{
                            block.settings.video
                            | video_tag:
                              autoplay: true,
                              loop: true,
                              muted: true,
                              controls: false,
                              playsinline: true,
                              class: 'nw-benefits__card-video',
                              image_size: '800x'
                          }}
                        {%- elsif block.settings.image != blank -%}
                          {%- assign benefits_card_alt = block.settings.title | escape -%}
                          {{
                            block.settings.image
                            | image_url: width: 800
                            | image_tag:
                              alt: benefits_card_alt,
                              class: 'nw-benefits__card-img',
                              loading: 'lazy',
                              widths: '400, 600, 800',
                              sizes: '(min-width: 750px) 400px, 90vw'
                          }}
                        {%- else -%}
                          <div class="nw-benefits__card-placeholder" aria-hidden="true">
                            {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                          </div>
                        {%- endif -%}

                        {%- if section.settings.card_style == 'style_2' and block.settings.tag != blank -%}
                          <span
                            class="nw-benefits__card-tag"
                            style="
                              {%- if block.settings.tag_bg_color != blank -%}background-color: {{ block.settings.tag_bg_color }};{%- endif -%}
                              {%- if block.settings.tag_text_color != blank -%}color: {{ block.settings.tag_text_color }};{%- endif -%}
                            "
                          >
                            {{ block.settings.tag }}
                          </span>
                        {%- endif -%}
                      </div>

                      <div class="nw-benefits__card-body">
                        {%- if block.settings.title != blank -%}
                          <h3 class="nw-benefits__card-title">{{ block.settings.title }}</h3>
                        {%- endif -%}
                        {%- if block.settings.description != blank -%}
                          <div class="nw-benefits__card-desc rte">{{ block.settings.description }}</div>
                        {%- endif -%}
                      </div>
                    </article>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

          {%- if section.settings.show_arrows -%}
            {% render 'nw-swiper-arrows' %}
          {%- endif -%}

          {%- if section.settings.show_pagination -%}
            <div class="nw-swiper-pagination" id="NwBenefitsPagination-{{ section.id }}"></div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_button == true -%}
        {%- assign trust_badge_blocks = section.blocks | where: 'type', 'trust_badge' -%}
        <div class="nw-benefits__footer">
          {% render 'nw-cta-badges',
            settings: section.settings,
            blocks: trust_badge_blocks,
            class: 'nw-benefits__cta'
          %}
        </div>
      {%- endif -%}
    </div>
  </div>
</nw-benefits>

{% schema %}
{
  "name": "t:sections.nw-benefits.name",
  "tag": "section",
  "class": "section-nw-benefits",
  "settings": [
    {
      "type": "header",
      "content": "SECTION HEADER"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Benefits That Matter"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Four reasons our customers say they're never going back to foam.</p>"
    },
    {
      "type": "header",
      "content": "TEXT COLORS"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "header",
      "content": "CARD LAYOUT"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card Style",
      "default": "style_1",
      "options": [
        { "value": "style_1", "label": "Style 1" },
        { "value": "style_2", "label": "Style 2" }
      ]
    },
    {
      "type": "header",
      "content": "CARD COLORS"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#FBF9F6",
      "alpha": true
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color",
      "default": "rgba(97, 57, 22, 0.2)",
      "alpha": true
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card Title Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "card_desc_color",
      "label": "Card Description Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "header",
      "content": "SLIDER SETTINGS"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Slider Arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show Slider Pagination",
      "default": true
    },
    {
      "type": "color",
      "id": "pagination_color",
      "label": "Pagination Color",
      "default": "#613916",
      "alpha": true,
      "visible_if": "{{ section.settings.show_pagination == true }}"
    },
    {
      "type": "header",
      "content": "FOOTER CTA"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": false
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "SHOP THE MATTRESS",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "default": "primary",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ],
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "color",
      "id": "badge_icon_color",
      "label": "Badge Icon Color",
      "default": "#CC926A",
      "alpha": true,
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge Text Color",
      "default": "#613916",
      "alpha": true,
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "header",
      "content": "BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "image",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "image", "label": "Image" },
        { "value": "gradient", "label": "Gradient" }
      ]
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF",
      "alpha": true,
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "range",
      "id": "bg_image_opacity",
      "label": "Background Image Opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 21,
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit card",
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "Media Type",
          "default": "image",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "visible_if": "{{ block.settings.media_type == 'image' }}"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "default": "Zero Airborne VOCs"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Sleep in a room that smells like nothing at all.</p>"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag Label",
          "default": "Side",
          "visible_if": "{{ section.settings.card_style == 'style_2' }}"
        },
        {
          "type": "color",
          "id": "tag_bg_color",
          "label": "Tag Background Color",
          "default": "#613916",
          "alpha": true,
          "visible_if": "{{ section.settings.card_style == 'style_2' }}"
        },
        {
          "type": "color",
          "id": "tag_text_color",
          "label": "Tag Text Color",
          "default": "#FFFFFF",
          "alpha": true,
          "visible_if": "{{ section.settings.card_style == 'style_2' }}"
        }
      ]
    },
    {
      "type": "trust_badge",
      "name": "Trust badge",
      "settings": [
        {
          "type": "checkbox",
          "id": "use_custom_icon",
          "label": "Use Custom Icon",
          "default": false
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Badge Icon",
          "default": "money",
          "options": [
            { "value": "money", "label": "Moneyback / Trial" },
            { "value": "warranty-2", "label": "Warranty" },
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Truck / Shipping" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "star", "label": "Star" },
            { "value": "verified-3", "label": "Verified" },
            { "value": "none", "label": "None" }
          ],
          "visible_if": "{{ block.settings.use_custom_icon == false }}"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon",
          "visible_if": "{{ block.settings.use_custom_icon }}"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Badge Text",
          "default": "100-Night Risk-Free Trial"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nw Benefits",
      "category": "NW Sections",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "title": "Zero Airborne VOCs",
            "description": "<p>Sleep in a room that smells like nothing at all.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Sleeps Cooler",
            "description": "<p>Wool naturally regulates temperature. Perforated latex never traps heat.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Real Pressure Relief",
            "description": "<p>Latex lifts and contours so hips and shoulders stop aching.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Outlasts Foam",
            "description": "<p>Add superior support and limited motion shift from coils</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
