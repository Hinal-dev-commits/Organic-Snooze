{{ 'nw-trusted-people.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-trusted-people.js' | asset_url }}" defer="defer"></script>

<style>
  #NwTrustedPeople-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_desktop | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop | default: 80 }}px;
    {% if section.settings.bg_type == 'color' and section.settings.bg_color != blank %}
      background-color: {{ section.settings.bg_color }};
    {% elsif section.settings.bg_type == 'gradient' and section.settings.bg_gradient != blank %}
      background: {{ section.settings.bg_gradient }};
    {% elsif section.settings.bg_type == 'image' and section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 2880 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    #NwTrustedPeople-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile | default: 48 }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile | default: 48 }}px;
      {% if section.settings.bg_type == 'image' and section.settings.bg_image_mobile != blank %}
        background-image: url('{{ section.settings.bg_image_mobile | image_url: width: 1200 }}');
      {% endif %}
    }
  }
</style>

<nw-trusted-people
  id="NwTrustedPeople-{{ section.id }}"
  class="nw-trusted-people"
  data-block-count="{{ section.blocks.size | default: 0 }}"
  data-show-arrows="{{ section.settings.show_arrows }}"
  style="
    --nw-tp-heading-color: {{ section.settings.heading_color }};
    --nw-tp-desc-color: {{ section.settings.description_color }};
    --nw-tp-card-bg: {{ section.settings.card_bg_color }};
    --nw-tp-card-text: {{ section.settings.card_text_color }};
    --nw-tp-card-border: {{ section.settings.card_border_color }};
    --nw-tp-verified-color: {{ section.settings.verified_icon_color }};
    --nw-tp-toggle-border: {{ section.settings.toggle_border_color }};
    --nw-cta-badge-text: {{ section.settings.badge_text_color }};
    --nw-cta-badge-icon: {{ section.settings.badge_icon_color }};
    --nw-swiper-bullet: {{ section.settings.pagination_color }};
    --nw-tp-overlay-color: {{ section.settings.overlay_color }};
  "
>
  <div class="nw-trusted-people__wrapper{%- render 'nw-scroll-animation' -%}">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="nw-trusted-people__header">
        {% render 'nw-section-heading', text: section.settings.heading, section_index: section.index %}
        {% render 'nw-section-description', text: section.settings.subheading %}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="nw-trusted-people__slider-wrap">
        <div class="swiper nw-trusted-people__swiper" id="NwTrustedPeopleSwiper-{{ section.id }}">
          <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
              <div
                class="swiper-slide"
                {{ block.shopify_attributes }}
                data-slide-index="{{ forloop.index0 }}"
              >
                {% render 'nw-trusted-people-card', block: block %}
              </div>
            {%- endfor -%}
          </div>
        </div>

        {%- if section.settings.show_arrows -%}
          {% render 'nw-swiper-arrows' %}
        {%- endif -%}

        {%- if section.settings.show_pagination and section.blocks.size > 1 -%}
            <div class="nw-swiper-pagination" id="NwTrustedPeoplePagination-{{ section.id }}" data-nw-tp-pagination>
            {%- for block in section.blocks -%}
              <span
                class="swiper-pagination-bullet{% if forloop.first %} swiper-pagination-bullet-active{% endif %}"
                data-bullet-index="{{ forloop.index0 }}"
              ></span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {% render 'nw-cta-badges', settings: section.settings, class: 'nw-trusted-people__footer' %}
  </div>
</nw-trusted-people>

