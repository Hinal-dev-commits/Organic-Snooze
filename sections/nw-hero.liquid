{{ 'nw-hero.css' | asset_url | stylesheet_tag }}
{%- if section.settings.enable_black_friday_mode -%}
  {{ 'nw-hero-black-friday.css' | asset_url | stylesheet_tag }}
{%- endif -%}
<script src="{{ 'nw-hero.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign hero_media_type = section.settings.media_type
  assign bf_mode = section.settings.enable_black_friday_mode
  if hero_media_type == blank and section.settings.shopify_video != blank
    assign hero_media_type = 'video'
  elsif hero_media_type == blank
    assign hero_media_type = 'image'
  endif
-%}

{%- if bf_mode -%}
  {% style %}
    {%- unless section.settings.bf_heading_font.system? -%}
      {{ section.settings.bf_heading_font | font_face: font_display: 'swap' }}
    {%- endunless -%}
    {%- unless section.settings.bf_heading_accent_font.system? -%}
      {{ section.settings.bf_heading_accent_font | font_face: font_display: 'swap' }}
    {%- endunless -%}
  {% endstyle %}
{%- endif -%}

<style>
  #NwHero-{{ section.id }} {
    {% if section.settings.enable_transparent_header %}
      margin-top: calc(-1 * var(--header-height, 76px));
      min-height: calc(727px + var(--header-height, 76px));
      padding-top: calc(var(--header-height, 76px) + {{ section.settings.padding_top_desktop | default: 43 }}px) !important;
      padding-bottom: {{ section.settings.padding_bottom_desktop | default: 43 }}px !important;
    {% else %}
      padding-top: {{ section.settings.padding_top_desktop | default: 43 }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop | default: 43 }}px;
    {% endif %}
    {% if section.settings.bg_type == 'color' and section.settings.bg_color != blank %}
      background-color: {{ section.settings.bg_color }};
      background-image: none;
    {% elsif section.settings.bg_type == 'gradient' and section.settings.bg_gradient != blank %}
      background: {{ section.settings.bg_gradient }};
      background-image: none;
    {% elsif section.settings.bg_type == 'none' %}
      background: transparent;
      background-image: none;
    {% endif %}
  }

  #NwHero-{{ section.id }} .nw-hero__overlay {
    background-color: {{ section.settings.overlay_color }};
    display: block !important;
  }

  @media screen and (max-width: 749px) {
    #NwHero-{{ section.id }} {
      {% if section.settings.enable_transparent_header %}
        margin-top: calc(-1 * var(--header-height, 60px) - 2px);
        min-height: 0;
        padding-top: calc(var(--header-height, 60px) + {{ section.settings.padding_top_mobile | default: 43 }}px) !important;
        padding-bottom: {{ section.settings.padding_bottom_mobile | default: 43 }}px !important;
      {% else %}
        padding-top: {{ section.settings.padding_top_mobile | default: 43 }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile | default: 43 }}px;
      {% endif %}
      {% if section.settings.bg_type == 'color' and section.settings.bg_color != blank %}
        background-image: none;
      {% elsif section.settings.bg_type == 'gradient' and section.settings.bg_gradient != blank %}
        background-image: none;
      {% endif %}
      {% if bf_mode %}
        height: auto;
        min-height: min(100svh, 620px);
      {% else %}
        height: 100vh;
      {% endif %}
    }
  }

  {%- if bf_mode -%}
    #NwHero-{{ section.id }}.nw-hero--black-friday {
      --nw-bf-accent: {{ section.settings.bf_accent_color }};
      --nw-bf-gold-rule-height: {{ section.settings.bf_gold_rule_height }}px;
      --nw-bf-heading-transform: {{ section.settings.bf_heading_text_transform }};
      --nw-bf-heading-font-family: {{ section.settings.bf_heading_font.family }}, {{ section.settings.bf_heading_font.fallback_families }};
      --nw-bf-heading-font-style: {{ section.settings.bf_heading_font.style }};
      --nw-bf-heading-font-weight: {{ section.settings.bf_heading_font.weight }};
      --nw-bf-heading-primary-size-dt: {{ section.settings.bf_heading_line_1_size_desktop }}px;
      --nw-bf-heading-primary-size-mb: {{ section.settings.bf_heading_line_1_size_mobile }}px;
      --nw-bf-heading-primary-lh: {{ section.settings.bf_heading_line_1_line_height | divided_by: 100.0 }};
      --nw-bf-heading-primary-ls: {{ section.settings.bf_heading_line_1_letter_spacing }}px;
      --nw-bf-heading-primary-color: {{ section.settings.bf_heading_line_1_color }};
      --nw-bf-heading-accent-font-family: {{ section.settings.bf_heading_accent_font.family }}, {{ section.settings.bf_heading_accent_font.fallback_families }};
      --nw-bf-heading-accent-font-style: {{ section.settings.bf_heading_accent_font.style }};
      --nw-bf-heading-accent-font-weight: {{ section.settings.bf_heading_accent_font.weight }};
      --nw-bf-heading-accent-size-dt: {{ section.settings.bf_heading_line_2_size_desktop }}px;
      --nw-bf-heading-accent-size-mb: {{ section.settings.bf_heading_line_2_size_mobile }}px;
      --nw-bf-heading-accent-lh: {{ section.settings.bf_heading_line_2_line_height | divided_by: 100.0 }};
      --nw-bf-heading-accent-ls: {{ section.settings.bf_heading_line_2_letter_spacing }}px;
      --nw-bf-heading-accent-color: {{ section.settings.bf_heading_line_2_color }};
      --nw-bf-rating-size-dt: {{ section.settings.bf_rating_size_desktop }}px;
      --nw-bf-rating-size-mb: {{ section.settings.bf_rating_size_mobile }}px;
      --nw-bf-rating-color: {{ section.settings.bf_rating_text_color }};
      --nw-bf-star-color: {{ section.settings.bf_star_color }};
      --nw-bf-subheading-font-weight: {{ section.settings.bf_subheading_font_weight }};
      --nw-bf-subheading-size-dt: {{ section.settings.bf_subheading_size_desktop }}px;
      --nw-bf-subheading-size-mb: {{ section.settings.bf_subheading_size_mobile }}px;
      --nw-bf-subheading-lh: {{ section.settings.bf_subheading_line_height | divided_by: 100.0 }};
      --nw-bf-subheading-color: {{ section.settings.bf_subheading_color }};
      --nw-bf-btn-size-dt: {{ section.settings.bf_button_size_desktop }}px;
      --nw-bf-btn-size-mb: {{ section.settings.bf_button_size_mobile }}px;
      --nw-bf-btn-bg: {{ section.settings.bf_button_bg_color }};
      --nw-bf-btn-color: {{ section.settings.bf_button_text_color }};
      --nw-bf-badge-size-dt: {{ section.settings.bf_badge_size_desktop }}px;
      --nw-bf-badge-size-mb: {{ section.settings.bf_badge_size_mobile }}px;
      --nw-bf-badge-color: {{ section.settings.bf_badge_text_color }};
      --nw-bf-promo-bg: {{ section.settings.bf_promo_bg_color }};
      --nw-bf-promo-border: {{ section.settings.bf_promo_border_color }};
      --nw-bf-promo-title-color: {{ section.settings.bf_promo_title_color }};
      --nw-bf-promo-title-size-dt: {{ section.settings.bf_promo_title_size_desktop }}px;
      --nw-bf-promo-subtext-color: {{ section.settings.bf_promo_subtext_color }};
      --nw-bf-promo-subtext-size-dt: {{ section.settings.bf_promo_subtext_size_desktop }}px;
      --nw-bf-promo-divider: {{ section.settings.bf_promo_divider_color }};
      --nw-bf-status-text-color: {{ section.settings.bf_status_text_color }};
      --nw-bf-status-dot-color: {{ section.settings.bf_status_dot_color }};
      --nw-bf-countdown-label-color: {{ section.settings.bf_countdown_label_color }};
      --nw-bf-countdown-label-size-dt: {{ section.settings.bf_countdown_label_size_desktop }}px;
      --nw-bf-timer-text-color: {{ section.settings.bf_timer_text_color }};
      --nw-bf-promo-inset-right: {{ section.settings.bf_promo_desktop_inset_right }}px;
      --nw-bf-promo-inset-bottom: {{ section.settings.bf_promo_desktop_inset_bottom }}px;
      --nw-bf-promo-inset-top: {{ section.settings.bf_promo_desktop_inset_top }}px;
    }
  {%- endif -%}
</style>

<nw-hero
  id="NwHero-{{ section.id }}"
  class="nw-hero__wrapper{% if section.settings.enable_transparent_header %} nw-hero--transparent-header{% endif %}{% if bf_mode %} nw-hero--black-friday{% if section.settings.bf_show_gold_rule %} nw-hero--bf-gold-rule{% endif %}{% if section.settings.bf_promo_desktop_anchor == 'top' %} nw-hero--bf-promo-anchor-top{% else %} nw-hero--bf-promo-anchor-bottom{% endif %}{% endif %}{%- render 'nw-scroll-animation', type: 'fade-in' -%}"
  {% if section.settings.enable_transparent_header %}
    data-nw-transparent-header
    data-nw-transparent-header-tone="{{ section.settings.transparent_header_tone | default: 'dark' }}"
  {% endif %}
  style="
    --nw-hero-overlay-color: {{ section.settings.overlay_color }};
    --nw-hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --nw-hero-pt-dt: {{ section.settings.padding_top_desktop }}px;
    --nw-hero-pb-dt: {{ section.settings.padding_bottom_desktop }}px;
    --nw-hero-pt-mb: {{ section.settings.padding_top_mobile }}px;
    --nw-hero-pb-mb: {{ section.settings.padding_bottom_mobile }}px;
    --nw-hero-text-color: {{ section.settings.text_color }};
  "
>
  {%- if hero_media_type == 'image' -%}
    <div class="nw-hero__bg-video-wrapper">
      {%- if section.settings.bg_image != blank or section.settings.bg_image_mobile != blank -%}
        {%- liquid
          assign hero_desktop_image = section.settings.bg_image
          assign hero_mobile_image = section.settings.bg_image_mobile
          assign hero_image_alt = hero_desktop_image.alt | default: hero_mobile_image.alt | default: section.settings.heading | strip_html | escape
        -%}
        {%- if hero_mobile_image != blank and hero_desktop_image != blank -%}
          {{
            hero_mobile_image
            | image_url: width: 1200
            | image_tag:
              class: 'nw-hero__bg-video nw-hero__bg-video--mobile',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '375, 550, 750, 1200',
              sizes: '100vw',
              alt: hero_image_alt
          }}
          {{
            hero_desktop_image
            | image_url: width: 2880
            | image_tag:
              class: 'nw-hero__bg-video nw-hero__bg-video--desktop',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '750, 1100, 1500, 2000, 2880',
              sizes: '100vw',
              alt: hero_image_alt
          }}
        {%- elsif hero_desktop_image != blank -%}
          {{
            hero_desktop_image
            | image_url: width: 2880
            | image_tag:
              class: 'nw-hero__bg-video',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '750, 1100, 1500, 2000, 2880',
              sizes: '100vw',
              alt: hero_image_alt
          }}
        {%- else -%}
          {{
            hero_mobile_image
            | image_url: width: 1200
            | image_tag:
              class: 'nw-hero__bg-video',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '375, 550, 750, 1200',
              sizes: '100vw',
              alt: hero_image_alt
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg nw-hero__bg-video' }}
      {%- endif -%}
    </div>
  {%- elsif hero_media_type == 'video' -%}
  {%- if section.settings.video_source == 'shopify_hosted' and section.settings.shopify_video != blank -%}
    <div class="nw-hero__bg-video-wrapper">
      {{ section.settings.shopify_video | video_tag: autoplay: section.settings.video_autoplay, loop: true, muted: true, controls: false, playsinline: true, class: 'nw-hero__bg-video' }}
    </div>
  {%- elsif section.settings.custom_video_url != blank -%}
    <div class="nw-hero__bg-video-wrapper">
      <video class="nw-hero__bg-video"{% if section.settings.video_autoplay %} autoplay{% endif %} loop muted playsinline src="{{ section.settings.custom_video_url }}"></video>
    </div>
  {%- elsif section.settings.video_source == 'url' and section.settings.video_url != blank -%}
    <div class="nw-hero__bg-video-wrapper">
      {%- if section.settings.video_url.type == 'youtube' -%}
        <iframe
          class="nw-hero__bg-video"
          src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?{% if section.settings.video_autoplay %}autoplay=1&{% endif %}mute=1&loop=1&playlist={{ section.settings.video_url.id }}&controls=0&showinfo=0&rel=0&enablejsapi=1"
          frameborder="0"
          allow="autoplay; encrypted-media"
          allowfullscreen
        ></iframe>
      {%- elsif section.settings.video_url.type == 'vimeo' -%}
        <iframe
          class="nw-hero__bg-video"
          src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?{% if section.settings.video_autoplay %}autoplay=1&{% endif %}muted=1&loop=1&background=1"
          frameborder="0"
          allow="autoplay; fullscreen"
          allowfullscreen
        ></iframe>
      {%- endif -%}
    </div>
  {%- endif -%}
  {%- endif -%}

  <div class="nw-hero__overlay"></div>

  <div class="page-width">
    <div class="nw-hero__inner nw-hero__inner--h-{{ section.settings.content_position_h }} nw-hero__inner--v-{{ section.settings.content_position_v }}">
      <div class="nw-hero__content nw-hero__content--align-{{ section.settings.text_alignment }}">
        {%- if section.settings.show_reviews -%}
          <div
            class="nw-hero__rating-wrap"
            style="--nw-hero-star-color: {{ section.settings.star_color }};"
          >
            <div class="nw-hero__stars">
              {%- for i in (1..5) -%}
                {%- if i <= section.settings.rating_stars -%}
                  <span class="nw-hero__star">
                    {% render 'nw-icon', icon: 'star-rating' %}
                  </span>
                {%- else -%}
                  <span class="nw-hero__star nw-hero__star--empty">
                    {% render 'nw-icon', icon: 'star-rating' %}
                  </span>
                {%- endif -%}
              {%- endfor -%}
            </div>
            {%- if section.settings.rating_text != blank -%}
              <div class="nw-hero__rating-text">{{ section.settings.rating_text }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if bf_mode -%}
          {%- liquid
            assign bf_heading_primary = section.settings.bf_heading_line_1 | strip
            assign bf_heading_accent = section.settings.bf_heading_line_2 | strip
            if bf_heading_primary == blank
              assign bf_heading_primary = section.settings.heading | strip_html | strip
            endif
            assign bf_heading_tag = 'h2'
            if section.index == 1 and template.name != 'collection'
              assign bf_heading_tag = 'h1'
            endif
          -%}
          {%- if bf_heading_primary != blank or bf_heading_accent != blank -%}
            <div class="nw-hero__bf-heading nw-heading">
              {%- if bf_heading_primary != blank -%}
                <{{ bf_heading_tag }} class="nw-hero__bf-heading-line nw-hero__bf-heading-line--primary">{{ bf_heading_primary | escape }}</{{ bf_heading_tag }}>
              {%- endif -%}
              {%- if bf_heading_accent != blank -%}
                <p class="nw-hero__bf-heading-line nw-hero__bf-heading-line--accent">{{ bf_heading_accent | escape }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- elsif section.settings.heading != blank -%}
          {% render 'nw-section-heading', text: section.settings.heading, section_index: section.index, class: 'nw-heading' %}
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          {% render 'nw-section-description', text: section.settings.subheading, class: 'nw-hero__subheading' %}
        {%- endif -%}

        {%- assign trust_badges = section.blocks | where: 'type', 'trust_badge' -%}
        {% render 'nw-cta-badges',
          settings: section.settings,
          blocks: trust_badges,
          class: 'nw-hero__cta'
        %}

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'promo_countdown' -%} 
              {%- liquid
                assign promo_link = block.settings.promo_link
                assign promo_open_new_tab = block.settings.promo_link_open_new_tab
              -%}
              {%- if promo_link != blank -%}
                <a
                  href="{{ promo_link }}"
                  class="nw-hero__promo-module nw-hero__promo-module--linked{% if bf_mode %} nw-hero__promo-module--bf{% endif %}"
                  data-countdown-date="{{ block.settings.countdown_end_date }}"
                  data-hide-on-end="{{ block.settings.hide_after_timer_end }}"
                  {% if promo_open_new_tab %}
                    target="_blank"
                    rel="noopener noreferrer"
                  {% endif %}
                  {{ block.shopify_attributes }}
                >
              {%- else -%}
                <div
                  class="nw-hero__promo-module{% if bf_mode %} nw-hero__promo-module--bf{% endif %}"
                  data-countdown-date="{{ block.settings.countdown_end_date }}"
                  data-hide-on-end="{{ block.settings.hide_after_timer_end }}"
                  {{ block.shopify_attributes }}
                >
              {%- endif -%}
                <div class="nw-hero__promo-header">
                  {%- if block.settings.promo_title != blank -%}
                    <div class="nw-hero__promo-title">
                      {%- if block.settings.show_icon -%}
                        {%- if block.settings.icon_type == 'us_flag' -%}
                          <span class="nw-hero__promo-icon" aria-hidden="true">
                            {% render 'nw-icon', icon: 'us-flag' %}
                          </span>
                        {%- elsif block.settings.icon_type == 'custom' and block.settings.custom_icon != blank -%}
                          <span class="nw-hero__promo-icon" aria-hidden="true">
                            <img src="{{ block.settings.custom_icon | image_url: width: 40 }}" alt="" width="20" height="15" loading="lazy">
                          </span>
                        {%- endif -%}
                      {%- endif -%}
                      {{ block.settings.promo_title }}
                    </div>
                  {%- endif -%}
                  {%- if block.settings.status_text != blank -%}
                    <div class="nw-hero__status-badge">
                      <span class="nw-hero__status-dot"></span>
                      <div class="nw-hero__status-text">{{ block.settings.status_text }}</div>
                    </div>
                  {%- endif -%}
                </div>
                {%- if block.settings.promo_subtext != blank -%}
                  <div class="nw-hero__promo-subtext rte">
                    {{ block.settings.promo_subtext }}
                  </div>
                {%- endif -%}
                {% if block.settings.countdown_end_date != blank or block.settings.countdown_label != blank %}
                <div class="nw-hero__countdown-wrap">
                  {%- if block.settings.countdown_label != blank -%}
                    <div class="nw-hero__countdown-label">{{ block.settings.countdown_label }}</div>
                  {%- endif -%}
                  {% if block.settings.countdown_end_date != blank %}
                  <div class="nw-hero__timer-units">
                    <div class="nw-hero__timer-unit">
                      <span class="nw-hero__timer-num nw-countdown-days">00</span>
                      <span class="nw-hero__timer-txt">{{ 'nw.countdown.days' | t }}</span>
                    </div>
                    <span class="nw-hero__timer-sep">:</span>
                    <div class="nw-hero__timer-unit">
                      <span class="nw-hero__timer-num nw-countdown-hours">00</span>
                      <span class="nw-hero__timer-txt">{{ 'nw.countdown.hours' | t }}</span>
                    </div>
                    <span class="nw-hero__timer-sep">:</span>
                    <div class="nw-hero__timer-unit">
                      <span class="nw-hero__timer-num nw-countdown-mins">00</span>
                      <span class="nw-hero__timer-txt">{{ 'nw.countdown.minutes' | t }}</span>
                    </div>
                  </div>
                  {% endif %}
                </div>
                {% endif %}
              {%- if promo_link != blank -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>

      {%- if hero_media_type == 'video' and section.settings.enable_video_button -%}
        <div class="nw-hero__media-col">
          <button type="button" class="nw-hero__play-btn" aria-label="Play or pause video">
            {% render 'nw-icon', icon: 'play-hero' %}
            {% render 'nw-icon', icon: 'pause-hero' %}
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>
</nw-hero>

{% schema %}
{
  "name": "t:sections.nw-hero.name",
  "tag": "section",
  "class": "section-nw-hero",
  "settings": [
    {
      "type": "header",
      "content": "HEADER INTEGRATION"
    },
    {
      "type": "checkbox",
      "id": "enable_transparent_header",
      "label": "Enable Transparent Header Over Hero",
      "default": true
    },
    {
      "type": "select",
      "id": "transparent_header_tone",
      "label": "Transparent header text tone",
      "info": "Match the hero area behind the nav. Light background uses dark links; dark background uses white links (Black Friday header).",
      "default": "dark",
      "options": [
        {
          "value": "dark",
          "label": "Dark hero background (white nav text)"
        },
        {
          "value": "light",
          "label": "Light hero background (black nav text)"
        }
      ],
      "visible_if": "{{ section.settings.enable_transparent_header }}"
    },
    {
      "type": "header",
      "content": "BLACK FRIDAY MODE"
    },
    {
      "type": "paragraph",
      "content": "When enabled, Black Friday typography and styling apply to this hero only. When disabled, the hero uses the default design and settings below."
    },
    {
      "type": "checkbox",
      "id": "enable_black_friday_mode",
      "label": "Enable Black Friday mode",
      "default": false
    },
    {
      "type": "color",
      "id": "bf_accent_color",
      "label": "Accent color (gold)",
      "default": "#E9B949",
      "visible_if": "{{ section.settings.enable_black_friday_mode }}"
    },
    {
      "type": "checkbox",
      "id": "bf_show_gold_rule",
      "label": "Show gold bottom rule",
      "default": true,
      "visible_if": "{{ section.settings.enable_black_friday_mode }}"
    },
    {
      "type": "range",
      "id": "bf_gold_rule_height",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "px",
      "label": "Gold rule height",
      "default": 4,
      "visible_if": "{{ section.settings.enable_black_friday_mode and section.settings.bf_show_gold_rule }}"
    },
    {
      "type": "header",
      "content": "Black Friday — heading",
      "visible_if": "{{ section.settings.enable_black_friday_mode }}"
    },
    {
      "type": "text",
      "id": "bf_heading_line_1",
      "label": "Heading line 1",
      "default": "BLACK FRIDAY",
      "info": "Leave blank to use the default Heading field below.",
      "visible_if": "{{ section.settings.enable_black_friday_mode }}"
    },
    {
      "type": "font_picker",
      "id": "bf_heading_font",
      "label": "Heading line 1 font",
      "default": "dm_sans_n4",
      "visible_if": "{{ section.settings.enable_black_friday_mode }}"
    },
    {
      "type": "range",
      "id": "bf_heading_line_1_size_desktop",
      "min": 24,
      "max": 120,
      "step": 1,
      "unit": "px",
      "label": "Heading line 1 size (desktop)",
      "default": 64,
      "visible_if": "{{ section.settings.enable_black_friday_mode }}"
    },
    {
      "type": "range",
      "id": "bf_heading_line_1_size_mobile",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Heading line 1 size (mobile)",
      "default": 40,
      "visible_if": "{{ section.settings.enable_black_friday_mode }}"
