{{ 'nw-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-hero.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign hero_media_type = section.settings.media_type
  if hero_media_type == blank and section.settings.shopify_video != blank
    assign hero_media_type = 'video'
  elsif hero_media_type == blank
    assign hero_media_type = 'image'
  endif
-%}

<style>
  #NwHero-{{ section.id }} {
    {% if section.settings.enable_transparent_header %}
      margin-top: calc(-1 * var(--header-height, 76px));
      min-height: calc(727px + var(--header-height, 76px));
      padding-top: calc(var(--header-height, 76px) + {{ section.settings.padding_top_desktop | default: 43 }}px) !important;
      padding-bottom: {{ section.settings.padding_bottom_desktop | default: 43 }}px !important;
    {% else %}
      padding-top: {{ section.settings.padding_top_desktop | default: 43 }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop | default: 43 }}px;
    {% endif %}
    {% if section.settings.bg_type == 'color' and section.settings.bg_color != blank %}
      background-color: {{ section.settings.bg_color }};
      background-image: none;
    {% elsif section.settings.bg_type == 'gradient' and section.settings.bg_gradient != blank %}
      background: {{ section.settings.bg_gradient }};
      background-image: none;
    {% elsif section.settings.bg_type == 'none' %}
      background: transparent;
      background-image: none;
    {% endif %}
  }

  #NwHero-{{ section.id }} .nw-hero__overlay {
    background-color: {{ section.settings.overlay_color }};
    display: block !important;
  }

  @media screen and (max-width: 749px) {
    #NwHero-{{ section.id }} {
      {% if section.settings.enable_transparent_header %}
        margin-top: calc(-1 * var(--header-height, 60px) - 2px);
        min-height: 0;
        padding-top: calc(var(--header-height, 60px) + {{ section.settings.padding_top_mobile | default: 43 }}px) !important;
        padding-bottom: {{ section.settings.padding_bottom_mobile | default: 43 }}px !important;
      {% else %}
        padding-top: {{ section.settings.padding_top_mobile | default: 43 }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile | default: 43 }}px;
      {% endif %}
      {% if section.settings.bg_type == 'color' and section.settings.bg_color != blank %}
        background-image: none;
      {% elsif section.settings.bg_type == 'gradient' and section.settings.bg_gradient != blank %}
        background-image: none;
      {% endif %}
      height: 100vh;
    }
  }
</style>

<nw-hero
  id="NwHero-{{ section.id }}"
  class="nw-hero__wrapper{% if section.settings.enable_transparent_header %} nw-hero--transparent-header{% endif %}{%- render 'nw-scroll-animation', type: 'fade-in' -%}"
  {% if section.settings.enable_transparent_header %}data-nw-transparent-header{% endif %}
  style="
    --nw-hero-overlay-color: {{ section.settings.overlay_color }};
    --nw-hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --nw-hero-pt-dt: {{ section.settings.padding_top_desktop }}px;
    --nw-hero-pb-dt: {{ section.settings.padding_bottom_desktop }}px;
    --nw-hero-pt-mb: {{ section.settings.padding_top_mobile }}px;
    --nw-hero-pb-mb: {{ section.settings.padding_bottom_mobile }}px;
    --nw-hero-text-color: {{ section.settings.text_color }};
  "
>
  {%- if hero_media_type == 'image' -%}
    <div class="nw-hero__bg-video-wrapper">
      {%- if section.settings.bg_image != blank or section.settings.bg_image_mobile != blank -%}
        {%- liquid
          assign hero_desktop_image = section.settings.bg_image
          assign hero_mobile_image = section.settings.bg_image_mobile
          assign hero_image_alt = hero_desktop_image.alt | default: hero_mobile_image.alt | default: section.settings.heading | strip_html | escape
        -%}
        {%- if hero_mobile_image != blank and hero_desktop_image != blank -%}
          {{
            hero_mobile_image
            | image_url: width: 1200
            | image_tag:
              class: 'nw-hero__bg-video nw-hero__bg-video--mobile',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '375, 550, 750, 1200',
              sizes: '100vw',
              alt: hero_image_alt
          }}
          {{
            hero_desktop_image
            | image_url: width: 2880
            | image_tag:
              class: 'nw-hero__bg-video nw-hero__bg-video--desktop',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '750, 1100, 1500, 2000, 2880',
              sizes: '100vw',
              alt: hero_image_alt
          }}
        {%- elsif hero_desktop_image != blank -%}
          {{
            hero_desktop_image
            | image_url: width: 2880
            | image_tag:
              class: 'nw-hero__bg-video',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '750, 1100, 1500, 2000, 2880',
              sizes: '100vw',
              alt: hero_image_alt
          }}
        {%- else -%}
          {{
            hero_mobile_image
            | image_url: width: 1200
            | image_tag:
              class: 'nw-hero__bg-video',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '375, 550, 750, 1200',
              sizes: '100vw',
              alt: hero_image_alt
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg nw-hero__bg-video' }}
      {%- endif -%}
    </div>
  {%- elsif hero_media_type == 'video' -%}
  {%- if section.settings.video_source == 'shopify_hosted' and section.settings.shopify_video != blank -%}
    <div class="nw-hero__bg-video-wrapper">
      {{ section.settings.shopify_video | video_tag: autoplay: section.settings.video_autoplay, loop: true, muted: true, controls: false, playsinline: true, class: 'nw-hero__bg-video' }}
    </div>
  {%- elsif section.settings.custom_video_url != blank -%}
    <div class="nw-hero__bg-video-wrapper">
      <video class="nw-hero__bg-video"{% if section.settings.video_autoplay %} autoplay{% endif %} loop muted playsinline src="{{ section.settings.custom_video_url }}"></video>
    </div>
  {%- elsif section.settings.video_source == 'url' and section.settings.video_url != blank -%}
    <div class="nw-hero__bg-video-wrapper">
      {%- if section.settings.video_url.type == 'youtube' -%}
        <iframe
          class="nw-hero__bg-video"
          src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?{% if section.settings.video_autoplay %}autoplay=1&{% endif %}mute=1&loop=1&playlist={{ section.settings.video_url.id }}&controls=0&showinfo=0&rel=0&enablejsapi=1"
          frameborder="0"
          allow="autoplay; encrypted-media"
          allowfullscreen
        ></iframe>
      {%- elsif section.settings.video_url.type == 'vimeo' -%}
        <iframe
          class="nw-hero__bg-video"
          src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?{% if section.settings.video_autoplay %}autoplay=1&{% endif %}muted=1&loop=1&background=1"
          frameborder="0"
          allow="autoplay; fullscreen"
          allowfullscreen
        ></iframe>
      {%- endif -%}
    </div>
  {%- endif -%}
  {%- endif -%}

  <div class="nw-hero__overlay"></div>

  <div class="page-width">
    <div class="nw-hero__inner nw-hero__inner--h-{{ section.settings.content_position_h }} nw-hero__inner--v-{{ section.settings.content_position_v }}">
      <div class="nw-hero__content nw-hero__content--align-{{ section.settings.text_alignment }}">
        {%- if section.settings.show_reviews -%}
          <div
            class="nw-hero__rating-wrap"
            style="--nw-hero-star-color: {{ section.settings.star_color }};"
          >
            <div class="nw-hero__stars">
              {%- for i in (1..5) -%}
                {%- if i <= section.settings.rating_stars -%}
                  <span class="nw-hero__star">
                    {% render 'nw-icon', icon: 'star-rating' %}
                  </span>
                {%- else -%}
                  <span class="nw-hero__star nw-hero__star--empty">
                    {% render 'nw-icon', icon: 'star-rating' %}
                  </span>
                {%- endif -%}
              {%- endfor -%}
            </div>
            {%- if section.settings.rating_text != blank -%}
              <div class="nw-hero__rating-text">{{ section.settings.rating_text }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          {% render 'nw-section-heading', text: section.settings.heading, section_index: section.index, class: 'nw-heading' %}
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          {% render 'nw-section-description', text: section.settings.subheading, class: 'nw-hero__subheading' %}
        {%- endif -%}

        {%- assign trust_badges = section.blocks | where: 'type', 'trust_badge' -%}
        {% render 'nw-cta-badges',
          settings: section.settings,
          blocks: trust_badges,
          class: 'nw-hero__cta'
        %}

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'promo_countdown' -%}
              <div
                class="nw-hero__promo-module"
                data-countdown-date="{{ block.settings.countdown_end_date }}"
                data-hide-on-end="{{ block.settings.hide_after_timer_end }}"
                {{ block.shopify_attributes }}
              >
                <div class="nw-hero__promo-header">
                  {%- if block.settings.promo_title != blank -%}
                    <div class="nw-hero__promo-title">
                      {%- if block.settings.show_icon -%}
                        {%- if block.settings.icon_type == 'us_flag' -%}
                          <span class="nw-hero__promo-icon" aria-hidden="true">
                            {% render 'nw-icon', icon: 'us-flag' %}
                          </span>
                        {%- elsif block.settings.icon_type == 'custom' and block.settings.custom_icon != blank -%}
                          <span class="nw-hero__promo-icon" aria-hidden="true">
                            <img src="{{ block.settings.custom_icon | image_url: width: 40 }}" alt="" width="20" height="15" loading="lazy">
                          </span>
                        {%- endif -%}
                      {%- endif -%}
                      {{ block.settings.promo_title }}
                    </div>
                  {%- endif -%}
                  {%- if block.settings.status_text != blank -%}
                    <div class="nw-hero__status-badge">
                      <span class="nw-hero__status-dot"></span>
                      <div class="nw-hero__status-text">{{ block.settings.status_text }}</div>
                    </div>
                  {%- endif -%}
                </div>
                {%- if block.settings.promo_subtext != blank -%}
                  <div class="nw-hero__promo-subtext">{{ block.settings.promo_subtext }}</div>
                {%- endif -%}
                {% if block.settings.countdown_end_date != blank or block.settings.countdown_label != blank %}
                <div class="nw-hero__countdown-wrap">
                  {%- if block.settings.countdown_label != blank -%}
                    <div class="nw-hero__countdown-label">{{ block.settings.countdown_label }}</div>
                  {%- endif -%}
                  {% if block.settings.countdown_end_date != blank %}
                  <div class="nw-hero__timer-units">
                    <div class="nw-hero__timer-unit">
                      <span class="nw-hero__timer-num nw-countdown-days">00</span>
                      <span class="nw-hero__timer-txt">{{ 'nw.countdown.days' | t }}</span>
                    </div>
                    <span class="nw-hero__timer-sep">:</span>
                    <div class="nw-hero__timer-unit">
                      <span class="nw-hero__timer-num nw-countdown-hours">00</span>
                      <span class="nw-hero__timer-txt">{{ 'nw.countdown.hours' | t }}</span>
                    </div>
                    <span class="nw-hero__timer-sep">:</span>
                    <div class="nw-hero__timer-unit">
                      <span class="nw-hero__timer-num nw-countdown-mins">00</span>
                      <span class="nw-hero__timer-txt">{{ 'nw.countdown.minutes' | t }}</span>
                    </div>
                  </div>
                  {% endif %}
                </div>
                {% endif %}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>

      {%- if hero_media_type == 'video' and section.settings.enable_video_button -%}
        <div class="nw-hero__media-col">
          <button type="button" class="nw-hero__play-btn" aria-label="Play or pause video">
            {% render 'nw-icon', icon: 'play-hero' %}
            {% render 'nw-icon', icon: 'pause-hero' %}
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>
</nw-hero>

{% schema %}
{
  "name": "t:sections.nw-hero.name",
  "tag": "section",
  "class": "section-nw-hero",
  "settings": [
    {
      "type": "header",
      "content": "HEADER INTEGRATION"
    },
    {
      "type": "checkbox",
      "id": "enable_transparent_header",
      "label": "Enable Transparent Header Over Hero",
      "default": true
    },
    {
      "type": "header",
      "content": "HERO CONTENT BOX & POSITIONING"
    },
    {
      "type": "select",
      "id": "content_position_h",
      "label": "Horizontal Positioning",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "text_color",
      "label": "Text Color"
    },
    {
      "type": "header",
      "content": "REVIEWS / RATING"
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show Reviews / Rating",
      "default": true
    },
    {
      "type": "range",
      "id": "rating_stars",
      "label": "Rating Stars Count",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.show_reviews == true }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "star_color",
      "label": "Star Color",
      "default": "#E57B1E",
      "visible_if": "{{ section.settings.show_reviews == true }}"
    },
    {
      "type": "richtext",
      "id": "rating_text",
      "label": "Review Text",
      "default": "<p>4.8/5 from 21,000+ sleepers</p>",
      "visible_if": "{{ section.settings.show_reviews == true }}"
    },
    {
      "type": "header",
      "content": "HEADING"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Organic Mattress From the Inside Out."
    },
    {
      "type": "header",
      "content": "SUBHEADING"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Bio-optimized mattress engineered with pure materials for deeper recovery.</p>"
    },
    {
      "type": "header",
      "content": "BUTTON"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Label",
      "default": "SHOP MATTRESSES",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "select",
      "id": "btn_style",
      "label": "Button Style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "outline",
          "label": "Outline"
        }
      ],
      "default": "primary",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "header",
      "content": "BACKGROUND MEDIA"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Background Media Type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "header",
      "content": "IMAGE SETTINGS",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile)",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "header",
      "content": "VIDEO SETTINGS",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "enable_video_button",
      "label": "Show Play Video Button",
      "default": true,
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "Autoplay Video In Background",
      "default": true,
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "select",
      "id": "video_source",
      "label": "Video Source",
      "options": [
        {
          "value": "shopify_hosted",
          "label": "Shopify Hosted Video"
        },
        {
          "value": "url",
          "label": "YouTube / Vimeo / External URL"
        }
      ],
      "default": "shopify_hosted",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "video",
      "id": "shopify_video",
      "label": "Shopify Hosted Video",
      "visible_if": "{{ section.settings.media_type == 'video' and section.settings.video_source == 'shopify_hosted' }}"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "YouTube / Vimeo URL",
      "accept": ["youtube", "vimeo"],
      "visible_if": "{{ section.settings.media_type == 'video' and section.settings.video_source == 'url' }}"
    },
    {
      "type": "text",
      "id": "custom_video_url",
      "label": "Direct MP4 Video URL",
      "visible_if": "{{ section.settings.media_type == 'video' and section.settings.video_source == 'url' }}"
    },
    {
      "type": "header",
      "content": "OVERLAY"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "overlay_color",
      "label": "Overlay Color"
    },
    {
      "type": "header",
      "content": "SECTION BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "color",
          "label": "Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ],
      "default": "color"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color",
      "label": "Background Color",
      "default": "#613916",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "SECTION PADDING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top Padding (Desktop)",
      "default": 43
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom Padding (Desktop)",
      "default": 43
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top Padding (Mobile)",
      "default": 43
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom Padding (Mobile)",
      "default": 43
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "color",
          "alpha": true,
          "id": "icon_color",
          "label": "Icon Color",
          "default": "#CC926A"
        },
        {
          "type": "checkbox",
          "id": "use_custom_icon",
          "label": "Use Custom Icon Image",
          "default": false
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Badge Icon",
          "visible_if": "{{ block.settings.use_custom_icon == false }}",
          "options": [
            {
              "value": "moneyback",
              "label": "Moneyback / Shield"
            },
            {
              "value": "truck",
              "label": "Truck / Free Shipping"
            },
            {
              "value": "warranty",
              "label": "Warranty / Ribbon"
            },
            {
              "value": "financing",
              "label": "0% Financing"
            },
            {
              "value": "checkmark",
              "label": "Checkmark"
            },
            {
              "value": "leaf",
              "label": "Organic / Leaf"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            },
            {
              "value": "none",
              "label": "None"
            }
          ],
          "default": "moneyback"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image",
          "visible_if": "{{ block.settings.use_custom_icon == true }}"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Badge Text",
          "default": "<p>100-Night Risk-Free Trial</p>"
        }
      ]
    },
    {
      "type": "promo_countdown",
      "name": "Promo & Countdown Box",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "ICON SETTINGS"
        },
        {
          "type": "checkbox",
          "id": "show_icon",
          "label": "Show Icon",
          "default": true
        },
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon Type",
          "default": "us_flag",
          "options": [
            {
              "value": "us_flag",
              "label": "US Flag"
            },
            {
              "value": "custom",
              "label": "Custom Icon"
            },
            {
              "value": "none",
