{{ 'nw-recovery.css' | asset_url | stylesheet_tag }}

<style>
  #NwRecovery-{{ section.id }} {
    {% if section.settings.layout_width == 'page_width' %}
      padding-top: {{ section.settings.padding_top_desktop | default: 80 }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop | default: 80 }}px;
    {% endif %}
    {% if section.settings.bg_type == 'color' and section.settings.bg_color != blank %}
      background-color: {{ section.settings.bg_color }};
    {% elsif section.settings.bg_type == 'gradient' and section.settings.bg_gradient != blank %}
      background: {{ section.settings.bg_gradient }};
    {% elsif section.settings.bg_type == 'image' and section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 2880 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    #NwRecovery-{{ section.id }} {
      {% if section.settings.layout_width == 'page_width' %}
        padding-top: {{ section.settings.padding_top_mobile | default: 48 }}px;
      {% else %}
        padding-top: 0;
      {% endif %}
      padding-bottom: {{ section.settings.padding_bottom_mobile | default: 48 }}px;
      {% if section.settings.bg_type == 'image' and section.settings.bg_image_mobile != blank %}
        background-image: url('{{ section.settings.bg_image_mobile | image_url: width: 1200 }}');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
      {% endif %}
    }
  }
</style>

<section
  id="NwRecovery-{{ section.id }}"
  class="nw-recovery nw-recovery--{{ section.settings.layout_width | default: 'full_width' }}"
  style="
    --nw-recovery-heading-color: {{ section.settings.heading_color }};
    --nw-recovery-desc-color: {{ section.settings.description_color }};
    --nw-recovery-box-bg: {{ section.settings.box_bg_color }};
    --nw-recovery-box-border: {{ section.settings.box_border_color }};
    --nw-recovery-box-heading-color: {{ section.settings.box_heading_color }};
    --nw-recovery-box-desc-color: {{ section.settings.box_desc_color }};
    --nw-recovery-box-icon-color: {{ section.settings.box_icon_color }};
  "
>
  <div class="nw-recovery__inner{% if section.settings.layout_width == 'page_width' %} page-width{% endif %}">
    <div class="nw-recovery__grid{%- render 'nw-scroll-animation' -%}">
      <div class="nw-recovery__media">
        {% render 'nw-recovery-media', section: section %}
      </div>

      <div class="nw-recovery__content">
        {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
          <div class="nw-recovery__header">
            {% render 'nw-section-header',
              heading: section.settings.heading,
              description: section.settings.subheading,
              section_index: section.index
            %}
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="nw-recovery__boxes">
            {%- for block in section.blocks -%}
              <article class="nw-recovery__box" {{ block.shopify_attributes }}>
                <div class="nw-recovery__box-media">
                  {%- if block.settings.use_custom_icon and block.settings.custom_icon != blank -%}
                    {{
                      block.settings.custom_icon
                      | image_url: width: 80
                      | image_tag:
                        loading: 'lazy',
                        class: 'nw-recovery__box-icon-img',
                        widths: '40, 60, 80',
                        sizes: '40px',
                        alt: ''
                    }}
                  {%- elsif block.settings.use_custom_icon == false and block.settings.icon != blank and block.settings.icon != 'none' -%}
                    <span class="nw-recovery__box-icon" aria-hidden="true">
                      {% render 'nw-icon', icon: block.settings.icon, class: 'nw-recovery__box-icon-svg' %}
                    </span>
                  {%- endif -%}
                </div>

                <div class="nw-recovery__box-text">
                  {%- if block.settings.title != blank -%}
                    <h3 class="nw-recovery__box-title">{{ block.settings.title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.description != blank -%}
                    <p class="nw-recovery__box-desc">{{ block.settings.description }}</p>
                  {%- endif -%}
                </div>
              </article>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.nw-recovery.name",
  "tag": "section",
  "class": "section-nw-recovery",
  "settings": [
    {
      "type": "header",
      "content": "LAYOUT"
    },
    {
      "type": "select",
      "id": "layout_width",
      "label": "Section Width",
      "default": "full_width",
      "options": [
        {
          "value": "full_width",
          "label": "Full Width"
        },
        {
          "value": "page_width",
          "label": "Page Width"
        }
      ]
    },
    {
      "type": "header",
      "content": "SECTION CONTENT"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Sleep is Biological Recovery"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Description",
      "default": "<p>Quality sleep is when your body repairs, your brain resets, and tomorrow begins. Creating a cleaner sleep environment is where that recovery starts.</p>"
    },
    {
      "type": "header",
      "content": "DESKTOP MEDIA"
    },
    {
      "type": "select",
      "id": "media_type_desktop",
      "label": "Media type (Desktop)",
      "default": "image",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (Desktop)",
      "visible_if": "{{ section.settings.media_type_desktop == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (Desktop)",
      "visible_if": "{{ section.settings.media_type_desktop == 'video' }}"
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Video poster (Desktop)",
      "info": "Optional. Uses video preview when empty.",
      "visible_if": "{{ section.settings.media_type_desktop == 'video' }}"
    },
    {
      "type": "header",
      "content": "MOBILE MEDIA"
    },
    {
      "type": "select",
      "id": "media_type_mobile",
      "label": "Media type (Mobile)",
      "default": "image",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ]
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image (Mobile)",
      "info": "Optional. Uses desktop image when empty.",
      "visible_if": "{{ section.settings.media_type_mobile == 'image' }}"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Video (Mobile)",
      "info": "Optional. Uses desktop video when empty.",
      "visible_if": "{{ section.settings.media_type_mobile == 'video' }}"
    },
    {
      "type": "image_picker",
      "id": "video_poster_mobile",
      "label": "Video poster (Mobile)",
      "info": "Optional. Uses desktop poster when empty.",
      "visible_if": "{{ section.settings.media_type_mobile == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "Autoplay video",
      "default": true,
      "visible_if": "{{ section.settings.media_type_desktop == 'video' or section.settings.media_type_mobile == 'video' }}"
    },
    {
      "type": "header",
      "content": "TEXT COLORS"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "header",
      "content": "BOX COLORS"
    },
    {
      "type": "color",
      "id": "box_bg_color",
      "label": "Box Background",
      "default": "#FBF9F6",
      "alpha": true
    },
    {
      "type": "color",
      "id": "box_border_color",
      "label": "Box Border Color",
      "default": "rgba(97, 57, 22, 0.12)",
      "alpha": true
    },
    {
      "type": "color",
      "id": "box_heading_color",
      "label": "Box Heading Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "box_desc_color",
      "label": "Box Description Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "box_icon_color",
      "label": "Box Icon Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "header",
      "content": "BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "color",
          "label": "Color"
        },
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF",
      "alpha": true,
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.layout_width == 'page_width' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.layout_width == 'page_width' }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "box",
      "name": "Recovery Box",
      "settings": [
        {
          "type": "checkbox",
          "id": "use_custom_icon",
          "label": "Use Custom Icon",
          "default": false
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "leaf",
          "options": [
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "moon",
              "label": "Moon"
            },
            {
              "value": "sun",
              "label": "Sun"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "wind",
              "label": "Wind"
            },
            {
              "value": "thermometer",
              "label": "Thermometer"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            },
            {
              "value": "checkmark",
              "label": "Checkmark"
            },
            {
              "value": "none",
              "label": "None"
            }
          ],
          "visible_if": "{{ block.settings.use_custom_icon == false }}"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon",
          "visible_if": "{{ block.settings.use_custom_icon }}"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Recovery"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Deep sleep is when your body is physically restored"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.nw-recovery.name",
      "category": "NW Sections",
      "blocks": [
        {
          "type": "box",
          "settings": {
            "icon": "leaf",
            "title": "Recovery",
            "description": "Deep sleep is when your body is physically restored"
          }
        },
        {
          "type": "box",
          "settings": {
            "icon": "sparkle",
            "title": "Performance",
            "description": "Quality sleep supports focus, reaction time, and sustained energy."
          }
        },
        {
          "type": "box",
          "settings": {
            "icon": "heart",
            "title": "Longevity",
            "description": "Years of healthy sleep habits add up to years of better health."
          }
        },
        {
          "type": "box",
          "settings": {
            "icon": "leaf",
            "title": "Lower Your Toxic Load",
            "description": "Sleep on organic materials without polyurethane, fiberglass, or chemicals."
          }
        }
      ]
    }
  ]
}
{% endschema %}
