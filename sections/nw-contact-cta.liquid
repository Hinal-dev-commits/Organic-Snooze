{{ 'nw-contact-cta.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign nw_contact_cta_selector = '.nw-contact-cta.section-' | append: section.id

  assign show_note = false
  if section.settings.show_info_note and section.settings.info_note != blank
    assign show_note = true
  endif

  assign show_btn_1 = false
  if section.settings.show_button_1 and section.settings.button_1_label != blank
    assign show_btn_1 = true
  endif

  assign show_btn_2 = false
  if section.settings.show_button_2 and section.settings.button_2_label != blank
    assign show_btn_2 = true
  endif

  assign column_blocks = section.blocks | where: 'type', 'delivery_column'
-%}

<style>
  .nw-contact-cta.section-{{ section.id }} {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: {{ section.settings.padding_top_desktop | default: 64 }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop | default: 64 }}px;
    {% case section.settings.bg_type %}
      {% when 'color' %}
        {% if section.settings.bg_color != blank %}
          background-color: {{ section.settings.bg_color }};
        {% endif %}
      {% when 'gradient' %}
        {% if section.settings.bg_gradient != blank %}
          background: {{ section.settings.bg_gradient }};
        {% endif %}
      {% when 'none' %}
        background: transparent;
    {% endcase %}
  }

  {%- if section.settings.bg_type == 'image' and section.settings.bg_image != blank -%}
    .nw-contact-cta.section-{{ section.id }}::before {
      content: '';
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background-image: url('{{ section.settings.bg_image | image_url: width: 2880 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      opacity: {{ section.settings.bg_image_opacity | default: 16 | times: 0.01 }};
      z-index: 0;
      pointer-events: none;
    }
  {%- endif -%}

  .nw-contact-cta.section-{{ section.id }} > * {
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 749px) {
    .nw-contact-cta.section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile | default: 40 }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile | default: 40 }}px;
    }

    {%- if section.settings.bg_type == 'image' and section.settings.bg_image_mobile != blank -%}
      .nw-contact-cta.section-{{ section.id }}::before {
        background-image: url('{{ section.settings.bg_image_mobile | image_url: width: 1200 }}');
      }
    {%- endif -%}
  }
</style>
{% render 'nw-section-text-colors', selector: nw_contact_cta_selector %}

<div
  class="nw-contact-cta section-{{ section.id }}"
  style="
    --nw-contact-cta-panel-bg: {{ section.settings.panel_bg_color }};
    --nw-contact-cta-panel-border: {{ section.settings.panel_border_color }};
    --nw-contact-cta-header-color: {{ section.settings.panel_heading_color }};
    --nw-contact-cta-header-icon-color: {{ section.settings.panel_icon_color }};
    --nw-contact-cta-column-title-color: {{ section.settings.column_title_color }};
    --nw-contact-cta-item-color: {{ section.settings.column_item_color }};
    --nw-contact-cta-item-icon-color: {{ section.settings.column_item_icon_color }};
    --nw-contact-cta-note-bg: {{ section.settings.note_bg_color }};
    --nw-contact-cta-note-border: {{ section.settings.note_border_color }};
    --nw-contact-cta-note-color: {{ section.settings.note_text_color }};
  "
>
  <div class="page-width">
    <div class="nw-contact-cta__wrapper{%- render 'nw-scroll-animation' -%}">
      <div class="nw-contact-cta__panel">
        {%- if section.settings.heading != blank or section.settings.header_icon != 'none' -%}
          <div class="nw-contact-cta__panel-header">
            {%- if section.settings.header_icon != 'none' -%}
              <span class="nw-contact-cta__panel-icon" aria-hidden="true">
                {% render 'nw-icon', icon: section.settings.header_icon %}
              </span>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <h2 class="nw-contact-cta__panel-heading inline-richtext">
                {{ section.settings.heading }}
              </h2>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if column_blocks.size > 0 -%}
          <div class="nw-contact-cta__columns">
            {%- for block in column_blocks -%}
              {%- liquid
                assign has_list_items = false
                if block.settings.item_1_text != blank
                  assign has_list_items = true
                elsif block.settings.item_2_text != blank
                  assign has_list_items = true
                elsif block.settings.item_3_text != blank
                  assign has_list_items = true
                elsif block.settings.item_4_text != blank
                  assign has_list_items = true
                elsif block.settings.item_5_text != blank
                  assign has_list_items = true
                endif
              -%}
              <div class="nw-contact-cta__column" {{ block.shopify_attributes }}>
                {%- if block.settings.title != blank -%}
                  <h3 class="nw-contact-cta__column-title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}

                {%- if has_list_items -%}
                  <ul class="nw-contact-cta__list" role="list">
                    {% render 'nw-contact-cta-list-item',
                      text: block.settings.item_1_text,
                      icon: block.settings.item_1_icon,
                      use_custom_icon: block.settings.item_1_use_custom_icon,
                      custom_icon: block.settings.item_1_custom_icon
                    %}
                    {% render 'nw-contact-cta-list-item',
                      text: block.settings.item_2_text,
                      icon: block.settings.item_2_icon,
                      use_custom_icon: block.settings.item_2_use_custom_icon,
                      custom_icon: block.settings.item_2_custom_icon
                    %}
                    {% render 'nw-contact-cta-list-item',
                      text: block.settings.item_3_text,
                      icon: block.settings.item_3_icon,
                      use_custom_icon: block.settings.item_3_use_custom_icon,
                      custom_icon: block.settings.item_3_custom_icon
                    %}
                    {% render 'nw-contact-cta-list-item',
                      text: block.settings.item_4_text,
                      icon: block.settings.item_4_icon,
                      use_custom_icon: block.settings.item_4_use_custom_icon,
                      custom_icon: block.settings.item_4_custom_icon
                    %}
                    {% render 'nw-contact-cta-list-item',
                      text: block.settings.item_5_text,
                      icon: block.settings.item_5_icon,
                      use_custom_icon: block.settings.item_5_use_custom_icon,
                      custom_icon: block.settings.item_5_custom_icon
                    %}
                  </ul>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if show_note -%}
          <div class="nw-contact-cta__note rte">
            {{ section.settings.info_note }}
          </div>
        {%- endif -%}
      </div>

      {%- if show_btn_1 or show_btn_2 -%}
        <div class="nw-contact-cta__actions">
          {%- if show_btn_1 -%}
            {% render 'nw-button',
              text: section.settings.button_1_label,
              link: section.settings.button_1_link,
              style: section.settings.button_1_style
            %}
          {%- endif -%}
          {%- if show_btn_2 -%}
            {% render 'nw-button',
              text: section.settings.button_2_label,
              link: section.settings.button_2_link,
              style: section.settings.button_2_style
            %}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

