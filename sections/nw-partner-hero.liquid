{{ 'nw-partner-hero.css' | asset_url | stylesheet_tag }}

<style>
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    {% if section.settings.text_color != blank %}
      color: {{ section.settings.text_color }};
    {% endif %}
    {% if section.settings.bg_type == 'color' %}
      background-color: {{ section.settings.bg_color }};
    {% endif %}
    {% if section.settings.bg_type == 'gradient' %}
      background: {{ section.settings.bg_gradient }};
    {% endif %}
    {% if section.settings.bg_type == 'image' and section.settings.background_image != blank %}
      background-image: url('{{ section.settings.background_image | image_url: width: auto }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    {% endif %}
    --nw-partner-hero-body: {{ section.settings.text_color | default: '#613916' }};
    --nw-partner-hero-accent: {{ section.settings.accent_color | default: '#613916' }};
    --nw-partner-hero-highlight: #cc926a;
  }
  @media screen and (max-width: 749px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      {% if section.settings.bg_type == 'image' and section.settings.background_image_mobile != blank %}
        background-image: url('{{ section.settings.background_image_mobile | image_url: width: auto }}');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
      {% endif %}
    }
  }
</style>

<div
  class="nw-main-section nw-partner-hero-main section-{{ section.id }}"
  data-layout="{{ section.settings.layout }}"
>
  <div class="page-width">
    <div class="nw-partner-hero">
      <div class="nw-partner-hero__grid">
        <div class="nw-partner-hero__content">
          {% if section.settings.eyebrow != blank %}
            <p class="nw-partner-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h1 class="nw-partner-hero__heading">{{ section.settings.heading }}</h1>
          {% endif %}

          {% if section.settings.description != blank %}
            <div class="nw-partner-hero__description rte">{{ section.settings.description }}</div>
          {% endif %}

          {% if section.settings.show_divider %}
            <span class="nw-partner-hero__divider" aria-hidden="true"></span>
          {% endif %}

          {% if section.settings.button_label != blank or section.settings.cta_note != blank %}
            <div class="nw-partner-hero__cta-row">
              {% if section.settings.button_label != blank %}
                <a
                  class="button"
                  href="{{ section.settings.button_link | default: '#' }}"
                  {% if section.settings.button_link == blank %}aria-disabled="true"{% endif %}
                >
                  {{- section.settings.button_label | escape -}}
                </a>
              {% endif %}

              {% if section.settings.cta_note != blank %}
                <p class="nw-partner-hero__cta-note">{{ section.settings.cta_note | escape }}</p>
              {% endif %}
            </div>
          {% endif %}
        </div>

        <div class="nw-partner-hero__media">
          {% if section.settings.hero_image != blank %}
            {%- liquid
              assign hero_alt = section.settings.hero_image.alt | default: section.settings.heading | strip_html | default: shop.name
            -%}
            <div class="nw-partner-hero__figure">
              {{
                section.settings.hero_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'eager',
                  fetchpriority: 'high',
                  widths: '400, 600, 800, 1000, 1200',
                  sizes: '(max-width: 749px) 100vw, 50vw',
                  alt: hero_alt
              }}
            </div>
          {% else %}
            <div class="nw-partner-hero__placeholder">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "NW Partner Hero",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "split",
      "options": [
        {
          "value": "split",
          "label": "Split (text left, image right)"
        },
        {
          "value": "center",
          "label": "Centered"
        }
      ]
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Wholesale & Hospitality Partners"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Partner With The Future of Sleep."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Organic sleep systems backed by Gary Brecka & performance science — built for retailers and hospitality venues ready to lead the wellness category.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Book a Discovery Call →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "cta_note",
      "label": "CTA note",
      "default": "Free 20-min call · No commitment required"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "header",
      "content": "Section settings"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background type",
      "default": "color",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "color",
          "label": "Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff",
      "alpha": true,
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Background image mobile",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Eyebrow accent color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top desktop",
      "default": 80,
      "min": 0,
      "max": 120,
      "step": 4
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom desktop",
      "default": 80,
      "min": 0,
      "max": 120,
      "step": 4
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top mobile",
      "default": 48,
      "min": 0,
      "max": 100,
      "step": 4
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile",
      "default": 48,
      "min": 0,
      "max": 100,
      "step": 4
    }
  ],
  "presets": [
    {
      "name": "NW Partner Hero",
      "category": "NW Sections"
    }
  ]
}
{% endschema %}
