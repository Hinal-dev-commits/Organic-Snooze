{{ 'nw-button.css' | asset_url | stylesheet_tag }}
{{ 'nw-warranty-timeline.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-warranty-timeline.js' | asset_url }}" defer="defer"></script>

<style>
  #NwWarrantyTimeline-{{ section.id }} {
    display: block;
    position: relative;
    isolation: isolate;
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    {% case section.settings.bg_type %}
      {% when 'color' %}
        background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
      {% when 'gradient' %}
        background: {{ section.settings.bg_gradient }};
      {% when 'image' %}
        background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
      {% when 'none' %}
        background: transparent;
      {% else %}
        background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
    {% endcase %}
  }

  {%- if section.settings.bg_type == 'image' and section.settings.bg_image != blank -%}
    #NwWarrantyTimeline-{{ section.id }}::before {
      content: '';
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background-image: url('{{ section.settings.bg_image | image_url: width: 2880 }}');
      background-size: cover;
      background-position: top right;
      background-repeat: no-repeat;
      z-index: 0;
      pointer-events: none;
    }
  {%- endif -%}

  {%- if section.settings.bg_type == 'image' and section.settings.bg_color_image != blank -%}
    #NwWarrantyTimeline-{{ section.id }}::after {
      content: '';
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background-color: {{ section.settings.bg_color_image | default: '#FFFFFF29' }};
      z-index: 0;
      pointer-events: none;
    }
  {%- endif -%}

  #NwWarrantyTimeline-{{ section.id }} > * {
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 749px) {
    #NwWarrantyTimeline-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    {%- if section.settings.bg_type == 'image' and section.settings.bg_image_mobile != blank -%}
      #NwWarrantyTimeline-{{ section.id }}::before {
        background-image: url('{{ section.settings.bg_image_mobile | image_url: width: 1200 }}');
      }
    {%- endif -%}
  }
</style>

<div
  id="NwWarrantyTimeline-{{ section.id }}"
  class="nw-warranty-timeline section-{{ section.id }}{% if section.settings.image_position == 'right' %} nw-warranty-timeline--image-right{% endif %}"
  style="
    --nw-wt-heading-color: {{ section.settings.heading_color }};
    --nw-wt-description-color: {{ section.settings.description_color }};
    --nw-wt-eyebrow-color: {{ section.settings.eyebrow_color }};
    --nw-wt-timeline-heading-color: {{ section.settings.timeline_heading_color }};
    --nw-wt-step-badge-text-color: {{ section.settings.step_badge_text_color }};
    --nw-wt-step-badge-bg-color: {{ section.settings.step_badge_bg_color }};
    --nw-wt-step-title-color: {{ section.settings.step_title_color }};
    --nw-wt-step-text-color: {{ section.settings.step_text_color }};
    --nw-wt-step-dot-bg-color: {{ section.settings.step_dot_bg_color }};
    --nw-wt-step-dot-border-color: {{ section.settings.step_dot_border_color }};
    --nw-wt-step-dot-active-bg-color: {{ section.settings.step_dot_active_bg_color }};
    --nw-wt-step-dot-active-border-color: {{ section.settings.step_dot_active_border_color }};
    --nw-wt-step-line-color: {{ section.settings.step_line_color }};
    --nw-wt-step-line-fill-color: {{ section.settings.step_line_fill_color }};
    --nw-wt-video-icon-color: {{ section.settings.video_icon_color }};
    --nw-wt-button-bg-color: {{ section.settings.button_bg_color }};
    --nw-wt-button-text-color: {{ section.settings.button_text_color }}; 
  "
>
  <div class="page-width">
    <div class="nw-warranty-timeline__wrapper scroll-trigger animate--slide-in">
      {%- if section.settings.heading != blank
        or section.settings.subheading != blank
        or section.settings.eyebrow != blank
      -%}
        <div class="nw-warranty-timeline__header">
          {% render 'nw-section-header',
            show_rating: section.settings.show_rating,
            rating: section.settings.star_rating,
            eyebrow: section.settings.eyebrow,
            heading: section.settings.heading,
            description: section.settings.subheading,
            section_index: section.index
          %}
        </div>
      {%- endif -%}

      <nw-warranty-timeline
        class="nw-warranty-timeline__main"
        data-scroll-trigger="{{ section.settings.scroll_trigger_percent | default: 60 }}"
      >
        <div
          class="nw-warranty-timeline__media-col{% if section.settings.media_type == 'video' %} nw-warranty-timeline__media-col--video{% if section.settings.video_autoplay %} is-autoplay{% endif %}{% endif %}"
          {% if section.settings.media_type == 'video' and section.settings.video != blank %}
            data-nw-warranty-timeline-media
            data-autoplay="{{ section.settings.video_autoplay }}"
          {% endif %}
        >
          {%- if section.settings.media_type == 'video' and section.settings.video != blank -%}
            {%- liquid
              assign media_poster = section.settings.video_poster
              assign media_poster_mobile = section.settings.video_poster_mobile
              if media_poster == blank and section.settings.video.preview_image != blank
                assign media_poster = section.settings.video.preview_image
              endif
              if media_poster_mobile == blank and media_poster != blank
                assign media_poster_mobile = media_poster
              endif
            -%}

            {{
              section.settings.video
              | video_tag:
                autoplay: section.settings.video_autoplay,
                loop: section.settings.video_autoplay,
                muted: section.settings.video_autoplay,
                controls: false,
                playsinline: true,
                preload: 'metadata',
                tabindex: -1,
                class: 'nw-warranty-timeline__video',
                image_size: '1400x'
            }}

            {%- if media_poster != blank or media_poster_mobile != blank -%}
              {%- if media_poster != blank and media_poster_mobile != blank and media_poster != media_poster_mobile -%}
                <img
                  src="{{ media_poster | image_url: width: 1400 }}"
                  alt="{{ section.settings.heading | strip_html | escape }}"
                  class="nw-warranty-timeline__img nw-warranty-timeline__img--desktop nw-warranty-timeline__poster"
                  loading="lazy"
                  width=""
                  height=""
                >
                <img
                  src="{{ media_poster_mobile | image_url: width: 800 }}"
                  alt="{{ section.settings.heading | strip_html | escape }}"
                  class="nw-warranty-timeline__img nw-warranty-timeline__img--mobile nw-warranty-timeline__poster"
                  loading="lazy"
                  width=""
                  height=""
                >
              {%- elsif media_poster != blank -%}
                <img
                  src="{{ media_poster | image_url: width: 1400 }}"
                  alt="{{ section.settings.heading | strip_html | escape }}"
                  class="nw-warranty-timeline__img nw-warranty-timeline__poster"
                  loading="lazy"
                  width=""
                  height=""
                >
              {%- else -%}
                <img
                  src="{{ media_poster_mobile | image_url: width: 800 }}"
                  alt="{{ section.settings.heading | strip_html | escape }}"
                  class="nw-warranty-timeline__img nw-warranty-timeline__poster"
                  loading="lazy"
                  width=""
                  height=""
                >
              {%- endif -%}
            {%- endif -%}

            {%- if section.settings.show_play_icon and section.settings.video_autoplay == false -%}
              <div class="nw-warranty-timeline__video-controls">
                <button type="button" class="nw-warranty-timeline__play" data-nw-wt-play aria-label="Play video">
                  <span class="nw-warranty-timeline__control-icon" aria-hidden="true">
                    {{ 'play-v2.svg' | inline_asset_content }}
                  </span>
                </button>
                <button type="button" class="nw-warranty-timeline__pause" data-nw-wt-pause aria-label="Pause video" hidden>
                  <span class="nw-warranty-timeline__control-icon" aria-hidden="true">
                    {{ 'icon-pause.svg' | inline_asset_content }}
                  </span>
                </button>
              </div>
            {%- endif -%}
          {%- elsif section.settings.image != blank or section.settings.image_mobile != blank -%}
            {%- if section.settings.image_mobile != blank -%}
              <picture class="nw-warranty-timeline__picture">
                <source
                  media="(max-width: 749px)"
                  srcset="{{ section.settings.image_mobile | image_url: width: 800 }}"
                >
                <img
                  src="{{ section.settings.image | default: section.settings.image_mobile | image_url: width: 1400 }}"
                  alt="{{ section.settings.image.alt | default: section.settings.heading | strip_html | escape }}"
                  loading="lazy"
                  class="nw-warranty-timeline__img"
                  height=""
                  width=""
                >
              </picture>
            {%- else -%}
              <img
                src="{{ section.settings.image | image_url: width: 1400 }}"
                alt="{{ section.settings.image.alt | default: section.settings.heading | strip_html | escape }}"
                loading="lazy"
                class="nw-warranty-timeline__img"
                height=""
                width=""
              >
            {%- endif -%}
          {%- else -%}
            <div class="nw-warranty-timeline__img-placeholder">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>

        <div class="nw-warranty-timeline__content-col">
          {%- if section.settings.timeline_heading != blank -%}
            <h3 class="nw-warranty-timeline__timeline-heading">{{ section.settings.timeline_heading }}</h3>
          {%- endif -%}

          {%- if section.blocks.size > 0 -%}
            <div class="nw-warranty-timeline__steps">
              {%- for block in section.blocks -%}
                <div
                  class="nw-warranty-timeline__step"
                  {{ block.shopify_attributes }}
                  data-step-index="{{ forloop.index0 }}"
                >
                  <div class="nw-warranty-timeline__indicator" aria-hidden="true">
                    <span class="nw-warranty-timeline__dot"></span>
                    {%- unless forloop.last -%}
                      <span class="nw-warranty-timeline__line">
                        <span class="nw-warranty-timeline__line-fill"></span>
                      </span>
                    {%- endunless -%}
                  </div>

                  <div class="nw-warranty-timeline__card">
                    {%- if block.settings.step_badge != blank -%}
                      <span class="nw-warranty-timeline__badge">{{ block.settings.step_badge }}</span>
                    {%- endif -%}

                    {%- if block.settings.title != blank -%}
                      <h4 class="nw-warranty-timeline__step-title">{{ block.settings.title }}</h4>
                    {%- endif -%}

                    {%- if block.settings.text != blank -%}
                      <div class="nw-warranty-timeline__step-text">{{ block.settings.text }}</div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if section.settings.show_button and section.settings.button_text != blank -%}
            <div class="nw-warranty-timeline__btn-wrap">
              {% render 'nw-button',
                text: section.settings.button_text,
                link: section.settings.button_link,
                style: section.settings.button_style,
                btn_class: 'nw-btn'
              %}
            </div>
          {%- endif -%}
        </div>
      </nw-warranty-timeline>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "NW Warranty Timeline",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "SECTION HEADER"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating Stars In Header",
      "default": false
    },
    {
      "type": "range",
      "id": "star_rating",
      "label": "Star Rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow Text"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "What Actually Happens to Your Body When You Don't Sleep"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Description",
      "default": "<p>In this episode, Gary breaks down the real science of sleep: why you can't supplement or exercise your way around it, and how fast the damage sets in</p>"
    },
    {
      "type": "header",
      "content": "TEXT COLORS"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "description_color",
      "label": "Description Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "timeline_heading_color",
      "label": "Timeline Heading Color",
      "default": "#613916"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "step_badge_text_color",
      "label": "Step Badge Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "step_badge_bg_color",
      "label": "Step Badge Background Color",
      "default": "#4E2F14"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "step_title_color",
      "label": "Step Title Color",
      "default": "#4E2F14"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "step_text_color",
      "label": "Step Description Color",
      "default": "#4E2F14"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "step_dot_bg_color",
      "label": "Step Dot Background Color",
      "default": "transparent"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "step_dot_border_color",
      "label": "Step Dot Border Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "step_dot_active_bg_color",
      "label": "Step Dot Active Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "step_dot_active_border_color",
      "label": "Step Dot Active Border Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "step_line_color",
      "label": "Timeline Line Color",
      "default": "#FFFFFF59"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "step_line_fill_color",
      "label": "Timeline Line Fill Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "video_icon_color",
      "label": "Video Icon Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "MEDIA SETTINGS"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media Type",
      "default": "video",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ]
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "Autoplay Video",
      "default": false,
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "show_play_icon",
      "label": "Show Play/pause Controls",
      "default": true,
      "visible_if": "{{ section.settings.media_type == 'video' and section.settings.video_autoplay == false }}"
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Video Poster (Desktop)",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "image_picker",
      "id": "video_poster_mobile",
      "label": "Video Poster (Mobile Optional)",
      "info": "Uses desktop poster when empty.",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (Desktop)",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image (Mobile Optional)",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop Image Position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "TIMELINE SETTINGS"
    },
    {
      "type": "inline_richtext",
      "id": "timeline_heading",
      "label": "Timeline Subheading"
    },
    {
      "type": "range",
      "id": "scroll_trigger_percent",
      "label": "Scroll Trigger Position",
      "min": 30,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 60,
      "info": "Viewport height percentage where timeline dots activate while scrolling."
    },
    {
      "type": "header",
      "content": "BUTTON"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "Listen to the Full Episode",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "default": "primary",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ],
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#A96B3E",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "header",
      "content": "BACKGROUND SETTINGS"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "image",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "image", "label": "Image" },
        { "value": "gradient", "label": "Gradient" }
      ]
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile Optional)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color_image",
      "label": "Overlay Color",
      "default": "#FFFFFF29",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Timeline Step",
      "settings": [
        {
          "type": "text",
          "id": "step_badge",
          "label": "Step Badge",
          "default": "KEY POINT 1"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Step Title (Optional)"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Step Description",
          "default": "<p>The research on how one week of short sleep changes your metabolism, and how chronic short sleep affects long-term brain health.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NW Warranty Timeline",
      "category": "NW Sections",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_badge": "KEY POINT 1",
            "text": "<p>The research on how one week of short sleep changes your metabolism, and how chronic short sleep affects long-term brain health.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "step_badge": "KEY POINT 2",
            "text": "<p>The 10-3-2-1-0 rule for winding down: no caffeine 10 hours before bed, no food or alcohol at 3, no work at 2, no screens at 1, and zero snoozes in the morning.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "step_badge": "KEY POINT 3",
            "text": "<p>Why your sleep environment, from light to temperature to what your mattress is made of, decides how much recovery you actually get.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
