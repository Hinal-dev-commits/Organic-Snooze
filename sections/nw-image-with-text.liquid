      "label": "Description color",
      "alpha": true,
      "default": "#613916"
    },
    {
      "type": "color",
      "id": "feature_text_color",
      "label": "Feature text color",
      "alpha": true,
      "default": "#613916"
    },
    {
      "type": "color",
      "id": "feature_plus_color",
      "label": "Feature plus color",
      "alpha": true,
      "default": "#613916"
    },
    {
      "type": "header",
      "content": "CTA button"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "default": true
