{{ 'nw-image-with-text.css' | asset_url | stylesheet_tag }}

{%- assign nw_shell_selector = '#NwImageWithText-' | append: section.id -%}
{% render 'nw-section-shell', selector: nw_shell_selector, mode: 'direct' %}

<section
  id="NwImageWithText-{{ section.id }}"
  class="nw-image-with-text"
  style="
    --nw-iwt-heading-color: {{ section.settings.heading_color }};
    --nw-iwt-desc-color: {{ section.settings.description_color }};
    --nw-iwt-feature-color: {{ section.settings.feature_text_color }};
    --nw-iwt-promo-bg: {{ section.settings.promo_bg_color }};
    --nw-iwt-promo-text: {{ section.settings.promo_text_color }};
    --nw-cta-badge-text: {{ section.settings.badge_text_color }};
    --nw-cta-badge-icon: {{ section.settings.badge_icon_color }};
  "
>
  <div class="page-width">
    <div class="nw-image-with-text__grid nw-image-with-text__grid--{% if section.settings.image_position == 'right' %}image-right{% else %}image-left{% endif %}{%- render 'nw-scroll-animation' -%}">
      <div class="nw-image-with-text__media-wrap">
        {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
          <div class="nw-image-with-text__header mobile-only">
            {% render 'nw-section-header',
              heading: section.settings.heading,
              description: section.settings.subheading,
              tag: 'h2'
            %}
          </div>
        {%- endif -%}
        <div class="nw-image-with-text__media">
          {%- if section.settings.image != blank and section.settings.image_mobile != blank -%}
            {{
              section.settings.image_mobile
              | image_url: width: 750
              | image_tag:
                loading: 'lazy',
                class: 'nw-image-with-text__image nw-image-with-text__image--mobile',
                widths: '375, 550, 750',
                sizes: '100vw',
                alt: section.settings.image_mobile.alt | default: section.settings.heading
            }}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                class: 'nw-image-with-text__image nw-image-with-text__image--desktop',
                widths: '375, 550, 750, 900, 1200',
                sizes: '(min-width: 750px) 50vw, 100vw',
                alt: section.settings.image.alt | default: section.settings.heading
            }}
          {%- elsif section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                class: 'nw-image-with-text__image',
                widths: '375, 550, 750, 900, 1200',
                sizes: '(min-width: 750px) 50vw, 100vw',
                alt: section.settings.image.alt | default: section.settings.heading
            }}
          {%- elsif section.settings.image_mobile != blank -%}
            {{
              section.settings.image_mobile
              | image_url: width: 750
              | image_tag:
                loading: 'lazy',
                class: 'nw-image-with-text__image',
                widths: '375, 550, 750',
                sizes: '100vw',
                alt: section.settings.image_mobile.alt | default: section.settings.heading
            }}
          {%- else -%}
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'nw-image-with-text__placeholder placeholder-svg' }}
          {%- endif -%}
        </div>

        {%- if section.settings.show_promo_bar and section.settings.promo_text != blank -%}
          <div class="nw-image-with-text__promo">
            {%- if section.settings.promo_icon != blank -%}
              <span class="nw-image-with-text__promo-icon">
                {{ section.settings.promo_icon | image_url: width: 40 | image_tag: loading: 'lazy', alt: '' }}
              </span>
            {%- endif -%}
            <span class="nw-image-with-text__promo-text">{{ section.settings.promo_text }}</span>
          </div>
        {%- endif -%}
      </div>

      <div class="nw-image-with-text__side">
        <div class="nw-image-with-text__content">
          {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
            <div class="nw-image-with-text__header">
              {% render 'nw-section-header',
                heading: section.settings.heading,
                description: section.settings.subheading,
                section_index: section.index
              %}
            </div>
          {%- endif -%}

          {%- if section.settings.features != blank -%}
            <div class="nw-image-with-text__features-wrap rte">
              {{ section.settings.features }}
            </div>
          {%- endif -%}
        </div>
        {%- assign trust_badge_blocks = section.blocks | where: 'type', 'trust_badge' -%}
        {% render 'nw-cta-badges', settings: section.settings, blocks: trust_badge_blocks, class: 'nw-image-with-text__cta' %}


      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.nw-image-with-text.name",
  "tag": "section",
  "class": "section-nw-image-with-text",
  "settings": [
    {
      "type": "header",
      "content": "IMAGE"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (Desktop)",
      "info": "Shows a default placeholder when empty."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image (Mobile)",
      "info": "Optional. Uses the desktop image when empty."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position (Desktop)",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "PROMO BAR"
    },
    {
      "type": "checkbox",
      "id": "show_promo_bar",
      "label": "Show Promo Bar",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "promo_icon",
      "label": "Promo Icon"
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Promo Text",
      "default": "BUNDLE & SAVE 30%+"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "promo_bg_color",
      "label": "Promo Bar Background",
      "default": "#878735"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "promo_text_color",
      "label": "Promo Bar Text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "CONTENT"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Bundle & Save On Your Recovery System"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Description",
      "default": "<p>Bundle your mattress, adjustable base, and organic bedding essentials to save 30% or more on the complete setup.</p>"
    },
    {
      "type": "richtext",
      "id": "features",
      "label": "Features List",
      "default": "<ul><li>+ Organic Mattress</li><li>+ Adjustable Base</li><li>+ Organic Sheet Set</li><li>+ Organic Pillow Cases</li><li>+ Pillows</li><li>+ Mattress Protector</li></ul>"
    },
    {
      "type": "header",
      "content": "TEXT COLORS"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#613916"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "description_color",
      "label": "Description Color",
      "default": "#613916"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "feature_text_color",
      "label": "Feature Text Color",
      "default": "#613916"
    },
    {
      "type": "header",
      "content": "CTA BUTTON"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Bundle and save",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "default": "secondary",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ],
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "header",
      "content": "BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "image", "label": "Image" },
        { "value": "gradient", "label": "Gradient" }
      ]
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFCF0",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Free Shipping" },
            { "value": "warranty", "label": "Warranty" },
            { "value": "moneyback", "label": "Moneyback" },
            { "value": "financing", "label": "Financing" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "moon", "label": "Moon" },
            { "value": "star", "label": "Star" },
            { "value": "shield", "label": "Shield" },
            { "value": "verified", "label": "Verified" },
            { "value": "custom", "label": "Custom Image" },
            { "value": "none", "label": "None" }
          ],
          "default": "none"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image",
          "visible_if": "{{ block.settings.icon == 'custom' }}"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Badge Text",
          "default": "Free Shipping & Installation"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.nw-image-with-text.name",
      "category": "NW Sections",
      "blocks": [
        { "type": "trust_badge", "settings": { "icon": "none", "text": "Free Shipping & Installation" } },
        { "type": "trust_badge", "settings": { "icon": "none", "text": "30-Year Warranty" } },
        { "type": "trust_badge", "settings": { "icon": "moneyback", "text": "100-Night Risk-Free Trial" } },
        { "type": "trust_badge", "settings": { "icon": "financing", "text": "0% Interest Financing Options" } }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["index"]
  }
}
{% endschema %}
