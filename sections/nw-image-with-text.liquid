{{ 'nw-image-with-text.css' | asset_url | stylesheet_tag }}

<style>
  #NwImageWithText-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_desktop | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop | default: 80 }}px;
    {% if section.settings.bg_type == 'color' and section.settings.bg_color != blank %}
      background-color: {{ section.settings.bg_color }};
    {% elsif section.settings.bg_type == 'gradient' and section.settings.bg_gradient != blank %}
      background: {{ section.settings.bg_gradient }};
    {% elsif section.settings.bg_type == 'image' and section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 2880 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    #NwImageWithText-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile | default: 48 }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile | default: 48 }}px;
      {% if section.settings.bg_type == 'image' and section.settings.bg_image_mobile != blank %}
        background-image: url('{{ section.settings.bg_image_mobile | image_url: width: 1200 }}');
      {% endif %}
    }
  }
</style>

<section
  id="NwImageWithText-{{ section.id }}"
  class="nw-image-with-text"
  style="
    --nw-iwt-heading-color: {{ section.settings.heading_color }};
    --nw-iwt-desc-color: {{ section.settings.description_color }};
    --nw-iwt-feature-color: {{ section.settings.feature_text_color }};
    --nw-iwt-feature-plus-color: {{ section.settings.feature_plus_color }};
    --nw-iwt-promo-bg: {{ section.settings.promo_bg_color }};
    --nw-iwt-promo-text: {{ section.settings.promo_text_color }};
    --nw-iwt-media-bg: {{ section.settings.media_bg_color }};
    --nw-cta-badge-text: {{ section.settings.badge_text_color }};
    --nw-cta-badge-icon: {{ section.settings.badge_icon_color }};
  "
>
  <div class="page-width">
    <div class="nw-image-with-text__grid nw-image-with-text__grid--{% if section.settings.image_position == 'right' %}image-right{% else %}image-left{% endif %}{%- render 'nw-scroll-animation' -%}">
      <div class="nw-image-with-text__media-wrap">
        {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
          <div class="nw-image-with-text__header mobile-only">
            {% render 'nw-section-heading', text: section.settings.heading, tag: 'h2' %}
            {% render 'nw-section-description', text: section.settings.subheading %}
          </div>
        {%- endif -%}
        <div class="nw-image-with-text__media">
          {%- if section.settings.image != blank and section.settings.image_mobile != blank -%}
            {{
              section.settings.image_mobile
              | image_url: width: 750
              | image_tag:
                loading: 'lazy',
                class: 'nw-image-with-text__image nw-image-with-text__image--mobile',
                widths: '375, 550, 750',
                sizes: '100vw',
                alt: section.settings.image_mobile.alt | default: section.settings.heading
            }}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                class: 'nw-image-with-text__image nw-image-with-text__image--desktop',
                widths: '375, 550, 750, 900, 1200',
                sizes: '(min-width: 750px) 50vw, 100vw',
                alt: section.settings.image.alt | default: section.settings.heading
            }}
          {%- elsif section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                class: 'nw-image-with-text__image',
                widths: '375, 550, 750, 900, 1200',
                sizes: '(min-width: 750px) 50vw, 100vw',
                alt: section.settings.image.alt | default: section.settings.heading
            }}
          {%- elsif section.settings.image_mobile != blank -%}
            {{
              section.settings.image_mobile
              | image_url: width: 750
              | image_tag:
                loading: 'lazy',
                class: 'nw-image-with-text__image',
                widths: '375, 550, 750',
                sizes: '100vw',
                alt: section.settings.image_mobile.alt | default: section.settings.heading
            }}
          {%- else -%}
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'nw-image-with-text__placeholder placeholder-svg' }}
          {%- endif -%}
        </div>

        {%- if section.settings.show_promo_bar and section.settings.promo_text != blank -%}
          <div class="nw-image-with-text__promo">
            {%- if section.settings.promo_icon != blank -%}
              <span class="nw-image-with-text__promo-icon">
                {{ section.settings.promo_icon | image_url: width: 40 | image_tag: loading: 'lazy', alt: '' }}
              </span>
            {%- endif -%}
            <span class="nw-image-with-text__promo-text">{{ section.settings.promo_text }}</span>
          </div>
        {%- endif -%}
      </div>

      <div class="nw-image-with-text__side">
        <div class="nw-image-with-text__content">
          {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
            <div class="nw-image-with-text__header">
              {% render 'nw-section-heading', text: section.settings.heading, section_index: section.index %}
              {% render 'nw-section-description', text: section.settings.subheading %}
            </div>
          {%- endif -%}

          {%- if section.blocks.size > 0 -%}
            <ul class="nw-image-with-text__features" role="list">
              {%- for block in section.blocks -%}
                {%- if block.type == 'feature' and block.settings.text != blank -%}
                  <li class="nw-image-with-text__feature" {{ block.shopify_attributes }}>
                    <span>{{ block.settings.text }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>

        {% render 'nw-cta-badges', settings: section.settings, class: 'nw-image-with-text__cta' %}


      </div>
    </div>
  </div>
</section>

{% schema %}
{
