    },
    {
      "type": "color",
      "alpha": true,
      "id": "feature_text_color",
      "label": "Feature Text Color",
      "default": "#613916"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "feature_plus_color",
      "label": "Feature Plus Color",
      "default": "#613916"
    },
    {
      "type": "header",
      "content": "CTA BUTTON"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": true
