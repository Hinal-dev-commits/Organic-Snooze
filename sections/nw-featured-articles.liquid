{{ 'nw-button.css' | asset_url | stylesheet_tag }}
{{ 'nw-cta-badges.css' | asset_url | stylesheet_tag }}
{{ 'nw-featured-articles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-featured-articles.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign nw_shell_selector = '#NwFeaturedArticles-' | append: section.id
  assign article_source = section.settings.article_source | default: 'blog'
  assign selected_blog = section.settings.blog
  assign selected_articles = section.settings.article
  assign selected_articles_count = section.settings.article.count | default: 0
  assign post_limit = section.settings.post_limit | default: 6
  assign slides_desktop = section.settings.slides_desktop | default: 3
  if post_limit < 1
    assign post_limit = 1
  endif
  if slides_desktop < 1
    assign slides_desktop = 1
  endif
  assign pagination_id = 'NwFeaturedArticlesPagination-' | append: section.id
  assign has_articles = false
  if article_source == 'article_list' and selected_articles != blank
    assign has_articles = true
  elsif article_source == 'blog' and selected_blog != blank and selected_blog.articles_count > 0
    assign has_articles = true
  endif
  assign placeholder_count = post_limit
  if article_source == 'article_list'
    if selected_articles_count > 0
      assign placeholder_count = selected_articles_count
    else
      assign placeholder_count = 3
    endif
  endif
-%}

{% render 'nw-section-shell', selector: nw_shell_selector, mode: 'direct', default_bg: '#FFFFFF' %}
{% render 'nw-section-text-colors', selector: nw_shell_selector %}

<nw-featured-articles
  id="NwFeaturedArticles-{{ section.id }}"
  class="nw-featured-articles section-{{ section.id }}"
  data-show-arrows="{{ section.settings.show_arrows }}"
  data-show-pagination="{{ section.settings.show_pagination }}"
  data-pagination-id="{{ pagination_id }}"
  data-enable-autoplay="{{ section.settings.enable_autoplay }}"
  data-autoplay-delay="{{ section.settings.autoplay_delay | default: 4 | times: 1000 }}"
  data-slides-desktop="{{ slides_desktop }}"
  style="
    --nw-fa-heading-color: {{ section.settings.heading_color }};
    --nw-fa-header-desc-color: {{ section.settings.description_color }};
    --nw-star-active: {{ section.settings.star_color }};
    --nw-star-inactive: {{ section.settings.star_inactive_color }};
    --nw-cta-badge-text: {{ section.settings.badge_text_color }};
    --nw-cta-badge-icon: {{ section.settings.badge_icon_color }};
    --nw-fa-tag-color: {{ section.settings.tag_color }};
    --nw-fa-title-color: {{ section.settings.title_color }};
    --nw-fa-excerpt-color: {{ section.settings.excerpt_color }};
    --nw-fa-meta-color: {{ section.settings.meta_color }};
    --nw-fa-card-bg: {{ section.settings.card_bg_color }};
    --nw-fa-card-border: {{ section.settings.card_border_color }};
    --nw-fa-media-bg: {{ section.settings.media_bg_color }};
    --nw-fa-badge-bg: {{ section.settings.badge_bg_color }};
    --nw-fa-badge-text: {{ section.settings.editor_badge_text_color }};
    --nw-fa-btn-bg: {{ section.settings.button_bg_color }};
    --nw-fa-btn-text: {{ section.settings.button_text_color }};
    --nw-swiper-bullet: {{ section.settings.pagination_color }};
    --nw-swiper-arrow-bg: {{ section.settings.swiper_arrow_bg }};
    --nw-swiper-arrow-color: {{ section.settings.swiper_arrow_color }};
  "
>
  <div class="page-width">
    <div class="nw-featured-articles__wrapper{%- render 'nw-scroll-animation' -%}">
      {%- if section.settings.show_rating
        or section.settings.eyebrow != blank
        or section.settings.heading != blank
        or section.settings.description != blank
      -%}
        <div class="nw-featured-articles__header">
          {% render 'nw-section-header',
            show_rating: section.settings.show_rating,
            rating: section.settings.star_rating,
            eyebrow: section.settings.eyebrow,
            heading: section.settings.heading,
            description: section.settings.description,
            section_index: section.index,
            heading_class: 'nw-featured-articles__heading'
          %}
        </div>
      {%- endif -%}

      <div class="nw-featured-articles__slider-wrap">
        {%- if section.settings.show_arrows -%}
          {% render 'nw-swiper-arrows', arrow_style: section.settings.arrow_style %}
        {%- endif -%}

        <div class="swiper nw-featured-articles__swiper" id="NwFeaturedArticlesSwiper-{{ section.id }}">
          <div class="swiper-wrapper">
            {%- if has_articles -%}
              {%- if article_source == 'article_list' -%}
                {%- for item in selected_articles -%}
                  {%- liquid
                    assign featured_article = item
                    if featured_article == blank or featured_article.title == blank
                      assign article_path = item | strip
                      if article_path contains '/'
                        assign article_path_parts = article_path | split: '/'
                        assign article_blog_handle = article_path_parts.first
                        assign article_handle = article_path_parts.last
                        if article_blog_handle != blank and article_handle != blank and blogs[article_blog_handle] != blank
                          assign featured_article = blogs[article_blog_handle].articles[article_handle]
                        endif
                      else
                        assign featured_article = articles[article_path]
                      endif
                    endif
                  -%}
                  {%- if featured_article != blank -%}
                    <div class="swiper-slide">
                      {% render 'nw-featured-articles-card', article: featured_article, section: section %}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                {%- for article in selected_blog.articles limit: post_limit -%}
                  <div class="swiper-slide">
                    {% render 'nw-featured-articles-card', article: article, section: section %}
                  </div>
                {%- endfor -%}
              {%- endif -%}
            {%- else -%}
              {%- for i in (1..placeholder_count) -%}
                {%- assign placeholder_image_index = forloop.index0 | modulo: 3 | plus: 1 -%}
                <div class="swiper-slide">
                  <article class="nw-featured-articles__card">
                    <div class="nw-featured-articles__media">
                      {{ 'blog-apparel-' | append: placeholder_image_index | placeholder_svg_tag: 'nw-featured-articles__placeholder' }}
                      {%- if i == 1 -%}
                        <span class="nw-featured-articles__badge">
                          <span class="nw-featured-articles__badge-icon" aria-hidden="true">
                            {% render 'nw-icon', icon: 'star' %}
                          </span>
                          <span class="nw-featured-articles__badge-text">{{ section.settings.editor_pick_label | default: "Editor's Pick" }}</span>
                        </span>
                      {%- endif -%}
                    </div>
                    <div class="nw-featured-articles__body">
                      <div class="nw-featured-articles__copy">
                        <p class="nw-featured-articles__tag">{{ 'sections.featured_blog.onboarding_title' | t | upcase }}</p>
                        <h3 class="nw-featured-articles__title">{{ 'sections.featured_blog.onboarding_title' | t }}</h3>
                        <p class="nw-featured-articles__excerpt">{{ 'sections.featured_blog.onboarding_content' | t }}</p>
                      </div>
                      <div class="nw-featured-articles__meta">
                        <span class="nw-featured-articles__author">{{ shop.name }}</span>
                        <span class="nw-featured-articles__meta-dot" aria-hidden="true">&bull;</span>
                        <span class="nw-featured-articles__read-time">8 min read</span>
                      </div>
                      <span class="nw-featured-articles__btn">
                        <span class="nw-featured-articles__btn-text">{{ section.settings.card_button_text | default: 'Read the article' }}</span>
                        <span class="nw-featured-articles__btn-icon" aria-hidden="true">
                          {% render 'nw-icon', icon: 'arrow-right' %}
                        </span>
                      </span>
                    </div>
                  </article>
                </div>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>

        {%- if section.settings.show_pagination -%}
          {% render 'nw-swiper-pagination', id: pagination_id, class: 'nw-featured-articles__pagination' %}
        {%- endif -%}
      </div>

      {%- if section.settings.show_button -%}
        <div class="nw-featured-articles__footer">
          {% render 'nw-cta-badges',
            settings: section.settings,
            class: 'nw-featured-articles__cta'
          %}
        </div>
      {%- endif -%}
    </div>
  </div>
</nw-featured-articles>

