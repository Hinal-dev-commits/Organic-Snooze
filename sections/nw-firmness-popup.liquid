{{ 'nw-firmness-popup.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-firmness-popup.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign modal_link_id = section.settings.modal_link_id | default: 'firmness-guide' | strip
  assign modal_id = 'NwFirmnessPopupModal-' | append: modal_link_id
  assign quiz_url = section.settings.quiz_url
-%}

<modal-dialog
  id="{{ modal_id }}"
  class="product-popup-modal nw-firmness-popup"
  data-nw-firmness-popup
  {{ section.shopify_attributes }}
>
  <div
    role="dialog"
    aria-label="{{ section.settings.heading | default: 'Firmness Guide' | escape }}"
    aria-modal="true"
    class="product-popup-modal__content nw-firmness-popup__dialog"
    tabindex="-1"
  >
    <div class="nw-firmness-popup__inner">
      <header class="nw-firmness-popup__header">
        <div class="nw-firmness-popup__title-group">
          {%- if section.settings.heading != blank -%}
            <h2 class="nw-firmness-popup__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="nw-firmness-popup__subheading">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
        <button
          id="ModalClose-{{ section.id }}"
          type="button"
          class="product-popup-modal__toggle nw-firmness-popup__close"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {% render 'nw-icon', icon: 'close' %}
        </button>
      </header>

      <div class="nw-firmness-popup__body">
        <div class="nw-firmness-popup__levels-col">
          <div class="nw-firmness-popup__levels" aria-hidden="true">
            <div class="nw-firmness-popup__level">
              <div class="nw-firmness-popup__level-art">
                {%- if section.settings.soft_illustration != blank -%}
                  {{
                    section.settings.soft_illustration
                    | image_url: width: 220
                    | image_tag: class: 'nw-firmness-popup__level-img', loading: 'lazy', alt: ''
                  }}
                {%- else -%}
                  <img
                    class="nw-firmness-popup__level-img"
                    src="{{ 'nw-firmness-popup-soft.svg' | asset_url }}"
                    alt=""
                    width="108"
                    height="58"
                    loading="lazy"
                  >
                {%- endif -%}
              </div>
              <p class="nw-firmness-popup__level-name">{{ section.settings.soft_label | default: 'Soft' | escape }}</p>
            </div>
            <div class="nw-firmness-popup__level">
              <div class="nw-firmness-popup__level-art">
                {%- if section.settings.medium_illustration != blank -%}
                  {{
                    section.settings.medium_illustration
                    | image_url: width: 220
                    | image_tag: class: 'nw-firmness-popup__level-img', loading: 'lazy', alt: ''
                  }}
                {%- else -%}
                  <img
                    class="nw-firmness-popup__level-img"
                    src="{{ 'nw-firmness-popup-medium.svg' | asset_url }}"
                    alt=""
                    width="108"
                    height="58"
                    loading="lazy"
                  >
                {%- endif -%}
              </div>
              <p class="nw-firmness-popup__level-name">{{ section.settings.medium_label | default: 'Medium' | escape }}</p>
            </div>
            <div class="nw-firmness-popup__level">
              <div class="nw-firmness-popup__level-art">
                {%- if section.settings.firm_illustration != blank -%}
                  {{
                    section.settings.firm_illustration
                    | image_url: width: 220
                    | image_tag: class: 'nw-firmness-popup__level-img', loading: 'lazy', alt: ''
                  }}
                {%- else -%}
                  <img
                    class="nw-firmness-popup__level-img"
                    src="{{ 'nw-firmness-popup-firm.svg' | asset_url }}"
                    alt=""
                    width="108"
                    height="58"
                    loading="lazy"
                  >
                {%- endif -%}
              </div>
              <p class="nw-firmness-popup__level-name">{{ section.settings.firm_label | default: 'Firm' | escape }}</p>
            </div>
          </div>

          <div class="nw-firmness-popup__scale">
            <div class="nw-firmness-popup__scale-bar" aria-hidden="true">
              <span class="nw-firmness-popup__scale-segment nw-firmness-popup__scale-segment--1"></span>
              <span class="nw-firmness-popup__scale-segment nw-firmness-popup__scale-segment--2"></span>
              <span class="nw-firmness-popup__scale-segment nw-firmness-popup__scale-segment--3"></span>
              <span class="nw-firmness-popup__scale-segment nw-firmness-popup__scale-segment--4"></span>
              <span class="nw-firmness-popup__scale-segment nw-firmness-popup__scale-segment--5"></span>
              <span class="nw-firmness-popup__scale-segment nw-firmness-popup__scale-segment--6"></span>
              <span class="nw-firmness-popup__scale-segment nw-firmness-popup__scale-segment--7"></span>
              <span class="nw-firmness-popup__scale-segment nw-firmness-popup__scale-segment--8"></span>
              <span class="nw-firmness-popup__scale-segment nw-firmness-popup__scale-segment--9"></span>
              <span class="nw-firmness-popup__scale-segment nw-firmness-popup__scale-segment--10"></span>
            </div>
            <div class="nw-firmness-popup__scale-labels">
              <span>{{ section.settings.scale_label_left | default: 'More Contour' | escape }}</span>
              <span>{{ section.settings.scale_label_right | default: 'More Support' | escape }}</span>
            </div>
          </div>
        </div>

        <div class="nw-firmness-popup__divider nw-firmness-popup__divider--vertical" aria-hidden="true"></div>
        <div class="nw-firmness-popup__divider nw-firmness-popup__divider--horizontal" aria-hidden="true"></div>

        <div class="nw-firmness-popup__recommend-col">
          <h3 class="nw-firmness-popup__recommend-heading">
            {{ section.settings.recommend_heading | default: 'Which One Is Right for You?' | escape }}
          </h3>
          <p class="nw-firmness-popup__recommend-hint">
            <span class="nw-firmness-popup__recommend-hint-desktop">
              {{- section.settings.recommend_hint_desktop | default: 'Click each one to learn more.' | escape -}}
            </span>
            <span class="nw-firmness-popup__recommend-hint-mobile">
              {{- section.settings.recommend_hint_mobile | default: 'Tap each one to learn more.' | escape -}}
            </span>
          </p>

          <div class="nw-firmness-popup__accordions" data-firmness-accordions>
            {%- assign accordion_items = 'soft,medium,firm' | split: ',' -%}
            {%- for item in accordion_items -%}
              {%- liquid
                assign title_key = item | append: '_title'
                assign hint_key = item | append: '_hint'
                assign body_key = item | append: '_body'
                assign title = section.settings[title_key]
                assign hint = section.settings[hint_key]
                assign body = section.settings[body_key]
              -%}
              <div class="nw-firmness-popup__accordion" data-firmness-accordion>
                <button
                  type="button"
                  class="nw-firmness-popup__accordion-trigger"
                  aria-expanded="false"
                  data-firmness-accordion-trigger
                >
                  <span class="nw-firmness-popup__accordion-label">
                    <span class="nw-firmness-popup__accordion-title">{{ title | escape }}</span>
                    <span class="nw-firmness-popup__accordion-hint">{{ hint | escape }}</span>
                  </span>
                  <span class="nw-firmness-popup__accordion-chevron" aria-hidden="true">
                    <img
                      class="nw-firmness-popup__chevron nw-firmness-popup__chevron--down"
                      src="{{ 'nw-firmness-popup-chevron-down.svg' | asset_url }}"
                      alt=""
                      width="16"
                      height="16"
                    >
                    <img
                      class="nw-firmness-popup__chevron nw-firmness-popup__chevron--up"
                      src="{{ 'nw-firmness-popup-chevron-up.svg' | asset_url }}"
                      alt=""
                      width="16"
                      height="16"
                    >
                  </span>
                </button>
                <div class="nw-firmness-popup__accordion-panel" hidden data-firmness-accordion-panel>
                  <div class="nw-firmness-popup__accordion-divider" aria-hidden="true"></div>
                  <div class="nw-firmness-popup__accordion-body rte">{{ body }}</div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>

      <footer class="nw-firmness-popup__footer">
        {%- if quiz_url != blank -%}
          <a href="{{ quiz_url }}" class="nw-firmness-popup__quiz-btn">
            <span>{{ section.settings.quiz_label | default: 'Take the Quiz' | escape }}</span>
            <img
              class="nw-firmness-popup__quiz-arrow"
              src="{{ 'nw-firmness-popup-arrow.svg' | asset_url }}"
              alt=""
              width="18"
              height="18"
            >
          </a>
        {%- else -%}
          <span class="nw-firmness-popup__quiz-btn nw-firmness-popup__quiz-btn--disabled" aria-disabled="true">
            <span>{{ section.settings.quiz_label | default: 'Take the Quiz' | escape }}</span>
            <img
              class="nw-firmness-popup__quiz-arrow"
              src="{{ 'nw-firmness-popup-arrow.svg' | asset_url }}"
              alt=""
              width="18"
              height="18"
            >
          </span>
        {%- endif -%}
        {%- if section.settings.quiz_subtext != blank -%}
          <p class="nw-firmness-popup__quiz-subtext">{{ section.settings.quiz_subtext | escape }}</p>
        {%- endif -%}
      </footer>
    </div>
  </div>
</modal-dialog>

{% schema %}
{
  "name": "NW Firmness Popup",
  "tag": "section",
  "class": "section-nw-firmness-popup",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "modal_link_id",
      "label": "Popup link ID",
      "default": "firmness-guide",
      "info": "Used to build the modal ID (NwFirmnessPopupModal-{id}). Match this in the Variant picker Firmness Popup ID setting."
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Firmness Guide"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find out how soft or firm your mattress should feel."
    },
    {
      "type": "header",
      "content": "Firmness levels"
    },
    {
      "type": "text",
      "id": "soft_label",
      "label": "Soft label",
      "default": "Soft"
    },
    {
      "type": "text",
      "id": "medium_label",
      "label": "Medium label",
      "default": "Medium"
    },
    {
      "type": "text",
      "id": "firm_label",
      "label": "Firm label",
      "default": "Firm"
    },
    {
      "type": "image_picker",
      "id": "soft_illustration",
      "label": "Soft illustration (optional)"
    },
    {
      "type": "image_picker",
      "id": "medium_illustration",
      "label": "Medium illustration (optional)"
    },
    {
      "type": "image_picker",
      "id": "firm_illustration",
      "label": "Firm illustration (optional)"
    },
    {
      "type": "text",
      "id": "scale_label_left",
      "label": "Scale label (left)",
      "default": "More Contour"
    },
    {
      "type": "text",
      "id": "scale_label_right",
      "label": "Scale label (right)",
      "default": "More Support"
    },
    {
      "type": "header",
      "content": "Recommendations — Soft"
    },
    {
      "type": "text",
      "id": "soft_title",
      "label": "Title",
      "default": "Soft"
    },
    {
      "type": "text",
      "id": "soft_hint",
      "label": "Hint",
      "default": "Best for side sleepers"
    },
    {
      "type": "richtext",
      "id": "soft_body",
      "label": "Expanded body",
      "default": "<p>Great for side sleepers. Your shoulders and hips sink in a little, so they don't get sore. Also good for smaller or lighter sleepers.</p>"
    },
    {
      "type": "header",
      "content": "Recommendations — Medium"
    },
    {
      "type": "text",
      "id": "medium_title",
      "label": "Title",
      "default": "Medium"
    },
    {
      "type": "text",
      "id": "medium_hint",
      "label": "Hint",
      "default": "Best for most people"
    },
    {
      "type": "richtext",
      "id": "medium_body",
      "label": "Expanded body",
      "default": "<p>The best pick for most people. It feels cozy on top but still holds you up. Great for couples. Switch sides at night? Medium works well in every position.</p>"
    },
    {
      "type": "header",
      "content": "Recommendations — Firm"
    },
    {
      "type": "text",
      "id": "firm_title",
      "label": "Title",
      "default": "Firm"
    },
    {
      "type": "text",
      "id": "firm_hint",
      "label": "Hint",
      "default": "Best for back & stomach"
    },
    {
      "type": "richtext",
      "id": "firm_body",
      "label": "Expanded body",
      "default": "<p>Great for back and stomach sleepers. It keeps your body flat and straight, so your hips don't sag. Also good for bigger or heavier sleepers.</p>"
    },
    {
      "type": "header",
      "content": "Recommendations section"
    },
    {
      "type": "text",
      "id": "recommend_heading",
      "label": "Heading",
      "default": "Which One Is Right for You?"
    },
    {
      "type": "text",
      "id": "recommend_hint_desktop",
      "label": "Hint (desktop)",
      "default": "Click each one to learn more."
    },
    {
      "type": "text",
      "id": "recommend_hint_mobile",
      "label": "Hint (mobile)",
      "default": "Tap each one to learn more."
    },
    {
      "type": "header",
      "content": "Quiz CTA"
    },
    {
      "type": "url",
      "id": "quiz_url",
      "label": "Quiz link"
    },
    {
      "type": "text",
      "id": "quiz_label",
      "label": "Button label",
      "default": "Take the Quiz"
    },
    {
      "type": "text",
      "id": "quiz_subtext",
      "label": "Subtext",
      "default": "Find out the perfect mattress for you"
    }
  ],
  "presets": [
    {
      "name": "NW Firmness Popup"
    }
  ]
}
{% endschema %}
