    {
      "type": "range",
      "id": "blocks_gap_desktop",
      "label": "Space between blocks (Desktop)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "blocks_gap_mobile",
      "label": "Space between blocks (Mobile)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "item_gap_desktop",
      "label": "Space between heading and content (Desktop)",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "item_gap_mobile",
      "label": "Space between heading and content (Mobile)",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "TEXT COLORS"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#613916"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "body_color",
      "label": "Body Text Color",
      "default": "#613916"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "divider_color",
      "label": "Divider Color",
      "default": "#61391633"
    },
    {
      "type": "header",
      "content": "BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "color",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "image", "label": "Image" },
        { "value": "gradient", "label": "Gradient" }
      ]
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile Optional)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "range",
      "id": "bg_image_opacity",
      "label": "Background Image Opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "content_item",
      "name": "Content Item",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
