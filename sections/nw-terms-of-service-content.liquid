{{ 'nw-terms-of-service-content.css' | asset_url | stylesheet_tag }}

{%- assign nw_shell_selector = '#NwTermsOfServiceContent-' | append: section.id -%}
{%- assign nw_heading_color = section.settings.heading_color | default: '#613916' -%}
{%- assign nw_body_color = section.settings.body_color | default: '#613916' -%}
{%- assign nw_divider_color = section.settings.divider_color | default: 'rgba(97, 57, 22, 0.2)' -%}
{%- assign nw_blocks_gap_desktop = section.settings.blocks_gap_desktop | default: 32 -%}
{%- assign nw_blocks_gap_mobile = section.settings.blocks_gap_mobile | default: 24 -%}
{%- assign nw_item_gap_desktop = section.settings.item_gap_desktop | default: 12 -%}
{%- assign nw_item_gap_mobile = section.settings.item_gap_mobile | default: 12 -%}

{% render 'nw-section-shell', selector: nw_shell_selector, mode: 'direct', default_bg: '#FFFFFF' %}

<style>
  {{ nw_shell_selector }} .nw-terms-of-service-content__wrapper {
    --nw-tos-content-blocks-gap: {{ nw_blocks_gap_desktop }}px;
    --nw-tos-content-item-gap: {{ nw_item_gap_desktop }}px;
  }

  @media screen and (max-width: 749px) {
    {{ nw_shell_selector }} .nw-terms-of-service-content__wrapper {
      --nw-tos-content-blocks-gap: {{ nw_blocks_gap_mobile }}px;
      --nw-tos-content-item-gap: {{ nw_item_gap_mobile }}px;
    }
  }

  {{ nw_shell_selector }} .nw-terms-of-service-content__heading {
    color: {{ nw_heading_color }};
  }

  {{ nw_shell_selector }} .nw-terms-of-service-content__body,
  {{ nw_shell_selector }} .nw-terms-of-service-content__body p,
  {{ nw_shell_selector }} .nw-terms-of-service-content__body li,
  {{ nw_shell_selector }} .nw-terms-of-service-content__body a {
    color: {{ nw_body_color }};
  }

  {{ nw_shell_selector }} .nw-terms-of-service-content__divider {
    border-top-color: {{ nw_divider_color }};
  }
</style>

<nw-terms-of-service-content
  id="NwTermsOfServiceContent-{{ section.id }}"
  class="nw-terms-of-service-content section-{{ section.id }}"
>
  <div class="page-width">
    {%- if section.blocks.size > 0 -%}
      <div class="nw-terms-of-service-content__wrapper{%- render 'nw-scroll-animation' -%}">
        {%- for block in section.blocks -%}
          {%- if block.settings.heading != blank or block.settings.content != blank -%}
            <article
              class="nw-terms-of-service-content__item"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.heading != blank -%}
                <h2 class="nw-terms-of-service-content__heading">
                  {{ block.settings.heading | escape }}
                </h2>
              {%- endif -%}

              {%- if block.settings.content != blank -%}
                <div class="nw-terms-of-service-content__body rte">
                  {{ block.settings.content }}
                </div>
              {%- endif -%}
            </article>

            {%- if section.settings.show_dividers and forloop.last == false -%}
              <hr class="nw-terms-of-service-content__divider" aria-hidden="true">
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</nw-terms-of-service-content>

{% schema %}
{
  "name": "NW Terms Content",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "LAYOUT"
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Show dividers between items",
      "default": true
