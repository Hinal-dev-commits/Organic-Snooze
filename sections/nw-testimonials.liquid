      "id": "subheading",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Text colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#613916"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#613916"
    },
    {
      "type": "header",
      "content": "Card colors"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background",
      "default": "#F4EFE8"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text",
      "default": "#613916"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#E57B1E"
    },
    {
      "type": "color",
      "id": "star_empty_color",
      "label": "Empty star color",
      "default": "#D1C7BA"
    },
    {
      "type": "color",
      "id": "verified_icon_color",
