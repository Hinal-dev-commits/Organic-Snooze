{{ 'nw-testimonials.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-testimonials.js' | asset_url }}" defer="defer"></script>

{%- assign nw_shell_selector = '#NwTestimonials-' | append: section.id -%}
{% render 'nw-section-shell', selector: nw_shell_selector, mode: 'direct' %}

<nw-testimonials
  id="NwTestimonials-{{ section.id }}"
  class="nw-testimonials"
  data-show-arrows="{{ section.settings.show_arrows }}"
  data-show-pagination="{{ section.settings.show_pagination }}"
  data-pagination-id="NwTestimonialsPagination-{{ section.id }}"
  style="
    --nw-star-active: {{ section.settings.star_color | default: '#E57B1E' }};
    --nw-star-inactive: {{ section.settings.star_color_inactive | default: '#D1D5DB' }};
    --nw-testimonials-header-star-active: {{ section.settings.star_color | default: '#E57B1E' }};
    --nw-testimonials-header-star-inactive: {{ section.settings.star_color_inactive | default: '#D1D5DB' }};
    --nw-testimonials-heading-color: {{ section.settings.heading_color }};
    --nw-testimonials-desc-color: {{ section.settings.description_color }};
    --nw-testimonials-card-bg: {{ section.settings.card_bg_color }};
    --nw-testimonials-card-text: {{ section.settings.card_text_color }};
    --nw-testimonials-star-color: {{ section.settings.card_star_color | default: '#E57B1E' }};
    --nw-testimonials-star-empty-color: {{ section.settings.card_star_empty_color | default: '#D1C7BA' }};
    --nw-testimonials-verified-color: {{ section.settings.verified_icon_color }};
    --nw-testimonials-verified-textcolor: {{ section.settings.verified_text_color }};
    --nw-swiper-bullet: {{ section.settings.pagination_color }};
  "
>
  <div class="page-width">
    <div class="nw-testimonials__wrapper{%- render 'nw-scroll-animation' -%}">
      <div class="nw-testimonials__header">
        {% render 'nw-section-header',
          show_rating: section.settings.show_rating,
          rating: section.settings.star_rating,
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          description: section.settings.subheading,
          section_index: section.index
        %}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="nw-testimonials__slider-wrap">
          <div class="swiper nw-testimonials__swiper" id="NwTestimonialsSwiper-{{ section.id }}">
            <div class="swiper-wrapper">
              {%- for block in section.blocks -%}
                <div class="swiper-slide" {{ block.shopify_attributes }}>
                  <article class="nw-testimonials__card">
                    <div class="nw-testimonials__card-top">
                      {%- assign rating_val = block.settings.rating | default: 5 -%}
                      {% render 'nw-stars',
                        rating: rating_val,
                        class: 'nw-testimonials__stars',
                        star_class: 'nw-testimonials__star',
                        icon: 'star'
                      %}

                      {%- if block.settings.quote != blank -%}
                        <div class="nw-testimonials__quote rte">{{ block.settings.quote }}</div>
                      {%- endif -%}
                    </div>

                    <div class="nw-testimonials__card-bottom">
                      {%- if block.settings.author != blank -%}
                        <span class="nw-testimonials__author">{{ block.settings.author }}</span>
                      {%- endif -%}

                      {%- if block.settings.verified -%}
                        <div class="nw-testimonials__verified">
                          <span class="nw-testimonials__verified-icon" aria-hidden="true">
                            {% render 'nw-icon', icon: 'verified' %}
                          </span>
                          <span class="nw-testimonials__verified-text">{{ block.settings.verified_text | default: 'Verified' }}</span>
                        </div>
                      {%- endif -%}
                    </div>
                  </article>
                </div>
              {%- endfor -%}
            </div>
          </div>
          {%- if section.settings.show_arrows -%}
            {% render 'nw-swiper-arrows' %}
          {%- endif -%}
          {%- if section.settings.show_pagination -%}
            <div class="nw-swiper-pagination" id="NwTestimonialsPagination-{{ section.id }}"></div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</nw-testimonials>

{% schema %}
{
  "name": "t:sections.nw-testimonials.name",
  "tag": "section",
  "class": "section-nw-testimonials",
  "settings": [
    {
      "type": "header",
      "content": "SECTION HEADER"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating Stars",
      "default": true
    },
    {
      "type": "range",
      "id": "star_rating",
      "label": "Star Rating (Active Stars)",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "star_color",
      "label": "Active Star Color",
      "default": "#E57B1E",
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "star_color_inactive",
      "label": "Inactive Star Color",
      "default": "#D1D5DB",
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Real sleepers, real mornings"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "In Their Own Words"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "TEXT COLORS"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#613916"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "description_color",
      "label": "Description Color",
      "default": "#613916"
    },
    {
      "type": "header",
      "content": "CARD COLORS"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#F4EFE8"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "card_text_color",
      "label": "Card Text",
      "default": "#613916"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "card_star_color",
      "label": "Card Star Color",
      "default": "#E57B1E"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "card_star_empty_color",
      "label": "Card Empty Star Color",
      "default": "#D1C7BA"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "verified_text_color",
      "label": "Verified Textcolor"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "verified_icon_color",
      "label": "Verified Icon Color",
      "default": "#878735"
    },
    {
      "type": "header",
      "content": "SLIDER SETTINGS"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Slider Arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show Slider Pagination",
      "default": true
    },
    {
      "type": "header",
      "content": "SLIDER COLORS"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "pagination_color",
      "label": "Pagination Bullet",
      "default": "#613916",
      "visible_if": "{{ section.settings.show_pagination == true }}"
    },
    {
      "type": "header",
      "content": "BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "color",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "image", "label": "Image" },
        { "value": "gradient", "label": "Gradient" }
      ]
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFCF0",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Card",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Star Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote",
          "default": "<p>“I am beyond impressed with this mattress. It’s the perfect mix of comfort and support, and I’ve genuinely been sleeping better since we got it. The quality feels incredible, it stays cool at night, and waking up without aches has been a game changer.”</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Chloe"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show Verified Badge",
          "default": true
        },
        {
          "type": "text",
          "id": "verified_text",
          "label": "Verified Text",
          "default": "Verified"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.nw-testimonials.name",
      "category": "NW Sections",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "author": "Marcello Delle Grotti",
            "quote": "<p>“First night was truly an amazing night! Been sleeping on a 20 year old mattress. And I definitely would recommend this to anyone looking for a new mattress”</p>",
            "verified": true
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "author": "Phillip Page",
            "quote": "<p>“I love it! sleeping great and the peace of mine knowing I am not breathing in those horrible gases from the conventional mattress!”</p>",
            "verified": true
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "author": "Chloe",
            "quote": "<p>“I am beyond impressed with this mattress. It’s the perfect mix of comfort and support, and I’ve genuinely been sleeping better since we got it. The quality feels incredible, it stays cool at night, and waking up without aches has been a game changer.”</p>",
            "verified": true
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "author": "Kristin McGee",
            "quote": "<p>“Incredible mattress I want to invest in more!”</p>",
            "verified": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
