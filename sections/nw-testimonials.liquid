{{ 'nw-testimonials.css' | asset_url | stylesheet_tag }}

<style>
  #NwTestimonials-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_desktop | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop | default: 80 }}px;
    {% if section.settings.bg_type == 'color' and section.settings.bg_color != blank %}
      background-color: {{ section.settings.bg_color }};
    {% elsif section.settings.bg_type == 'gradient' and section.settings.bg_gradient != blank %}
      background: {{ section.settings.bg_gradient }};
    {% elsif section.settings.bg_type == 'image' and section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 2880 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    #NwTestimonials-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile | default: 48 }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile | default: 48 }}px;
      {% if section.settings.bg_type == 'image' and section.settings.bg_image_mobile != blank %}
        background-image: url('{{ section.settings.bg_image_mobile | image_url: width: 1200 }}');
      {% endif %}
    }
  }
</style>

<section
  id="NwTestimonials-{{ section.id }}"
  class="nw-testimonials"
  style="
    --nw-testimonials-heading-color: {{ section.settings.heading_color }};
    --nw-testimonials-desc-color: {{ section.settings.description_color }};
    --nw-testimonials-card-bg: {{ section.settings.card_bg_color }};
    --nw-testimonials-card-text: {{ section.settings.card_text_color }};
    --nw-testimonials-star-color: {{ section.settings.star_color }};
    --nw-testimonials-star-empty-color: {{ section.settings.star_empty_color }};
    --nw-testimonials-verified-color: {{ section.settings.verified_icon_color }};
    --nw-swiper-bullet: {{ section.settings.pagination_color }};
  "
>
  <div class="page-width">
    <div class="nw-testimonials__wrapper{%- render 'nw-scroll-animation' -%}">
      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="nw-testimonials__header">
          {% render 'nw-section-heading', text: section.settings.heading %}
          {% render 'nw-section-description', text: section.settings.subheading %}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="nw-testimonials__slider-wrap">
          <div class="swiper nw-testimonials__swiper" id="NwTestimonialsSwiper-{{ section.id }}">
            <div class="swiper-wrapper">
              {%- for block in section.blocks -%}
                <div class="swiper-slide" {{ block.shopify_attributes }}>
                  <article class="nw-testimonials__card">
                    <div class="nw-testimonials__card-top">
                      {%- assign rating_val = block.settings.rating | default: 5 -%}
                      <div class="nw-testimonials__stars" aria-label="{{ rating_val }} out of 5 stars">
                        {%- for i in (1..5) -%}
                          <span class="nw-testimonials__star{% if i <= rating_val %} nw-testimonials__star--active{% else %} nw-testimonials__star--inactive{% endif %}">
                            {{ 'star.svg' | inline_asset_content }}
                          </span>
                        {%- endfor -%}
                      </div>

                      {%- if block.settings.quote != blank -%}
                        <p class="nw-testimonials__quote">{{ block.settings.quote }}</p>
                      {%- endif -%}
                    </div>

                    <div class="nw-testimonials__card-bottom">
                      {%- if block.settings.author != blank -%}
                        <span class="nw-testimonials__author">{{ block.settings.author }}</span>
                      {%- endif -%}

                      {%- if block.settings.verified -%}
                        <div class="nw-testimonials__verified">
                          <span class="nw-testimonials__verified-icon" aria-hidden="true">
                            {{ 'verified.svg' | inline_asset_content }}
                          </span>
                          <span class="nw-testimonials__verified-text">{{ block.settings.verified_text | default: 'Verified' }}</span>
                        </div>
                      {%- endif -%}
                    </div>
                  </article>
                </div>
              {%- endfor -%}
            </div>
          </div>
          {%- if section.settings.show_arrows -%}
            <button type="button" class="nw-swiper-btn nw-swiper-btn--prev" aria-label="Previous slide">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="nw-swiper-btn nw-swiper-btn--next" aria-label="Next slide">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          {%- endif -%}
          {%- if section.settings.show_pagination -%}
            <div class="nw-swiper-pagination" id="NwTestimonialsPagination-{{ section.id }}"></div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var sectionEl = document.getElementById('NwTestimonials-{{ section.id }}');
    if (!sectionEl) return;

    function initSwiper() {
      if (typeof Swiper === 'undefined') {
        window.setTimeout(initSwiper, 50);
        return;
      }

      var sliderEl = sectionEl.querySelector('.nw-testimonials__swiper');
      if (!sliderEl) return;
      if (sliderEl.swiper) sliderEl.swiper.destroy(true, true);

      new Swiper(sliderEl, {
        slidesPerView: 'auto',
        spaceBetween: 12,
        centeredSlides: true,
        grabCursor: true,
        watchOverflow: true,
        {% if section.settings.show_arrows %}
        navigation: {
          nextEl: sectionEl.querySelector('.nw-swiper-btn--next'),
          prevEl: sectionEl.querySelector('.nw-swiper-btn--prev')
        },
        {% endif %}
        {% if section.settings.show_pagination %}
        pagination: {
          el: '#NwTestimonialsPagination-{{ section.id }}',
          clickable: true
        },
        {% endif %}
        breakpoints: {
          750: {
            centeredSlides: false,
            spaceBetween: 20
          }
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSwiper);
    } else {
      initSwiper();
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (event.target.contains(sectionEl)) initSwiper();
    });
  })();
</script>

{% schema %}
{
  "name": "NW Testimonials",
  "tag": "section",
  "class": "section-nw-testimonials",
  "settings": [
    {
      "type": "header",
