{{ 'nw-rich-text.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign nw_shell_selector = '.nw-rich-text.section-' | append: section.id
  assign content_alignment = section.settings.content_alignment | default: 'center'
  assign content_position = section.settings.desktop_content_position | default: 'center'

  case section.settings.content_width
    when 'narrow'
      assign content_max_width = '50rem'
    when 'wide'
      assign content_max_width = '100%'
    else
      assign content_max_width = '78rem'
  endcase
-%}

{% render 'nw-section-shell', selector: nw_shell_selector, mode: 'direct', default_bg: '#FFFFFF' %}
{% render 'nw-section-text-colors', selector: nw_shell_selector %}

{%- if section.settings.body_color != blank -%}
  <style>
    {{ nw_shell_selector }} .nw-rich-text__text.rte,
    {{ nw_shell_selector }} .nw-rich-text__text.rte p,
    {{ nw_shell_selector }} .nw-rich-text__text.rte li,
    {{ nw_shell_selector }} .nw-rich-text__text.rte a {
      color: {{ section.settings.body_color }};
    }
  </style>
{%- endif -%}

<section
  class="nw-rich-text section-{{ section.id }} nw-rich-text--align-{{ content_alignment }}"
  style="--nw-rich-text-max-width: {{ content_max_width }};"
>
  <div class="page-width">
    <div class="nw-rich-text__wrapper nw-rich-text__wrapper--{{ content_position }}{%- render 'nw-scroll-animation' -%}">
      {%- if section.blocks.size > 0 -%}
        <div class="nw-rich-text__blocks">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'heading' -%}
                {%- if block.settings.heading != blank -%}
                  <div
                    class="nw-rich-text__heading{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {{ block.shopify_attributes }}
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    {% render 'nw-section-heading',
                      text: block.settings.heading,
                      section_index: section.index
                    %}
                  </div>
                {%- endif -%}

              {%- when 'caption' -%}
                {%- if block.settings.caption != blank -%}
                  <p
                    class="nw-eyebrow nw-rich-text__caption{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {{ block.shopify_attributes }}
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    {{ block.settings.caption | escape }}
                  </p>
                {%- endif -%}

              {%- when 'stars' -%}
                {%- if block.settings.show_rating -%}
                  <div
                    class="nw-rating nw-rich-text__rating{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {{ block.shopify_attributes }}
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    {% render 'nw-stars', rating: block.settings.star_rating %}
                    {%- if block.settings.eyebrow != blank -%}
                      <span class="nw-eyebrow">{{ block.settings.eyebrow | escape }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}

              {%- when 'text' -%}
                {%- if block.settings.text != blank -%}
                  <div
                    class="nw-rich-text__text rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {{ block.shopify_attributes }}
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    {{ block.settings.text }}
                  </div>
                {%- endif -%}

              {%- when 'button' -%}
                {%- liquid
                  assign show_button_1 = false
                  assign show_button_2 = false
                  assign button_width = block.settings.button_width | default: 'auto'
                  if block.settings.button_label != blank
                    assign show_button_1 = true
                  endif
                  if block.settings.button_label_2 != blank
                    assign show_button_2 = true
                  endif
                -%}
                {%- if show_button_1 or show_button_2 -%}
                  <div
                    class="nw-rich-text__buttons nw-rich-text__buttons--{{ button_width }}{% if show_button_1 and show_button_2 %} nw-rich-text__buttons--multiple{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {{ block.shopify_attributes }}
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    {%- if show_button_1 -%}
                      {% render 'nw-button',
                        text: block.settings.button_label,
                        link: block.settings.button_link,
                        style: block.settings.button_style,
                        btn_class: 'nw-rich-text__btn'
                      %}
                    {%- endif -%}
                    {%- if show_button_2 -%}
                      {% render 'nw-button',
                        text: block.settings.button_label_2,
                        link: block.settings.button_link_2,
                        style: block.settings.button_style_2,
                        btn_class: 'nw-rich-text__btn'
                      %}
                    {%- endif -%}
                  </div>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.nw-rich-text.name",
  "tag": "section",
  "class": "section-nw-rich-text",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "LAYOUT"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "label": "Desktop Content Position",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Text Alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content Width",
      "default": "medium",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "wide",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "header",
      "content": "TEXT COLORS"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Caption Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body Text Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "header",
      "content": "BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "color",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "color",
          "label": "Color"
        },
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF",
      "alpha": true,
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile Optional)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 3,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Talk about your brand"
        }
      ]
    },
    {
      "type": "caption",
      "name": "Caption",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Add a tagline"
        }
      ]
    },
    {
      "type": "stars",
      "name": "Star Rating",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_rating",
          "label": "Show Star Rating",
          "default": true
        },
        {
          "type": "range",
          "id": "star_rating",
          "label": "Star Rating",
          "min": 0,
          "max": 5,
          "step": 0.5,
          "default": 5,
          "visible_if": "{{ block.settings.show_rating == true }}"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow Text",
          "visible_if": "{{ block.settings.show_rating == true }}"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 3,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Buttons",
      "limit": 2,
      "settings": [
        {
          "type": "select",
          "id": "button_width",
          "label": "Button Width",
          "default": "auto",
          "options": [
            {
              "value": "auto",
              "label": "Auto"
            },
            {
              "value": "full",
              "label": "Full Width"
            }
          ]
        },
        {
          "type": "header",
          "content": "BUTTON 1"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button Style",
          "default": "primary",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "outline",
              "label": "Outline"
            }
          ]
        },
        {
          "type": "header",
          "content": "BUTTON 2"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Button Label"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Button Link"
        },
        {
          "type": "select",
          "id": "button_style_2",
          "label": "Button Style",
          "default": "outline",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "outline",
              "label": "Outline"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.nw-rich-text.name",
      "category": "NW Sections",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
