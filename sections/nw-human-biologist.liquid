{{ 'nw-swiper-bundle.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-insights-slider.js' | asset_url }}" defer="defer"></script>
{{ 'nw-human-biologist.css' | asset_url | stylesheet_tag }}

<style>
  .nw-human-biologist.section-{{ section.id }} {
    --nw-hb-star-active: {{ section.settings.star_color | default: '#E57B1E' }};
    --nw-hb-star-inactive: {{ section.settings.star_color_inactive | default: '#D1D5DB' }};
    position: relative;
    background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
    padding-top: {{ section.settings.padding_top_desktop | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop | default: 80 }}px;
    isolation: isolate;
    overflow: hidden;
    {% if section.settings.bg_type == 'gradient' and section.settings.bg_gradient != blank %}
      background: {{ section.settings.bg_gradient }};
    {% elsif section.settings.bg_type == 'none' %}
      background: transparent;
    {% endif %}
  }

  {%- if section.settings.bg_image != blank and section.settings.bg_type != 'none' -%}
    .nw-human-biologist.section-{{ section.id }}::before {
      content: "";
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background-image: url('{{ section.settings.bg_image | image_url: width: 2880 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      opacity: calc({{ section.settings.bg_image_opacity | default: 100 }} / 100);
      z-index: -1;
      pointer-events: none;
    }
  {%- endif -%}

  @media screen and (max-width: 749px) {
    .nw-human-biologist.section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile | default: 48 }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile | default: 48 }}px;
    }

    {%- if section.settings.bg_image_mobile != blank and section.settings.bg_type != 'none' -%}
      .nw-human-biologist.section-{{ section.id }}::before {
        background-image: url('{{ section.settings.bg_image_mobile | image_url: width: 1200 }}');
      }
    {%- endif -%}
  }
</style>

<section class="nw-human-biologist section-{{ section.id }}">
  <div class="nw page-width">
    <div class="nw-human-biologist__wrapper{%- render 'nw-scroll-animation' -%}">
      <div class="nw-human-biologist__header">
        {%- if section.settings.show_rating -%}
          {%- assign active_stars = section.settings.star_rating | default: 5 | plus: 0 -%}
          <div class="nw-rating">
            <div class="nw-stars" aria-label="{{ active_stars }} out of 5 stars">
              {%- for i in (1..5) -%}
                <span class="nw-star{% if i <= active_stars %} nw-star--active{% endif %}">
                  <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path d="M8 0.5L10.247 5.053L15.266 5.783L11.633 9.324L12.49 14.317L8 11.956L3.51 14.317L4.367 9.324L0.734 5.783L5.753 5.053L8 0.5Z"/>
                  </svg>
                </span>
              {%- endfor -%}
            </div>
            {%- if section.settings.eyebrow != blank -%}
              <span class="nw-eyebrow">{{ section.settings.eyebrow }}</span>
            {%- endif -%}
          </div>
        {%- elsif section.settings.eyebrow != blank -%}
          <p class="nw-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          {% render 'nw-section-heading', text: section.settings.heading, section_index: section.index %}
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          {% render 'nw-section-description', text: section.settings.subheading %}
        {%- endif -%}
      </div>

      <div class="nw-human-biologist__main">
        <div class="nw-human-biologist__content">
          {%- if section.settings.name != blank or section.settings.role != blank or section.settings.quote != blank -%}
          <div class="nw-human-biologist__bio-wrap">
            <div class="nw-human-biologist__author-info">
              {%- if section.settings.name != blank -%}
                <div class="nw-human-biologist__name-row">
                  <h3 class="nw-human-biologist__name">{{ section.settings.name }}</h3>
                  {%- if section.settings.show_verified -%}
                    <span class="nw-human-biologist__verified-icon" aria-label="Verified">
                      {%- if section.settings.custom_verified_icon != blank -%}
                        <img
                          src="{{ section.settings.custom_verified_icon | image_url }}"
                          alt="Verified"
                          width="28"
                          height="28"
                          loading="lazy"
                        >
                      {%- else -%}
                        {% render 'nw-icon', icon: 'verified-lg' %}
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if section.settings.role != blank -%}
                <p class="nw-human-biologist__role">{{ section.settings.role }}</p>
              {%- endif -%}
            </div>

            {%- if section.settings.quote != blank -%}
              <div class="nw-human-biologist__quote">
                {{ section.settings.quote }}
              </div>
            {%- endif -%}
          </div>
          {%- endif -%}

          {%- liquid
            assign show_btn_1 = false
            if section.settings.show_btn_1 and section.settings.btn_1_text != blank
              assign show_btn_1 = true
            endif

            assign show_btn_2 = false
            if section.settings.show_btn_2 and section.settings.btn_2_text != blank
              assign show_btn_2 = true
            endif
          -%}

          {%- if show_btn_1 or show_btn_2 -%}
            <div class="nw-human-biologist__buttons">
              {%- if show_btn_1 -%}
                {% render 'nw-button',
                  text: section.settings.btn_1_text,
                  link: section.settings.btn_1_link,
                  style: section.settings.btn_1_style
                %}
              {%- endif -%}

              {%- if show_btn_2 -%}
                {% render 'nw-button',
                  text: section.settings.btn_2_text,
                  link: section.settings.btn_2_link,
                  style: section.settings.btn_2_style
                %}
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- assign featured_logos = section.blocks | where: 'type', 'featured_logo' -%}
          {%- if section.settings.show_featured and featured_logos.size > 0 -%}
            <div class="nw-human-biologist__featured">
              {%- if section.settings.featured_title != blank -%}
                <h4 class="nw-human-biologist__featured-title">{{ section.settings.featured_title }}</h4>
              {%- endif -%}
              <div class="nw-human-biologist__featured-marquee">
                <div class="nw-human-biologist__featured-track">
                  {%- for block in featured_logos -%}
                    <div class="nw-human-biologist__featured-item" {{ block.shopify_attributes }}>
                      {%- if block.settings.image != blank -%}
                        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" target="_blank" rel="noopener">{%- endif -%}
                        <img
                          src="{{ block.settings.image | image_url: width: 400 }}"
                          alt="{{ block.settings.image.alt | default: 'Featured logo' | escape }}"
                          class="nw-human-biologist__featured-img"
                          style="max-width: {{ block.settings.logo_width | default: 120 }}px;" height="" width=""
                        >
                        {%- if block.settings.link != blank -%}</a>{%- endif -%}
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
                <div class="nw-human-biologist__featured-track" aria-hidden="true">
                  {%- for block in featured_logos -%}
                    <div class="nw-human-biologist__featured-item">
                      {%- if block.settings.image != blank -%}
                        <img
                          src="{{ block.settings.image | image_url: width: 400 }}"
                          alt="{{ block.settings.image.alt | default: 'Featured logo' | escape }}"
                          class="nw-human-biologist__featured-img"
                          style="max-width: {{ block.settings.logo_width | default: 120 }}px;" height="" width=""
                        >
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        </div>

        {%- if section.settings.image != blank or section.settings.image_mobile != blank -%}
        {%- liquid
          assign image_alt = section.settings.image.alt | default: section.settings.name | default: 'Author' | escape
          assign image_mobile_alt = section.settings.image_mobile.alt | default: section.settings.name | default: 'Author' | escape
        -%}
        <div class="nw-human-biologist__image-wrap">
          {%- if section.settings.image != blank and section.settings.image_mobile != blank -%}
            {{
              section.settings.image_mobile
              | image_url: width: 750
              | image_tag:
                loading: 'lazy',
                class: 'nw-human-biologist__image nw-human-biologist__image--mobile',
                widths: '375, 550, 750',
                sizes: '100vw',
                alt: image_mobile_alt
            }}
            {{
              section.settings.image
              | image_url: width: 1440
              | image_tag:
                loading: 'lazy',
                class: 'nw-human-biologist__image nw-human-biologist__image--desktop',
                widths: '712, 900, 1200, 1440',
                sizes: '(min-width: 750px) 712px, 100vw',
                alt: image_alt,
                width: 712,
                height: 496
            }}
          {%- elsif section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1440
              | image_tag:
                loading: 'lazy',
                class: 'nw-human-biologist__image',
                widths: '712, 900, 1200, 1440',
                sizes: '(min-width: 750px) 712px, 100vw',
                alt: image_alt,
                width: 712,
                height: 496
            }}
          {%- elsif section.settings.image_mobile != blank -%}
            {{
              section.settings.image_mobile
              | image_url: width: 750
              | image_tag:
                loading: 'lazy',
                class: 'nw-human-biologist__image',
                widths: '375, 550, 750',
                sizes: '100vw',
                alt: image_mobile_alt
            }}
          {%- else -%}
            <span class="nw-human-biologist__image-placeholder" aria-hidden="true"></span>
          {%- endif -%}
        </div>
        {%- endif -%}
      </div>

      {%- assign insight_slides = section.blocks | where: 'type', 'insight_slide' -%}
      {%- if section.settings.show_insights_slider and insight_slides.size > 0 -%}
        <div
          class="nw-human-biologist__insights"
          data-enable-autoplay="{{ section.settings.enable_autoplay }}"
          data-autoplay-delay="{{ section.settings.autoplay_delay | default: 4 | times: 1000 }}"
          data-show-arrows="{{ section.settings.show_arrows }}"
          data-show-dots="{{ section.settings.show_dots }}"
        >
          {%- if section.settings.show_arrows and insight_slides.size > 1 -%}
            {% render 'nw-swiper-arrows', prev_label: 'Previous insight', next_label: 'Next insight' %}
          {%- endif -%}
          <div class="swiper nw-human-biologist__insights-slider" id="nw-human-biologist-insights-{{ section.id }}" data-nw-insights-slider>
            <div class="swiper-wrapper">
              {%- for block in insight_slides -%}
                <div class="swiper-slide" {{ block.shopify_attributes }}>
                  <div class="nw-human-biologist__insights-slide">
                    {%- if block.settings.icon != 'none' or block.settings.custom_icon != blank -%}
                      <div class="nw-human-biologist__insight-icon-wrap">
                        {%- if block.settings.custom_icon != blank -%}
                          <img
                            src="{{ block.settings.custom_icon | image_url: width: 48 }}"
                            alt="{{ block.settings.tag | escape }}"
                            width="24"
                            height="24"
                            loading="lazy"
                          >
                        {%- elsif block.settings.icon == 'moon' or block.settings.icon == 'thermometer' or block.settings.icon == 'wind' -%}
                          {% render 'nw-icon', icon: block.settings.icon %}
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                    <div class="nw-human-biologist__insight-content">
                      {%- if block.settings.tag != blank -%}
                        <span class="nw-human-biologist__insight-tag">{{ block.settings.tag }}</span>
                      {%- endif -%}
                      {%- if block.settings.quote != blank -%}
                        <div class="nw-human-biologist__insight-quote{% if block.settings.is_italic %} is-italic{% endif %}">
                          {{ block.settings.quote }}
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </div>

          {%- if section.settings.show_dots and insight_slides.size > 1 -%}
            <div class="nw-human-biologist__insights-pagination swiper-pagination" id="nw-human-biologist-pagination-{{ section.id }}" data-nw-insights-pagination></div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NW Human Biologist",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "SECTION HEADER"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating Stars",
      "default": true
    },
    {
      "type": "range",
      "id": "star_rating",
      "label": "Star Rating (Active Stars)",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Active Star Color",
      "default": "#E57B1E",
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "color",
      "id": "star_color_inactive",
      "label": "Inactive Star Color",
      "default": "#D1D5DB",
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Real sleepers, real mornings"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Why a Human Biologist Built a Mattress"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "AUTHOR INFO"
    },
    {
      "type": "inline_richtext",
      "id": "name",
      "label": "Author Name",
      "default": "Gary Brecka"
    },
    {
      "type": "checkbox",
      "id": "show_verified",
      "label": "Show Verified Badge",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "custom_verified_icon",
      "label": "Custom Verified Badge Icon",
      "visible_if": "{{ section.settings.show_verified == true }}"
    },
    {
      "type": "inline_richtext",
      "id": "role",
      "label": "Author Role / Subtitle",
      "default": "Longevity Expert & Founder of The Ultimate Human"
    },
    {
      "type": "richtext",
      "id": "quote",
      "label": "Author Quote / Bio",
      "default": "<p>“I spent years helping people reduce toxic exposure. It didn't make sense to ignore the place we spend a third of our lives. That's why we built this mattress.”</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Author Image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Author Image (mobile)",
      "info": "Optional. Uses the desktop image when empty."
    },
    {
      "type": "header",
      "content": "PRIMARY BUTTON"
    },
    {
      "type": "checkbox",
      "id": "show_btn_1",
      "label": "Show Primary Button",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_1_text",
      "label": "Button 1 Label",
      "default": "SHOP MATTRESSES",
      "visible_if": "{{ section.settings.show_btn_1 == true }}"
    },
    {
      "type": "url",
      "id": "btn_1_link",
      "label": "Button 1 Link",
      "visible_if": "{{ section.settings.show_btn_1 == true }}"
    },
    {
      "type": "select",
      "id": "btn_1_style",
      "label": "Button 1 Style",
      "default": "primary",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ],
      "visible_if": "{{ section.settings.show_btn_1 == true }}"
    },
    {
      "type": "header",
      "content": "SECONDARY BUTTON"
    },
    {
      "type": "checkbox",
      "id": "show_btn_2",
      "label": "Show Secondary Button",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_2_text",
      "label": "Button 2 Label",
      "default": "MEET GARY BRECKA",
      "visible_if": "{{ section.settings.show_btn_2 == true }}"
    },
    {
      "type": "url",
      "id": "btn_2_link",
      "label": "Button 2 Link",
      "visible_if": "{{ section.settings.show_btn_2 == true }}"
    },
    {
      "type": "select",
      "id": "btn_2_style",
      "label": "Button 2 Style",
      "default": "outline",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ],
      "visible_if": "{{ section.settings.show_btn_2 == true }}"
    },
    {
      "type": "header",
      "content": "FEATURED ON LOGOS"
    },
    {
      "type": "checkbox",
      "id": "show_featured",
      "label": "Show Featured On Section",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "featured_title",
      "label": "Featured Title",
      "default": "Featured On",
      "visible_if": "{{ section.settings.show_featured == true }}"
    },
    {
      "type": "header",
      "content": "INSIGHTS SLIDER"
    },
    {
      "type": "checkbox",
      "id": "show_insights_slider",
      "label": "Show Insights Box & Slider",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Slider Arrows",
      "default": false,
      "visible_if": "{{ section.settings.show_insights_slider == true }}"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show Pagination Dots",
      "default": true,
      "visible_if": "{{ section.settings.show_insights_slider == true }}"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable Autoplay",
      "default": true,
      "visible_if": "{{ section.settings.show_insights_slider == true }}"
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay Delay (Seconds)",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4,
      "visible_if": "{{ section.settings.show_insights_slider == true and section.settings.enable_autoplay == true }}"
    },
    {
      "type": "header",
      "content": "BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "image",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "image", "label": "Image" },
        { "value": "gradient", "label": "Gradient" }
      ]
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.bg_type == 'color' or section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "range",
      "id": "bg_image_opacity",
      "label": "Background Image Opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile Optional)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "featured_logo",
      "name": "Featured Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Logo Link (Optional)"
        },
        {
          "type": "range",
          "id": "logo_width",
          "label": "Logo Max Width",
          "min": 40,
          "max": 220,
          "step": 5,
          "unit": "px",
          "default": 120
        }
      ]
    },
    {
      "type": "insight_slide",
      "name": "Insight Slide",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "tag",
          "label": "Insight Tag / Eyebrow",
          "default": "Recovery Insight #1"
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote / Insight Text",
          "default": "<p>You spend nearly 23 years in bed. Your mattress is one of the most-used surfaces your body touches every night.</p>"
        },
        {
          "type": "checkbox",
          "id": "is_italic",
          "label": "Italicize Text",
          "default": false
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Slide Icon",
          "default": "none",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "moon", "label": "Moon / Night" },
            { "value": "thermometer", "label": "Thermometer / Cooler" },
            { "value": "wind", "label": "Wind / Breath" },
            { "value": "custom", "label": "Custom Icon Image" }
          ]
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image",
          "visible_if": "{{ block.settings.icon == 'custom' }}"
        }
      ]
    }
  ],
  "presets": [
