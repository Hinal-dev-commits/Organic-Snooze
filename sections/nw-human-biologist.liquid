  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "SECTION HEADING"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Why a Human Biologist Built a Mattress"
    },
    {
      "type": "header",
      "content": "AUTHOR INFO"
    },
    {
      "type": "inline_richtext",
      "id": "name",
