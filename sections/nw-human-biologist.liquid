            "is_italic": false,
            "icon": "none"
          }
        },
        {
          "type": "insight_slide",
          "settings": {
            "tag": "SLEEP FACT · 02",
            "quote": "<p>Deep sleep is when your body repairs and recovers.</p>",
            "is_italic": true,
            "icon": "moon"
          }
        },
        {
          "type": "insight_slide",
          "settings": {
            "tag": "SLEEP FACT · 03",
            "quote": "<p>A cooler bed supports deeper, less interrupted sleep.</p>",
            "is_italic": true,
            "icon": "thermometer"
          }
        },
        {
