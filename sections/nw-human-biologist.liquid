{{ 'nw-swiper-bundle.min.css' | asset_url | stylesheet_tag }}
{{ 'nw-human-biologist.css' | asset_url | stylesheet_tag }}

<style>
  .nw-human-biologist.section-{{ section.id }} {
    position: relative;
    background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
    padding-top: {{ section.settings.padding_top_desktop | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop | default: 80 }}px;
    isolation: isolate;
    overflow: hidden;
    {% if section.settings.bg_type == 'gradient' and section.settings.bg_gradient != blank %}
      background: {{ section.settings.bg_gradient }};
    {% elsif section.settings.bg_type == 'none' %}
      background: transparent;
    {% endif %}
  }

  {%- if section.settings.bg_image != blank and section.settings.bg_type != 'none' -%}
    .nw-human-biologist.section-{{ section.id }}::before {
      content: "";
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background-image: url('{{ section.settings.bg_image | image_url: width: 2880 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      opacity: calc({{ section.settings.bg_image_opacity | default: 100 }} / 100);
      z-index: -1;
      pointer-events: none;
    }
  {%- endif -%}

  @media screen and (max-width: 749px) {
    .nw-human-biologist.section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile | default: 48 }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile | default: 48 }}px;
    }

    {%- if section.settings.bg_image_mobile != blank and section.settings.bg_type != 'none' -%}
      .nw-human-biologist.section-{{ section.id }}::before {
        background-image: url('{{ section.settings.bg_image_mobile | image_url: width: 1200 }}');
      }
    {%- endif -%}
  }
</style>

<section class="nw-human-biologist section-{{ section.id }}">
  <div class="nw page-width">
    <div class="nw-human-biologist__wrapper{%- render 'nw-scroll-animation' -%}">
      {%- if section.settings.heading != blank -%}
        {% render 'nw-section-heading', text: section.settings.heading %}
      {%- endif -%}

      <div class="nw-human-biologist__main">
        <div class="nw-human-biologist__content">
          <div class="nw-human-biologist__bio-wrap">
            <div class="nw-human-biologist__author-info">
              {%- if section.settings.name != blank -%}
                <div class="nw-human-biologist__name-row">
                  <h3 class="nw-human-biologist__name">{{ section.settings.name }}</h3>
                  {%- if section.settings.show_verified -%}
                    <span class="nw-human-biologist__verified-icon" aria-label="Verified">
                      {%- if section.settings.custom_verified_icon != blank -%}
                        <img
                          src="{{ section.settings.custom_verified_icon | image_url }}"
                          alt="Verified"
                          width="28"
                          height="28"
                          loading="lazy"
                        >
                      {%- else -%}
                        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M13.9498 3.21788C13.9795 3.19627 14.0198 3.19627 14.0495 3.21788L16.8434 5.24774H20.2968C20.3336 5.24774 20.3662 5.27141 20.3775 5.30637L21.4447 8.59073L24.2386 10.6206C24.2683 10.6422 24.2807 10.6805 24.2694 10.7155L23.2022 13.9998L24.2694 17.2842C24.2807 17.3191 24.2683 17.3574 24.2386 17.379L21.4447 19.4089L20.3775 22.6933C20.3662 22.7282 20.3336 22.7519 20.2968 22.7519H16.8434L14.0495 24.7818C14.0198 24.8034 13.9795 24.8034 13.9498 24.7818L11.1559 22.7519H7.70253C7.66578 22.7519 7.6332 22.7282 7.62184 22.6933L6.55469 19.4089L3.76081 17.379C3.73107 17.3574 3.71863 17.3191 3.72999 17.2842L4.79713 13.9998L3.72999 10.7155C3.71863 10.6805 3.73107 10.6422 3.76081 10.6206L6.55469 8.59073L7.62184 5.30637C7.6332 5.27141 7.66578 5.24774 7.70253 5.24774H11.156L13.9498 3.21788Z" fill="#70804A" stroke="#70804A" stroke-width="0.848485" stroke-miterlimit="10" stroke-linecap="round"/>
                            <path d="M9.3125 13.6263L12.6286 16.9424C12.6617 16.9756 12.7155 16.9756 12.7486 16.9424L18.6905 11.0005" fill="#70804A"/>
                            <path d="M9.3125 13.6263L12.6286 16.9424C12.6617 16.9756 12.7155 16.9756 12.7486 16.9424L18.6905 11.0005" stroke="white" stroke-width="1.27273" stroke-miterlimit="10" stroke-linecap="round"/>
                        </svg>
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if section.settings.role != blank -%}
                <p class="nw-human-biologist__role">{{ section.settings.role }}</p>
              {%- endif -%}
            </div>

            {%- if section.settings.quote != blank -%}
              <div class="nw-human-biologist__quote">
                {{ section.settings.quote }}
              </div>
            {%- endif -%}
          </div>

          {%- if section.settings.btn_1_text != blank or section.settings.btn_2_text != blank -%}
            <div class="nw-human-biologist__buttons">
              {%- if section.settings.btn_1_text != blank -%}
                {% render 'nw-button',
                  text: section.settings.btn_1_text,
                  link: section.settings.btn_1_link,
                  style: section.settings.btn_1_style
                %}
              {%- endif -%}

              {%- if section.settings.btn_2_text != blank -%}
                {% render 'nw-button',
                  text: section.settings.btn_2_text,
                  link: section.settings.btn_2_link,
                  style: section.settings.btn_2_style
                %}
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- assign featured_logos = section.blocks | where: 'type', 'featured_logo' -%}
          {%- if section.settings.show_featured and featured_logos.size > 0 -%}
            <div class="nw-human-biologist__featured">
              {%- if section.settings.featured_title != blank -%}
                <h4 class="nw-human-biologist__featured-title">{{ section.settings.featured_title }}</h4>
              {%- endif -%}
              <div class="nw-human-biologist__featured-marquee">
                <div class="nw-human-biologist__featured-track">
                  {%- for block in featured_logos -%}
                    <div class="nw-human-biologist__featured-item" {{ block.shopify_attributes }}>
                      {%- if block.settings.image != blank -%}
                        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" target="_blank" rel="noopener">{%- endif -%}
                        <img
                          src="{{ block.settings.image | image_url: width: 400 }}"
                          alt="{{ block.settings.image.alt | default: 'Featured logo' | escape }}"
                          class="nw-human-biologist__featured-img"
                          style="max-width: {{ block.settings.logo_width | default: 120 }}px;" height="" width=""
                        >
                        {%- if block.settings.link != blank -%}</a>{%- endif -%}
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
                <div class="nw-human-biologist__featured-track" aria-hidden="true">
                  {%- for block in featured_logos -%}
                    <div class="nw-human-biologist__featured-item">
                      {%- if block.settings.image != blank -%}
                        <img
                          src="{{ block.settings.image | image_url: width: 400 }}"
                          alt="{{ block.settings.image.alt | default: 'Featured logo' | escape }}"
                          class="nw-human-biologist__featured-img"
                          style="max-width: {{ block.settings.logo_width | default: 120 }}px;" height="" width=""
                        >
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        </div>

        <div class="nw-human-biologist__image-wrap">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 1440 }}"
              alt="{{ section.settings.name | default: 'Gary Brecka' | escape }}"
              loading="lazy"
              class="nw-human-biologist__image"
              width="712"
              height="496"
            >
          {%- else -%}
            <span class="nw-human-biologist__image-placeholder" aria-hidden="true"></span>
          {%- endif -%}
        </div>
      </div>

      {%- assign insight_slides = section.blocks | where: 'type', 'insight_slide' -%}
      {%- if section.settings.show_insights_slider and insight_slides.size > 0 -%}
        <div class="nw-human-biologist__insights">
          <div class="swiper nw-human-biologist__insights-slider" id="nw-human-biologist-insights-{{ section.id }}">
            <div class="swiper-wrapper">
              {%- for block in insight_slides -%}
                <div class="swiper-slide" {{ block.shopify_attributes }}>
                  <div class="nw-human-biologist__insights-slide">
                    {%- if block.settings.icon != 'none' or block.settings.custom_icon != blank -%}
                      <div class="nw-human-biologist__insight-icon-wrap">
                        {%- if block.settings.custom_icon != blank -%}
                          <img
                            src="{{ block.settings.custom_icon | image_url: width: 48 }}"
                            alt="{{ block.settings.tag | escape }}"
                            width="24"
                            height="24"
                            loading="lazy"
                          >
                        {%- elsif block.settings.icon == 'moon' -%}
                          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        {%- elsif block.settings.icon == 'thermometer' -%}
                          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M14 14.76V3.5a2.5 2.5 0 00-5 0v11.26a4.5 4.5 0 105 0z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        {%- elsif block.settings.icon == 'wind' -%}
                          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M9.59 4.59A2 2 0 1111 8H2m10.59 11.41A2 2 0 1014 16H2m15.73-8.27A2.5 2.5 0 1119.5 12H2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                    <div class="nw-human-biologist__insight-content">
                      {%- if block.settings.tag != blank -%}
                        <span class="nw-human-biologist__insight-tag">{{ block.settings.tag }}</span>
                      {%- endif -%}
                      {%- if block.settings.quote != blank -%}
                        <div class="nw-human-biologist__insight-quote{% if block.settings.is_italic %} is-italic{% endif %}">
                          {{ block.settings.quote }}
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </div>

          {%- if section.settings.show_dots and insight_slides.size > 1 -%}
            <div class="nw-human-biologist__insights-pagination swiper-pagination" id="nw-human-biologist-pagination-{{ section.id }}"></div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function() {
    function initBiologistSlider() {
      if (typeof Swiper === 'undefined') {
        var script = document.querySelector('#nw-swiper-bundle-js');
        if (!script) {
          script = document.createElement('script');
          script.id = 'nw-swiper-bundle-js';
          script.src = '{{ "nw-swiper-bundle.min.js" | asset_url }}';
          script.onload = runBiologistSlider;
          document.head.appendChild(script);
        } else {
          script.addEventListener('load', runBiologistSlider);
          var checkCount = 0;
          var checkSwiper = setInterval(function() {
            checkCount++;
            if (typeof Swiper !== 'undefined' || checkCount > 60) {
              clearInterval(checkSwiper);
              if (typeof Swiper !== 'undefined') runBiologistSlider();
            }
          }, 50);
        }
      } else {
        runBiologistSlider();
      }
    }

    function runBiologistSlider() {
      var sliderEl = document.querySelector('#nw-human-biologist-insights-{{ section.id }}');
      if (!sliderEl) return;
      if (sliderEl.swiper) sliderEl.swiper.destroy(true, true);
      var slideCount = sliderEl.querySelectorAll('.swiper-slide').length;

      var swiperOptions = {
        slidesPerView: 1,
        spaceBetween: 16,
        loop: slideCount > 1,
        speed: 500,
        grabCursor: true,
        autoHeight: true
      };

      {% if section.settings.enable_autoplay %}
      swiperOptions.autoplay = {
        delay: {{ section.settings.autoplay_delay | default: 4 | times: 1000 }},
        disableOnInteraction: false,
        pauseOnMouseEnter: true
      };
      {% endif %}

      {% if section.settings.show_dots %}
      swiperOptions.pagination = {
        el: '#nw-human-biologist-pagination-{{ section.id }}',
        clickable: true
      };
      {% endif %}

      new Swiper(sliderEl, swiperOptions);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBiologistSlider);
    } else {
      initBiologistSlider();
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.target.classList.contains('section-{{ section.id }}') || e.target.querySelector('.section-{{ section.id }}')) {
        initBiologistSlider();
      }
    });

    document.addEventListener('shopify:section:select', function(e) {
      var sliderEl = document.querySelector('#nw-human-biologist-insights-{{ section.id }}');
      if (sliderEl && sliderEl.swiper) {
        sliderEl.swiper.update();
      }
    });
  })();
</script>

