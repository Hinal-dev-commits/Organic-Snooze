{{ 'nw-marquee.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-marquee.js' | asset_url }}" defer="defer"></script>

<nw-marquee
  id="NwMarquee-{{ section.id }}"
  class="nw-marquee-section nw-marquee--{{ section.settings.direction }}{% if section.settings.pause_on_hover %} nw-marquee--pause-hover{% endif %}{% if section.settings.enable_parallax %} nw-marquee--parallax{% endif %}{%- render 'nw-scroll-animation' -%}"
  style="
    --nw-marquee-bg: {{ section.settings.bg_color }};
    --nw-marquee-color: {{ section.settings.text_color }};
    --nw-marquee-icon-color: {{ section.settings.icon_color }};
    --nw-marquee-speed: {{ section.settings.speed }}s;
    --nw-marquee-font-size-dt: {{ section.settings.font_size_desktop }}px;
    --nw-marquee-font-size-mb: {{ section.settings.font_size_mobile }}px;
    --nw-marquee-font-weight: {{ section.settings.font_weight }};
    --nw-marquee-text-transform: {{ section.settings.text_transform }};
    --nw-marquee-letter-spacing: {{ section.settings.letter_spacing }}px;
    --nw-marquee-gap-dt: {{ section.settings.gap_items_desktop }}px;
    --nw-marquee-gap-mb: {{ section.settings.gap_items_mobile }}px;
    --nw-marquee-icon-gap-dt: {{ section.settings.gap_icon_text_desktop }}px;
    --nw-marquee-icon-gap-mb: {{ section.settings.gap_icon_text_mobile }}px;
    --nw-marquee-icon-size-dt: {{ section.settings.icon_size_desktop }}px;
    --nw-marquee-icon-size-mb: {{ section.settings.icon_size_mobile }}px;
    --nw-marquee-min-height-dt: {{ section.settings.section_height_desktop }}px;
    --nw-marquee-min-height-mb: {{ section.settings.section_height_mobile }}px;
    --nw-marquee-padding-top-dt: {{ section.settings.padding_top_desktop }}px;
    --nw-marquee-padding-bottom-dt: {{ section.settings.padding_bottom_desktop }}px;
    --nw-marquee-padding-top-mb: {{ section.settings.padding_top_mobile }}px;
    --nw-marquee-padding-bottom-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
  data-direction="{{ section.settings.direction }}"
  data-parallax="{{ section.settings.enable_parallax }}"
>
  <div class="nw-marquee__wrapper">
    <div class="nw-marquee__track">
      {%- for i in (1..2) -%}
        <div class="nw-marquee__group" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}">
          {%- for repeat_idx in (1..section.settings.repeat_count) -%}
            {%- for block in section.blocks -%}
              {%- liquid
                assign icon_to_show = block.settings.icon_override
                if icon_to_show == 'inherit'
                  assign icon_to_show = section.settings.icon
                endif
              -%}
              <div class="nw-marquee__item"{% if i == 1 and repeat_idx == 1 %} {{ block.shopify_attributes }}{% endif %}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="nw-marquee__link">
                {%- endif -%}

                {%- if block.settings.use_custom_icon -%}
                  {%- if block.settings.image_icon != blank -%}
                    <span class="nw-marquee__icon nw-marquee__icon--image">
                      {{ block.settings.image_icon | image_url: width: 100 | image_tag: loading: 'lazy', class: 'nw-marquee__custom-img', alt: block.settings.text }}
                    </span>
                  {%- endif -%}
                {%- elsif section.settings.custom_icon_image != blank and icon_to_show != 'none' and block.settings.icon_override == 'inherit' -%}
                  <span class="nw-marquee__icon nw-marquee__icon--image">
                    {{ section.settings.custom_icon_image | image_url: width: 100 | image_tag: loading: 'lazy', class: 'nw-marquee__custom-img', alt: block.settings.text }}
                  </span>
                {%- elsif icon_to_show != 'none' -%}
                  <span class="nw-marquee__icon">
                    {%- if icon_to_show == 'verified' -%}
                      {% render 'nw-icon', icon: 'verified-2' %}
                    {%- else -%}
                      {% render 'nw-icon', icon: icon_to_show %}
                    {%- endif -%}
                  </span>
                {%- endif -%}

                <span class="nw-marquee__text">{{ block.settings.text }}</span>

                {%- if block.settings.link != blank -%}
                  </a>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</nw-marquee>

{% schema %}
{
  "name": "t:sections.nw-marquee.name",
  "tag": "section",
  "class": "section-nw-marquee",
  "settings": [
    {
      "type": "header",
      "content": "ANIMATION & MOTION"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll Direction",
      "options": [
        {
          "value": "right_to_left",
          "label": "Right To Left"
        },
        {
          "value": "left_to_right",
          "label": "Left To Right"
        }
      ],
      "default": "right_to_left"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll Speed",
      "min": 5,
      "max": 80,
      "step": 1,
      "unit": "s",
      "default": 25
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause On Hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_parallax",
      "label": "Enable Parallax Scroll Effect",
      "default": false
    },
    {
      "type": "range",
      "id": "repeat_count",
      "label": "Loop Item Repeat Count",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "COLORS"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color",
      "label": "Background Color",
      "default": "#613916"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#F4EFE8"
    },
    {
      "type": "header",
      "content": "ICON SETTINGS"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Default Icon",
      "options": [
        {
          "value": "verified",
          "label": "Verified Badge"
        },
        {
          "value": "star",
          "label": "Star"
        },
        {
          "value": "checkmark",
          "label": "Checkmark"
        },
        {
          "value": "leaf",
          "label": "Leaf"
        },
        {
          "value": "shield",
          "label": "Shield"
        },
        {
          "value": "heart",
          "label": "Heart"
        },
        {
          "value": "truck",
          "label": "Truck"
        },
        {
          "value": "award",
          "label": "Award"
        },
        {
          "value": "sparkle",
          "label": "Sparkle"
        },
        {
          "value": "moon",
          "label": "Moon"
        },
        {
          "value": "sun",
          "label": "Sun"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "verified"
    },
    {
      "type": "image_picker",
      "id": "custom_icon_image",
      "label": "Default Custom Icon Image"
    },
    {
      "type": "range",
      "id": "icon_size_desktop",
      "label": "Icon Size (Desktop)",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "label": "Icon Size (Mobile)",
      "min": 10,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "TYPOGRAPHY"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "label": "Font Size (Desktop)",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font Size (Mobile)",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "font_weight",
      "label": "Font Weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 500
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text Transform",
      "options": [
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter Spacing",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "SPACING & DIMENSIONS"
    },
    {
      "type": "range",
      "id": "gap_icon_text_desktop",
      "label": "Gap Between Icon & Text (Desktop)",
      "min": 2,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "gap_icon_text_mobile",
      "label": "Gap Between Icon & Text (Mobile)",
      "min": 2,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "gap_items_desktop",
      "label": "Gap Between Items (Desktop)",
      "min": 6,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "gap_items_mobile",
      "label": "Gap Between Items (Mobile)",
      "min": 4,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "section_height_desktop",
      "label": "Min Section Height (Desktop)",
      "min": 30,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "section_height_mobile",
      "label": "Min Section Height (Mobile)",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "header",
      "content": "SECTION PADDING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top Padding (Desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom Padding (Desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Top Padding (Mobile)",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Bottom Padding (Mobile)",
      "default": 14
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Marquee Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "100% ORGANIC MATERIALS"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "use_custom_icon",
          "label": "Use Custom Icon Image",
          "default": false
        },
        {
          "type": "select",
          "id": "icon_override",
          "label": "Icon Override",
          "visible_if": "{{ block.settings.use_custom_icon == false }}",
          "options": [
            {
              "value": "verified",
              "label": "Verified Badge"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "checkmark",
              "label": "Checkmark"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "award",
              "label": "Award"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            },
            {
              "value": "moon",
              "label": "Moon"
            },
            {
              "value": "sun",
              "label": "Sun"
            },
            {
              "value": "none",
              "label": "No Icon"
            }
          ],
          "default": "verified"
        },
        {
          "type": "image_picker",
          "id": "image_icon",
          "label": "Custom Image Icon",
          "visible_if": "{{ block.settings.use_custom_icon == true }}"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.nw-marquee.name",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "100% ORGANIC MATERIALS"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "MADE IN THE USA"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "NO CHEMICAL FOAMS"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "30-YEAR WARRANTY"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "100-NIGHT TRIAL"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "FREE WHITE-GLOVE DELIVERY"
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["index"]
  }
}
{% endschema %}
