{{ 'nw-swiper-bundle.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'nw-collection-list.js' | asset_url }}" defer="defer"></script>
{{ 'nw-collection-list.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign collection_blocks = section.blocks | where: 'type', 'collection'
  assign trust_badge_blocks = section.blocks | where: 'type', 'trust_badge'
  assign slide_count = collection_blocks.size
-%}

<style>
  .nw-collection-list.section-{{ section.id }} {
    --nw-star-active: {{ section.settings.star_color | default: '#E57B1E' }};
    --nw-star-inactive: {{ section.settings.star_color_inactive | default: '#D1D5DB' }};
    --nw-collection-fade-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
    position: relative;
    background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
    padding-top: {{ section.settings.padding_top_desktop | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop | default: 80 }}px;
    isolation: isolate;
    overflow: hidden;
    {% if section.settings.bg_type == 'gradient' and section.settings.bg_gradient != blank %}
      background: {{ section.settings.bg_gradient }};
    {% elsif section.settings.bg_type == 'none' %}
      background: transparent;
    {% endif %}
  }

  {%- if section.settings.bg_image != blank and section.settings.bg_type != 'none' -%}
    .nw-collection-list.section-{{ section.id }}::before {
      content: "";
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background-image: url('{{ section.settings.bg_image | image_url: width: 2880 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      opacity: calc({{ section.settings.bg_image_opacity | default: 100 }} / 100);
      z-index: -1;
      pointer-events: none;
    }
  {%- endif -%}

  {%- unless section.settings.show_fade -%}
    .nw-collection-list.section-{{ section.id }} .nw-collection-list__slider-wrap::before,
    .nw-collection-list.section-{{ section.id }} .nw-collection-list__slider-wrap::after {
      display: none !important;
    }
  {%- endunless -%}

  @media screen and (max-width: 749px) {
    .nw-collection-list.section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile | default: 48 }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile | default: 48 }}px;
    }

    {%- if section.settings.bg_image_mobile != blank and section.settings.bg_type != 'none' -%}
      .nw-collection-list.section-{{ section.id }}::before {
        background-image: url('{{ section.settings.bg_image_mobile | image_url: width: 1200 }}');
      }
    {%- endif -%}
  }
</style>

<nw-collection-list
  class="nw-collection-list nw-main-section section-{{ section.id }}"
  data-enable-autoplay="{{ section.settings.enable_autoplay }}"
  data-autoplay-delay="{{ section.settings.autoplay_delay | default: 4 | times: 1000 }}"
  data-show-arrows="{{ section.settings.show_arrows }}"
  data-show-dots="{{ section.settings.show_dots }}"
>
  <div class="nw-collection-list__container">
    <div class="nw-collection-list__inner{%- render 'nw-scroll-animation' -%}">
      <div class="nw-collection-list__header">
        {%- if section.settings.show_rating -%}
          {%- assign active_stars = section.settings.star_rating | default: 5 | plus: 0 -%}
          <div class="nw-rating">
            <div class="nw-stars" aria-label="{{ active_stars }} out of 5 stars">
              {%- for i in (1..5) -%}
                <span class="nw-star{% if i <= active_stars %} nw-star--active{% endif %}">
                  <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path d="M8 0.5L10.247 5.053L15.266 5.783L11.633 9.324L12.49 14.317L8 11.956L3.51 14.317L4.367 9.324L0.734 5.783L5.753 5.053L8 0.5Z"/>
                  </svg>
                </span>
              {%- endfor -%}
            </div>
            {%- if section.settings.eyebrow != blank -%}
              <span class="nw-eyebrow">{{ section.settings.eyebrow }}</span>
            {%- endif -%}
          </div>
        {%- elsif section.settings.eyebrow != blank -%}
          <p class="nw-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          {% render 'nw-section-heading', text: section.settings.heading, section_index: section.index %}
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          {% render 'nw-section-description', text: section.settings.subheading %}
        {%- endif -%}
      </div>

      {%- if slide_count > 0 -%}
        <div class="nw-collection-list__slider-wrap">
          {%- if section.settings.show_arrows and slide_count > 1 -%}
            {% render 'nw-swiper-arrows', prev_label: 'Previous collections', next_label: 'Next collections' %}
          {%- endif -%}

          <div class="swiper" id="nw-collection-list-{{ section.id }}" data-nw-collection-slider>
            <div class="swiper-wrapper">
              {%- for block in collection_blocks -%}
                {%- liquid
                  assign selected_collection = block.settings.collection
                  assign card_title = block.settings.custom_title
                  if card_title == blank and selected_collection != blank
                    assign card_title = selected_collection.title
                  endif
                  if card_title == blank
                    assign card_title = 'Collection'
                  endif

                  assign card_url = block.settings.custom_link
                  if card_url == blank and selected_collection != blank
                    assign card_url = selected_collection.url
                  endif

                  assign card_image = block.settings.custom_image
                  if card_image == blank and selected_collection != blank and selected_collection.image != blank
                    assign card_image = selected_collection.image
                  elsif card_image == blank and selected_collection != blank and selected_collection.products.first.featured_media.preview_image != blank
                    assign card_image = selected_collection.products.first.featured_media.preview_image
                  endif
                -%}

                <div class="swiper-slide" {{ block.shopify_attributes }}>
                  {%- if card_url != blank -%}
                    <a href="{{ card_url }}" class="nw-collection-list__card">
                  {%- else -%}
                    <div class="nw-collection-list__card">
                  {%- endif -%}
                    {%- if card_image != blank -%}
                      <img
                        src="{{ card_image | image_url: width: 800 }}"
                        alt="{{ card_title | escape }}"
                        width="282"
                        height="423"
                        loading="lazy"
                        class="nw-collection-list__card-image"
                      >
                    {%- else -%}
                      <div class="nw-collection-list__card-placeholder" aria-hidden="true"></div>
                    {%- endif -%}
                    {%- if card_title != blank -%}
                    <div class="nw-collection-list__card-label">
                      <p class="nw-collection-list__card-title">{{ card_title }}</p>
                    </div>
                    {%- endif -%}
                  {%- if card_url != blank -%}
                    </a>
                  {%- else -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          </div>

        </div>

        {%- if section.settings.show_dots and slide_count > 1 -%}
          <div class="nw-collection-list__pagination swiper-pagination" id="nw-collection-list-pagination-{{ section.id }}" data-nw-collection-pagination></div>
        {%- endif -%}
      {%- endif -%}
      {% if section.settings.button_label != blank or trust_badge_blocks.size > 0 %}
        <div class="nw-collection-list__actions">
          {% render 'nw-cta-badges', settings: section.settings, blocks: trust_badge_blocks, class: 'nw-collection-list__actions' %}
        </div>
      {% endif %}
    </div>
  </div>
</nw-collection-list>

{% schema %}
{
  "name": "NW Collection List",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "SECTION HEADER"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating Stars",
      "default": true
    },
    {
      "type": "range",
      "id": "star_rating",
      "label": "Star Rating (Active Stars)",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "star_color",
      "label": "Active Star Color",
      "default": "#E57B1E",
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "star_color_inactive",
      "label": "Inactive Star Color",
      "default": "#D1D5DB",
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Real sleepers, real mornings"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Explore Our Collections"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Find the right organic sleep essentials for every stage of your recovery.</p>"
    },
    {
      "type": "header",
      "content": "SLIDER CONTROLS"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Navigation Arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show Pagination Dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_fade",
      "label": "Show Left/Right Fade Shadows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay Delay (Seconds)",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4,
      "visible_if": "{{ section.settings.enable_autoplay == true }}"
    },
    {
      "type": "header",
      "content": "BUTTON"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "SHOP ALL",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "default": "primary",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ],
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "header",
      "content": "BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "image", "label": "Image" },
        { "value": "gradient", "label": "Gradient" }
      ]
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.bg_type == 'color' or section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "range",
      "id": "bg_image_opacity",
      "label": "Background Image Opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile Optional)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title (Overrides Collection Name)"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image (Overrides Collection Image)"
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom Link (Optional)"
        }
      ]
    },
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "trial", "label": "100-Night Trial" },
            { "value": "warranty", "label": "Warranty" },
            { "value": "shipping", "label": "Shipping" },
            { "value": "financing", "label": "Financing" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "moon", "label": "Moon" },
            { "value": "star", "label": "Star" },
            { "value": "shield", "label": "Shield" },
            { "value": "verified", "label": "Verified" },
            { "value": "custom", "label": "Custom Image" },
            { "value": "none", "label": "None" }
          ],
          "default": "trial"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image",
          "visible_if": "{{ block.settings.icon == 'custom' }}"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Badge Text",
          "default": "100-Night Risk-Free Trial"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NW Collection List",
      "category": "NW Sections",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "custom_title": "Bedding"
          }
        },
        {
          "type": "collection",
          "settings": {
            "custom_title": "Mattresses"
          }
        },
        {
          "type": "collection",
          "settings": {
            "custom_title": "Kids"
          }
        },
        {
          "type": "collection",
          "settings": {
            "custom_title": "Bases"
          }
        },
        {
          "type": "collection",
          "settings": {
            "custom_title": "Bundle & Save"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "trial",
            "text": "100-Night Risk-Free Trial"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "warranty",
            "text": "30-Year Warranty"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "shipping",
            "text": "Free Shipping"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "financing",
            "text": "0% Interest financing options"
          }
        }
      ]
    }
  ]
}
{% endschema %}
