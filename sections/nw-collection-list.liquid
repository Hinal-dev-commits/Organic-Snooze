<script src="{{ 'nw-collection-list.js' | asset_url }}" defer="defer"></script>
{{ 'nw-collection-list.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign collection_blocks = section.blocks | where: 'type', 'collection'
  assign slide_count = collection_blocks.size
  assign trust_badge_blocks = section.blocks | where: 'type', 'trust_badge'
-%}

{%- assign nw_shell_selector = '.nw-collection-list.section-' | append: section.id -%}
{% capture nw_shell_extra %}
  {% render 'nw-section-color-var', name: '--nw-star-active', value: section.settings.star_color %}
  {% render 'nw-section-color-var', name: '--nw-star-inactive', value: section.settings.star_color_inactive %}
  {%- if section.settings.bg_color != blank -%}
    --nw-collection-fade-color: {{ section.settings.bg_color }};
  {%- endif -%}
{% endcapture %}
{% render 'nw-section-shell', selector: nw_shell_selector, extra: nw_shell_extra %}
{% render 'nw-section-text-colors', selector: nw_shell_selector %}
{%- unless section.settings.show_fade -%}
  <style>
    .nw-collection-list.section-{{ section.id }} .nw-collection-list__slider-wrap::before,
    .nw-collection-list.section-{{ section.id }} .nw-collection-list__slider-wrap::after {
      display: none !important;
    }
  </style>
{% endunless %}

<style>
  .nw-collection-list.section-{{ section.id }} .nw-collection-list__card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<nw-collection-list
  class="nw-collection-list nw-main-section section-{{ section.id }}{% if section.settings.no_loop %} nw-no-loop{% endif %}"
  data-slide-count="{{ slide_count }}"
  data-no-loop="{{ section.settings.no_loop }}"
  data-enable-autoplay="{{ section.settings.enable_autoplay }}"
  data-autoplay-delay="{{ section.settings.autoplay_delay | default: 4 | times: 1000 }}"
  data-show-arrows="{{ section.settings.show_arrows }}"
  data-show-dots="{{ section.settings.show_dots }}"
>
  <div class="nw-collection-list__container">
    <div class="nw-collection-list__inner{%- render 'nw-scroll-animation' -%}">
      <div class="nw-collection-list__header">
        {% render 'nw-section-header',
          show_rating: section.settings.show_rating,
          rating: section.settings.star_rating,
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          description: section.settings.subheading,
          section_index: section.index
        %}
      </div>

      {%- if slide_count > 0 -%}
        <div class="nw-collection-list__slider-wrap">
          {%- if section.settings.show_arrows and slide_count > 1 -%}
            {% render 'nw-swiper-arrows', prev_label: 'Previous collections', next_label: 'Next collections' %}
          {%- endif -%}

          {%- liquid
            assign repeat_times = 1
            unless section.settings.no_loop
              if slide_count > 0 and slide_count < 6
                assign repeat_times = 3
              elsif slide_count >= 6 and slide_count < 10
                assign repeat_times = 2
              endif
            endunless
          -%}
          <div class="swiper" id="nw-collection-list-{{ section.id }}" data-nw-collection-slider>
            <div class="swiper-wrapper">
              {%- for r in (1..repeat_times) -%}
                {%- for block in collection_blocks -%}
                  {%- liquid
                    assign selected_collection = block.settings.collection
                    assign card_title = block.settings.custom_title
                    if card_title == blank and selected_collection != blank
                      assign card_title = selected_collection.title
                    endif
                    if card_title == blank
                      assign card_title = 'Collection'
                    endif

                    assign card_url = block.settings.custom_link
                    if card_url == blank and selected_collection != blank
                      assign card_url = selected_collection.url
                    endif
                    if card_url == blank
                      assign card_url = '#'
                    endif

                    assign card_image = block.settings.custom_image
                    if card_image == blank and selected_collection != blank and selected_collection.image != blank
                      assign card_image = selected_collection.image
                    elsif card_image == blank and selected_collection != blank and selected_collection.products.first.featured_media.preview_image != blank
                      assign card_image = selected_collection.products.first.featured_media.preview_image
                    endif
                  -%}

                  <div class="swiper-slide"{% if r == 1 %} {{ block.shopify_attributes }}{% endif %}>
                    {%- if card_url != blank -%}
                      <a href="{{ card_url }}" class="nw-collection-list__card">
                    {%- else -%}
                      <div class="nw-collection-list__card">
                    {%- endif -%}
                      {%- if card_image != blank -%}
                        <img
                          src="{{ card_image | image_url: width: 800 }}"
                          alt="{{ card_title | escape }}"
                          width="282"
                          height="423"
                          loading="lazy"
                          class="nw-collection-list__card-image"
                        >
                      {%- else -%}
                        <div class="nw-collection-list__card-placeholder" aria-hidden="true"></div>
                      {%- endif -%}
                      {%- if card_title != blank -%}
                      <div class="nw-collection-list__card-label">
                        <p class="nw-collection-list__card-title">{{ card_title }}</p>
                      </div>
                      {%- endif -%}
                    {%- if card_url != blank -%}
                      </a>
                    {%- else -%}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              {%- endfor -%}
            </div>
          </div>

        </div>

        {%- if section.settings.show_dots and slide_count > 1 -%}
          <div class="nw-swiper-pagination" id="nw-collection-list-pagination-{{ section.id }}" data-nw-collection-pagination>
            {%- for block in collection_blocks -%}
              <button
                type="button"
                class="swiper-pagination-bullet{% if forloop.first %} swiper-pagination-bullet-active{% endif %}"
                data-bullet-index="{{ forloop.index0 }}"
                aria-label="Go to collection {{ forloop.index }}"
              ></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.show_button or trust_badge_blocks.size > 0 or section.settings.show_features -%}
        <div class="nw-collection-list__actions">
          {% render 'nw-cta-badges',
            settings: section.settings,
            blocks: trust_badge_blocks,
            class: 'nw-collection-list__actions'
          %}
        </div>
      {%- endif -%}
    </div>
  </div>
</nw-collection-list>

{% schema %}
{
  "name": "t:sections.nw-collection-list.name",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "SECTION HEADER"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating Stars",
      "default": true
    },
    {
      "type": "range",
      "id": "star_rating",
      "label": "Star Rating (Active Stars)",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "star_color",
      "label": "Active Star Color",
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "star_color_inactive",
      "label": "Inactive Star Color",
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Real sleepers, real mornings"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Explore Our Collections"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Find the right organic sleep essentials for every stage of your recovery.</p>"
    },
    {
      "type": "header",
      "content": "TEXT COLORS"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "heading_color",
      "label": "Heading Color"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "description_color",
      "label": "Description Color"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "eyebrow_color",
      "label": "Eyebrow Color"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "text_color",
      "label": "Body Text Color"
    },
    {
      "type": "header",
      "content": "SLIDER CONTROLS"
    },
    {
      "type": "checkbox",
      "id": "no_loop",
      "label": "No Loop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Navigation Arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show Pagination Dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_fade",
      "label": "Show Side Fade Overlays",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay Delay (Seconds)",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4,
      "visible_if": "{{ section.settings.enable_autoplay == true }}"
    },
    {
      "type": "header",
      "content": "BUTTON"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "SHOP ALL",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "default": "primary",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ],
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "header",
      "content": "FEATURES / BADGES"
    },
    {
      "type": "checkbox",
      "id": "show_features",
      "label": "Show Features / Badges Row",
      "default": true
    },
    {
      "type": "header",
      "content": "BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "image", "label": "Image" },
        { "value": "gradient", "label": "Gradient" }
      ]
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color",
      "label": "Background Color",
      "visible_if": "{{ section.settings.bg_type == 'color' or section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "range",
      "id": "bg_image_opacity",
      "label": "Background Image Opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile Optional)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title (Overrides Collection Name)"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image (Overrides Collection Image)"
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom Link (Optional)"
        }
      ]
    },
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "checkbox",
          "id": "use_custom_icon",
          "label": "Use Custom Icon Image",
          "default": false
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Badge Icon",
          "default": "moneyback",
          "visible_if": "{{ block.settings.use_custom_icon == false }}",
          "options": [
            { "value": "moneyback", "label": "100-Night Trial / Moneyback" },
            { "value": "warranty", "label": "Warranty" },
            { "value": "shipping", "label": "Shipping / Truck" },
            { "value": "financing", "label": "Financing / Offer" },
            { "value": "shield", "label": "Shield" },
            { "value": "none", "label": "None" }
          ]
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image",
          "visible_if": "{{ block.settings.use_custom_icon == true }}"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Badge Text",
          "default": "100-Night Risk-Free Trial"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.nw-collection-list.name",
      "category": "NW Sections",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "custom_title": "Bedding"
          }
        },
        {
          "type": "collection",
          "settings": {
            "custom_title": "Mattresses"
          }
        },
        {
          "type": "collection",
          "settings": {
            "custom_title": "Kids"
          }
        },
        {
          "type": "collection",
          "settings": {
            "custom_title": "Bases"
          }
        },
        {
          "type": "collection",
          "settings": {
            "custom_title": "Bundle & Save"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "moneyback",
            "text": "100-Night Risk-Free Trial"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "warranty",
            "text": "30-Year Warranty"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "shipping",
            "text": "Free Shipping"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "financing",
            "text": "0% Interest Financing Options"
          }
        }
      ]
    }
  ]
}
{% endschema %}
