{%- liquid
  assign nw_shell_selector = '#NwBlogLatest-' | append: section.id
  assign article_source = section.settings.article_source | default: 'blog'
  assign selected_blog = section.settings.blog
  assign selected_articles = section.settings.article
  assign selected_articles_count = section.settings.article.count | default: 0
  assign bl_similar_mf = blank
  assign bl_similar_mf_list = blank
  if article != blank
    assign bl_similar_mf = article.metafields.custom.similar_article
    if bl_similar_mf == blank
      assign bl_similar_mf = article.metafields.custom.similar_articles
    endif
    if bl_similar_mf != blank
      assign bl_similar_mf_list = bl_similar_mf.value
      if bl_similar_mf_list == blank
        assign bl_similar_mf_list = bl_similar_mf
      endif
    endif
  endif
  assign bl_selected_ids = ''
  assign bl_selected_count = 0
  assign bl_metafield_count = 0
  assign bl_selection_source = ''
  assign bl_selection_source_label = ''
  assign bl_selected_titles_display = ''
  assign bl_use_metafield_selection = false
  assign bl_category_count = 0
  assign bl_current_topic = blank
  assign bl_show_selected_blog = false
  assign post_limit = section.settings.post_limit | default: 6
  assign slides_desktop = section.settings.slides_desktop | default: 4
  if post_limit < 1
    assign post_limit = 1
  endif
  if slides_desktop < 1
    assign slides_desktop = 1
  endif
  if slides_desktop > 4
    assign slides_desktop = 4
  endif
  assign pagination_id = 'NwBlogLatestPagination-' | append: section.id
  assign has_articles = false
  assign hide_section = false
  if article != blank
    assign bl_use_metafield_selection = true
  elsif article_source == 'metafields'
    assign bl_use_metafield_selection = true
  endif

  if bl_use_metafield_selection
      assign bl_source_blog = blank
      if selected_blog != blank
        assign bl_source_blog = selected_blog
      elsif article != blank and article.blog != blank
        assign bl_source_blog = article.blog
      endif
      if bl_source_blog != blank and bl_source_blog.handle != blank and blogs[bl_source_blog.handle] != blank
        assign bl_source_blog = blogs[bl_source_blog.handle]
      endif

      if bl_similar_mf_list != blank
        if bl_similar_mf_list.title != blank
          assign bl_mf_item = bl_similar_mf_list
          if bl_mf_item.value != blank
            assign bl_mf_item = bl_mf_item.value
          endif
          if bl_mf_item != blank and bl_mf_item.title != blank and bl_mf_item.id != article.id
            assign bl_metafield_count = 1
          endif
        else
          for bl_mf_item in bl_similar_mf_list limit: post_limit
            assign bl_mf_article = bl_mf_item
            if bl_mf_article.value != blank
              assign bl_mf_article = bl_mf_article.value
            endif
            if bl_mf_article == blank or bl_mf_article.title == blank
              assign article_path = bl_mf_item | strip
              if article_path contains '/'
                assign article_path_parts = article_path | split: '/'
                assign article_blog_handle = article_path_parts.first
                assign article_handle = article_path_parts.last
                assign bl_mf_article = blank
                if article_blog_handle != blank and article_handle != blank and blogs[article_blog_handle] != blank
                  for bl_mf_candidate in blogs[article_blog_handle].articles
                    if bl_mf_candidate.handle == article_handle
                      assign bl_mf_article = bl_mf_candidate
                      break
                    endif
                  endfor
                endif
              else
                assign bl_mf_article = articles[article_path]
              endif
            endif
            if bl_mf_article != blank and bl_mf_article.title != blank and bl_mf_article.id != article.id
              assign bl_metafield_count = bl_metafield_count | plus: 1
            endif
          endfor
        endif
      endif

      if bl_metafield_count > 0
        assign bl_selection_source = 'metafield'
        assign bl_selection_source_label = 'Related Articles Metafield'
      endif

      if bl_metafield_count == 0 and bl_source_blog != blank
        assign bl_current_topic = blank
        if article != blank
          assign bl_current_topic_mf = article.metafields.custom.blog_tag
          if bl_current_topic_mf != blank
            if bl_current_topic_mf.value != blank
              assign bl_current_topic = bl_current_topic_mf.value | strip
            else
              assign bl_current_topic = bl_current_topic_mf | strip
            endif
          endif
          if bl_current_topic == blank and article.tags.size > 0
            assign bl_current_topic = article.tags.first | strip
          endif
        endif
        assign bl_current_topic_handle = bl_current_topic | handleize

        if bl_current_topic_handle != blank and article != blank
          for candidate in bl_source_blog.articles limit: 50
            if article != blank and candidate.id == article.id
              continue
            endif
            assign candidate_match = false
            if bl_current_topic != blank and candidate.tags contains bl_current_topic
              assign candidate_match = true
            endif
            unless candidate_match
              assign cand_topic = blank
              assign cand_topic_mf = candidate.metafields.custom.blog_tag
              if cand_topic_mf != blank
                if cand_topic_mf.value != blank
                  assign cand_topic = cand_topic_mf.value | strip
                else
                  assign cand_topic = cand_topic_mf | strip
                endif
              endif
              if cand_topic == blank and candidate.tags.size > 0
                assign cand_topic = candidate.tags.first | strip
              endif
              if cand_topic != blank
                assign cand_topic_handle = cand_topic | handleize
                if cand_topic_handle == bl_current_topic_handle
                  assign candidate_match = true
                endif
              endif
            endunless
            unless candidate_match
              for cand_shop_tag in candidate.tags
                assign cand_shop_tag = cand_shop_tag | strip
                if cand_shop_tag != blank
                  assign cand_shop_tag_handle = cand_shop_tag | handleize
                  if cand_shop_tag_handle == bl_current_topic_handle
                    assign candidate_match = true
                    break
                  endif
                endif
              endfor
            endunless
            if candidate_match and candidate.blog != blank
              assign ref_token = candidate.blog.handle | append: '/' | append: candidate.handle
              assign id_check = '|' | append: ref_token | append: '|'
              assign ids_wrapped = '|' | append: bl_selected_ids | append: '|'
              unless ids_wrapped contains id_check
                if bl_selected_ids != blank
                  assign bl_selected_ids = bl_selected_ids | append: '|'
                endif
                assign bl_selected_ids = bl_selected_ids | append: ref_token
                assign bl_category_count = bl_category_count | plus: 1
                assign bl_selected_count = bl_selected_count | plus: 1
              endunless
            endif
            if bl_category_count >= post_limit
              break
            endif
          endfor
        endif

        if bl_category_count > 0 and bl_selection_source == blank
          assign bl_selection_source = 'category'
          assign bl_selection_source_label = 'Same category (NW Blog Info topic)'
        endif

        if bl_category_count == 0
          assign bl_selected_ids = ''
          assign bl_selected_count = 0
          for candidate in bl_source_blog.articles limit: 50
            if article != blank and candidate.id == article.id
              continue
            endif
            if candidate.blog == blank
              continue
            endif
            assign ref_token = candidate.blog.handle | append: '/' | append: candidate.handle
            assign id_check = '|' | append: ref_token | append: '|'
            assign ids_wrapped = '|' | append: bl_selected_ids | append: '|'
            unless ids_wrapped contains id_check
              if bl_selected_ids != blank
                assign bl_selected_ids = bl_selected_ids | append: '|'
              endif
              assign bl_selected_ids = bl_selected_ids | append: ref_token
              assign bl_selected_count = bl_selected_count | plus: 1
            endunless
            if bl_selected_count >= post_limit
              break
            endif
          endfor
        endif

        if bl_category_count == 0 and bl_selected_count > 0 and bl_selection_source == blank
          assign bl_selection_source = 'latest'
          assign bl_selection_source_label = 'Latest Articles Fallback'
        endif
      endif

      if bl_metafield_count > 0
        assign has_articles = true
        if bl_similar_mf_list.title != blank
          assign bl_mf_title_article = bl_similar_mf_list
          if bl_mf_title_article.value != blank
            assign bl_mf_title_article = bl_mf_title_article.value
          endif
          if bl_mf_title_article != blank and bl_mf_title_article.title != blank
            assign bl_selected_titles_display = bl_mf_title_article.title
          endif
        else
          for bl_mf_item in bl_similar_mf_list limit: post_limit
            assign bl_mf_title_article = bl_mf_item
            if bl_mf_title_article.value != blank
              assign bl_mf_title_article = bl_mf_title_article.value
            endif
            if bl_mf_title_article != blank and bl_mf_title_article.title != blank and bl_mf_title_article.id != article.id
              if bl_selected_titles_display != blank
                assign bl_selected_titles_display = bl_selected_titles_display | append: ' • '
              endif
              assign bl_selected_titles_display = bl_selected_titles_display | append: bl_mf_title_article.title
            endif
          endfor
        endif
      elsif bl_selected_count > 0
        assign has_articles = true
        assign bl_ref_list_for_titles = bl_selected_ids | split: '|'
        for bl_title_ref in bl_ref_list_for_titles
          if bl_title_ref == blank
            continue
          endif
          assign bl_title_parts = bl_title_ref | split: '/'
          assign bl_title_blog_handle = bl_title_parts | first
          assign bl_title_article_handle = bl_title_parts | last
          if bl_title_blog_handle != blank and bl_title_article_handle != blank and blogs[bl_title_blog_handle] != blank
            assign bl_title_article = blank
            for bl_title_candidate in blogs[bl_title_blog_handle].articles
              if bl_title_candidate.handle == bl_title_article_handle
                assign bl_title_article = bl_title_candidate
                break
              endif
            endfor
            if bl_title_article != blank and bl_title_article.title != blank
              if bl_selected_titles_display != blank
                assign bl_selected_titles_display = bl_selected_titles_display | append: ' • '
              endif
              assign bl_selected_titles_display = bl_selected_titles_display | append: bl_title_article.title
            endif
          endif
        endfor
      elsif bl_source_blog != blank and bl_source_blog.articles_count > 0
        assign bl_show_selected_blog = true
        assign has_articles = true
        if bl_selection_source == blank
          assign bl_selection_source = 'latest'
          assign bl_selection_source_label = 'Latest Articles Fallback'
        endif
      elsif request.design_mode
        assign has_articles = false
      else
        assign hide_section = true
      endif
  elsif article_source == 'article_list' and selected_articles != blank
    assign has_articles = true
  elsif article_source == 'blog' and selected_blog != blank and selected_blog.articles_count > 0
    assign has_articles = true
  endif
  assign placeholder_count = post_limit
  if article_source == 'article_list'
    if selected_articles_count > 0
      assign placeholder_count = selected_articles_count
    else
      assign placeholder_count = 3
    endif
  elsif bl_use_metafield_selection
    if bl_metafield_count > 0
      assign placeholder_count = bl_metafield_count
    elsif bl_selected_count > 0
      assign placeholder_count = bl_selected_count
    else
      assign placeholder_count = 3
    endif
  endif
-%}

{%- unless hide_section -%}
{{ 'nw-cta-badges.css' | asset_url | stylesheet_tag }}
{{ 'nw-blog-latest.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-blog-latest.js' | asset_url }}" defer="defer"></script>
{% render 'nw-section-shell', selector: nw_shell_selector, mode: 'direct', default_bg: '#FFFFFF' %}
{% render 'nw-section-text-colors', selector: nw_shell_selector %}

<nw-blog-latest
  id="NwBlogLatest-{{ section.id }}"
  class="nw-blog-latest section-{{ section.id }}"
  data-show-arrows="{{ section.settings.show_arrows }}"
  data-show-pagination="{{ section.settings.show_pagination }}"
  data-pagination-id="{{ pagination_id }}"
  data-enable-autoplay="{{ section.settings.enable_autoplay }}"
  data-autoplay-delay="{{ section.settings.autoplay_delay | default: 4 | times: 1000 }}"
  data-slides-desktop="{{ slides_desktop }}"
  style="
    --nw-bl-slides-desktop: {{ slides_desktop }};
    --nw-bl-heading-color: {{ section.settings.heading_color }};
    --nw-bl-header-desc-color: {{ section.settings.description_color }};
    --nw-star-active: {{ section.settings.star_color }};
    --nw-star-inactive: {{ section.settings.star_inactive_color }};
    --nw-cta-badge-text: {{ section.settings.badge_text_color }};
    --nw-cta-badge-icon: {{ section.settings.badge_icon_color }};
    --nw-bl-tag-color: {{ section.settings.tag_color }};
    --nw-bl-title-color: {{ section.settings.title_color }};
    --nw-bl-excerpt-color: {{ section.settings.excerpt_color }};
    --nw-bl-meta-color: {{ section.settings.meta_color }};
    --nw-bl-card-bg: {{ section.settings.card_bg_color }};
    --nw-bl-card-border: {{ section.settings.card_border_color }};
    --nw-bl-media-bg: {{ section.settings.media_bg_color }};
    --nw-bl-badge-bg: {{ section.settings.badge_bg_color }};
    --nw-bl-badge-text: {{ section.settings.editor_badge_text_color }};
    --nw-bl-btn-bg: {{ section.settings.button_bg_color }};
    --nw-bl-btn-text: {{ section.settings.button_text_color }};
    --nw-swiper-bullet: {{ section.settings.pagination_color }};
    --nw-swiper-arrow-bg: {{ section.settings.swiper_arrow_bg }};
    --nw-swiper-arrow-color: {{ section.settings.swiper_arrow_color }};
  "
>
  <div class="page-width">
    {%- if request.design_mode and section.settings.show_selection_status -%}
      <div
        class="nw-blog-latest__selection-status"
        style="margin:0 0 24px;padding:16px 20px;border:1px dashed #cc926a;border-radius:8px;background:#faf7f2;font-family:var(--font-body-family);font-size:14px;line-height:1.5;color:#613916;"
        aria-live="polite"
      >
        <p style="margin:0 0 8px;font-weight:600;">Article selection (theme editor only)</p>
        {%- if bl_use_metafield_selection -%}
          {%- if article == blank -%}
            <p style="margin:0;">Preview an <strong>article</strong> page to see which source and articles are used.</p>
          {%- elsif bl_selection_source_label != blank -%}
            <p style="margin:0 0 8px;"><strong>Source:</strong> {{ bl_selection_source_label }}</p>
            {%- if bl_selected_titles_display != blank -%}
              <p style="margin:0;"><strong>Articles:</strong> {{ bl_selected_titles_display }}</p>
            {%- elsif bl_current_topic != blank -%}
              <p style="margin:0;"><strong>Topic:</strong> {{ bl_current_topic }}</p>
            {%- else -%}
              <p style="margin:0;">No articles selected (section hidden on storefront).</p>
            {%- endif -%}
          {%- else -%}
            <p style="margin:0;">No articles selected (section hidden on storefront).</p>
          {%- endif -%}
        {%- elsif article_source == 'article_list' -%}
          <p style="margin:0;"><strong>Source:</strong> Manual article list (section settings)</p>
        {%- elsif article_source == 'blog' -%}
          <p style="margin:0;"><strong>Source:</strong> Blog — latest from selected blog</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="nw-blog-latest__wrapper{%- render 'nw-scroll-animation' -%}">
      {%- if section.settings.show_rating
        or section.settings.eyebrow != blank
        or section.settings.heading != blank
        or section.settings.description != blank
      -%}
        <div class="nw-blog-latest__header">
          {% render 'nw-section-header',
            show_rating: section.settings.show_rating,
            rating: section.settings.star_rating,
            eyebrow: section.settings.eyebrow,
            heading: section.settings.heading,
            description: section.settings.description,
            section_index: section.index,
            heading_class: 'nw-blog-latest__heading'
          %}
        </div>
      {%- endif -%}

      <div class="nw-blog-latest__slider-wrap">
        {%- if section.settings.show_arrows -%}
          {% render 'nw-swiper-arrows', arrow_style: section.settings.arrow_style %}
        {%- endif -%}

        <div class="swiper nw-blog-latest__swiper" id="NwBlogLatestSwiper-{{ section.id }}">
          <div class="swiper-wrapper">
            {%- if has_articles -%}
              {%- if bl_use_metafield_selection -%}
                {%- if bl_metafield_count > 0 -%}
                  {%- if bl_similar_mf_list.title != blank -%}
                    {%- assign bl_mf_slide = bl_similar_mf_list -%}
                    {%- if bl_mf_slide.value != blank -%}
                      {%- assign bl_mf_slide = bl_mf_slide.value -%}
                    {%- endif -%}
                    {%- if bl_mf_slide != blank and bl_mf_slide.title != blank and bl_mf_slide.id != article.id -%}
                      <div class="swiper-slide">
                        {% render 'nw-blog-latest-card', article: bl_mf_slide, section: section %}
                      </div>
                    {%- endif -%}
                  {%- else -%}
                    {%- assign bl_mf_slides_rendered = 0 -%}
                    {%- for bl_mf_item in bl_similar_mf_list -%}
                      {%- assign bl_mf_slide = bl_mf_item -%}
                      {%- if bl_mf_slide.value != blank -%}
                        {%- assign bl_mf_slide = bl_mf_slide.value -%}
                      {%- endif -%}
                      {%- if bl_mf_slide == blank or bl_mf_slide.title == blank -%}
                        {%- assign article_path = bl_mf_item | strip -%}
                        {%- if article_path contains '/' -%}
                          {%- assign article_path_parts = article_path | split: '/' -%}
                          {%- assign article_blog_handle = article_path_parts.first -%}
                          {%- assign article_handle = article_path_parts.last -%}
                          {%- if article_blog_handle != blank and article_handle != blank and blogs[article_blog_handle] != blank -%}
                            {%- for bl_mf_slide in blogs[article_blog_handle].articles -%}
                              {%- if bl_mf_slide.handle == article_handle -%}
                                {%- break -%}
                              {%- endif -%}
                            {%- endfor -%}
                          {%- endif -%}
                        {%- else -%}
                          {%- assign bl_mf_slide = articles[article_path] -%}
                        {%- endif -%}
                      {%- endif -%}
                      {%- if bl_mf_slide != blank and bl_mf_slide.title != blank and bl_mf_slide.id != article.id -%}
                        <div class="swiper-slide">
                          {% render 'nw-blog-latest-card', article: bl_mf_slide, section: section %}
                        </div>
                        {%- assign bl_mf_slides_rendered = bl_mf_slides_rendered | plus: 1 -%}
                        {%- if bl_mf_slides_rendered >= post_limit -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                {%- elsif bl_selected_count > 0 -%}
                  {%- assign bl_ref_list = bl_selected_ids | split: '|' -%}
                  {%- for bl_ref_token in bl_ref_list -%}
                    {%- if bl_ref_token != blank -%}
                      {%- assign bl_ref_parts = bl_ref_token | split: '/' -%}
                      {%- assign bl_ref_blog_handle = bl_ref_parts | first -%}
                      {%- assign bl_ref_article_handle = bl_ref_parts | last -%}
                      {%- if bl_ref_blog_handle != blank and bl_ref_article_handle != blank and blogs[bl_ref_blog_handle] != blank -%}
                        {%- assign bl_slide_article = blank -%}
                        {%- for bl_candidate in blogs[bl_ref_blog_handle].articles -%}
                          {%- if bl_candidate.handle == bl_ref_article_handle -%}
                            {%- assign bl_slide_article = bl_candidate -%}
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}
                        {%- if bl_slide_article != blank and bl_slide_article.title != blank -%}
                          <div class="swiper-slide">
                            {% render 'nw-blog-latest-card', article: bl_slide_article, section: section %}
                          </div>
                        {%- endif -%}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- elsif bl_show_selected_blog -%}
                  {%- assign bl_slides_rendered = 0 -%}
                  {%- for bl_slide_article in bl_source_blog.articles -%}
                    {%- if article != blank and bl_slide_article.id == article.id -%}
                      {%- continue -%}
                    {%- endif -%}
                    <div class="swiper-slide">
                      {% render 'nw-blog-latest-card', article: bl_slide_article, section: section %}
                    </div>
                    {%- assign bl_slides_rendered = bl_slides_rendered | plus: 1 -%}
                    {%- if bl_slides_rendered >= post_limit -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              {%- elsif article_source == 'article_list' -%}
                {%- for item in selected_articles -%}
                  {%- liquid
                    assign featured_article = item
                    if featured_article == blank or featured_article.title == blank
                      assign article_path = item | strip
                      if article_path contains '/'
                        assign article_path_parts = article_path | split: '/'
                        assign article_blog_handle = article_path_parts.first
                        assign article_handle = article_path_parts.last
                        if article_blog_handle != blank and article_handle != blank and blogs[article_blog_handle] != blank
                          assign featured_article = blogs[article_blog_handle].articles[article_handle]
                        endif
                      else
                        assign featured_article = articles[article_path]
                      endif
                    endif
                  -%}
                  {%- if featured_article != blank -%}
                    <div class="swiper-slide">
                      {% render 'nw-blog-latest-card', article: featured_article, section: section %}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                {%- for article in selected_blog.articles limit: post_limit -%}
                  <div class="swiper-slide">
                    {% render 'nw-blog-latest-card', article: article, section: section %}
                  </div>
                {%- endfor -%}
              {%- endif -%}
            {%- else -%}
              {%- for i in (1..placeholder_count) -%}
                {%- assign placeholder_image_index = forloop.index0 | modulo: 3 | plus: 1 -%}
                <div class="swiper-slide">
                  <article class="nw-blog-latest__card">
                    <div class="nw-blog-latest__media">
                      {{ 'blog-apparel-' | append: placeholder_image_index | placeholder_svg_tag: 'nw-blog-latest__placeholder' }}
                      {%- if section.settings.show_editors_pick and i == 1 -%}
                        <span class="nw-blog-latest__badge">
                          <span class="nw-blog-latest__badge-icon" aria-hidden="true">
                            {% render 'nw-icon', icon: 'star' %}
                          </span>
                          <span class="nw-blog-latest__badge-text">{{ section.settings.editor_pick_label | default: "Editor's Pick" }}</span>
                        </span>
                      {%- endif -%}
                    </div>
                    <div class="nw-blog-latest__body">
                      <div class="nw-blog-latest__copy">
                        <p class="nw-blog-latest__tag">{{ 'sections.featured_blog.onboarding_title' | t | upcase }}</p>
                        <h3 class="nw-blog-latest__title">{{ 'sections.featured_blog.onboarding_title' | t }}</h3>
                        <p class="nw-blog-latest__excerpt">{{ 'sections.featured_blog.onboarding_content' | t }}</p>
                      </div>
                      {%- if section.settings.show_author or section.settings.show_read_time -%}
                        <div class="nw-blog-latest__meta">
                          {%- if section.settings.show_author -%}
                            <span class="nw-blog-latest__author">{{ shop.name }}</span>
                          {%- endif -%}
                          {%- if section.settings.show_author and section.settings.show_read_time -%}
                            <span class="nw-blog-latest__meta-dot" aria-hidden="true">&bull;</span>
                          {%- endif -%}
                          {%- if section.settings.show_read_time -%}
                            <span class="nw-blog-latest__read-time">6 min read</span>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                      {%- if section.settings.show_card_button -%}
                        <span class="nw-blog-latest__btn">
                          <span class="nw-blog-latest__btn-text">{{ section.settings.card_button_text | default: 'Read the article' }}</span>
                          <span class="nw-blog-latest__btn-icon" aria-hidden="true">
                            {% render 'nw-icon', icon: 'arrow-right-3' %}
                          </span>
                        </span>
                      {%- endif -%}
                    </div>
                  </article>
                </div>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>

        {%- if section.settings.show_pagination -%}
          {% render 'nw-swiper-pagination', id: pagination_id, class: 'nw-blog-latest__pagination' %}
        {%- endif -%}
      </div>

      {%- if section.settings.show_button -%}
        <div class="nw-blog-latest__footer">
          {% render 'nw-cta-badges',
            settings: section.settings,
            class: 'nw-blog-latest__cta'
          %}
