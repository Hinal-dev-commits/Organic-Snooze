      "alpha": true
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#E57B1E",
      "alpha": true
    },
    {
      "type": "color",
      "id": "star_inactive_color",
      "label": "Star Inactive Color",
      "default": "#D1D5DB",
      "alpha": true
    },
    {
      "type": "color",
      "id": "tag_color",
      "label": "Category Tag Color",
      "default": "#C2673B",
      "alpha": true
    },
    {
      "type": "color",
      "id": "description_color",
