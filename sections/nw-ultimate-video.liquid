{{ 'nw-ultimate-video.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-ultimate-video.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign nw_shell_selector = '#NwUltimateVideo-' | append: section.id
  assign video_blocks = section.blocks | where: 'type', 'video'
  assign slides_desktop = section.settings.slides_desktop | default: 3
  if slides_desktop < 1
    assign slides_desktop = 1
  endif
  assign pagination_id = 'NwUltimateVideoPagination-' | append: section.id
-%}

{% render 'nw-section-shell', selector: nw_shell_selector, mode: 'direct', default_bg: '#FFFCF0' %}
{% render 'nw-section-text-colors', selector: nw_shell_selector %}

<nw-ultimate-video
  id="NwUltimateVideo-{{ section.id }}"
  class="nw-ultimate-video section-{{ section.id }}"
  data-block-count="{{ video_blocks.size | default: 4 }}"
  data-show-arrows="{{ section.settings.show_arrows }}"
  data-show-pagination="{{ section.settings.show_pagination }}"
  data-pagination-id="{{ pagination_id }}"
  data-enable-autoplay="{{ section.settings.enable_autoplay }}"
  data-autoplay-delay="{{ section.settings.autoplay_delay | default: 4 | times: 1000 }}"
  style="
    --nw-uv-heading-color: {{ section.settings.heading_color }};
    --nw-uv-rating-text-color: {{ section.settings.rating_text_color }};
    --nw-star-active: {{ section.settings.star_color }};
    --nw-star-inactive: {{ section.settings.star_inactive_color }};
    --nw-uv-tag-color: {{ section.settings.tag_color }};
    --nw-uv-description-color: {{ section.settings.description_color }};
    --nw-uv-meta-color: {{ section.settings.meta_color }};
    --nw-uv-social-color: {{ section.settings.social_color }};
    --nw-uv-card-bg: {{ section.settings.card_bg_color }};
    --nw-uv-card-border: {{ section.settings.card_border_color }};
    --nw-uv-media-bg: {{ section.settings.media_bg_color }};
    --nw-uv-media-badge-bg: {{ section.settings.media_badge_bg_color }};
    --nw-uv-media-badge-text: {{ section.settings.media_badge_text_color }};
    --nw-uv-play-bg: {{ section.settings.play_bg_color }};
    --nw-uv-play-icon: {{ section.settings.play_icon_color }};
    --nw-swiper-bullet: {{ section.settings.pagination_color }};
    --nw-swiper-arrow-bg: {{ section.settings.swiper_arrow_bg }};
    --nw-swiper-arrow-color: {{ section.settings.swiper_arrow_color }};
  "
>
  <div class="page-width">
    <div class="nw-ultimate-video__wrapper{%- render 'nw-scroll-animation' -%}">
      {%- if section.settings.logo != blank
        or section.settings.show_rating
        or section.settings.rating_text != blank
        or section.settings.heading != blank
      -%}
        <div class="nw-ultimate-video__header">
          {%- if section.settings.logo != blank -%}
            {%- liquid
              assign logo_alt = section.settings.logo.alt
              if logo_alt == blank
                assign logo_alt = section.settings.heading | strip_html
              endif
            -%}
            {{
              section.settings.logo
              | image_url: width: 400
              | image_tag:
                loading: 'lazy',
                class: 'nw-ultimate-video__logo',
                alt: logo_alt,
                width: section.settings.logo.width,
                height: section.settings.logo.height
            }}
          {%- endif -%}

          {% render 'nw-section-header',
            show_rating: section.settings.show_rating,
            rating: section.settings.star_rating,
            eyebrow: section.settings.rating_text,
            heading: section.settings.heading,
            section_index: section.index,
            heading_class: 'nw-ultimate-video__heading'
          %}
        </div>
      {%- endif -%}

      <div class="nw-ultimate-video__slider-wrap">
        {%- if section.settings.show_arrows -%}
          {% render 'nw-swiper-arrows', arrow_style: section.settings.arrow_style %}
        {%- endif -%}

        <div class="swiper nw-ultimate-video__swiper" id="NwUltimateVideoSwiper-{{ section.id }}">
          <div class="swiper-wrapper">
            {%- if video_blocks.size > 0 -%}
              {%- liquid
                assign repeat_times = 1
                if section.settings.enable_slider_loop and video_blocks.size > 1
                  assign repeat_times = 2
                  if video_blocks.size <= 4
                    assign repeat_times = 3
                  endif
                  if video_blocks.size == 1
                    assign repeat_times = 8
                  endif
                endif
              -%}
              {%- for r in (1..repeat_times) -%}
                {%- for block in video_blocks -%}
                  <div class="swiper-slide" data-slide-index="{{ forloop.index0 }}">
                    {% render 'nw-ultimate-video-card', block: block %}
                  </div>
                {%- endfor -%}
              {%- endfor -%}
            {%- else -%}
              {%- for r in (1..2) -%}
                {%- for i in (1..4) -%}
                  <div class="swiper-slide" data-slide-index="{{ forloop.index0 }}">
                    <article class="nw-ultimate-video__card">
                      <div class="nw-ultimate-video__media">
                        <div class="nw-ultimate-video__placeholder" aria-hidden="true">
                          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                        </div>
                        <span class="nw-ultimate-video__play nw-ultimate-video__play--link" aria-hidden="true">
                          <span class="nw-ultimate-video__play-icon">
                            {% render 'nw-icon', icon: 'play' %}
                          </span>
                        </span>
                      </div>
                      <div class="nw-ultimate-video__body">
                        <p class="nw-ultimate-video__tag">Expert insights</p>
                        <div class="nw-ultimate-video__description rte">
                          <p>Add video cards in the theme editor to showcase your podcast episodes.</p>
                        </div>
                        <div class="nw-ultimate-video__footer">
                          <div class="nw-ultimate-video__author">
                            <span class="nw-ultimate-video__handle">@theultimatehuman</span>
                            <span class="nw-ultimate-video__meta-dot" aria-hidden="true">&bull;</span>
                            <span class="nw-ultimate-video__followers">162K followers</span>
                          </div>
                          <span class="nw-ultimate-video__social" aria-hidden="true">
                            {% render 'nw-icon', icon: 'instagram' %}
                          </span>
                        </div>
                      </div>
                    </article>
                  </div>
                {%- endfor -%}
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>
      </div>

      {%- if section.settings.show_pagination and video_blocks.size > 1 -%}
        <div
          id="{{ pagination_id }}"
          class="nw-swiper-pagination nw-ultimate-video__pagination"
          data-nw-ultimate-video-pagination
          aria-label="Video slider pagination"
        >
          {%- for block in video_blocks -%}
            <button
              type="button"
              class="swiper-pagination-bullet{% if forloop.first %} swiper-pagination-bullet-active{% endif %}"
              data-bullet-index="{{ forloop.index0 }}"
              aria-label="Go to slide {{ forloop.index }}"
            ></button>
          {%- endfor -%}
        </div>
      {%- elsif section.settings.show_pagination and video_blocks.size == 0 -%}
        <div
          id="{{ pagination_id }}"
          class="nw-swiper-pagination nw-ultimate-video__pagination"
          data-nw-ultimate-video-pagination
          aria-label="Video slider pagination"
        >
          {%- for i in (1..4) -%}
            <button
              type="button"
              class="swiper-pagination-bullet{% if forloop.first %} swiper-pagination-bullet-active{% endif %}"
              data-bullet-index="{{ forloop.index0 }}"
              aria-label="Go to slide {{ forloop.index }}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</nw-ultimate-video>

{% schema %}
{
  "name": "t:sections.nw-ultimate-video.name",
  "tag": "section",
  "class": "section-nw-ultimate-video",
  "disabled_on": {
    "groups": ["header", "footer"]
