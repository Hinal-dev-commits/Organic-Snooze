      "default": "#F4EFE8",
      "alpha": true
    },
    {
      "type": "color",
      "id": "media_badge_bg_color",
      "label": "Media Badge Background",
      "default": "#F5C518",
      "alpha": true
    },
    {
      "type": "color",
      "id": "media_badge_text_color",
      "label": "Media Badge Text Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "play_bg_color",
      "label": "Play Button Background",
      "default": "#FFFFFF80",
      "alpha": true
    },
    {
      "type": "color",
      "id": "play_icon_color",
      "label": "Play Button Icon Color",
      "default": "#fff",
      "alpha": true
    },
    {
