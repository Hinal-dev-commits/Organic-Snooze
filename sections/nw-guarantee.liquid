          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Icon / Logo"
        },
        {
          "type": "text",
          "id": "seal_ring",
          "label": "Seal Ring Text",
          "default": "MONEY BACK GUARANTEE"
        },
        {
          "type": "text",
          "id": "seal_number",
          "label": "Seal Number",
          "default": "100"
        },
        {
          "type": "text",
          "id": "seal_label",
          "label": "Seal Label",
          "default": "NIGHTS"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Sleep On It for 100 Nights. Risk-Free."
        },
        {
          "type": "richtext",
          "id": "text",
