    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#613916",
      "visible_if": "{{ section.settings.show_btn == true and section.settings.btn_style == 'custom' }}"
    },
    {
      "type": "color",
      "id": "btn_border_color",
      "label": "Button Border Color",
      "visible_if": "{{ section.settings.show_btn == true and section.settings.btn_style == 'custom' }}"
    },
    {
      "type": "header",
      "content": "BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "image",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "image", "label": "Image" },
        { "value": "gradient", "label": "Gradient" }
      ]
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFCF0",
      "visible_if": "{{ section.settings.bg_type == 'color' or section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "range",
      "id": "bg_image_opacity",
      "label": "Background Image Opacity",
