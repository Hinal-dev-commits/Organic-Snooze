{{ 'nw-button.css' | asset_url | stylesheet_tag }}
{{ 'nw-image.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign desktop_img = section.settings.image_desktop
  assign mobile_img = section.settings.image_mobile
  if desktop_img == blank and mobile_img != blank
    assign desktop_img = mobile_img
  endif
-%}

<style>
  #NwImage-{{ section.id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding-top: {{ section.settings.padding_top_desktop | default: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop | default: 0 }}px;
    --nw-image-heading-color: {{ section.settings.heading_color }};
  }

  #NwImage-{{ section.id }} .nw-image__container {
    height: 100%;
    min-height: {{ section.settings.height_desktop | default: 560 }}px;
  }
  #NwImage-{{ section.id }} .nw-image__container .nw-image__media .nw-image__img{
    min-height: {{ section.settings.height_desktop | default: 560 }}px;
  }

  {%- liquid
    assign nw_show_gradient = section.settings.show_gradient
    assign nw_gradient_end = section.settings.gradient_color_end | default: '#FFFCF0'
    assign nw_gradient_position = section.settings.gradient_end_position | default: 91

    if section.settings.gradient_color_start != blank
      assign nw_gradient_start = section.settings.gradient_color_start
    else
      assign nw_gradient_start = nw_gradient_end | color_modify: 'alpha', 0
    endif
  -%}

  {%- if nw_show_gradient -%}
    #NwImage-{{ section.id }} .nw-image__container::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      background: linear-gradient(
        180deg,
        {{ nw_gradient_start }} 0%,
        {{ nw_gradient_end }} {{ nw_gradient_position }}%
      );
    }
  {%- endif -%}

  #NwImage-{{ section.id }} .nw-image__container--fixed .nw-image__media {
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    background-attachment: fixed;
    {%- if section.settings.image_desktop != blank -%}
      background-image: url('{{ section.settings.image_desktop | image_url: width: 2880 }}');
    {%- else -%}
      background-color: #EAE3D9;
    {%- endif -%}
  }

  @media screen and (max-width: 749px) {
    #NwImage-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile | default: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile | default: 0 }}px;
    }

    #NwImage-{{ section.id }} .nw-image__container {
      height: 100%;
      min-height: {{ section.settings.height_mobile | default: 600 }}px;
    }

    #NwImage-{{ section.id }} .nw-image__container--fixed .nw-image__media {
      background-attachment: scroll;
      {%- if section.settings.image_mobile != blank -%}
        background-image: url('{{ section.settings.image_mobile | image_url: width: 1200 }}');
      {%- elsif section.settings.image_desktop != blank -%}
        background-image: url('{{ section.settings.image_desktop | image_url: width: 1200 }}');
      {%- endif -%}
    }
  }
</style>

<div
  id="NwImage-{{ section.id }}"
  class="nw-image section-{{ section.id }}"
>
  <div class="nw-image__container{% if section.settings.enable_fixed_bg %} nw-image__container--fixed{% endif %}">
    <div class="nw-image__media">
      {%- if section.settings.enable_fixed_bg -%}
        {%- if desktop_img == blank and mobile_img == blank -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      {%- elsif desktop_img != blank -%}
        <picture>
          {%- if mobile_img != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="{{ mobile_img | image_url: width: 750 }}"
            >
          {%- endif -%}
          <img
            src="{{ desktop_img | image_url }}"
            alt="{{ desktop_img.alt | default: section.settings.heading | strip_html | default: 'Banner image' | escape }}"
            width=""
            height=""
            loading="lazy"
            class="nw-image__img"
          >
        </picture>
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="nw-image__content">
      <div class="nw-image__content-inner">
        {%- if section.settings.heading != blank -%}
          <div class="nw-image__heading rte">{{ section.settings.heading }}</div>
        {%- endif -%}

        {%- if section.settings.button_text != blank -%}
          <div class="nw-image__button">
            {% render 'nw-button',
              text: section.settings.button_text,
              link: section.settings.button_link,
              style: section.settings.button_style,
              btn_class: 'nw-image__btn'
            %}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.nw-image.name",
  "tag": "section",
  "class": "section-nw-image",
  "settings": [
    {
      "type": "header",
      "content": "SECTION CONTENT"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "default": "primary",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ]
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "header",
      "content": "IMAGE SETTINGS"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Background Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Background Image (Optional)"
    },
    {
      "type": "checkbox",
      "id": "enable_fixed_bg",
      "label": "Enable Fixed Background (Parallax Effect)",
      "default": false
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Desktop Height",
      "min": 100,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 300
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Mobile Height",
      "min": 200,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "header",
      "content": "GRADIENT OVERLAY"
    },
    {
      "type": "checkbox",
      "id": "show_gradient",
      "label": "Show Gradient",
      "default": false,
      "info": "Adds a bottom fade overlay on the image. Customize the gradient colors below."
    },
    {
      "type": "color",
      "alpha": true,
      "id": "gradient_color_start",
      "label": "Gradient Start Color",
      "info": "Leave empty to auto-fade from transparent using the end color."
    },
    {
      "type": "color",
      "alpha": true,
      "id": "gradient_color_end",
      "label": "Gradient End Color",
      "default": "#FFFCF0",
      "info": "Match this to the background color of the section below the image."
    },
    {
      "type": "range",
      "id": "gradient_end_position",
      "label": "Gradient End Position",
      "min": 50,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 91
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:sections.nw-image.name",
      "category": "NW Sections"
    }
  ]
}
{% endschema %}
