{{ 'nw-button.css' | asset_url | stylesheet_tag }}
{{ 'nw-about-us.css' | asset_url | stylesheet_tag }}

<style>
  #NwAboutUs-{{ section.id }} {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: {{ section.settings.padding_top_desktop | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop | default: 80 }}px;
    {% case section.settings.bg_type %}
      {% when 'color' %}
        background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
      {% when 'gradient' %}
        background: {{ section.settings.bg_gradient }};
      {% when 'image' %}
        background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
      {% when 'none' %}
        background: transparent;
      {% else %}
        background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
    {% endcase %}
  }

  {%- if section.settings.bg_type == 'image' and section.settings.bg_image != blank -%}
    #NwAboutUs-{{ section.id }}::before {
      content: '';
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background-image: url('{{ section.settings.bg_image | image_url: width: 2880 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      z-index: 0;
      pointer-events: none;
    }
  {%- endif -%}

  {%- if section.settings.bg_type == 'image' and section.settings.bg_color_image != blank -%}
    #NwAboutUs-{{ section.id }}::after {
      content: '';
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background-color: {{ section.settings.bg_color_image | default: '#FFFFFF29' }};
      z-index: 0;
      pointer-events: none;
    }
  {%- endif -%}

  #NwAboutUs-{{ section.id }} > * {
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 749px) {
    #NwAboutUs-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile | default: 48 }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile | default: 48 }}px;
    }

    {%- if section.settings.bg_type == 'image' and section.settings.bg_image_mobile != blank -%}
      #NwAboutUs-{{ section.id }}::before {
        background-image: url('{{ section.settings.bg_image_mobile | image_url: width: 1200 }}');
      }
    {%- endif -%}
  }
</style>

<div
  id="NwAboutUs-{{ section.id }}"
  class="nw-about-us section-{{ section.id }} scroll-trigger animate--fade-in"
>
  <div class="page-width">
    <div class="nw-about-us__wrapper">
      {%- if section.settings.heading != blank -%}
        <div class="nw-about-us__header">
          {% render 'nw-section-heading',
            text: section.settings.heading,
            section_index: section.index
          %}
        </div>
      {%- endif -%}

      <div class="nw-about-us__body{% if section.settings.image_position == 'right' %} nw-about-us__body--image-right{% endif %}{% if section.settings.image_position_mobile == 'bottom' %} nw-about-us__body--mobile-image-bottom{% else %} nw-about-us__body--mobile-image-top{% endif %}">
        <div class="nw-about-us__media-col">
          {%- liquid
            assign desktop_img = section.settings.image_desktop
            assign mobile_img = section.settings.image_mobile
            if desktop_img == blank and mobile_img != blank
              assign desktop_img = mobile_img
            endif
          -%}
          {%- if desktop_img != blank -%}
            <picture>
              {%- if mobile_img != blank -%}
                <source
                  media="(max-width: 749px)"
                  srcset="{{ mobile_img | image_url: width: 750 }}"
                >
              {%- endif -%}
              <img
                src="{{ desktop_img | image_url: width: 1200 }}"
                alt="{{ desktop_img.alt | default: section.settings.heading | strip_html | escape }}"
                width="620"
                height="300"
                loading="lazy"
                class="nw-about-us__img"
              >
            </picture>
          {%- else -%}
            <div class="nw-about-us__placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>

        <div class="nw-about-us__content-col">
          {%- if section.settings.text != blank -%}
            <div class="rte nw-about-us__text">
              {{ section.settings.text }}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- if section.settings.show_button and section.settings.button_text != blank -%}
        <div class="nw-about-us__footer">
          {% render 'nw-button',
            text: section.settings.button_text,
            link: section.settings.button_link,
            style: section.settings.button_style,
            btn_class: 'nw-about-us__btn'
          %}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "NW About Us",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "CONTENT"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Sleep, Rebuilt From the Ground Up"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>The Ultimate Snooze was born from a simple belief: nature already knows how to help us heal — we just have to stop getting in the way. Created with human biologist Gary Brecka and veteran mattress makers, we built the world's first bio-optimized organic sleep system. Not the cheapest bed. The right one.</p>"
    },
    {
      "type": "header",
      "content": "MEDIA"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image (Optional)"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop Image Position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "image_position_mobile",
      "label": "Mobile Image Position",
      "default": "top",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "header",
      "content": "BUTTON"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "DISCOVER OUR STORY"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "default": "primary",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ]
    },
    {
      "type": "header",
      "content": "BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "color",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "image", "label": "Image" },
        { "value": "gradient", "label": "Gradient" }
      ]
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile Optional)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color_image",
      "label": "Overlay Color",
      "default": "#FFFFFF29",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "NW About Us",
      "category": "NW Sections"
    }
  ]
}
{% endschema %}
