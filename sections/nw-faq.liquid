{{ 'nw-faq.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-faq.js' | asset_url }}" defer="defer"></script>

{%- assign nw_shell_selector = '.nw-faq.section-' | append: section.id -%}
{% render 'nw-section-shell', selector: nw_shell_selector %}
<style>
  .nw-faq.section-{{ section.id }} {
    --nw-star-active: {{ section.settings.star_color | default: '#E57B1E' }};
    --nw-star-inactive: {{ section.settings.star_color_inactive | default: '#D1D5DB' }};
    position: relative;
    background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};
    padding-top: {{ section.settings.padding_top_desktop | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop | default: 80 }}px;
    isolation: isolate;
    overflow: hidden;
    {% if section.settings.bg_type == 'gradient' and section.settings.bg_gradient != blank %}
      background: {{ section.settings.bg_gradient }};
    {% elsif section.settings.bg_type == 'none' %}
      background: transparent;
    {% endif %}
  }

  {%- if section.settings.bg_image != blank and section.settings.bg_type != 'none' -%}
    .nw-faq.section-{{ section.id }}::before {
      content: "";
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background-image: url('{{ section.settings.bg_image | image_url: width: 2880 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      opacity: calc({{ section.settings.bg_image_opacity | default: 100 }} / 100);
      z-index: -1;
      pointer-events: none;
    }
  {%- endif -%}

  @media screen and (max-width: 749px) {
    .nw-faq.section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile | default: 48 }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile | default: 48 }}px;
    }

    {%- if section.settings.bg_image_mobile != blank and section.settings.bg_type != 'none' -%}
      .nw-faq.section-{{ section.id }}::before {
        background-image: url('{{ section.settings.bg_image_mobile | image_url: width: 1200 }}');
      }
    {%- endif -%}
  }
</style>
<nw-faq
  class="nw-faq section-{{ section.id }}"
  style="
    --nw-star-active: {{ section.settings.star_color | default: '#E57B1E' }};
    --nw-star-inactive: {{ section.settings.star_color_inactive | default: '#D1D5DB' }};
  "
>
  <div class="page-width">
    <div class="nw-faq__wrapper{%- render 'nw-scroll-animation' -%}">
      <div class="nw-faq__main">
        <div class="nw-faq__header">
          {% render 'nw-section-header',
            show_rating: section.settings.show_rating,
            rating: section.settings.star_rating,
            eyebrow: section.settings.eyebrow,
            heading: section.settings.heading,
            description: section.settings.subheading,
            section_index: section.index,
            heading_wrap_class: 'nw-faq__heading-wrap'
          %}
        </div>

        {%- if section.settings.show_search -%}
          <div class="nw-faq__search">
            <input
              type="text"
              class="nw-faq__search-input"
              placeholder="{{ section.settings.search_placeholder | default: 'What can we help with?' }}"
              aria-label="{{ section.settings.search_placeholder | default: 'What can we help with?' }}"
            >
            <span class="nw-faq__search-icon" aria-hidden="true">
              {% render 'nw-icon', icon: 'search-sm' %}
            </span>
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="nw-faq__list" data-initial-limit="{{ section.settings.initial_faq_count | default: 6 }}">
            {%- for block in section.blocks -%}
              <div class="nw-faq__item accordion smooth" {{ block.shopify_attributes }}>
                <details
                  id="Details-{{ block.id }}-{{ section.id }}"
                  {% if section.settings.open_first_faq and forloop.first %}
                    open
                  {% endif %}
                >
                  <summary id="Summary-{{ block.id }}-{{ section.id }}" class="nw-faq__summary">
                    <h3 class="accordion__title nw-faq__question">
                      {{ block.settings.question }}
                    </h3>
                    <span class="nw-faq__toggle" aria-hidden="true">
                      <span class="nw-faq__toggle-h"></span>
                      <span class="nw-faq__toggle-v"></span>
                    </span>
                  </summary>
                  {%- if block.settings.answer != blank -%}
                    <div
                      class="accordion__content nw-faq__answer rte"
                      id="CollapsibleAccordion-{{ block.id }}-{{ section.id }}"
                      role="region"
                      aria-labelledby="Summary-{{ block.id }}-{{ section.id }}"
                    >
                      {{ block.settings.answer }}
                    </div>
                  {%- endif -%}
                </details>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.more_label != blank -%}
          <div class="nw-faq__more-wrap">
            <button
              type="button"
              class="nw-faq__more"
              data-toggle="true"
              data-more-text="{{ section.settings.more_label | default: "SEE MORE FAQ'S" }}"
              data-less-text="SEE LESS FAQ'S"
            >
              {{ section.settings.more_label }}
            </button>
          </div>
        {%- endif -%}
      </div>

      {%- liquid
        assign show_call = false
        if section.settings.show_call_btn and section.settings.call_label != blank
          assign show_call = true
        endif

        assign show_text = false
        if section.settings.show_text_btn and section.settings.text_label != blank
          assign show_text = true
        endif

        assign show_quiz = false
        if section.settings.show_quiz_btn and section.settings.quiz_label != blank
          assign show_quiz = true
        endif
      -%}

      {%- if section.settings.contact_heading != blank or show_call or show_text or show_quiz -%}
        <div class="nw-faq__contact">
          {%- if section.settings.contact_heading != blank -%}
            <div class="nw-faq__contact-heading-wrap" id="faq-heading">
              {% render 'nw-section-heading', text: section.settings.contact_heading, tag: 'h2' %}
            </div>
          {%- endif -%}

          {%- if show_call or show_text or show_quiz -%}
            <div class="nw-faq__actions">
              {%- if show_call -%}
                {% render 'nw-button',
                  text: section.settings.call_label,
                  link: section.settings.call_link,
                  style: section.settings.call_style
                %}
              {%- endif -%}

              {%- if show_text or show_quiz -%}
                <div class="nw-faq__btn-row">
                  {%- if show_text -%}
                    {% render 'nw-button',
                      text: section.settings.text_label,
                      link: section.settings.text_link,
                      style: section.settings.text_style
                    %}
                  {%- endif -%}

                  {%- if show_quiz -%}
                    {% render 'nw-button',
                      text: section.settings.quiz_label,
                      link: section.settings.quiz_link,
                      style: section.settings.quiz_style
                    %}
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</nw-faq>

{% schema %}
{
  "name": "t:sections.nw-faq.name",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "SECTION HEADER"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating Stars",
      "default": true
    },
    {
      "type": "range",
      "id": "star_rating",
      "label": "Star Rating (Active Stars)",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "star_color",
      "label": "Active Star Color",
      "default": "#E57B1E",
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "color",
      "alpha": true,
      "id": "star_color_inactive",
      "label": "Inactive Star Color",
      "default": "#D1D5DB",
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Real sleepers, real mornings"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "FAQ SETTINGS"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Live Search",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search Placeholder",
      "default": "What can we help with?",
      "visible_if": "{{ section.settings.show_search == true }}"
    },
    {
      "type": "checkbox",
      "id": "open_first_faq",
      "label": "Open First FAQ By Default",
      "default": false
    },
    {
      "type": "range",
      "id": "initial_faq_count",
      "label": "Initial FAQs To Show Before Expand",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "See More Button Label",
      "default": "SEE MORE FAQ’S"
    },
    {
      "type": "header",
      "content": "CONTACT SETTINGS"
    },
    {
      "type": "inline_richtext",
      "id": "contact_heading",
      "label": "Contact Heading",
      "default": "Speak with Our Live Sleep Experts."
    },
    {
      "type": "checkbox",
      "id": "show_call_btn",
      "label": "Show Call Button",
      "default": true
    },
    {
      "type": "text",
      "id": "call_label",
      "label": "Call Button Label",
      "default": "CALL (443) 333-1213",
      "visible_if": "{{ section.settings.show_call_btn == true }}"
    },
    {
      "type": "text",
      "id": "call_link",
      "label": "Call Button Link (E.g. Tel:+14433331213)",
      "default": "tel:+14433331213",
      "visible_if": "{{ section.settings.show_call_btn == true }}"
    },
    {
      "type": "select",
      "id": "call_style",
      "label": "Call Button Style",
      "default": "primary",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ],
      "visible_if": "{{ section.settings.show_call_btn == true }}"
    },
    {
      "type": "checkbox",
      "id": "show_text_btn",
      "label": "Show Text Button",
      "default": true
    },
    {
      "type": "text",
      "id": "text_label",
      "label": "Text Button Label",
      "default": "TEXT US",
      "visible_if": "{{ section.settings.show_text_btn == true }}"
    },
    {
      "type": "text",
      "id": "text_link",
      "label": "Text Button Link (E.g. Sms:+14433331213)",
      "default": "sms:+14433331213",
      "visible_if": "{{ section.settings.show_text_btn == true }}"
    },
    {
      "type": "select",
      "id": "text_style",
      "label": "Text Button Style",
      "default": "outline",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ],
      "visible_if": "{{ section.settings.show_text_btn == true }}"
    },
    {
      "type": "checkbox",
      "id": "show_quiz_btn",
      "label": "Show Quiz Button",
      "default": true
    },
    {
      "type": "text",
      "id": "quiz_label",
      "label": "Quiz Button Label",
      "default": "SLEEP QUIZ",
      "visible_if": "{{ section.settings.show_quiz_btn == true }}"
    },
    {
      "type": "url",
      "id": "quiz_link",
      "label": "Quiz Button Link",
      "visible_if": "{{ section.settings.show_quiz_btn == true }}"
    },
    {
      "type": "select",
      "id": "quiz_style",
      "label": "Quiz Button Style",
      "default": "outline",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ],
      "visible_if": "{{ section.settings.show_quiz_btn == true }}"
    },
    {
      "type": "header",
      "content": "BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "image",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "image", "label": "Image" },
        { "value": "gradient", "label": "Gradient" }
      ]
    },
    {
      "type": "color",
      "alpha": true,
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.bg_type == 'color' or section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "range",
      "id": "bg_image_opacity",
      "label": "Background Image Opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile Optional)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What makes the Ultimate Snooze different from other organic mattresses?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Ultimate Snooze combines certified organic latex, organic wool, and pocket coils with zero toxic chemicals, glues, or fiberglass for restorative, clean sleep.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.nw-faq.name",
      "category": "NW Sections",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "What makes the Ultimate Snooze different from other organic mattresses?",
            "answer": "<p>Ultimate Snooze combines certified organic latex, organic wool, and pocket coils with zero toxic chemicals, glues, or fiberglass for restorative, clean sleep.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What materials are used?",
            "answer": "<p>We use 100% GOLS certified organic latex, GOTS certified organic wool, and GOTS certified organic cotton with recycled steel pocket coils.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Does it contain flame retardants or fiberglass?",
            "answer": "<p>No. We never use chemical flame retardants or fiberglass. We use natural organic wool as our flame barrier.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Will I sleep hot?",
            "answer": "<p>Organic latex and wool are naturally temperature regulating and breathable, keeping you cool all night long.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What if I don’t like it?",
            "answer": "<p>We offer a 100-night risk-free trial. If it's not the right fit, you can return it hassle-free.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Can I finance it or use HSA/FSA?",
            "answer": "<p>Yes, we offer financing through Affirm, ShopPay, and Acima, as well as TrueMed HSA/FSA eligibility at checkout.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
