{{ 'nw-article-products.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-article-products.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign nw_products = article.metafields.custom.product.value
  if nw_products == blank
    assign nw_products = article.metafields.custom.products.value
  endif
  if nw_products == blank
    assign nw_products = article.metafields.custom.product
  endif
  if nw_products == blank
    assign nw_products = article.metafields.custom.products
  endif
-%}

{%- if nw_products != blank -%}
  {%- liquid
    assign nw_heading = section.settings.heading | default: 'Products Mentioned in this Article'
    assign nw_show_btn = section.settings.show_button
    assign nw_btn_text = section.settings.button_text | default: 'Shop Now'
    assign nw_btn_style = section.settings.button_style | default: 'primary'
    assign nw_btn_link = section.settings.button_link
  -%}

  {%- assign nw_shell_selector = '#NwArticleProducts-' | append: section.id -%}
  {% render 'nw-section-shell', selector: nw_shell_selector, mode: 'direct', default_bg: 'transparent' %}

  <nw-article-products id="NwArticleProducts-{{ section.id }}" class="nw-article-products section-{{ section.id }}">
    <div class="page-width">
      <div class="nw-article-products__inner">
        {%- if nw_heading != blank -%}
          <h2 class="nw-article-products__heading">{{ nw_heading | escape }}</h2>
        {%- endif -%}

        <div class="nw-article-products__slider-wrap">
          <div class="swiper nw-article-products__swiper" id="NwArticleProductsSwiper-{{ section.id }}">
            <div class="swiper-wrapper nw-article-products__grid" id="NwArticleProductsGrid-{{ section.id }}">
            {%- for card_product in nw_products -%}
              {%- liquid
                assign actual_prod = card_product
                if actual_prod.value != blank
                  assign actual_prod = actual_prod.value
                endif
              -%}

              {%- if actual_prod.title != blank -%}
                {%- liquid
                  assign prod_img = actual_prod.featured_media | default: actual_prod.featured_image
                  assign prod_title = actual_prod.metafields.custom.product_title.value | default: actual_prod.metafields.custom.product_title | default: actual_prod.title
                  assign prod_desc = actual_prod.metafields.custom.card_description.value | default: actual_prod.metafields.custom.card_description | default: actual_prod.metafields.custom.short_description.value | default: actual_prod.metafields.custom.short_description

                  assign prod_price = actual_prod.price_min | default: actual_prod.price
                  assign prod_compare = actual_prod.compare_at_price_min | default: actual_prod.compare_at_price
                  assign prod_save = 0
                  if prod_compare > prod_price and prod_compare > 0
                    assign prod_save = prod_compare | minus: prod_price
                  endif

                  assign rating_val = actual_prod.metafields.reviews.rating.value.rating | default: actual_prod.metafields.reviews.rating.value | default: actual_prod.metafields.custom.rating.value | default: actual_prod.metafields.custom.rating
                  assign rating_cnt = actual_prod.metafields.reviews.rating_count.value | default: actual_prod.metafields.reviews.rating_count | default: actual_prod.metafields.custom.rating_count.value | default: actual_prod.metafields.custom.rating_count

                  assign prod_benefits = actual_prod.metafields.custom.benefits.value
                  if prod_benefits == blank
                    assign prod_benefits = actual_prod.metafields.custom.benefits
                  endif

                  assign card_url = nw_btn_link | default: actual_prod.url
                -%}
                <div class="swiper-slide nw-article-product-card">
                  {%- if prod_img != blank -%}
                    <div class="nw-article-product-card__media-wrap">
                      <a href="{{ card_url }}" class="nw-article-product-card__media-link" aria-label="{{ prod_title | escape }}">
                        {{ prod_img | image_url: width: 800 | image_tag: loading: 'lazy', widths: '343, 630, 800', sizes: '(max-width: 749px) 343px, 630px', class: 'nw-article-product-card__media-img', alt: prod_title }}
                      </a>
                    </div>
                  {%- endif -%}

                  <div class="nw-article-product-card__content">
                    <div class="nw-article-product-card__body-top">
                      <div class="nw-article-product-card__header-group">
                        <div class="nw-article-product-card__meta-group">
                          {%- if rating_val != blank -%}
                            <div class="nw-article-product-card__rating-row">
                              <div class="nw-article-product-card__stars" aria-hidden="true">
                                {%- for i in (1..5) -%}
                                  <span class="nw-article-product-card__star">
                                    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M8 1.5l1.9 4.2 4.6.4-3.4 3.1 1 4.6L8 11.4 3.9 13.8l1-4.6-3.4-3.1 4.6-.4L8 1.5z" fill="currentColor"/></svg>
                                  </span>
                                {%- endfor -%}
                              </div>
                              <span class="nw-article-product-card__rating-score">{{ rating_val }}/5</span>
                              {%- if rating_cnt != blank -%}
                                <span class="nw-article-product-card__rating-count">({{ rating_cnt }})</span>
                              {%- endif -%}
                            </div>
                          {%- endif -%}

                          {%- if prod_title != blank -%}
                            <h3 class="nw-article-product-card__title">
                              <a href="{{ card_url }}">{{ prod_title }}</a>
                            </h3>
                          {%- endif -%}

                          {%- if prod_desc != blank -%}
                            <p class="nw-article-product-card__excerpt">{{ prod_desc | strip_html }}</p>
                          {%- endif -%}
                        </div>

                        {%- if prod_price != blank -%}
                          <div class="nw-article-product-card__price-container">
                            <div class="nw-article-product-card__price-row">
                              <div class="nw-article-product-card__price-values">
                                <span class="nw-article-product-card__price">{{ prod_price | money }}</span>
                                {%- if prod_compare > prod_price and prod_compare > 0 -%}
                                  <span class="nw-article-product-card__compare-price">{{ prod_compare | money }}</span>
                                {%- endif -%}
                              </div>
                              {%- if prod_save > 0 -%}
                                <div class="nw-article-product-card__tag">
                                  <span class="nw-article-product-card__tag-text">Save {{ prod_save | money_without_trailing_zeros }}</span>
                                </div>
                              {%- endif -%}
                            </div>
                          </div>
                        {%- endif -%}
                      </div>

                      {%- if prod_benefits != blank -%}
                        <ul class="nw-article-product-card__features" role="list">
                          {%- if prod_benefits.count > 0 or prod_benefits.size > 0 or prod_benefits.first != blank -%}
                            {%- for feat in prod_benefits -%}
                              {%- liquid
                                assign feat_icon = feat.icon.value | default: feat.icon
                                if feat_icon == blank
                                  assign feat_icon = feat.Icon.value | default: feat.Icon
                                endif
                                if feat_icon == blank
                                  assign feat_icon = feat.image.value | default: feat.image
                                endif
                              -%}
                              <li class="nw-article-product-card__feature-item">
                                <span class="nw-article-product-card__feature-icon" aria-hidden="true">
                                  {%- if feat_icon != blank -%}
                                    <img
                                      src="{{ feat_icon | image_url: width: 60 }}"
                                      alt="Icon"
                                      class="nw-article-product-card__feature-img"
                                      width="24"
                                      height="24"
                                      loading="lazy"
                                    >
                                  {%- else -%}
                                    {%- render 'nw-icon', icon: 'leaf' -%}
                                  {%- endif -%}
                                </span>
                                <div class="nw-article-product-card__feature-text">
                                  {%- if feat.label != blank -%}
                                    {%- if feat.label.type == 'rich_text_field' -%}
                                      {{ feat.label | metafield_tag }}
                                    {%- elsif feat.label.value != blank -%}
                                      {{ feat.label.value }}
                                    {%- else -%}
                                      {{ feat.label }}
                                    {%- endif -%}
                                  {%- elsif feat.Label != blank -%}
                                    {%- if feat.Label.type == 'rich_text_field' -%}
                                      {{ feat.Label | metafield_tag }}
                                    {%- elsif feat.Label.value != blank -%}
                                      {{ feat.Label.value }}
                                    {%- else -%}
                                      {{ feat.Label }}
                                    {%- endif -%}
                                  {%- elsif feat.label.value != blank -%}
                                    {{ feat.label.value }}
                                  {%- elsif feat.title != blank -%}
                                    {{ feat.title.value | default: feat.title }}
                                  {%- elsif feat.name != blank -%}
                                    {{ feat.name.value | default: feat.name }}
                                  {%- else -%}
                                    {{ feat }}
                                  {%- endif -%}
                                </div>
                              </li>
                            {%- endfor -%}
                          {%- elsif prod_benefits.icon != blank or prod_benefits.label != blank or prod_benefits.Label != blank -%}
                            {%- liquid
                              assign feat_icon = prod_benefits.icon.value | default: prod_benefits.icon | default: prod_benefits.Icon.value | default: prod_benefits.Icon | default: prod_benefits.image.value | default: prod_benefits.image
                            -%}
                            <li class="nw-article-product-card__feature-item">
                              <span class="nw-article-product-card__feature-icon" aria-hidden="true">
                                {%- if feat_icon != blank -%}
                                  <img
                                    src="{{ feat_icon | image_url: width: 60 }}"
                                    alt="Icon"
                                    class="nw-article-product-card__feature-img"
                                    width="24"
                                    height="24"
                                    loading="lazy"
                                  >
                                {%- else -%}
                                  {%- render 'nw-icon', icon: 'leaf' -%}
                                {%- endif -%}
                              </span>
                              <div class="nw-article-product-card__feature-text">
                                {%- if prod_benefits.label != blank -%}
                                  {%- if prod_benefits.label.type == 'rich_text_field' -%}
                                    {{ prod_benefits.label | metafield_tag }}
                                  {%- elsif prod_benefits.label.value != blank -%}
                                    {{ prod_benefits.label.value }}
                                  {%- else -%}
                                    {{ prod_benefits.label }}
                                  {%- endif -%}
                                {%- elsif prod_benefits.Label != blank -%}
                                  {%- if prod_benefits.Label.type == 'rich_text_field' -%}
                                    {{ prod_benefits.Label | metafield_tag }}
                                  {%- elsif prod_benefits.Label.value != blank -%}
                                    {{ prod_benefits.Label.value }}
                                  {%- else -%}
                                    {{ prod_benefits.Label }}
                                  {%- endif -%}
                                {%- elsif prod_benefits.title != blank -%}
                                  {{ prod_benefits.title.value | default: prod_benefits.title }}
                                {%- elsif prod_benefits.name != blank -%}
                                  {{ prod_benefits.name.value | default: prod_benefits.name }}
                                {%- else -%}
                                  {{ prod_benefits }}
                                {%- endif -%}
                              </div>
                            </li>
                          {%- else -%}
                            {%- assign feat_lines = prod_benefits | newline_to_br | split: '<br />' -%}
                            {%- for line in feat_lines -%}
                              {%- assign clean_line = line | strip_html | strip -%}
                              {%- if clean_line != blank -%}
                                <li class="nw-article-product-card__feature-item">
                                  <span class="nw-article-product-card__feature-icon" aria-hidden="true">
                                    {%- render 'nw-icon', icon: 'leaf' -%}
                                  </span>
                                  <div class="nw-article-product-card__feature-text">{{ clean_line }}</div>
                                </li>
                              {%- endif -%}
                            {%- endfor -%}
                          {%- endif -%}
                        </ul>
                      {%- endif -%}
                    </div>

                    <div class="nw-article-product-card__cta-wrap">
                      {%- if nw_show_btn != false and nw_btn_text != blank -%}
                        {% render 'nw-button', text: nw_btn_text, link: card_url, style: nw_btn_style, btn_class: 'nw-article-product-card__btn' %}
                      {%- endif -%}

                      <div class="nw-article-product-card__trust-badges">
                        <div class="nw-article-product-card__trust-badge">
                          <span class="nw-article-product-card__trust-icon" aria-hidden="true">
                            {%- render 'nw-icon', icon: 'money' -%}
                          </span>
                          <span class="nw-article-product-card__trust-text">100-Night Risk-Free Trial</span>
                        </div>
                        <div class="nw-article-product-card__trust-badge">
                          <span class="nw-article-product-card__trust-icon" aria-hidden="true">
                            {%- render 'nw-icon', icon: 'shield' -%}
                          </span>
                          <span class="nw-article-product-card__trust-text">30-Year Warranty</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
            </div>
          </div>

          <div class="nw-article-products__pagination" id="NwArticleProductsPagination-{{ section.id }}"></div>
        </div>
      </div>
    </div>
  </nw-article-products>
{%- endif -%}

{% schema %}
{
  "name": "NW Article Products",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["article"]
  },
  "settings": [
    {
      "type": "header",
      "content": "CONTENT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Products Mentioned in this Article"
    },

    {
      "type": "header",
      "content": "BUTTON"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "Shop Now",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Custom Button Link",
      "info": "Optional. If blank, links to product page.",
      "visible_if": "{{ section.settings.show_button == true }}"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "default": "primary",
      "visible_if": "{{ section.settings.show_button == true }}",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" }
      ]
    },
    {
      "type": "header",
      "content": "BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "gradient", "label": "Gradient" },
        { "value": "image", "label": "Image" }
      ]
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "NW Article Products",
      "category": "NW Sections"
    }
  ]
}
{% endschema %}
