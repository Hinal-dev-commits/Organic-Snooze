{% comment %} {{ 'nw-product-card.css' | asset_url | stylesheet_tag }} {% endcomment %}
{{ 'nw-collections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nw-collections.js' | asset_url }}" defer="defer"></script>

{%- assign nw_shell_selector = '#NwCollections-' | append: section.id -%}
{% render 'nw-section-shell', selector: nw_shell_selector, mode: 'direct', default_bg: '#FFFFFF' %}

{%- assign collection_blocks = section.blocks | where: 'type', 'collection' -%}
{%- liquid
  assign active_tab_index = 0
  assign tab_mode = section.settings.active_tab_mode | default: 'page'

  if tab_mode == 'page' and collection != blank
    for block in collection_blocks
      if block.settings.collection != blank and block.settings.collection.id == collection.id
        assign active_tab_index = forloop.index0
        break
      endif
    endfor
  endif

  assign prod_limit = section.settings.products_to_show
  if prod_limit == blank
    assign prod_limit = 8
  endif

  assign pagination_size = section.settings.products_per_page | default: 50
  assign pagination_anchor = '#NwCollections-' | append: section.id
  assign active_collection = nil

  for block in collection_blocks
    if forloop.index0 == active_tab_index and block.settings.collection != blank
      assign active_collection = block.settings.collection
      break
    endif
  endfor

  assign use_pagination = false
  if prod_limit == 0 and active_collection != blank and active_collection.products_count > pagination_size
    assign use_pagination = true
  endif
-%}

<nw-collections
  id="NwCollections-{{ section.id }}"
  class="nw-collections section-{{ section.id }}"
  data-active-tab-mode="{{ tab_mode }}"
  data-initial-tab="{{ active_tab_index }}"
>
  <div class="nw-collections__container">
    {%- if section.settings.heading != blank
      or section.settings.description != blank
      or section.settings.eyebrow != blank
    -%}
      <div class="nw-collections__header">
        {% render 'nw-section-header',
          show_rating: section.settings.show_rating,
          rating: section.settings.star_rating,
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          description: section.settings.description,
          section_index: section.index
        %}
      </div>
    {%- endif -%}

    {%- if collection_blocks.size > 0 -%}
      <div class="nw-collections__tabs-wrap">
        <div class="nw-collections__tabs" role="tablist" aria-label="Collections">
          {%- for block in collection_blocks -%}
            {%- liquid
              assign tab_title = block.settings.label
              if tab_title == blank and block.settings.collection != blank
                assign tab_title = block.settings.collection.title
              endif
              if tab_title == blank
                assign tab_title = 'Collection ' | append: forloop.index
              endif
            -%}
            <button
              type="button"
              class="nw-collections__tab{% if forloop.index0 == active_tab_index %} is-active{% endif %}"
              id="NwCollectionTabBtn-{{ section.id }}-{{ forloop.index0 }}"
              role="tab"
              aria-selected="{% if forloop.index0 == active_tab_index %}true{% else %}false{% endif %}"
              aria-controls="NwCollectionTabPanel-{{ section.id }}-{{ forloop.index0 }}"
              tabindex="{% if forloop.index0 == active_tab_index %}0{% else %}-1{% endif %}"
              data-nw-collection-tab="{{ forloop.index0 }}"
              data-collection-url="{% if block.settings.collection != blank %}{{ block.settings.collection.url }}{% endif %}"
              {{ block.shopify_attributes }}
            >
              {{ tab_title }}
            </button>
          {%- endfor -%}
        </div>
      </div>

      <div class="nw-collections__panels">
        {%- if use_pagination -%}
          {%- paginate active_collection.products by pagination_size -%}
            {%- for block in collection_blocks -%}
              {%- liquid
                assign current_collection = block.settings.collection
                assign is_active_panel = false
                assign is_paginated_panel = false
                if forloop.index0 == active_tab_index
                  assign is_active_panel = true
                endif
                if current_collection != blank and current_collection.id == active_collection.id
                  assign is_paginated_panel = true
                endif
              -%}
              <div
                class="nw-collections__panel"
                id="NwCollectionTabPanel-{{ section.id }}-{{ forloop.index0 }}"
                data-nw-collection-panel="{{ forloop.index0 }}"
                role="tabpanel"
                aria-labelledby="NwCollectionTabBtn-{{ section.id }}-{{ forloop.index0 }}"
                {% unless is_active_panel %}
                  hidden
                {% endunless %}
              >
                {%- if current_collection != blank and current_collection.products_count > 0 -%}
                  {%- if section.settings.show_product_count -%}
                    <div class="nw-collections__count-bar">
                      <span>
                        {{- current_collection.products_count }}
                        {{ current_collection.products_count | pluralize: 'Product', 'Products' -}}
                      </span>
                    </div>
                  {%- endif -%}

                  <div class="nw-collections__grid">
                    {%- if is_paginated_panel -%}
                      {%- for product in paginate.products -%}
                        {% render 'nw-product-card',
                          product: product,
                          section_id: section.id,
                          show_rating: section.settings.show_rating_on_card,
                          show_firmness: section.settings.show_firmness,
                          show_seller_tag: section.settings.show_seller_tag,
                          show_best_for: section.settings.show_best_for,
                          button_text: section.settings.pcard_button_text,
                          button_style: section.settings.pcard_button_style,
                          lazy_load: true
                        %}
                      {%- endfor -%}
                    {%- else -%}
                      {%- for product in current_collection.products limit: pagination_size -%}
                        {% render 'nw-product-card',
                          product: product,
                          section_id: section.id,
                          show_rating: section.settings.show_rating_on_card,
                          show_firmness: section.settings.show_firmness,
                          show_seller_tag: section.settings.show_seller_tag,
                          show_best_for: section.settings.show_best_for,
                          button_text: section.settings.pcard_button_text,
                          button_style: section.settings.pcard_button_style,
                          lazy_load: true
                        %}
                      {%- endfor -%}
                    {%- endif -%}
                  </div>

                  {%- if is_paginated_panel and is_active_panel and paginate.pages > 1 -%}
                    <div class="nw-collections__pagination">
                      {% render 'pagination', paginate: paginate, anchor: pagination_anchor %}
                    </div>
                  {%- endif -%}
                {%- elsif current_collection != blank -%}
                  <div class="nw-collections__empty">No products found in this collection.</div>
                {%- else -%}
                  <div class="nw-collections__empty">Select a collection to display products.</div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endpaginate -%}
        {%- else -%}
          {%- for block in collection_blocks -%}
            {%- assign current_collection = block.settings.collection -%}
            <div
              class="nw-collections__panel"
              id="NwCollectionTabPanel-{{ section.id }}-{{ forloop.index0 }}"
              data-nw-collection-panel="{{ forloop.index0 }}"
              role="tabpanel"
              aria-labelledby="NwCollectionTabBtn-{{ section.id }}-{{ forloop.index0 }}"
              {% unless forloop.index0 == active_tab_index %}
                hidden
              {% endunless %}
            >
              {%- if current_collection != blank and current_collection.products_count > 0 -%}
                {%- if section.settings.show_product_count -%}
                  <div class="nw-collections__count-bar">
                    <span>
                      {{- current_collection.products_count }}
                      {{ current_collection.products_count | pluralize: 'Product', 'Products' -}}
                    </span>
                  </div>
                {%- endif -%}

                <div class="nw-collections__grid">
                  {%- if prod_limit == 0 -%}
                    {%- for product in current_collection.products limit: pagination_size -%}
                      {% render 'nw-product-card',
                        product: product,
                        section_id: section.id,
                        show_rating: section.settings.show_rating_on_card,
                        show_firmness: section.settings.show_firmness,
                        show_seller_tag: section.settings.show_seller_tag,
                        show_best_for: section.settings.show_best_for,
                        button_text: section.settings.pcard_button_text,
                        button_style: section.settings.pcard_button_style,
                        lazy_load: true
                      %}
                    {%- endfor -%}
                  {%- else -%}
                    {%- for product in current_collection.products limit: prod_limit -%}
                      {% render 'nw-product-card',
                        product: product,
                        section_id: section.id,
                        show_rating: section.settings.show_rating_on_card,
                        show_firmness: section.settings.show_firmness,
                        show_seller_tag: section.settings.show_seller_tag,
                        show_best_for: section.settings.show_best_for,
                        button_text: section.settings.pcard_button_text,
                        button_style: section.settings.pcard_button_style,
                        lazy_load: true
                      %}
                    {%- endfor -%}
                  {%- endif -%}
                </div>
              {%- elsif current_collection != blank -%}
                <div class="nw-collections__empty">No products found in this collection.</div>
              {%- else -%}
                <div class="nw-collections__empty">Select a collection to display products.</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_button and section.settings.button_label != blank -%}
      {%- liquid
        assign action_btn_link = section.settings.button_link
        if action_btn_link == blank and collection_blocks.size > 0
          for block in collection_blocks
            if forloop.index0 == active_tab_index and block.settings.collection != blank
              assign action_btn_link = block.settings.collection.url
              break
            endif
          endfor
          if action_btn_link == blank
            assign first_block = collection_blocks | first
            if first_block.settings.collection != blank
              assign action_btn_link = first_block.settings.collection.url
            endif
          endif
        endif
      -%}
      <div class="nw-collections__footer">
        <a
          href="{{ action_btn_link | default: '#' }}"
          class="nw-btn nw-btn--{{ section.settings.button_style | default: 'primary' }}"
          data-nw-collection-action-btn
        >
          <span class="nw-btn__text">{{ section.settings.button_label }}</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</nw-collections>

{% schema %}
{
  "name": "NW Collections",
  "tag": "section",
  "class": "section-nw-collections",
  "settings": [
    {
      "type": "header",
      "content": "CONTENT"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating Stars",
      "default": false
    },
    {
      "type": "range",
      "id": "star_rating",
      "label": "Star Rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow Text"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "TAB SETTINGS"
    },
    {
      "type": "select",
      "id": "active_tab_mode",
      "label": "Active Tab Mode",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "Page"
        },
        {
          "value": "tab",
          "label": "Tab"
        }
      ],
      "info": "Page mode highlights the current collection on collection pages and navigates when a tab is clicked. Tab mode keeps the first tab active and switches products in place."
    },
    {
      "type": "header",
      "content": "PRODUCT SETTINGS"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products To Show Per Tab",
      "min": 0,
      "max": 24,
      "step": 1,
      "default": 8,
      "info": "0 = Show all products. Pagination is added automatically when a collection has more products than the per-page limit below."
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products Per Page",
      "min": 12,
      "max": 50,
      "step": 2,
      "default": 50,
      "info": "Used when showing all products and the collection has more than this many items.",
      "visible_if": "{{ section.settings.products_to_show == 0 }}"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show Product Count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating_on_card",
      "label": "Show Card Rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_firmness",
      "label": "Show Firmness Bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_best_for",
      "label": "Show Best For",
      "default": false,
      "info": "Only displays when the product custom.best_for metafield is set."
    },
    {
      "type": "checkbox",
      "id": "show_seller_tag",
      "label": "Show Seller Tag",
      "default": true
    },
    {
      "type": "text",
      "id": "pcard_button_text",
      "label": "Card Button Label",
      "default": "Shop Now"
    },
    {
      "type": "select",
      "id": "pcard_button_style",
      "label": "Card Button Style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "outline",
          "label": "Outline"
        }
      ],
      "default": "primary"
    },
    {
      "type": "header",
      "content": "BUTTON SETTINGS"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "outline",
          "label": "Outline"
        }
      ],
      "default": "primary"
    },
    {
      "type": "header",
      "content": "BACKGROUND SETTINGS"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "color",
          "label": "Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ],
      "default": "color"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "header",
      "content": "SECTION PADDING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Tab",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Tab Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NW Collections",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "label": "Bestsellers"
          }
        },
        {
          "type": "collection",
          "settings": {
            "label": "All"
          }
        },
        {
          "type": "collection",
          "settings": {
            "label": "Mattress"
          }
        },
        {
          "type": "collection",
          "settings": {
            "label": "Bedding"
          }
        }
      ]
    }
  ]
}
{% endschema %}
