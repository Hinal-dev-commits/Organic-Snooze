{{ 'nw-guarantee-v2.css' | asset_url | stylesheet_tag }}

{%- assign nw_shell_selector = '.nw-guarantee-v2.section-' | append: section.id -%}
{%- assign guarantee_badge_alt = section.settings.heading | strip_html | escape -%}
{% render 'nw-section-shell', selector: nw_shell_selector, mode: 'overlay', default_bg: '#FFFCF0' %}
<section
  class="nw-guarantee-v2 section-{{ section.id }}"
  style="
    --nw-gv2-card-bg: {{ section.settings.card_bg_color }};
    --nw-gv2-heading-color: {{ section.settings.heading_color }};
    --nw-gv2-text-color: {{ section.settings.text_color }};
    --nw-gv2-cta-heading-color: {{ section.settings.cta_heading_color }};
    --nw-gv2-primary-btn-bg: {{ section.settings.primary_btn_bg_color }};
    --nw-gv2-primary-btn-text: {{ section.settings.primary_btn_text_color }};
    --nw-gv2-outline-btn-border: {{ section.settings.outline_btn_border_color }};
    --nw-gv2-outline-btn-text: {{ section.settings.outline_btn_text_color }};
    --nw-gv2-divider-color: {{ section.settings.divider_color }};
  "
>
  <div class="page-width">
    <div class="nw-guarantee-v2__wrapper{%- render 'nw-scroll-animation' -%}">
      <div class="nw-guarantee-v2__card">
        <div class="nw-guarantee-v2__main">
          {%- if section.settings.badge_image != blank -%}
            <div class="nw-guarantee-v2__badge">
              {{
                section.settings.badge_image
                | image_url: width: 200
                | image_tag:
                  alt: guarantee_badge_alt,
                  class: 'nw-guarantee-v2__badge-img',
                  loading: 'lazy'
              }}
            </div>
          {%- endif -%}

          <div class="nw-guarantee-v2__copy">
            {%- if section.settings.heading != blank -%}
              <h2 class="nw-guarantee-v2__heading">{{ section.settings.heading }}</h2>
            {%- endif -%}
            {%- if section.settings.description != blank -%}
              <div class="nw-guarantee-v2__description rte">{{ section.settings.description }}</div>
            {%- endif -%}
          </div>
        </div>

        <div class="nw-guarantee-v2__cta">
          {%- if section.settings.cta_heading != blank -%}
            <h3 class="nw-guarantee-v2__cta-heading">{{ section.settings.cta_heading }}</h3>
          {%- endif -%}

          <div class="nw-guarantee-v2__actions">
            {%- if section.settings.show_primary_button and section.settings.primary_button_text != blank -%}
              {%- if section.settings.primary_button_link != blank -%}
                <a
                  href="{{ section.settings.primary_button_link }}"
                  class="nw-btn nw-btn--secondary nw-guarantee-v2__btn nw-guarantee-v2__btn--primary"
                >
                  <span class="nw-btn__text">{{ section.settings.primary_button_text }}</span>
                </a>
              {%- else -%}
                <button type="button" class="nw-btn nw-btn--secondary nw-guarantee-v2__btn nw-guarantee-v2__btn--primary">
                  <span class="nw-btn__text">{{ section.settings.primary_button_text }}</span>
                </button>
              {%- endif -%}
            {%- endif -%}

            {%- liquid
              assign show_secondary_row = false
              if section.settings.show_text_button and section.settings.text_button_label != blank
                assign show_secondary_row = true
              endif
              if section.settings.show_quiz_button and section.settings.quiz_button_label != blank
                assign show_secondary_row = true
              endif
            -%}

            {%- if show_secondary_row -%}
              <div class="nw-guarantee-v2__actions-row">
                {%- if section.settings.show_text_button and section.settings.text_button_label != blank -%}
                  {% render 'nw-button',
                    text: section.settings.text_button_label,
                    link: section.settings.text_button_link,
                    style: 'outline',
                    btn_class: 'nw-guarantee-v2__btn nw-guarantee-v2__btn--outline'
                  %}
                {%- endif -%}

                {%- if section.settings.show_quiz_button and section.settings.quiz_button_label != blank -%}
                  {% render 'nw-button',
                    text: section.settings.quiz_button_label,
                    link: section.settings.quiz_button_link,
                    style: 'outline',
                    btn_class: 'nw-guarantee-v2__btn nw-guarantee-v2__btn--outline'
                  %}
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.nw-guarantee-v2.name",
  "tag": "section",
  "class": "section-nw-guarantee-v2",
  "settings": [
    {
      "type": "header",
      "content": "GUARANTEE CONTENT"
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "Badge Image"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Try It for 100 Nights. Keep It for 30 Years"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>We know buying a mattress online is a big decision. That's why we give you over 3 months to decide if it's the right fit for your body. If not, we'll pick it up for a refund.</p>"
    },
    {
      "type": "header",
      "content": "CALL TO ACTION"
    },
    {
      "type": "inline_richtext",
      "id": "cta_heading",
      "label": "CTA Heading",
      "default": "Still Deciding? Talk to a Sleep Expert"
    },
    {
      "type": "checkbox",
      "id": "show_primary_button",
      "label": "Show Primary Button",
      "default": true
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Primary Button Label",
      "default": "Call (443) 333-1213",
      "visible_if": "{{ section.settings.show_primary_button == true }}"
    },
    {
      "type": "text",
      "id": "primary_button_link",
      "label": "Primary Button Link (E.g. tel:+14433331213)",
      "default": "tel:+14433331213",
      "visible_if": "{{ section.settings.show_primary_button == true }}"
    },
    {
      "type": "checkbox",
      "id": "show_text_button",
      "label": "Show Text Button",
      "default": true
    },
    {
      "type": "text",
      "id": "text_button_label",
      "label": "Text Button Label",
      "default": "Text Us",
      "visible_if": "{{ section.settings.show_text_button == true }}"
    },
    {
      "type": "text",
      "id": "text_button_link",
      "label": "Text Button Link (E.g. sms:+14433331213)",
      "default": "sms:+14433331213",
      "visible_if": "{{ section.settings.show_text_button == true }}"
    },
    {
      "type": "checkbox",
      "id": "show_quiz_button",
      "label": "Show Quiz Button",
      "default": true
    },
    {
      "type": "text",
      "id": "quiz_button_label",
      "label": "Quiz Button Label",
      "default": "Sleep Quiz",
      "visible_if": "{{ section.settings.show_quiz_button == true }}"
    },
    {
      "type": "url",
      "id": "quiz_button_link",
      "label": "Quiz Button Link",
      "visible_if": "{{ section.settings.show_quiz_button == true }}"
    },
    {
      "type": "header",
      "content": "COLORS"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#FFFFFF",
      "alpha": true
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "cta_heading_color",
      "label": "CTA Heading Color",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "primary_btn_bg_color",
      "label": "Primary Button Background",
      "default": "#878735",
      "alpha": true
    },
    {
      "type": "color",
      "id": "primary_btn_text_color",
      "label": "Primary Button Text",
      "default": "#FFFFFF",
      "alpha": true
    },
    {
      "type": "color",
      "id": "outline_btn_border_color",
      "label": "Outline Button Border",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "outline_btn_text_color",
      "label": "Outline Button Text",
      "default": "#613916",
      "alpha": true
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Mobile Divider Color",
      "default": "rgba(97, 57, 22, 0.2)",
      "alpha": true
    },
    {
      "type": "header",
      "content": "BACKGROUND"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "default": "image",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "color", "label": "Color" },
        { "value": "image", "label": "Image" },
        { "value": "gradient", "label": "Gradient" }
      ]
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFCF0",
      "alpha": true,
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile)",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "range",
      "id": "bg_image_opacity",
      "label": "Background Image Opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 35,
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "SECTION SPACING"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:sections.nw-guarantee-v2.name",
      "category": "NW Sections",
      "settings": {
        "primary_button_link": "tel:+14433331213"
      }
    }
  ]
}
{% endschema %}
