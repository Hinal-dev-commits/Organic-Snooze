{% include 'shogun-content-handler' %}
<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}">
  {%- liquid
    assign nw_toxin_trade_in_page = false
    if template.name == 'page' and template.suffix == 'toxin-trade-in'
      assign nw_toxin_trade_in_page = true
    elsif template.name == 'page' and request.query_parameters.view == 'toxin-trade-in'
      assign nw_toxin_trade_in_page = true
    endif
  -%}
  <head>
  {% comment %}Loads Shogun Analytics. Removing this will disrupt analytics data collection.{% endcomment %}
  <script type="text/javascript" async src="https://na.shgcdn3.com/pixel-collector.js"></script>
{% render 'replo-head' %}
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <script type="module">
      import * as StandardEvents from 'https://cdn.shopify.com/storefront/standard-events.js';

      window.StandardEvents = StandardEvents;

      customElements.define('collection-component', StandardEvents.createViewEventElement());
      customElements.define(
        'product-component',
        StandardEvents.createViewEventElement(HTMLElement, { defaultTrigger: 'intersect' }),
      );

      document.addEventListener('DOMContentLoaded', () => {
        const template = document.querySelector('main[data-template]')?.dataset.template || '';
        document.dispatchEvent(
          new StandardEvents.PageViewEvent({
            page: { template, title: document.title, url: window.location.href },
          })
        );
      }, { once: true });
    </script>

    <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart-disclosure-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart-disclosure-tooltip.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'details-disclosure.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'details-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'search-form.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'standard-actions-override.js' | asset_url }}" defer="defer"></script>

    {%- if settings.animations_reveal_on_scroll -%}
      <script src="{{ 'animations.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {{ content_for_header }}

    {% render 'theme-settings-styles' %}
    {% render 'theme-stylesheets' %}

    <script>
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>
    {%- comment -%} NW body type: DM Sans, only the weights this theme uses. {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap" rel="stylesheet">
    {{ 'nw-swiper-bundle.min.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'nw-swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'nw-when-swiper-ready.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'nw-countdown.js' | asset_url }}" defer="defer"></script>
    {%- comment -%}
      NW owns type: Optima LT Pro (self-hosted) for headings and DM Sans for body.
      Dawn font pickers still generate faces, but NW overrides --font-body-family and --font-heading-family below.
    {%- endcomment -%}
    {% render 'nw-theme-styles' %}
    {% render 'nw-theme-stylesheets' %}
    {% render 'nw-script' %}
    {%- if nw_toxin_trade_in_page -%}
      {% render 'nw-toxin-trade-in-page-head' %}
    {%- endif -%}

  {% render 'shogun-head' %}
  {%- comment -%} Gohighlevel code {%- endcomment -%}
  <script src="https://widgets.leadconnectorhq.com/loader.js" data-resources-url="https://widgets.leadconnectorhq.com/chat-widget/loader.js" data-widget-id="6aa1684faa1a4795583990d8" data-source="WEB_USER" defer></script>
</head>

  <body class="gradient{% if settings.animations_hover_elements != 'none' %} animate--hover-{{ settings.animations_hover_elements }}{% endif %} nw-theme-{{ template.name }}">
    <div id="scrollbar-measure">
      <div class="scrollbar-measure-inner"></div>
    </div>
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {%- if settings.cart_type == 'drawer' -%}
      {%- render 'cart-drawer' -%}
    {%- endif -%}

    <div id="nw-site-scroll" class="nw-site-scroll">
      {% sections 'header-group' %}

      <main
        id="MainContent"
        class="content-for-layout focus-none{% if nw_toxin_trade_in_page %} nw-toxin-trade-in-page{% endif %}"
        role="main"
        tabindex="-1"
        data-template="{{ template.name }}"
        {% if nw_toxin_trade_in_page %}
          data-nw-scroll-animate="{% if settings.animations_reveal_on_scroll %}true{% else %}false{% endif %}"
        {% endif %}
      >
        {% render 'nw-collection-page-h1' %}
        {{ content_for_layout }}
      </main>

      {% sections 'footer-group' %}
    </div>

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    {% render 'theme-global-scripts' %}

    {%- if settings.predictive_search_enabled -%}
      <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if settings.cart_type == 'drawer' -%}
      <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- comment -%} Load after Replo/landing CSS so header/footer overrides win. {%- endcomment -%}
    {%- if nw_toxin_trade_in_page -%}
      {{ 'nw-toxin-trade-in-page.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

  <!-- TUS: fold free-gift tags in UpCart cart (BFCM 2026). Delete this line to undo. --><script>!function(){if(!window.__tusFoldGifts){window.__tusFoldGifts=!0;var t="tus-fold-gifts-style",e=".upcart-public-cart-summary__slide-codes",n="upcart-public-component-tag",r=!1,o=!1,i=0;!function n(){var o,a=document.getElementById("upCart");if(a&&a.shadowRoot)return c(o=a.shadowRoot),new MutationObserver(function(){c(o)}).observe(o,{childList:!0,subtree:!0,characterData:!0}),void o.addEventListener("click",function(n){try{var i=o.querySelector(e);if(!i||n.target!==i)return;var a=o.getElementById(t);if(!a||!a.textContent)return;r=!r,c(o)}catch(t){}});200>++i&&setTimeout(n,300)}()}function c(i){if(!o){o=!0;try{var c=i.querySelector(e),a=c?function(t){var o=Array.prototype.slice.call(t.children),i=[],c=0;if(o.forEach(function(t,e){if(t.classList&&t.classList.contains(n)){var r=t.querySelector("."+n+"__text");r&&/^\s*free\b/i.test(r.textContent||"")?i.push(e+1):c++}}),!i.length||!c)return"";var a=e+'::after{content:"'+(r?"Show less":"+"+i.length+(1===i.length?" free gift":" free gifts"))+'";cursor:pointer;align-self:center;font-size:11.5px;line-height:17px;font-weight:600;text-transform:uppercase;text-decoration:underline;text-underline-offset:2px;color:#613916;padding:1px 2px;white-space:nowrap;}';return r?a:i.map(function(t){return e+">:nth-child("+t+")"}).join(",")+"{display:none!important;}"+a}(c):"",s=i.getElementById(t);s||((s=document.createElement("style")).id=t,i.appendChild(s)),s.textContent!==a&&(s.textContent=a)}catch(e){try{var l=i.getElementById(t);l&&(l.textContent="")}catch(t){}}o=!1}}}();</script></body>
</html>
