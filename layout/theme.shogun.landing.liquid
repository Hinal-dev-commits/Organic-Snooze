{% comment %}
Auto-generated by Shogun.
This file can be re-written at any time.
{% endcomment %}

{% include 'shogun-content-handler' %}
<html class="js" lang="{{ request.locale.iso_code }}">
  <head>
  {% comment %}Loads Shogun Analytics. Removing this will disrupt analytics data collection.{% endcomment %}
  <script type="text/javascript" async src="https://na.shgcdn3.com/pixel-collector.js"></script>
{% render 'replo-head' %}
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <script type="module">
      import * as StandardEvents from 'https://cdn.shopify.com/storefront/standard-events.js';

      window.StandardEvents = StandardEvents;

      customElements.define('collection-component', StandardEvents.createViewEventElement());
      customElements.define(
        'product-component',
        StandardEvents.createViewEventElement(HTMLElement, { defaultTrigger: 'intersect' }),
      );

      document.addEventListener('DOMContentLoaded', () => {
        const template = document.querySelector('main[data-template]')?.dataset.template || '';
        document.dispatchEvent(
          new StandardEvents.PageViewEvent({
            page: { template, title: document.title, url: window.location.href },
          })
        );
      }, { once: true });
    </script>

    <script src="https://widgets.leadconnectorhq.com/loader.js" data-resources-url="https://widgets.leadconnectorhq.com/chat-widget/loader.js" data-widget-id="6a995a8bc6e0c5008d00cc21" data-source="WEB_USER"></script>

    <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart-disclosure-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart-disclosure-tooltip.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'details-disclosure.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'details-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'search-form.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'standard-actions-override.js' | asset_url }}" defer="defer"></script>

    {%- if settings.animations_reveal_on_scroll -%}
      <script src="{{ 'animations.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {{ content_for_header }}

    {% render 'theme-settings-styles' %}
    {% render 'theme-stylesheets' %}

    <script>
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>
    {%- comment -%} NW body type: DM Sans, only the weights this theme uses. {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap" rel="stylesheet">
    {{ 'nw-swiper-bundle.min.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'nw-swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'nw-when-swiper-ready.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'nw-countdown.js' | asset_url }}" defer="defer"></script>
    {%- comment -%}
      NW owns type: Optima LT Pro (self-hosted) for headings and DM Sans for body.
      Dawn font pickers still generate faces, but NW overrides --font-body-family and --font-heading-family below.
    {%- endcomment -%}
    {% render 'nw-theme-styles' %}
    {% render 'nw-theme-stylesheets' %}
    {% render 'nw-script' %}
    {%- if nw_toxin_trade_in_page -%}
      {% render 'nw-toxin-trade-in-page-head' %}
    {%- endif -%}

  {% render 'shogun-head' %}
  {%- comment -%} Gohighlevel code {%- endcomment -%}
  <script src="https://widgets.leadconnectorhq.com/loader.js" data-resources-url="https://widgets.leadconnectorhq.com/chat-widget/loader.js" data-widget-id="6aa1684faa1a4795583990d8" data-source="WEB_USER"></script>
</head>
  <body>
    {% include 'shogun-content-handler' %}

    {{ 'nw-toxin-trade-in-page.css' | asset_url | stylesheet_tag }}
    
    {{ content_for_layout }}
    
    <script src="{{ 'predictive-search.js' | asset_url }}" defer></script>
<script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>
    <style type="text/css">
      body, html {
        width: 100% !important;
        background: white !important;
      }
    </style>
    
  </body>
</html>
