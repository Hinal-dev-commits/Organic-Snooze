      "type": "nw-faq",
      "blocks": {
        "faq_item_y66aRz": {
          "type": "faq_item",
          "settings": {
            "question": "Why do you only use natural materials?",
            "answer": "<p>Because what you sleep on matters. We build with certified organic cotton, wool, and natural latex instead of polyurethane foams, fiberglass, and unnecessary chemical additives whenever possible.</p>"
          }
        },
        "faq_item_NCDqpK": {
          "type": "faq_item",
          "settings": {
            "question": "What makes your craftsmanship different?",
            "answer": "<p>Every mattress and sheet is handcrafted in our Georgia factory using premium natural materials, thoughtful construction, and rigorous quality standards—not mass-produced on an overseas assembly line.</p>"
          }
        },
        "faq_item_QfaXFJ": {
          "type": "faq_item",
          "settings": {
            "question": "What does \"Made with Certified Organic Materials\" mean?",
            "answer": "<p>Our products are made using certified organic materials sourced from trusted suppliers. We focus on transparency and quality, using natural fibers and materials that meet recognized organic certification standards. Each layer is independently certified.&nbsp;</p>"
          }
        },
        "faq_item_er8HLg": {
          "type": "faq_item",
          "settings": {
            "question": "Why don't you use polyurethane foam?",
            "answer": "<p>We believe your bed should support recovery, not introduce unnecessary synthetic materials. That's why we focus on natural latex, organic cotton, and wool to create breathable, durable sleep products.</p>"
          }
        },
        "faq_item_yTKMy4": {
          "type": "faq_item",
          "settings": {
            "question": "How long are your products designed to last?",
            "answer": "<p>Quality natural materials are naturally resilient. With proper care, they're designed to provide years of comfortable, restorative sleep while maintaining their performance over time.</p>"
          }
        },
        "faq_item_3ATbxX": {
          "type": "faq_item",
          "settings": {
            "question": "Why is organic worth the investment?",
            "answer": "<p>Natural materials are more breathable, more durable, and free from many of the synthetic components commonly found in conventional bedding. We believe you'll feel the difference every night.</p>"
          }
        }
      },
