    "nw_testimonials_BU9rMk": {
      "type": "nw-testimonials",
      "blocks": {
        "testimonial_PwYfRk": {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "<p>“I am in love with my pillows, the first thing I must say is, these pillows are healthier, I am able to breath, no more headaches. And they keep cold, this is a plus for us who live in FL.”</p>",
            "author": "Clara",
            "verified": true,
            "verified_text": "Verified Customer"
          }
        },
        "testimonial_qpGpdz": {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "<p>“This pillow is amazing!! It's also reassuring knowing that what I'm sleeping on everyday is free of chemicals. I also love how you can adapt it to your head and neck for pressure relief.”</p>",
