        "collapsible_tab_W7etYx": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Product Specifications",
            "icon": "none",
            "content": "<ul><li>Includes 1 flat sheet, 1 fitted sheet, and 2 pillowcases&nbsp;</li><li>100% certified organic cotton</li><li>300 thread count, single-ply Breezeline™ sateen weave</li><li>Engineered for airflow and natural breathability</li><li>Deep-pocket fitted sheet fits mattresses up to 15\"</li><li>Reinforced elastic for a secure fit</li><li>Machine washable</li><li>Handcrafted in the USA</li></ul><p><em>(Twin/Twin XL includes 1 pillowcase)</em></p>",
            "page": "",
            "margin_top": 0,
            "margin_bottom": 0,
            "margin_top_mobile": 0,
            "margin_bottom_mobile": 0
          }
        },
        "collapsible_tab_THr6Kx": {
