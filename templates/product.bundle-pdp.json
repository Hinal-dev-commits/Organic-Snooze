    "nw_faq_eNAtek": {
      "type": "nw-faq",
      "blocks": {
        "faq_item_86xLYm": {
          "type": "faq_item",
          "settings": {
            "question": "What's in the bundle?",
            "answer": "<p>The Pillow Top Organic Latex Mattress by Gary Brecka, the SnoozeLift 5.0 Adjustable Base, two Kloud organic pillows, a Breezeline organic cotton sheet set, and an organic mattress protector, all matched to your selected size. A complete sleep system.</p>"
          }
        },
        "faq_item_A8nmKm": {
          "type": "faq_item",
          "settings": {
            "question": "How much do I save?",
            "answer": "<p>This bundle is $5,799.99, down from $8,199.99 bought separately, a saving of $2,400 (over 30%). Bundling is the best-value way to get a full organic sleep system.</p>"
          }
        },
        "faq_item_kRtVUc": {
          "type": "faq_item",
          "settings": {
            "question": "What are the sheets and protector made of?",
            "answer": "<p>The sheets are Breezeline organic cotton with a cooling weave, in a set of one fitted sheet, one flat sheet, and two pillowcases. The protector pairs an ORGANIC-AIR organic cotton comfort layer with a MoistureGuard plant-based, breathable, water-resistant barrier, with corner straps for a secure fit.</p>"
          }
        },
        "faq_item_j3cjpx": {
          "type": "faq_item",
          "settings": {
            "question": "Can I choose the pillow and sheet type?",
            "answer": "<p>Bundle accessories are fixed as configured. If you want to swap items, you can build a custom bundle on the mattress page, or call a Sleep Expert at 443-333-1213 to arrange one.</p>"
          }
        },
        "faq_item_NNbpUf": {
          "type": "faq_item",
          "settings": {
            "question": "Do the pieces ship together?",
            "answer": "<p>Not always. Bundle components may ship separately. The mattress typically arrives within about 14 days from our Georgia facility.</p>"
          }
        }
      },
