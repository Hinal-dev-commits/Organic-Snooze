      "name": "t:sections.nw-founder-story.name",
      "settings": {
        "show_rating": false,
        "star_rating": 5,
        "eyebrow": "Featured: Gary Brecka on organic sleep",
        "heading": "The Science of Deep Sleep",
        "media_type": "video",
        "video": "shopify://files/videos/instagram-video_e8b26256-9aaa-4428-b2d4-b9640655d5ba.mp4",
        "video_autoplay": false,
        "show_play_icon": true,
        "poster": "shopify://shop_images/founder-story-image.png",
        "overlay_text": "",
        "quote": "<p>\"You spend 8 hours a night breathing inches from your mattress and pillow. If those materials are off-gassing synthetic chemicals, your body is absorbing them all night. An organic sleep system isn't a luxury — it's a health decision.\"</p>",
        "name": "Gary Brecka",
        "show_verified": true,
        "role": "Longevity Expert & Founder of The Ultimate Human",
