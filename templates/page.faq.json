        "faq_item_0044": {
          "type": "faq_item",
          "settings": {
            "tab_label": "Comfort & Support",
            "question": "How do I know if my mattress is too firm?",
            "answer": "<p>Signs include pressure on the shoulders or hips, numbness, tossing and turning, or waking up sore on the side of your body that contacts the mattress.</p>"
          }
        },
        "faq_item_0045": {
          "type": "faq_item",
          "settings": {
            "tab_label": "Comfort & Support",
            "question": "How do I know if my mattress is too soft?",
            "answer": "<p>Signs include your hips sinking too far, lower back soreness, feeling stuck in the bed, or struggling to change positions.</p>"
          }
        },
        "faq_item_0046": {
          "type": "faq_item",
          "settings": {
            "tab_label": "Comfort & Support",
            "question": "What is pressure relief in a mattress?",
            "answer": "<p>Pressure relief is how well a mattress cushions high-pressure areas like shoulders, hips, and lower back while still supporting healthy alignment.</p>"
          }
        },
        "faq_item_0047": {
          "type": "faq_item",
          "settings": {
