        "faq_item_0043": {
          "type": "faq_item",
          "settings": {
            "tab_label": "Comfort & Support",
            "question": "Why do my shoulders hurt when I sleep on my side?",
            "answer": "<p>Shoulder discomfort can come from excess pressure, poor pillow height, or a mattress that does not allow enough contouring for side sleeping.</p>"
