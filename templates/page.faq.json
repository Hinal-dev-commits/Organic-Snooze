          "type": "faq_item",
          "settings": {
            "tab_label": "Mattress Materials",
            "question": "What materials are inside an Ultimate Snooze mattress?",
            "answer": "<p>Ultimate Snooze mattresses use organic cotton, organic wool, natural latex, and a supportive pocketed coil system, depending on the model.</p>"
          }
        },
