        "faq_item_0042": {
          "type": "faq_item",
          "settings": {
            "tab_label": "Comfort & Support",
            "question": "Why do my hips hurt when I sleep on my side?",
            "answer": "<p>Hip pain can happen when a mattress is too firm and creates pressure points, or too soft and lets your hips sink out of alignment.</p>"
