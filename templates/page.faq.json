        "faq_item_0052": {
          "type": "faq_item",
          "settings": {
            "tab_label": "Cooling & Temperature",
            "question": "Why does memory foam sleep hot?",
            "answer": "<p>Memory foam can contour closely around the body and restrict airflow, which may trap heat. Natural latex and coils are generally more breathable.</p>"
          }
        },
        "faq_item_0053": {
          "type": "faq_item",
          "settings": {
            "tab_label": "Cooling & Temperature",
            "question": "Does wool make a mattress hot?",
