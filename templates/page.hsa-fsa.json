    "nw_faq_BfXQfr": {
      "type": "nw-faq",
      "blocks": {
        "faq_item_Rfk7Vf": {
          "type": "faq_item",
          "settings": {
            "question": "What Truemed is?",
            "answer": "<p>Truemed is a payment platform that enables qualified customers to use their HSA (Health Savings Account) or FSA (Flexible Spending Account) funds on eligible health and wellness products. Truemed partners with a network of independent, licensed clinicians who review customer health information and issue a Letter of Medical Necessity (LMN) when a purchase qualifies.</p>"
          }
        },
        "faq_item_NwLPQ6": {
          "type": "faq_item",
          "settings": {
            "question": "How customers save?",
            "answer": "<p>HSA and FSA accounts hold pre-tax dollars. When customers pay with these funds, they effectively save their income tax rate on the purchase. Qualified customers save an average of 30%* compared to paying with after-tax income.</p>"
          }
        },
        "faq_item_LHmNHp": {
          "type": "faq_item",
          "settings": {
            "question": "What is an LMN?",
            "answer": "<p>A Letter of Medical Necessity (LMN) is a document issued by an independent, licensed clinician confirming that a purchase is medically necessary for a diagnosed health condition. The IRS requires this documentation for HSA/FSA funds to be used on health and wellness products.</p><p>Key things you should know about LMNs:</p><ul><li>Truemed’s clinician network handles all LMN issuance.&nbsp;</li><li>Each LMN is valid for 12 months from the date of issue.</li><li>Not every person will qualify. Eligibility depends on individual health circumstances and the clinician’s assessment.</li></ul>"
          }
        },
        "faq_item_4inxgG": {
          "type": "faq_item",
          "settings": {
            "question": "Two ways to use Truemed",
            "answer": "<h3><strong>At-checkout (Orders)</strong></h3><p>Select Truemed as a payment option during checkout, complete a clinical intake form, and pay with your HSA/FSA card. Documentation is generated automatically.&nbsp;</p><h3><strong>Post-purchase (Reimbursements)</strong></h3><p>You pay with a regular credit or debit card, then receive a link to complete a clinical intake form after purchase. If you qualify, Truemed issues an LMN and receipt. You &nbsp;then submit those documents to your HSA/FSA administrator for reimbursement.&nbsp;</p>"
          }
        }
      },
