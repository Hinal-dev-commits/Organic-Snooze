    "nw_faq_VygLpj": {
      "type": "nw-faq",
      "blocks": {
        "faq_item_hb8tnf": {
          "type": "faq_item",
          "settings": {
            "question": "What's the difference between the Pure and the Pillow Top?",
            "answer": "<p>The Pure Organic Mattress - Essential is 10\" depth versus the Pillowtop's 13\". The Pillowtop features a 4\" organic latex comfort layer, while the Essential has a 1\" latex comfort profile designed for a more supportive, medium-firm feel. Perfect for back and stomach sleepers.</p>"
          }
        },
        "faq_item_rnJYwh": {
          "type": "faq_item",
          "settings": {
            "question": "Is the Pure mattress soft or firm?",
            "answer": "<p>Firm — a 4 out of 10 on our comfort scale (1 = ultra firm, 10 = ultra plush). The Pure Organic Mattress delivers maximum support with no plush top layer.</p>"
          }
        },
        "faq_item_rG8phx": {
          "type": "faq_item",
          "settings": {
            "question": "What's inside the Pure mattress?",
            "answer": "<p>Organic cotton cover, organic wool base layer, natural latex, and a pocketed steel coil support system. Hand-tufted with no glue.</p>"
          }
        },
        "faq_item_qwBaqn": {
          "type": "faq_item",
          "settings": {
            "question": "Who is the Pure mattress best for?",
            "answer": "<p>The Pure Organic Mattress is ideal for the health-conscious shopper who wants the cleanest, most supportive organic mattress without the luxury comfort top layer. It is an excellent choice for back and stomach sleepers who need firm, flat support, and pairs exceptionally well with an adjustable base for customized positioning.</p>"
          }
        },
        "faq_item_QbMgNb": {
          "type": "faq_item",
          "settings": {
            "question": "Does it off-gas or smell?",
            "answer": "<p>Ultimate Snooze combines certified organic latex, organic wool, and pocket coils with zero toxic chemicals, glues, or fiberglass for restorative, clean sleep.</p>"
          }
        },
        "faq_item_pV4KRW": {
          "type": "faq_item",
          "settings": {
            "question": "Can I try it risk-free?",
            "answer": "<p>Yes. The Pure Organic Mattress - Essential comes with the same 100-night sleep trial (with a 30-night break-in period) and the same 30-year limited warranty as our Pillowtop Mattress. The return process does require a pick up fee of $199 in some cases.</p>"
          }
        },
        "faq_item_EkJ8ed": {
          "type": "faq_item",
          "settings": {
            "question": "Does it work with an adjustable base?",
            "answer": "<p>Yes. It is compatible with adjustable bases with proper support. We recommend our Snooze Lift adjustable base as a perfect pairing</p>"
          }
        },
        "faq_item_xqi3wi": {
          "type": "faq_item",
          "settings": {
            "question": "How long does the warranty last?",
            "answer": "<p>30 years — non-prorated for years 1–20, prorated for years 21–30.</p>"
          }
        }
      },
