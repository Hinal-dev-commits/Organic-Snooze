{% style %}

    :root {
        --font-body-family: 'DM Sans', sans-serif;
        --font-heading-family: 'Optima LT Pro', sans-serif;
    }
    @font-face {
        font-family: 'Optima LT Pro';
        src: url('{{ "OptimaLTPro-Medium.woff2" | asset_url }}') format('woff2'),
             url('{{ "OptimaLTPro-Medium.woff" | asset_url }}') format('woff'),
             url('{{ "OptimaLTPro-Medium.ttf" | asset_url }}') format('truetype');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
    }
    @font-face {
        font-family: 'Optima LT Pro';
        src: url('{{ "OptimaLTPro-Bold.woff2" | asset_url }}') format('woff2'),
             url('{{ "OptimaLTPro-Bold.woff" | asset_url }}') format('woff'),
             url('{{ "OptimaLTPro-Bold.ttf" | asset_url }}') format('truetype');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
    }
    body{
        letter-spacing: 0;
    }

    .announcement-bar__message {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: center;
        font-family: var(--font-body-family);
        font-weight: 400;
        font-size: 14px;
        line-height: 145%;
        letter-spacing: 0;
        text-align: center;
        text-transform: uppercase;
        padding: 0;
        min-height: unset;
        align-items: center;
        width: 100%;
    }

    .announcement-bar__link {
        font-family: var(--font-heading-family);
        font-weight: 700;
        text-decoration: underline;
        text-underline-offset: 2px !important;
        font-size: 14px !important;
        color: #fff !important;
        height: unset;
        width: unset;
    }
    .announcement-bar__link-divider{
        min-width: 4px;
        min-height: 4px;
        width: 4px;
        height: 4px;
        background: #fff;
        border-radius: 50%;
    }
    .header__menu-item{
        font-family: var(--font-body-family);
        font-weight: 400;
        font-size: 14px;
        line-height: 145% !important;
        letter-spacing: 0%;
        text-align: center;
        text-transform: capitalize;
        padding: 14px 11px;
    }
    .header--middle-left{
        gap: 53px;
    }
    .list-menu li:first-child a{
        padding-left: 0;
    }
    .list-menu li:last-child a{
        padding-right: 0;
    }
    .header__icon .svg-wrapper{
        width: unset;
        height: unset;
    }
    .header__icon .icon{
        width: 36px;
        height: 36px;
    }
    .header__icon--account{
        display: none !important;
    }
    .header__icon--cart{
        margin-right: 0px;
    }
    .header__icons{
        padding-right: 0px;
        gap: 12px;
    }
    .header__icon{
        width: unset;
        height: unset;
    }
    .header__icons shopify-store:empty{
        display: none !important;
    }
    .header--middle-left .header__heading-link, .header--top-left .header__heading-link{
        margin-left: 0px;
    }
    header-drawer{
        margin-left: 0px !important;
    }
    @media screen and (max-width: 1299px) {
        
        .header__heading-logo-wrapper{
            max-width: 180px;
        }
        .header__menu-item{
            padding: 14px 10px;
        }
        .header--middle-left{
            gap: 43px;
        }
    }
    @media screen and (max-width: 1199px) {
        .list-menu--inline{
            justify-content: center;
        }
    }
    @media screen and (max-width: 749px) {
        .header--middle-left{
            gap: 6px
        }
        header-drawer, .menu-drawer-container{
            width: 36px;
            justify-content: center;
        }
        header-drawer .icon{
            width: 24px !important;
            height: 24px !important;
        }
        .header__heading .header__heading-link{
            padding: 0px 10px;
        }
        .header__icons{
            gap: 6px
        }
        header-drawer .header__icon span{
            width: 36px;
            height: 36px;
        }
        .menu-drawer__menu-item{
            padding: 14px 22px !important;
        }
        .list-menu li:first-child a{
            padding-left: 11px;
        }
        .list-menu li:last-child a{
            padding-right: 11px;
        }
    }

    /* Footer */
    .footer {
        border-top: none;
    }


    .footer__content-top {
        display: flex !important;
        flex-direction: column;
        align-items: center;
        gap: 32px;
        padding-bottom: 0 !important;
    }

    .footer__logo {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .footer__logo-link {
        display: inline-flex;
    }

    .footer__logo-image {
        width: 271px;
        max-width: 100%;
        height: auto;
    }

    .footer__main {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 40px;
        width: 100%;
    }

    .footer-block--newsletter {
        flex: 0 0 444px;
        max-width: 444px;
        width: 100%;
        margin-top: 0;
        flex-direction: column;
        align-items: flex-start;
        gap: 0;
    }

    .footer-block__newsletter {
        text-align: left !important;
        flex-grow: 0;
        width: 100%;
    }

    .footer-block__newsletter .footer-block__heading {
        font-family: var(--font-heading-family);
        font-weight: 400;
        font-size: 34px;
        line-height: 1.15;
        letter-spacing: -0.34px;
        text-transform: capitalize;
        margin-bottom: 8px;
        color: #fff;
    }

    .footer__newsletter-description {
        font-family: var(--font-body-family);
        font-size: 16px;
        line-height: 1.2;
        color: #fff;
        margin: 0 0 20px;
    }

    .footer .newsletter-form {
        max-width: 100%;
        width: 100%;
        align-items: stretch;
        margin: 0;
    }

    .footer .newsletter-form__field-wrapper {
        max-width: 100%;
        width: 100%;
    }

    .footer .newsletter-form__field-wrapper .field {
        height: 56px;
    }

    .footer .newsletter-form__field-wrapper .field__input {
        height: 56px;
        min-height: 56px;
        border-radius: 1000px;
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 0 72px 0 20px;
        color: #fff;
        font-family: var(--font-body-family);
        font-size: 16px;
        line-height: 1.35;
        box-shadow: none;
    }

    .footer .newsletter-form__field-wrapper .field__input:focus,
    .footer .newsletter-form__field-wrapper .field__input:not(:placeholder-shown) {
        padding: 0 72px 0 20px;
        box-shadow: none;
    }

    .footer .newsletter-form__field-wrapper .field__label {
        display: none;
    }

    .footer .newsletter-form__field-wrapper .field__input::placeholder {
        color: rgba(255, 255, 255, 0.7);
        opacity: 1;
    }

    .footer .newsletter-form__button {
        width: auto;
        min-width: 56px;
        height: 100%;
        background: #878735;
        border-radius: 1000px;
        padding: 18px 24px;
        right: 0;
        border: none;
        color: #fff;
    }

    .footer .newsletter-form__button:focus,
    .footer .newsletter-form__button:focus-visible,
    .footer .newsletter-form__button:not(:focus-visible):not(.focused) {
        background: #878735;
        box-shadow: none;
    }

    .footer .newsletter-form__button .icon {
        width: 24px;
        height: 24px;
    }

    .footer__blocks-wrapper.grid {
        display: flex;
        flex: 1;
        flex-wrap: nowrap;
        gap: 40px;
        margin: 0;
        width: auto;
        max-width: 682px;
    }

    .footer-block.grid__item {
        width: auto;
        flex: 1 1 0;
        min-width: 0;
        margin: 0;
        padding: 0;
    }

    .footer-block__heading {
        font-family: var(--font-body-family);
        font-weight: 500;
        font-size: 20px;
        line-height: 1.35;
        letter-spacing: -0.4px;
        text-transform: uppercase;
        margin-bottom: 16px;
        color: #fff;
    }

    .footer-block__details-content {
        margin-bottom: 0 !important;
    }

    .footer-block__details-content .list-menu__item--link {
        font-family: var(--font-body-family);
        font-size: 20px !important;
        line-height: 1.35;
        letter-spacing: -0.4px;
        color: #fff;
        padding: 0 !important;
        display: block;
        text-decoration: none;
    }
    .footer-block__details-content li {
        margin-right: 0px !important;
    }

    .footer-block__details-content li + li {
        margin-top: 12px;
        display: flex;
    }

    .footer-block__details-content .list-menu__item--link:hover {
        color: #fff;
        text-decoration: underline;
        text-underline-offset: 0.2rem;
    }

    .footer__content-bottom {
        border-top: none !important;
        padding-top: 32px !important;
    }

    .footer__content-bottom-wrapper {
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 24px;
    }

    .footer__column,
    .footer__column--info {
        width: 100%;
        align-items: center;
        padding: 0;
    }

    .footer__list-social.list-social {
        justify-content: center;
        gap: 24px;
    }

    .footer .list-social__link {
        border: 1px solid #fff;
        border-radius: 1000px;
        padding: 8px;
        color: #fff;
    }

    .footer .list-social__item .icon {
        width: 24px;
        height: 24px;
    }

    .footer__payment {
        margin-top: 0;
        width: 100%;
    }

    .footer .list-payment {
        justify-content: center;
        gap: 10px;
        padding-top: 0;
        margin: 0;
    }

    .footer .list-payment__item {
        padding: 0;
    }

    .footer__copyright {
        margin-top: 24px !important;
        text-align: center !important;
        width: 100%;
    }

    .footer .copyright__content {
        font-family: var(--font-body-family);
        font-size: 14px;
        line-height: 1.4;
        opacity: 0.7;
        color: #fff;
    }

    .footer .copyright__content a {
        color: #fff;
        text-decoration: none;
    }

    .footer .copyright__content + .copyright__content {
        display: none;
    }

    .footer .policies {
        display: none;
    }
    .field::after{
        display: none;
    }
    .footer-block__details-content .list-menu__item--link, .copyright__content a{
        color: rgba(var(--color-foreground)) !important;
    }
    .footer-block--menu > h2.footer-block__heading{
        display: none;
    }
    @media screen and (max-width: 989px) {

        .footer__main {
            flex-direction: column;
            gap: 32px;
        }

        .footer-block--newsletter {
            flex: 1 1 auto;
            max-width: 100%;
        }

        .footer__blocks-wrapper.grid {
            flex-wrap: wrap;
            width: 100%;
        }

        .footer-block.grid__item {
            flex: 1 1 calc(50% - 20px);
        }
    }

    @media screen and (max-width: 749px) {

        .footer__content-top {
            gap: 24px;
        }
        .footer__main{
            gap: 40px
        }

        .footer__blocks-wrapper.grid {
            flex-direction: column;
        }

        .footer-block.grid__item {
            flex: 1 1 100%;
            margin: 0 !important;
            border-bottom: 1px solid rgba(var(--color-foreground), 0.15);
        }

        .footer-block__heading,
        .footer-block__details-content .list-menu__item--link {
            font-size: 14px !important;
        }

        .footer-block__newsletter .footer-block__heading {
            font-size: 28px;
        }
        .footer__content-top{
            padding-left: 16px !important;
            padding-right: 16px !important;
        }
        .footer-block__heading{
            margin-bottom: 0px !important;
            letter-spacing: 0px ;
            font-size: 16px !important;
            line-height: 1.5;
        }
        .footer-block--menu {
            padding: 14px 0px !important;
        }
        .footer-block__details-content{
            padding-top: 10px !important;
        }
        .footer-block__newsletter .footer-block__heading{
            font-size: 32px !important;
        }
        .footer__newsletter-description{
            font-size: 14px;
        }
        .footer-block__newsletter{
            text-align: center !important;
        }
        .footer-block--newsletter{
            margin-top: 0px !important;
        }
        .footer__content-bottom{
            padding-top: 40px !important;
        }
        .footer .list-social__link{
            width: 40px;
            height: 40px;
        }
        .footer__content-bottom-wrapper{
            gap: 32px !important;
        }
        .footer__localization:empty + .footer__column{
            padding-top: 0px !important;
        }
        .footer .list-payment__item .icon {
            width: 36px;
            height: 22px;
        }
        .footer__copyright{
            margin-top: 32px !important;
        }
    }
{% endstyle %}