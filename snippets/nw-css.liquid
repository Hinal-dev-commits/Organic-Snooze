{% style %}

    :root {
 --font-body-family: 'DM Sans', sans-serif;
 --font-heading-family: 'Optima LT Pro', sans-serif;
        --primary-color: #613916;
        --secondary-color: #cc926a;
        --tertiary-color: #f4efe8;
        --quaternary-color: #70804a;
        --quinary-color: #fffcf0;
        --senary-color: #ffffff;
        --septenary-color: #e57b1e;
        --white: #ffffff;
        --octonary-color: #e0e0e0;
        --nonary-color: #878735;
    }
    @font-face {
        font-family: 'Optima LT Pro';
        src: url('{{ "OptimaLTPro-Medium.woff2" | asset_url }}') format('woff2'),
             url('{{ "OptimaLTPro-Medium.woff" | asset_url }}') format('woff'),
             url('{{ "OptimaLTPro-Medium.ttf" | asset_url }}') format('truetype');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
    }
    @font-face {
        font-family: 'Optima LT Pro';
        src: url('{{ "OptimaLTPro-Bold.woff2" | asset_url }}') format('woff2'),
             url('{{ "OptimaLTPro-Bold.woff" | asset_url }}') format('woff'),
             url('{{ "OptimaLTPro-Bold.ttf" | asset_url }}') format('truetype');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
    }
    body{
        letter-spacing: 0;
    }
    h1, .h1, 
    h2, .h2,
    h3, .h3,
    h4, .h4,
    h5, .h5,
    h6, .h6{
        font-family: var(--font-heading-family);
        font-weight: 400;
        color: var(--primary-color);
    }
    h3, .h3{
        font-family: var(--font-heading-family);
        font-weight: 400;
        font-style: Regular;
        font-size: 18px;
        line-height: 114.99999999999999%;
        letter-spacing: -1%;
        text-transform: capitalize;
        color: var(--primary-color);
    }
    h2 , .h2{
        font-family: var(--font-heading-family);
        font-weight:400;
        font-size: 36px;
        line-height: 114.99999999999999%;
        letter-spacing: -1%;
        text-align: center;
        text-transform: capitalize;
    }
    .nw-section-heading,
    .nw-section-heading .h2 {
        margin: 0;
        width: 100%;
    }
    .nw-section-description{
        margin-top: 14px;
    }

    .rte{
        font-family: var(--font-body-family);
        font-weight: 400;
        font-size: 18px;
        line-height: 140%;
        letter-spacing: 0%;
        text-align: center;
        color: var(--primary-color);
    }
    .rte > *:first-child{
        margin-top: 0;
    }
    .rte > *:last-child{
        margin-bottom: 0;
    }
    .announcement-bar__message {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: center;
        font-family: var(--font-body-family);
        font-weight: 400;
        font-size: 14px;
        line-height: 145%;
        letter-spacing: 0;
        text-align: center;
        text-transform: uppercase;
        padding: 0;
        min-height: unset;
        align-items: center;
        width: 100%;
        color: var(--white);
    }

    .announcement-bar__link {
        font-family: var(--font-heading-family);
        font-weight: 700;
        text-decoration: underline;
        text-underline-offset: 2px !important;
        font-size: 14px !important;
        color: #fff !important;
        height: unset;
        width: unset;
    }
    .announcement-bar__link-divider{
        min-width: 4px;
        min-height: 4px;
        width: 4px;
        height: 4px;
        background: #fff;
        border-radius: 50%;
    }
    .header__menu-item{
        font-family: var(--font-body-family);
        font-weight: 400;
        font-size: 14px;
        line-height: 145% !important;
        letter-spacing: 0%;
        text-align: center;
        text-transform: capitalize;
        padding: 14px 11px;
    }
    .header--middle-left{
        gap: 53px;
    }
    .list-menu li:first-child a{
        padding-left: 0;
    }
    .list-menu li:last-child a{
        padding-right: 0;
    }
    .header__icon .svg-wrapper{
        width: unset;
        height: unset;
    }
    .header__icon .icon{
        width: 36px;
        height: 36px;
    }
    .header__icon--account{
        display: none !important;
    }
    .header__icon--cart{
        margin-right: 0px;
    }
    .header__icons{
        padding-right: 0px;
        gap: 12px;
    }
    .header__icon{
        width: unset;
        height: unset;
    }
    .header__icons shopify-store:empty{
        display: none !important;
    }
    .header--middle-left .header__heading-link, .header--top-left .header__heading-link{
        margin-left: 0px;
    }
    header-drawer{
        margin-left: 0px !important;
    }


    .nw-eyebrow {
  font-family: var(--font-body-family);
  font-style: normal;
  font-weight: 500;
  font-size: 14px;
  line-height: 150%;
  color: var(--primary-color);
  padding-left: 3px;
  margin: 0;
  display: inline-flex;
  align-items: center;
}

h2, .h2 {
  font-family: var(--font-heading-family);
  font-style: normal;
  font-weight: 400;
  font-size: 36px;
  line-height: 115%;
  text-align: center;
  letter-spacing: -0.01em;
  text-transform: capitalize;
  color: var(--primary-color);
  margin: 0;
  width: 100%;
}


    .header-wrapper.nw-header-transprant,
    .header-wrapper:has(.header.nw-header-transprant) {
        background: transparent;
        background-color: transparent;
    }

    .header.nw-header-transprant {
        background: transparent;
        background-color: transparent;
    }

    .section-header:has(.header.nw-header-transprant) {
        margin-bottom: 0;
    }

    .header__heading-logo--transparent {
        display: none;
    }

    .header.nw-header-transprant .header__heading-logo--default {
        display: none;
    }

    .header.nw-header-transprant .header__heading-logo--transparent {
        display: block;
    }

    .header.nw-header-transprant:not(:has(.header__heading-logo--transparent)) .header__heading-logo--default {
        display: block;
    }

    .header.nw-header-transprant .header__menu-item,
    .header.nw-header-transprant .header__menu-item span,
    .header.nw-header-transprant summary.list-menu__item,
    .header.nw-header-transprant .header__heading-link,
    .header.nw-header-transprant .header__active-menu-item {
        color: rgb(var(--nw-header-transparent-text, var(--color-foreground)));
    }

    .header.nw-header-transprant .header__icon,
    .header.nw-header-transprant header-drawer .header__icon,
    .header.nw-header-transprant .localization-form__select,
    .header.nw-header-transprant .disclosure__button {
        color: rgb(var(--nw-header-transparent-icon, var(--color-foreground)));
    }

    .header-wrapper.nw-header-transprant.header-wrapper--border-bottom,
    .header-wrapper:has(.header.nw-header-transprant).header-wrapper--border-bottom {
        border-bottom-color: rgba(var(--nw-header-transparent-icon, var(--color-foreground)), 0.2);
    }
    .shopify-section-group-header-group{
        z-index: 100 !important;
    }

    @media screen and (max-width: 1299px) {
        
        .header__heading-logo-wrapper{
            max-width: 180px;
        }
        .header__menu-item{
            padding: 14px 10px;
        }
        .header--middle-left{
            gap: 43px;
        }
    }
    @media screen and (max-width: 1199px) {
        .list-menu--inline{
            justify-content: center;
        }
    }
    @media screen and (max-width: 749px) {
        .header--middle-left{
            gap: 6px
        }
        header-drawer, .menu-drawer-container{
            width: 36px;
            justify-content: center;
        }
        header-drawer .icon{
            width: 24px !important;
            height: 24px !important;
        }
        .header__heading .header__heading-link{
            padding: 0px 10px;
        }
        .header__icons{
            gap: 6px
        }
        header-drawer .header__icon span{
            width: 36px;
            height: 36px;
        }
        .menu-drawer__menu-item{
            padding: 14px 22px !important;
        }
        .list-menu li:first-child a{
            padding-left: 11px;
        }
        .list-menu li:last-child a{
            padding-right: 11px;
        }

        .nw-eyebrow {
    font-size: 12px;
    line-height: 150%;
  }

         h2, .h2 {
    font-size: 32px;
    line-height: 115%;
  }
    }

    /* Footer */
    .footer {
        border-top: none;
    }


    .footer__content-top {
        display: flex !important;
        flex-direction: column;
        align-items: center;
        gap: 32px;
        padding-bottom: 0 !important;
    }

    .footer__logo {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .footer__logo-link {
        display: inline-flex;
    }

    .footer__logo-image {
        width: 271px;
        max-width: 100%;
        height: auto;
    }

    .footer__main {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 40px;
        width: 100%;
    }

    .footer-block--newsletter {
        flex: 0 0 444px;
        max-width: 444px;
        width: 100%;
        margin-top: 0;
        flex-direction: column;
        align-items: flex-start;
        gap: 0;
    }

    .footer-block__newsletter {
        text-align: left !important;
        flex-grow: 0;
        width: 100%;
    }

    .footer-block__newsletter .footer-block__heading {
        font-family: var(--font-heading-family);
        font-weight: 400;
        font-size: 34px;
        line-height: 1.15;
        letter-spacing: -0.34px;
        text-transform: capitalize;
        margin-bottom: 8px;
        color: #fff;
    }

    .footer__newsletter-description {
        font-family: var(--font-body-family);
        font-size: 16px;
        line-height: 1.2;
        color: #fff;
        margin: 0 0 20px;
    }

    .footer .newsletter-form {
        max-width: 100%;
        width: 100%;
        align-items: stretch;
        margin: 0;
    }

    .footer .newsletter-form__field-wrapper {
        max-width: 100%;
        width: 100%;
    }

    .footer .newsletter-form__field-wrapper .field {
        height: 56px;
    }

    .footer .newsletter-form__field-wrapper .field__input {
        height: 56px;
        min-height: 56px;
        border-radius: 1000px;
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 0 72px 0 20px;
        color: #fff;
        font-family: var(--font-body-family);
        font-size: 16px;
        line-height: 1.35;
        box-shadow: none;
    }

    .footer .newsletter-form__field-wrapper .field__input:focus,
    .footer .newsletter-form__field-wrapper .field__input:not(:placeholder-shown) {
        padding: 0 72px 0 20px;
        box-shadow: none;
    }

    .footer .newsletter-form__field-wrapper .field__label {
        display: none;
    }

    .footer .newsletter-form__field-wrapper .field__input::placeholder {
        color: rgba(255, 255, 255, 0.7);
        opacity: 1;
    }

    .footer .newsletter-form__button {
        width: auto;
        min-width: 56px;
        height: 100%;
        background: #878735;
        border-radius: 1000px;
        padding: 18px 24px;
        right: 0;
        border: none;
        color: #fff;
    }

    .footer .newsletter-form__button:focus,
    .footer .newsletter-form__button:focus-visible,
    .footer .newsletter-form__button:not(:focus-visible):not(.focused) {
        background: #878735;
        box-shadow: none;
    }

    .footer .newsletter-form__button .icon {
        width: 24px;
        height: 24px;
    }

    .footer__blocks-wrapper.grid {
        display: flex;
        flex: 1;
        flex-wrap: nowrap;
        gap: 40px;
        margin: 0;
        width: auto;
        max-width: 682px;
    }

    .footer-block.grid__item {
        width: auto;
        flex: 1 1 0;
        min-width: 0;
        margin: 0;
        padding: 0;
    }

    .footer-block__heading {
        font-family: var(--font-body-family);
        font-weight: 500;
        font-size: 20px;
        line-height: 1.35;
        letter-spacing: -0.4px;
        text-transform: uppercase;
        margin-bottom: 16px;
        color: #fff;
        text-align: left;
    }

    .footer-block__details-content {
        margin-bottom: 0 !important;
    }

    .footer-block__details-content .list-menu__item--link {
        font-family: var(--font-body-family);
        font-size: 20px !important;
        line-height: 1.35;
        letter-spacing: -0.4px;
        color: #fff;
        padding: 0 !important;
        display: block;
        text-decoration: none;
    }
    .footer-block__details-content li {
        margin-right: 0px !important;
    }

    .footer-block__details-content li + li {
        margin-top: 12px;
        display: flex;
    }

    .footer-block__details-content .list-menu__item--link:hover {
        color: #fff;
        text-decoration: underline;
        text-underline-offset: 0.2rem;
    }

    .footer__content-bottom {
        border-top: none !important;
        padding-top: 32px !important;
    }

    .footer__content-bottom-wrapper {
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 24px;
    }

    .footer__column,
    .footer__column--info {
        width: 100%;
        align-items: center;
        padding: 0;
    }

    .footer__list-social.list-social {
        justify-content: center;
        gap: 24px;
    }

    .footer .list-social__link {
        border: 1px solid #fff;
        border-radius: 1000px;
        padding: 8px;
        color: #fff;
    }

    .footer .list-social__item .icon {
        width: 24px;
        height: 24px;
    }

    .footer__payment {
        margin-top: 0;
        width: 100%;
    }

    .footer .list-payment {
        justify-content: center;
        gap: 10px;
        padding-top: 0;
        margin: 0;
    }

    .footer .list-payment__item {
        padding: 0;
    }

    .footer__copyright {
        margin-top: 24px !important;
        text-align: center !important;
        width: 100%;
    }

    .footer .copyright__content {
        font-family: var(--font-body-family);
        font-size: 14px;
        line-height: 1.4;
        opacity: 0.7;
        color: #fff;
    }

    .footer .copyright__content a {
        color: #fff;
        text-decoration: none;
    }

    .footer .copyright__content + .copyright__content {
        display: none;
    }

    .footer .policies {
        display: none;
    }
    .field::after{
        display: none;
    }
    .footer-block__details-content .list-menu__item--link, .copyright__content a{
        color: rgba(var(--color-foreground)) !important;
    }
    .footer-block--menu > h2.footer-block__heading{
        display: none;
    }
    .header__menu-item:hover span{
        text-decoration: none;
        text-underline-offset: unset;
        color: var(--secondary-color);
    }
    .header.nw-header-transprant .header__menu-item:hover span{
        color: var(--septenary-color) !important;
    }
    .footer-block__details-content .list-menu__item--link:hover, .copyright__content a:hover{
        text-decoration: none !important;
        text-underline-offset: unset !important;
        color: var(--nonary-color) !important;
    }
    @media screen and (max-width: 989px) {

        .footer__main {
            flex-direction: column;
            gap: 32px;
        }

        .footer-block--newsletter {
            flex: 1 1 auto;
            max-width: 100%;
        }

        .footer__blocks-wrapper.grid {
            flex-wrap: wrap;
            width: 100%;
        }
    }

    .nw-product-card {
        display: flex;
        flex-direction: column;
        gap: 12px;
        width: 100%;
        color: var(--nw-pcard-text, #613916);
        height: 100%;
    }

    .nw-product-card__media {
        position: relative;
        border-radius: 10px;
        overflow: hidden;
        aspect-ratio: 260 / 330;
        background: #e0e0e0;
    }

    .nw-product-card__media-link {
        display: block;
        width: 100%;
        height: 100%;
    }

    .nw-product-card__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .nw-product-card__tag {
        position: absolute;
        top: 6px;
        padding: 4px 7px;
        border-radius: 4px;
        font-family: var(--font-body-family);
        font-size: 12px;
        font-weight: 600;
        line-height: 1.4;
        text-transform: uppercase;
        white-space: nowrap;
        z-index: 1;
    }

    .nw-product-card__tag--save {
        left: 8px;
        background: var(--nw-pcard-save-bg, #fffcf0);
        color: var(--nw-pcard-save-text, #613916);
    }

    .nw-product-card__tag--seller {
        right: 6px;
        background: var(--nw-pcard-seller-bg, #70804a);
        color: var(--nw-pcard-seller-text, #ffffff);
    }

    .nw-product-card__body {
        display: flex;
        flex-direction: column;
        gap: 12px;
        flex: 1;
    }

    .nw-product-card__rating {
        display: flex;
        align-items: center;
        gap: 4px;
        flex-wrap: wrap;
    }

    .nw-product-card__stars {
        display: inline-flex;
        align-items: center;
        gap: 0;
    }

    .nw-product-card__star {
        width: 14px;
        height: 14px;
        color: var(--nw-pcard-star-empty, rgba(97, 57, 22, 0.2));
    }

    .nw-product-card__star--full {
        color: var(--nw-pcard-star, #e57b1e);
    }

    .nw-product-card__star svg {
        width: 14px;
        height: 14px;
        display: block;
    }

    .nw-product-card__rating-value,
    .nw-product-card__rating-count {
        font-family: var(--font-body-family);
        font-size: 13px;
        line-height: 1.4;
        color: var(--nw-pcard-text, #613916);
    }

    .nw-product-card__title {
        margin: 0;
        font-family: var(--font-heading-family);
        font-size: 18px;
        line-height: 21px;
        letter-spacing: -0.18px;
        text-transform: capitalize;
        color: var(--primary-color);
        text-overflow: ellipsis;
        overflow: hidden;
        max-width: 100%;
        white-space: nowrap;
    }

    .nw-product-card__title a {
        color: inherit;
        text-decoration: none;
        line-height: inherit;
    }

    .nw-product-card__title a:hover {
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    .nw-product-card__firmness {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 4px 10px;
        border-radius: 4px;
        background: var(--nw-pcard-firmness-bg, #f4efe8);
    }

    .nw-product-card__firmness-label {
        font-family: var(--font-body-family);
        font-size: 12px;
        line-height: 1.4;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .nw-product-card__firmness-track {
        flex: 1;
        display: flex;
        align-items: center;
        min-width: 0;
    }

    .nw-product-card__firmness-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        border: 1px solid var(--nw-pcard-firmness-dot, rgba(97, 57, 22, 0.25));
        flex-shrink: 0;
    }

    .nw-product-card__firmness-dot.is-active {
        width: 8px;
        height: 8px;
        border-color: var(--nw-pcard-firmness-dot-active, #613916);
        background: var(--nw-pcard-firmness-dot-active, #613916);
    }

    .nw-product-card__firmness-line {
        flex: 1;
        height: 1px;
        background: var(--nw-pcard-firmness-line, rgba(97, 57, 22, 0.2));
        min-width: 4px;
    }

    .nw-product-card__footer {
        display: flex;
        flex-direction: column;
        gap: 12px;
        flex: 1;
        justify-content: flex-end;
    }

    .nw-product-card__price {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 5px;
        font-family: var(--font-body-family);
        color: var(--nw-pcard-text, #613916);
    }

    .nw-product-card__price-from {
        font-size: 12px;
        font-weight: 600;
        line-height: 1.4;
    }

    .nw-product-card__price-current {
        font-size: 15px;
        font-weight: 600;
        line-height: 1.4;
    }

    .nw-product-card__price-compare {
        font-size: 13px;
        line-height: 1.4;
        opacity: 0.6;
        text-decoration: line-through;
    }

    .nw-product-card .nw-btn {
        padding: 12px 32px;
        min-height: 49px;
    }
    .nw-product-card .nw-btn--primary {
        background: var(--nw-pcard-btn-bg, #cc926a);
        color: var(--nw-pcard-btn-text, #ffffff);
        border-color: var(--nw-pcard-btn-bg, #cc926a);

    }

    .nw-product-card .nw-btn--primary:hover {
        background: var(--nw-pcard-btn-bg-hover, #b57d57);
        border-color: var(--nw-pcard-btn-bg-hover, #b57d57);
        color: var(--nw-pcard-btn-text, #ffffff);
    }

    .nw-swiper-btn {
        position: absolute;
        top: calc(50% - 85px);
        z-index: 2;
        width: 40px;
        height: 40px;
        border: none;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--nw-swiper-arrow-bg, #613916);
        color: var(--nw-swiper-arrow-color, #ffffff);
        cursor: pointer;
        transition: opacity 0.2s ease, transform 0.2s ease;
        padding: 0;
    }

    .nw-swiper-btn svg {
        width: 25px;
        height: 25px;
        display: block;
    }

    .nw-swiper-btn:hover {
        opacity: 0.9;
    }

    .nw-swiper-btn:disabled,
    .nw-swiper-btn.swiper-button-disabled {
        opacity: 0;
        cursor: not-allowed;
        
    }

    .nw-swiper-btn--prev {
        left: -20px;
    }

    .nw-swiper-btn--next {
        right: -20px;
    }

    .nw-swiper-pagination {
        position: unset;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6.4px;
        margin-top: 40px;
        min-height: 8px;
    }

