{% doc %}
Renders a featured blog article card for NW Featured Articles.
@param {object} article - Shopify article object
@param {object} section - Parent section for settings
@example
{% render 'nw-featured-articles-card', article: article, section: section %}
{% enddoc %}

{%- liquid
  assign blog_tag_metafield = article.metafields.custom.blog_tag
  assign read_time_metafield = article.metafields.custom.read_time
  assign editors_pick_metafield = article.metafields.custom.editor_s_pick

  assign blog_tag = blank
  if blog_tag_metafield != blank
    assign blog_tag = blog_tag_metafield.value
  endif

  assign read_time = blank
  if read_time_metafield != blank
    assign read_time = read_time_metafield.value
  endif

  assign card_excerpt = article.excerpt | strip_html
  if card_excerpt == blank
    assign card_excerpt = article.content | strip_html | truncate: 180
  endif
  assign read_time_display = blank
  if read_time != blank
    assign read_time_text = read_time | strip
    if read_time_text contains 'read'
      assign read_time_display = read_time_text
    else
      assign read_time_display = read_time_text | append: ' min read'
    endif
  endif

  assign show_editors_pick = false
  assign editors_pick_label = section.settings.editor_pick_label | default: "Editor's Pick"
  if editors_pick_metafield != blank
    assign editors_pick_value = editors_pick_metafield.value | strip
    if editors_pick_value != blank
      assign show_editors_pick = true
      assign editors_pick_label = editors_pick_value
    endif
  endif
  assign button_label = section.settings.card_button_text | default: 'Read the article'
-%}

<article class="nw-featured-articles__card">
  <div class="nw-featured-articles__media">
    {%- if article.image != blank -%}
      <img
        src="{{ article.image | image_url }}"
        alt="{{ article.image.alt | default: article.title | escape }}"
        width=""
        height=""
        loading="lazy"
        class="nw-featured-articles__image"
      >
    {%- else -%}
      <div class="nw-featured-articles__placeholder" aria-hidden="true">
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}

    {%- if show_editors_pick -%}
      <span class="nw-featured-articles__badge">
        <span class="nw-featured-articles__badge-icon" aria-hidden="true">
          {% render 'nw-icon', icon: 'star' %}
        </span>
        <span class="nw-featured-articles__badge-text">{{ editors_pick_label }}</span>
      </span>
    {%- endif -%}
  </div>

  <div class="nw-featured-articles__body">
    <div class="nw-featured-articles__copy">
      {%- if blog_tag != blank -%}
        <p class="nw-featured-articles__tag">{{ blog_tag }}</p>
      {%- endif -%}

      {%- if article.title != blank -%}
        <h3 class="nw-featured-articles__title">
          <a href="{{ article.url }}" class="nw-featured-articles__title-link">{{ article.title }}</a>
        </h3>
      {%- endif -%}

      {%- if card_excerpt != blank -%}
        <div class="nw-featured-articles__excerpt rte">{{ card_excerpt }}</div>
      {%- endif -%}
    </div>

    {%- if article.author != blank or read_time_display != blank -%}
      <div class="nw-featured-articles__meta">
        {%- if article.author != blank -%}
          <span class="nw-featured-articles__author">{{ article.author }}</span>
        {%- endif -%}
        {%- if article.author != blank and read_time_display != blank -%}
          <span class="nw-featured-articles__meta-dot" aria-hidden="true">&bull;</span>
        {%- endif -%}
        {%- if read_time_display != blank -%}
          <span class="nw-featured-articles__read-time">{{ read_time_display }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if button_label != blank -%}
      <a href="{{ article.url }}" class="nw-featured-articles__btn">
        <span class="nw-featured-articles__btn-text">{{ button_label }}</span>
        <span class="nw-featured-articles__btn-icon" aria-hidden="true">
          {% render 'nw-icon', icon: 'arrow-right-3' %}
        </span>
      </a>
    {%- endif -%}
  </div>
</article>
