{% doc %}
Renders a Breezeline collection product card.
@param {product} product - Product object
@param {object} block - Section block with tag and title overrides
@param {boolean} show_feel - Show feel metafield
@param {boolean} show_best_for - Show best for metafield
@param {boolean} show_breathable - Show breathable scale
@param {string} breathable_label_1 - Left scale label
@param {string} breathable_label_2 - Center scale label
@param {string} breathable_label_3 - Right scale label
@param {string} cta_text - Link label
{% enddoc %}

{%- liquid
  assign card_product = product
  assign card_title = block.settings.custom_title
  if card_title == blank
    assign card_title = card_product.title
  endif

  assign feel_raw = card_product.metafields.custom.feel_text.value | default: card_product.metafields.custom.feel_text
  assign feel_text = feel_raw | strip

  assign best_for_raw = card_product.metafields.custom.best_for.value | default: card_product.metafields.custom.best_for
  assign best_for_text = ''
  if best_for_raw.first
    assign best_for_text = best_for_raw | join: ', ' | strip
  else
    assign best_for_text = best_for_raw | strip
  endif

  assign breathable_value = card_product.metafields.custom.breathable.value | default: card_product.metafields.custom.breathable
  assign breathable_key = breathable_value | downcase | strip
  assign breathable_index = 0

  if breathable_key == 'breathable'
    assign breathable_index = 1
  elsif breathable_key == 'comfort'
    assign breathable_index = 2
  elsif breathable_key == 'cool'
    assign breathable_index = 3
  endif

  assign show_feel_row = false
  if show_feel and feel_text != blank
    assign show_feel_row = true
  endif

  assign show_best_for_row = false
  if show_best_for and best_for_text != blank
    assign show_best_for_row = true
  endif

  assign show_breathable_row = false
  if show_breathable and breathable_index > 0
    assign show_breathable_row = true
  endif

  assign tag_text = block.settings.tag_text | strip

  assign card_image = card_product.featured_media
  if block.settings.use_custom_image and block.settings.custom_image != blank
    assign card_image = block.settings.custom_image
  endif

  assign breathable_label_1 = breathable_label_1 | default: 'Breathable'
  assign breathable_label_2 = breathable_label_2 | default: 'Comfort'
  assign breathable_label_3 = breathable_label_3 | default: 'Cool'
  assign cta_text = cta_text | default: 'Shop Now'
-%}

<article class="nw-breezeline-card" {{ block.shopify_attributes }}>
  <div class="nw-breezeline-card__media">
    <a href="{{ card_product.url }}" class="nw-breezeline-card__media-link" aria-label="{{ card_title | escape }}">
      {%- if card_image != blank -%}
        <img
          src="{{ card_image | image_url: width: 800 }}"
          alt="{{ card_image.alt | default: card_title | escape }}"
          width="400"
          height="400"
          loading="lazy"
          class="nw-breezeline-card__image"
        >
      {%- else -%}
        {{ 'product-apparel-2' | placeholder_svg_tag: 'nw-breezeline-card__image nw-breezeline-card__image--placeholder' }}
      {%- endif -%}
    </a>

    {%- if tag_text != blank -%}
      <span class="nw-breezeline-card__tag">{{ tag_text }}</span>
    {%- endif -%}
  </div>

  <div class="nw-breezeline-card__body">
    <h3 class="nw-breezeline-card__title">
      <a href="{{ card_product.url }}">{{ card_title | escape }}</a>
    </h3>

    {%- if show_feel_row -%}
      <div class="nw-breezeline-card__feel">
        {%- if card_product.metafields.custom.feel_text.type == 'rich_text_field' -%}
          <span class="nw-breezeline-card__value rte">{{ card_product.metafields.custom.feel_text | metafield_tag }}</span>
        {%- else -%}
          <span class="nw-breezeline-card__value">{{ feel_text }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if show_best_for_row -%}
      <div class="nw-breezeline-card__best-for">
        {%- if card_product.metafields.custom.best_for.type == 'rich_text_field' -%}
          <span class="nw-breezeline-card__value rte">{{ card_product.metafields.custom.best_for | metafield_tag }}</span>
        {%- else -%}
          <span class="nw-breezeline-card__value">{{ best_for_text }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if show_breathable_row -%}
      <div class="nw-breezeline-card__breathable">
        <div class="nw-breezeline-card__breathable-track" aria-hidden="true">
          {%- for i in (1..3) -%}
            <span class="nw-breezeline-card__breathable-dot{% if i == breathable_index %} is-active{% endif %}"></span>
            {%- unless forloop.last -%}
              <span class="nw-breezeline-card__breathable-line"></span>
            {%- endunless -%}
          {%- endfor -%}
        </div>
        <div class="nw-breezeline-card__breathable-labels">
          <span class="nw-breezeline-card__breathable-label{% if breathable_index == 1 %} is-active{% endif %}">{{ breathable_label_1 }}</span>
          <span class="nw-breezeline-card__breathable-label{% if breathable_index == 2 %} is-active{% endif %}">{{ breathable_label_2 }}</span>
          <span class="nw-breezeline-card__breathable-label{% if breathable_index == 3 %} is-active{% endif %}">{{ breathable_label_3 }}</span>
        </div>
      </div>
    {%- endif -%}

    <a href="{{ card_product.url }}" class="nw-breezeline-card__cta">
      <span>{{ cta_text }}</span>
      {% render 'nw-icon', icon: 'arrow-right' %}
    </a>
  </div>
</article>
