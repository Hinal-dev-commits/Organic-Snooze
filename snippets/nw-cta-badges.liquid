{% doc %}
Renders a CTA button plus optional trust badges from section or block settings.
@param {object} settings - Section or block settings with button and badge fields
@param {object} [blocks] - Optional badge blocks
@param {string} [class] - Extra class on the wrapper
@param {boolean} [show_cta_button] - When false, skips rendering the CTA button (badges only). Default: true
@example
{% render 'nw-cta-badges', settings: section.settings, blocks: section.blocks %}
{% enddoc %}

{%- liquid
  assign cta_text = settings.button_text | default: settings.btn_text | default: settings.button_label | default: settings.btn_label
  assign cta_link = settings.button_link | default: settings.btn_link
  assign cta_style = settings.button_style | default: settings.btn_style

  assign show_button = false
  if show_cta_button != false
    if settings.show_button == null or settings.show_button != false
      if cta_text != blank
        assign show_button = true
      endif
    endif
  endif

  assign show_badges = false
  if settings.show_features != false
    if blocks != blank and blocks.size > 0
      assign show_badges = true
    else
      for i in (1..4)
        case i
          when 1
            assign badge_text = settings.badge_1_text | default: settings.feature_1_text
            assign badge_icon = settings.badge_1_icon | default: settings.feature_1_icon
            assign badge_custom_icon = settings.badge_1_custom_icon | default: settings.feature_1_custom_icon
          when 2
            assign badge_text = settings.badge_2_text | default: settings.feature_2_text
            assign badge_icon = settings.badge_2_icon | default: settings.feature_2_icon
            assign badge_custom_icon = settings.badge_2_custom_icon | default: settings.feature_2_custom_icon
          when 3
            assign badge_text = settings.badge_3_text | default: settings.feature_3_text
            assign badge_icon = settings.badge_3_icon | default: settings.feature_3_icon
            assign badge_custom_icon = settings.badge_3_custom_icon | default: settings.feature_3_custom_icon
          when 4
            assign badge_text = settings.badge_4_text | default: settings.feature_4_text
            assign badge_icon = settings.badge_4_icon | default: settings.feature_4_icon
            assign badge_custom_icon = settings.badge_4_custom_icon | default: settings.feature_4_custom_icon
        endcase

        if badge_text != blank
          if badge_custom_icon != blank or badge_icon != blank and badge_icon != 'none'
            assign show_badges = true
            break
          endif
        endif
      endfor
    endif
  endif
-%}

{%- if show_button or show_badges -%}
  <div class="nw-cta-badges{% if class != blank %} {{ class }}{% endif %}">
    {%- if show_button -%}
      <div class="nw-cta-badges__button">
        {% render 'nw-button',
          text: cta_text,
          link: cta_link,
          style: cta_style
        %}
      </div>
    {%- endif -%}

    {%- if show_badges -%}
      <div class="nw-cta-badges__list">
        {%- if blocks != blank and blocks.size > 0 -%}
          {%- for block in blocks -%}
            {%- if block.settings.text != blank -%}
              {%- liquid
                assign badge_icon = block.settings.icon
                assign badge_custom_icon = blank

                if block.settings.use_custom_icon and block.settings.custom_icon != blank
                  assign badge_custom_icon = block.settings.custom_icon
                  assign badge_icon = blank
                elsif block.settings.icon == 'custom' and block.settings.custom_icon != blank
                  assign badge_custom_icon = block.settings.custom_icon
                  assign badge_icon = blank
                endif
              -%}
              <div class="nw-cta-badges__item" {{ block.shopify_attributes }}>
                {%- if badge_custom_icon != blank or badge_icon != blank and badge_icon != 'none' -%}
                  {%- liquid
                    assign badge_icon_style = ''
                    assign badge_icon_class = 'nw-cta-badges__icon'
                    if block.settings.icon_color != blank
                      assign badge_icon_class = badge_icon_class | append: ' nw-cta-badges__icon--themed'
                      assign badge_icon_style = '--nw-cta-badge-icon: ' | append: block.settings.icon_color | append: ';'
                      if badge_custom_icon != blank
                        assign badge_mask_url = badge_custom_icon | image_url: width: 80
                        assign badge_icon_style = badge_icon_style | append: ' --nw-cta-badge-icon-mask: url(' | append: badge_mask_url | append: ');'
                      endif
                    endif
                  -%}
                  <span
                    class="{{ badge_icon_class }}"
                    {% if badge_icon_style != blank %}
                      style="{{ badge_icon_style }}"
                    {% endif %}
                  >
                    {% render 'nw-trust-badge-icon', icon: badge_icon, custom_icon: badge_custom_icon %}
                  </span>
                {%- endif -%}
                <div class="nw-cta-badges__text">{{ block.settings.text }}</div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            {%- liquid
              case i
                when 1
                  assign badge_text = settings.badge_1_text | default: settings.feature_1_text
                  assign badge_icon = settings.badge_1_icon | default: settings.feature_1_icon
                  assign badge_custom_icon = settings.badge_1_custom_icon | default: settings.feature_1_custom_icon
                when 2
                  assign badge_text = settings.badge_2_text | default: settings.feature_2_text
                  assign badge_icon = settings.badge_2_icon | default: settings.feature_2_icon
                  assign badge_custom_icon = settings.badge_2_custom_icon | default: settings.feature_2_custom_icon
                when 3
                  assign badge_text = settings.badge_3_text | default: settings.feature_3_text
                  assign badge_icon = settings.badge_3_icon | default: settings.feature_3_icon
                  assign badge_custom_icon = settings.badge_3_custom_icon | default: settings.feature_3_custom_icon
                when 4
                  assign badge_text = settings.badge_4_text | default: settings.feature_4_text
                  assign badge_icon = settings.badge_4_icon | default: settings.feature_4_icon
                  assign badge_custom_icon = settings.badge_4_custom_icon | default: settings.feature_4_custom_icon
              endcase

              assign show_badge = false
              if badge_text != blank
                if badge_custom_icon != blank or badge_icon != blank and badge_icon != 'none'
                  assign show_badge = true
                endif
              endif
            -%}
            {%- if show_badge -%}
              <div class="nw-cta-badges__item">
                <span class="nw-cta-badges__icon">
                  {% render 'nw-trust-badge-icon', icon: badge_icon, custom_icon: badge_custom_icon %}
                </span>
                <div class="nw-cta-badges__text">{{ badge_text }}</div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
