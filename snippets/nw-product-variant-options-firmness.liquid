{% doc %}
  Renders firmness variant option cards.
  @param {object} product - Product object
  @param {object} option - Current product option
  @param {object} block - Block object
  @param {string} [values_order] - Comma-separated value order
{% enddoc %}
{%- liquid
  assign values_order = values_order | default: '' | strip
-%}

{%- if values_order != blank -%}
  {%- assign ordered_value_names = values_order | split: ',' -%}
  {%- for order_value in ordered_value_names -%}
    {%- assign order_value_clean = order_value | strip | downcase -%}
    {%- if order_value_clean == blank -%}
      {%- continue -%}
    {%- endif -%}
    {%- for value in option.values -%}
      {%- assign value_name_clean = value | strip | downcase -%}
      {%- if value_name_clean == order_value_clean -%}
        {% render 'nw-product-variant-firmness-value',
          product: product,
          option: option,
          value: value,
          value_index: forloop.index0
        %}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}

  {%- for value in option.values -%}
    {%- assign value_in_order = false -%}
    {%- assign value_name_clean = value | strip | downcase -%}
    {%- for order_value in ordered_value_names -%}
      {%- assign order_value_clean = order_value | strip | downcase -%}
      {%- if value_name_clean == order_value_clean -%}
        {%- assign value_in_order = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
    {%- unless value_in_order -%}
      {% render 'nw-product-variant-firmness-value',
        product: product,
        option: option,
        value: value,
        value_index: forloop.index0
      %}
    {%- endunless -%}
  {%- endfor -%}
{%- else -%}
  {%- for value in option.values -%}
    {% render 'nw-product-variant-firmness-value',
      product: product,
      option: option,
      value: value,
      value_index: forloop.index0
    %}
  {%- endfor -%}
{%- endif -%}
