{% doc %}
  NW product page wrapper rendered from main-product.
  Uses global section and product context.
{% enddoc %}

{% style %}
.nw-product-page {
  border-bottom: 1px solid rgba(78, 47, 20, 0.4);
}
.nw-product-page-media media-gallery{
    display: flex !important;
    flex-direction: column;
    gap: 12px;
}

.product__title > *{
    font-size: 28px;
}
.product__info-container .product__description{
    font-size: 20px;
}
.nw-product-price__save-badge{
    padding: 2px 8px;
}

.nw-product-page__section-header {
  margin-bottom: 40px;
  text-align: center;
}

.nw-product-page .product.grid {
  gap: 60px;
  align-items: flex-start;
}

.nw-product-page .product--large:not(.product--no-media) .product__media-wrapper {
  max-width: none;
  width: 100%;
  flex: 1 1 0;
  padding-top: 0;
  padding-bottom: 0;
}

.nw-product-page .product--large:not(.product--no-media) .product__info-wrapper {
  flex: 1 1 0;
  max-width: none;
  padding-left: 0;
}

.nw-product-page-media {
  display: block;
  width: 100%;
}

.nw-product-page-media__main {
  position: relative;
  width: 100%;
  min-height: 290px;
  background: #e0e0e0;
}

.nw-product-page-media--static .nw-product-page-media__main {
  border-radius: 12px;
  overflow: hidden;
}

.nw-product-page-media:not(.nw-product-page-media--static) .nw-product-page-media__main {
  overflow: visible;
  background: transparent;
  min-height: 0;
}

.nw-product-page-media__img,
.nw-product-page-media__video,
.nw-product-page-media__placeholder {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.nw-product-page-media--static .nw-product-page-media__main {
  height: 608px;
}

.nw-product-page-media:not(.nw-product-page-media--static) .nw-product-media__viewport {
  margin-bottom: 0;
}

.nw-product-page-media:not(.nw-product-page-media--static) media-gallery,
.nw-product-page-media:not(.nw-product-page-media--static) slider-component {
  display: block;
  width: 100%;
}

.nw-product-page-media__badge {
  position: absolute;
  top: 12px;
  z-index: 2;
  padding: 4px 7px;
  border-radius: 4px;
  font-family: var(--font-body-family);
  font-size: 16px;
  font-weight: 600;
  line-height: 1.3;
  text-transform: uppercase;
}

.nw-product-page-media__badge--left {
  left: 12px;
  background: #ffffff;
  color: #4e2f14;
}

.nw-product-page-media__badge--right {
  right: 12px;
  background: #878735;
  color: #ffffff;
}

.nw-mattress-upgrade {
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 100%;
}

.nw-mattress-upgrade__heading {
  margin: 0;
  font-family: var(--font-body-family);
  font-size: 20px;
  font-weight: 700;
  line-height: 1.4;
  color: #613916;
}

.nw-mattress-upgrade__card {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 18px;
  border: 1px solid rgba(97, 57, 22, 0.2);
  border-radius: 10px;
  background: #fffcf0;
}

.nw-mattress-upgrade__top {
  display: flex;
  gap: 16px;
  align-items: flex-start;
}

.nw-mattress-upgrade__media {
  flex: 0 0 211px;
  width: 211px;
  max-width: 42%;
  height: 198px;
  border-radius: 10px;
  overflow: hidden;
}

.nw-mattress-upgrade__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.nw-mattress-upgrade__content {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16px;
  width: 100%;
}

.nw-mattress-upgrade__title {
  margin: 0;
  font-family: var(--font-heading-family);
  font-size: 18px;
  font-weight: 400;
  line-height: 1.15;
  letter-spacing: -0.01em;
  text-transform: capitalize;
  color: #4e2f14;
}

.nw-mattress-upgrade__features {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.nw-mattress-upgrade__feature {
  display: flex;
  align-items: flex-start;
  gap: 4px;
  font-family: var(--font-body-family);
  font-size: 16px;
  line-height: 1.4;
  color: #4e2f14;
}

.nw-mattress-upgrade__feature-icon {
  flex-shrink: 0;
  width: 22px;
  height: 22px;
  color: #613916;
}

.nw-mattress-upgrade__feature-icon svg {
  width: 22px;
  height: 22px;
  display: block;
}

.nw-mattress-upgrade__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 47px;
  padding: 12px 32px;
  border: 1px solid #613916;
  border-radius: 50px;
  background: transparent;
  color: #613916;
  font-family: var(--font-body-family);
  font-size: 18px;
  font-weight: 600;
  line-height: 1.4;
  text-transform: uppercase;
  text-decoration: none;
  text-align: center;
}

.nw-mattress-upgrade__addon {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 12px;
  border: 1px solid rgba(78, 47, 20, 0.2);
  border-radius: 8px;
  background: #ffffff;
  cursor: pointer;
}

.nw-mattress-upgrade__checkbox {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.nw-mattress-upgrade__checkbox-ui {
  flex-shrink: 0;
  width: 20px;
  height: 20px;
  border: 1px solid #b3b3b3;
  border-radius: 4px;
  background: #ffffff;
}

.nw-mattress-upgrade__checkbox:checked + .nw-mattress-upgrade__checkbox-ui {
  background: #613916;
  border-color: #613916;
  box-shadow: inset 0 0 0 2px #ffffff;
}

.nw-mattress-upgrade__addon-title {
  flex: 1 1 auto;
  min-width: 0;
  font-family: var(--font-heading-family);
  font-size: 18px;
  line-height: 1.21;
  letter-spacing: -0.01em;
  text-transform: capitalize;
  color: #4e2f14;
  max-width: 144px;
}
.nw-mattress-upgrade__addon-price-inner{
  display: flex;
  gap: 4px;
  flex-wrap: wrap;
  justify-content: end;
  align-items: center;
}

.nw-mattress-upgrade__addon-pricing {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2px;
}

.nw-mattress-upgrade__addon-price {
  font-family: var(--font-body-family);
  font-size: 16px;
  font-weight: 600;
  color: #4e2f14;
  line-height: 1.3;
}

.nw-mattress-upgrade__addon-save {
  padding: 2px 8px;
  border-radius: 2px;
  background: #878735;
  color: #ffffff;
  font-family: var(--font-body-family);
  font-size: 10px;
  font-weight: 600;
  line-height: 1.3;
  text-transform: uppercase;
}

.nw-mattress-upgrade__addon-compare {
  font-family: var(--font-body-family);
  font-size: 12px;
  line-height: 1.4;
  color: rgba(78, 47, 20, 0.5);
  text-decoration: line-through;
}
.nw-mattress-upgrade__addon-inner{
  display: flex;
  gap: 6px;
  align-items: center;
}

@media screen and (max-width: 1199px) {
  .nw-product-page .product.grid{
    gap: 30px;
  }
}
@media screen and (max-width: 1023px) {
  .nw-product-page .product.grid{
    gap: 20px;
  }
  .nw-mattress-upgrade__top{
    flex-direction: column;
  }
  .nw-mattress-upgrade__media{
    flex: 1 1;
    width: 100%;
    max-width: 100%;
  }
  .nw-mattress-upgrade__heading{
    font-size: 18px;
  }
}
@media screen and (max-width: 749px) {
  .nw-product-page {
    border-bottom: none;
  }

  .nw-product-page__section-header {
    margin-bottom: 28px;
  }

  .nw-product-page .product.grid {
    gap: 16px;
    flex-direction: column;
  }

  .nw-product-page-media--static .nw-product-page-media__main {
    height: 290px;
    border-radius: 8px;
  }

  .nw-product-page-media:not(.nw-product-page-media--static) .nw-product-media__viewport {
    border-radius: 8px;
  }

  .nw-product-page-media__badge {
    top: 8px;
    font-size: 12px;
  }

  .nw-product-page-media__badge--left {
    left: 8px;
  }

  .nw-product-page-media__badge--right {
    right: 8px;
  }

  .nw-mattress-upgrade__top {
    flex-direction: column;
  }

  .nw-mattress-upgrade__media {
    width: 100%;
    max-width: 100%;
    height: 180px;
  }

  .nw-mattress-upgrade__addon {
    gap: 12px;
  }

  .nw-mattress-upgrade__addon-pricing {
    width: 100%;
    align-items: flex-start;
    gap: 2px;
    margin-left: 0px;
  }
  .nw-mattress-upgrade__heading{
    font-size: 16px;
  }
  .nw-product-page__section-header .nw-section-heading h1{
    font-size: 32px;
  }
  .product__media-wrapper{
    padding: 0 16px;
  }
  .product__title > *{
    font-size: 24px;
  }
  .product__info-container .product__description{
    font-size: 16px;
  }
  .nw-product-icon-text__text{
    font-size: 16px;
  }
  .nw-variant-picker__options input[type="radio"]:checked + label{
    padding: 9px 4px;
  }
  .nw-mattress-upgrade__card{
    padding: 16px;
  }
  .nw-mattress-upgrade__feature-icon{
    width: 24px;
    height: 24px;
  }
  .nw-mattress-upgrade__feature-icon svg{
    width: 24px;
    height: 24px;
  }
  .nw-mattress-upgrade__addon-title{
    max-width: 100%;
  }
  .nw-mattress-upgrade__addon input[type="checkbox"]{
    min-width: 20px;
    min-height: 20px;
  }
  .nw-mattress-upgrade__addon-price-inner{
    gap: 8px;
  }
  .nw-mattress-upgrade__addon-compare{
    line-height: 1.4;
  }
  .nw-mattress-upgrade__addon-inner{
    flex-direction: column;
  }
}
{% endstyle %}
