{% doc %}
Maps collection-list badge icon aliases onto nw-icon names.
@param {string} icon - Badge icon key from the section schema
@example
{% render 'nw-collection-list-icon', icon: block.settings.icon %}
{% enddoc %}

{%- liquid
  assign icon_name = icon
  case icon
    when 'warranty'
      assign icon_name = 'warranty-check'
    when 'financing'
      assign icon_name = 'financing-badge'
    when 'check'
      assign icon_name = 'default-check'
  endcase
-%}
{% render 'nw-icon', icon: icon_name %}
