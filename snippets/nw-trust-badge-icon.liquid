{% doc %}
Renders a trust badge icon from a preset or custom upload.
@param {string} icon - Preset icon: truck, warranty, moneyback, financing, none
@param {image} [custom_icon] - Optional custom icon image
@example
{% render 'nw-trust-badge-icon', icon: 'truck', custom_icon: block.settings.custom_icon %}
{% enddoc %}

{%- if custom_icon != blank -%}
  {% render 'nw-icon', icon: icon, custom_icon: custom_icon, img_class: 'nw-cta-badges__icon-img', img_width: 80 %}
{%- elsif icon != blank and icon != 'none' -%}
  {% render 'nw-icon', icon: icon, img_class: 'nw-cta-badges__icon-img' %}
{%- endif -%}