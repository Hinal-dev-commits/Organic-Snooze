{% doc %}
Mobile menu utilities: chat/call buttons and trust block.
@param {block} block - mobile_menu_utilities block
@param {string} [modifier_class] - optional extra class on the root utilities wrapper
@example
{% render 'nw-mobile-menu-utilities', block: utilities_block %}
{% enddoc %}

{%- if block != blank -%}
<div class="nw-mobile-menu__utilities{% if modifier_class != blank %} {{ modifier_class }}{% endif %}" {{ block.shopify_attributes }}>
  <div class="nw-mobile-menu__utility-buttons">
    {%- if block.settings.chat_label != blank -%}
      <a
        href="#"
        class="nw-mobile-menu__utility-btn"
        data-nw-open-ghl-chat
        role="button"
        aria-label="{{ block.settings.chat_label | escape }}"
      >
        <span class="nw-mobile-menu__utility-btn-icon" aria-hidden="true">
          {%- if block.settings.chat_icon != blank -%}
            {{
              block.settings.chat_icon
              | image_url: width: 48
              | image_tag: loading: 'lazy', widths: '24,48', class: 'nw-mobile-menu__utility-btn-img'
            }}
          {%- else -%}
            {{- 'icon-chat-bubble.svg' | inline_asset_content -}}
          {%- endif -%}
        </span>
        <span class="nw-mobile-menu__utility-btn-text">{{ block.settings.chat_label | escape }}</span>
      </a>
    {%- endif -%}

    {%- if block.settings.call_label != blank -%}
      <a
        {% if block.settings.call_link != blank %}
          href="{{ block.settings.call_link }}"
        {% else %}
          href="#" role="link" aria-disabled="true"
        {% endif %}
        class="nw-mobile-menu__utility-btn"
      >
        <span class="nw-mobile-menu__utility-btn-icon" aria-hidden="true">
          {%- if block.settings.call_icon != blank -%}
            {{
              block.settings.call_icon
              | image_url: width: 48
              | image_tag: loading: 'lazy', widths: '24,48', class: 'nw-mobile-menu__utility-btn-img'
            }}
          {%- else -%}
            <svg class="nw-mobile-menu__utility-btn-svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.3 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.1 21 3 13.9 3 5c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.3 1.1L6.6 10.8z" fill="currentColor"/>
            </svg>
          {%- endif -%}
        </span>
        <span class="nw-mobile-menu__utility-btn-text">{{ block.settings.call_label | escape }}</span>
      </a>
    {%- endif -%}
  </div>

  <div class="nw-mobile-menu__trust">
    <div class="nw-mobile-menu__trust-logo">
      {%- if block.settings.trust_logo != blank -%}
        {{
          block.settings.trust_logo
          | image_url: width: 58
          | image_tag: loading: 'lazy', widths: '29,58', class: 'nw-mobile-menu__trust-logo-img', width: 29, height: 29
        }}
      {%- elsif settings.logo != blank -%}
        {{
          settings.logo
          | image_url: width: 58
          | image_tag: loading: 'lazy', widths: '29,58', class: 'nw-mobile-menu__trust-logo-img', width: 29, height: 29, alt: shop.name
        }}
      {%- endif -%}
    </div>

    <div class="nw-mobile-menu__trust-divider" aria-hidden="true"></div>

    <div class="nw-mobile-menu__trust-body">
      <div class="nw-mobile-menu__trust-top">
        <span class="nw-mobile-menu__trust-stars" aria-hidden="true">
          {%- for i in (1..5) -%}
            {% render 'nw-icon', icon: 'star' %}
          {%- endfor -%}
        </span>

        {%- if block.settings.trust_rating_text != blank -%}
          <p class="nw-mobile-menu__trust-rating-text">{{ block.settings.trust_rating_text | escape }}</p>
        {%- endif -%}
      </div>

      <div class="nw-mobile-menu__trust-bottom">
        <div class="nw-mobile-menu__trust-reviewers">
          {%- for i in (1..3) -%}
            {%- liquid
              assign reviewer_key = 'reviewer_image_' | append: i
              assign reviewer_image = block.settings[reviewer_key]
            -%}
            {%- if reviewer_image != blank -%}
              <span class="nw-mobile-menu__trust-reviewer">
                {{
                  reviewer_image
                  | image_url: width: 48
                  | image_tag: loading: 'lazy', widths: '24,48', class: 'nw-mobile-menu__trust-reviewer-img', width: 24, height: 24
                }}
              </span>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <ul class="nw-mobile-menu__trust-items" role="list">
          {%- for i in (1..3) -%}
            {%- liquid
              assign icon_key = 'trust_item_' | append: i | append: '_icon'
              assign text_key = 'trust_item_' | append: i | append: '_text'
              assign trust_icon = block.settings[icon_key]
              assign trust_text = block.settings[text_key]
            -%}
            {%- if trust_text != blank -%}
              <li class="nw-mobile-menu__trust-item">
                <span class="nw-mobile-menu__trust-item-icon" aria-hidden="true">
                  {%- if trust_icon != blank -%}
                    {{
                      trust_icon
                      | image_url: width: 24
                      | image_tag: loading: 'lazy', widths: '12,24', class: 'nw-mobile-menu__trust-item-img', width: 12, height: 12
                    }}
                  {%- endif -%}
                </span>
                <span class="nw-mobile-menu__trust-item-text">{{ trust_text | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</div>
{%- endif -%}
