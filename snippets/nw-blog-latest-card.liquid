{% doc %}
  Renders a blog article card for NW Blog Latest.

  @param {object} article - Shopify article object
  @param {object} section - Parent section for settings

  @example
  {% render 'nw-blog-latest-card', article: article, section: section %}
{% enddoc %}

{%- liquid
  assign read_time_metafield = article.metafields.custom.read_time
  assign editors_pick_metafield = article.metafields.custom.editor_s_pick

  capture blog_tag
    render 'nw-blog-article-topic', article: article
  endcapture
  assign blog_tag = blog_tag | strip

  assign read_time = blank
  if section.settings.show_read_time and read_time_metafield != blank
    if read_time_metafield.value != blank
      assign read_time = read_time_metafield.value
    else
      assign read_time = read_time_metafield
    endif
  endif

  assign card_excerpt = article.excerpt | strip_html
  if card_excerpt == blank
    assign card_excerpt = article.content | strip_html | truncate: 180
  endif

  assign read_time_display = blank
  if read_time != blank
    assign read_time_text = read_time | strip_html | strip
    if read_time_text != blank
      if read_time_text contains 'read'
        assign read_time_display = read_time_text
      else
        assign read_time_display = read_time_text | append: ' read'
      endif
    endif
  endif

  assign show_author_meta = false
  if section.settings.show_author and article.author != blank
    assign show_author_meta = true
  endif

  assign show_read_time_meta = false
  if section.settings.show_read_time and read_time_display != blank
    assign show_read_time_meta = true
  endif

  assign show_editors_pick = false
  assign editors_pick_label = section.settings.editor_pick_label | default: "Editor's Pick"
  if section.settings.show_editors_pick and editors_pick_metafield != blank
    assign editors_pick_value = editors_pick_metafield.value | default: editors_pick_metafield | strip
    if editors_pick_value != blank
      assign show_editors_pick = true
      assign editors_pick_label = editors_pick_value
    endif
  endif

  assign button_label = section.settings.card_button_text | default: 'Read the article'
-%}

<article class="nw-blog-latest__card">
  <div class="nw-blog-latest__media">
    {%- if article.image != blank -%}
      <a href="{{ article.url }}" class="nw-blog-latest__media-link">
      <img
        src="{{ article.image | image_url: width: 1040 }}"
        alt="{{ article.image.alt | default: article.title | escape }}"
        width=""
        height=""
        loading="lazy"
        class="nw-blog-latest__image"
      >
      </a>
    {%- else -%}
      <div class="nw-blog-latest__placeholder" aria-hidden="true">
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}

    {%- if show_editors_pick -%}
      <span class="nw-blog-latest__badge">
        <span class="nw-blog-latest__badge-icon" aria-hidden="true">
          {% render 'nw-icon', icon: 'star' %}
        </span>
        <span class="nw-blog-latest__badge-text">{{ editors_pick_label }}</span>
      </span>
    {%- endif -%}
  </div>

  <div class="nw-blog-latest__body">
    <div class="nw-blog-latest__copy">
      {%- if blog_tag != blank -%}
        <p class="nw-blog-latest__tag">{{ blog_tag }}</p>
      {%- endif -%}

      {%- if article.title != blank -%}
        <h3 class="nw-blog-latest__title">
          <a href="{{ article.url }}" class="nw-blog-latest__title-link">{{ article.title }}</a>
        </h3>
      {%- endif -%}

      {%- if card_excerpt != blank -%}
        <div class="nw-blog-latest__excerpt rte">{{ card_excerpt }}</div>
      {%- endif -%}
    </div>

    {%- if show_author_meta or show_read_time_meta -%}
      <div class="nw-blog-latest__meta">
        {%- if show_author_meta -%}
          <span class="nw-blog-latest__author">{{ article.author }}</span>
        {%- endif -%}
        {%- if show_author_meta and show_read_time_meta -%}
          <span class="nw-blog-latest__meta-dot" aria-hidden="true">&bull;</span>
        {%- endif -%}
        {%- if show_read_time_meta -%}
          <span class="nw-blog-latest__read-time">{{ read_time_display }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_card_button and button_label != blank -%}
      <a href="{{ article.url }}" class="nw-blog-latest__btn">
        <span class="nw-blog-latest__btn-text">{{ button_label }}</span>
        <span class="nw-blog-latest__btn-icon" aria-hidden="true">
          {% render 'nw-icon', icon: 'arrow-right-3' %}
        </span>
      </a>
    {%- endif -%}
  </div>
</article>
