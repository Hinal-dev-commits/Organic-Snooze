{% doc %}
Returns Dawn scroll-reveal classes when Theme settings > Animations > Reveal sections on scroll is enabled.
Use inside a class attribute.
@param {string} [type] - Animation type. Default: slide-in
@example
<div class="my-class{%- render 'nw-scroll-animation' -%}">
{% enddoc %}
{%- liquid
  assign animation_type = type | default: 'slide-in'
  if settings.animations_reveal_on_scroll
    echo ' scroll-trigger animate--' | append: animation_type
  endif
-%}
