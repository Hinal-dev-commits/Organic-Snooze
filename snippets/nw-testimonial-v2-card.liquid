  endcase

  assign card_title = blank
  assign card_image = blank
  assign card_price = blank
  assign card_compare = blank
  assign card_link = blank

  if card_product_image != blank
    assign card_image = card_product_image
  endif

  if card_product != blank
    assign card_title = card_product.title
    if card_image == blank and card_product.featured_image != blank
      assign card_image = card_product.featured_image
    endif
    assign card_price = card_product.price_min
    assign card_compare = card_product.compare_at_price_min
    assign card_link = card_product.url
  endif

  assign category_label = card_category_tag
  if category_label == blank
    assign category_label = category_tag
  endif

  assign reviewer_name = card_name | strip
  assign reviewer_initials = ''
  if reviewer_name != blank and card_avatar == blank
    assign name_parts = reviewer_name | split: ' '
    assign first_initial = name_parts[0] | slice: 0, 1 | upcase
    assign reviewer_initials = first_initial
    if name_parts.size > 1
      assign last_name_part = name_parts | last
      assign last_initial = last_name_part | slice: 0, 1 | upcase
      assign reviewer_initials = first_initial | append: last_initial
    endif
  endif
-%}

<article class="nw-testimonial-v2__card">
  <div class="nw-testimonial-v2__card-main">
    {% render 'nw-stars',
      rating: card_rating,
      class: 'nw-testimonial-v2__stars',
      star_class: 'nw-testimonial-v2__star',
      icon: 'star-rating-sm'
    %}

    {%- if card_quote != blank -%}
      <div class="nw-testimonial-v2__quote rte">{{ card_quote }}</div>
    {%- endif -%}

    {%- if category_label != blank -%}
      <p class="nw-testimonial-v2__category">{{ category_label | upcase }}</p>
    {%- endif -%}

    <div class="nw-testimonial-v2__author">
      {%- if card_avatar != blank -%}
        <img
          src="{{ card_avatar | image_url: width: 96 }}"
          alt=""
          class="nw-testimonial-v2__avatar"
          width="32"
          height="32"
          loading="lazy"
        >
      {%- elsif reviewer_initials != blank -%}
        <span class="nw-testimonial-v2__avatar nw-testimonial-v2__avatar--initials" aria-hidden="true">
          {{ reviewer_initials }}
        </span>
      {%- endif -%}
      <div class="nw-testimonial-v2__author-main">

        {%- if reviewer_name != blank -%}
          <span class="nw-testimonial-v2__name">{{ reviewer_name }}</span>
        {%- endif -%}
        {%- if card_show_verified -%}
          <div class="nw-testimonial-v2__verified">
            <span class="nw-testimonial-v2__verified-icon" aria-hidden="true">
              {% render 'nw-icon', icon: 'verified' %}
            </span>
            <span class="nw-testimonial-v2__verified-text">
              {{ card_verified_text | default: 'Verified Customer' }}
            </span>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>

  {%- if card_show_product and card_product != blank -%}
    <div class="nw-testimonial-v2__product">
      {%- if card_image != blank -%}
        <img
          src="{{ card_image | image_url: width: 120 }}"
          alt=""
          class="nw-testimonial-v2__product-img"
          width="48"
          height="48"
          loading="lazy"
        >
      {%- endif -%}

      <div class="nw-testimonial-v2__product-copy">
        <p class="nw-testimonial-v2__product-title">{{ card_product_title | default: card_title }}</p>
        <div class="nw-testimonial-v2__product-prices">
          {%- if card_compare != blank and card_compare != card_price and card_compare > 0  -%}
            <span class="nw-testimonial-v2__product-compare">{{ card_compare | money }}</span>
          {%- endif -%}
          {%- if card_price != blank -%}
            <span class="nw-testimonial-v2__product-price">{{ card_price | money }}</span>
          {%- endif -%}
        </div>
      </div>

      {%- if card_link != blank -%}
        <a
          href="{{ card_link }}"
          class="nw-testimonial-v2__product-add"
          aria-label="{{ 'products.product.view_full_details' | t | default: 'View product' | escape }}"
        >
          <span aria-hidden="true">{% render 'nw-icon', icon: 'plus' %}</span>
        </a>
      {%- else -%}
        <span class="nw-testimonial-v2__product-add" aria-hidden="true">{% render 'nw-icon', icon: 'plus' %}</span>
      {%- endif -%}
    </div>
  {%- endif -%}
</article>
