{% doc %}
  Affirm promotional messaging for product buy-buttons.
  @param {object} product - Product object
  @param {string} section_id - Section ID for scoped variant updates
{% enddoc %}

{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign affirm_amount = selected_variant.price | times: 1 | round
-%}

{%- if product.available -%}
  <nw-product-affirm class="nw-product-affirm" data-section-id="{{ section_id }}">
    <p
      class="affirm-as-low-as"
      data-amount="{{ affirm_amount }}"
      data-page-type="product"
      data-learnmore-show="true"
    ></p>
  </nw-product-affirm>
{%- endif -%}
