{% doc %}
  Renders an SVG icon from a preset name or custom upload.

  @param {string} icon - Preset icon name
  @param {image} [custom_icon] - Optional custom icon image
  @param {string} [class] - Optional CSS class on SVG element
  @param {string} [img_class] - CSS class for custom icon image
  @param {number} [img_width] - Custom icon image width (default 40)

  @example
  {% render 'nw-icon', icon: 'truck' %}
{% render 'nw-icon', icon: 'verified', custom_icon: block.settings.custom_icon, img_class: 'nw-cta-badges__icon-img' %}
{% enddoc %}

{%- liquid
  assign icon_name = icon | default: ''
  assign svg_class = class | default: ''
  assign custom_img_class = img_class | default: 'nw-icon__img'
  assign custom_img_width = img_width | default: 40 | plus: 0
  if custom_img_width < 1
    assign custom_img_width = 40
  endif
  assign icon_asset = ''

  case icon_name
    when 'arrow-left'
      assign icon_asset = 'arrow-left.svg'
    when 'arrow-right'
      assign icon_asset = 'arrow-right.svg'
    when 'arrow-left-2'
      assign icon_asset = 'arrow-left-2.svg'
    when 'arrow-right-2'
      assign icon_asset = 'arrow-right-2.svg'
    when 'arrow-down'
      assign icon_asset = 'arrow-down.svg'
    when 'money', 'moneyback'
      assign icon_asset = 'money.svg'
    when 'truck'
      assign icon_asset = 'truck.svg'
    when 'shield'
      assign icon_asset = 'shield.svg'
    when 'offer', 'financing'
      assign icon_asset = 'offer.svg'
    when 'checkmark', 'check'
      assign icon_asset = 'checkmark.svg'
    when 'check-circle'
      assign icon_asset = 'check-circle.svg'
    when 'check-v2'
      assign icon_asset = 'check-v2.svg'
    when 'cross-circle'
      assign icon_asset = 'cross-circle.svg'
    when 'leaf'
      assign icon_asset = 'leaf.svg'
    when 'heart'
      assign icon_asset = 'heart.svg'
    when 'sparkle', 'award'
      assign icon_asset = 'sparkle.svg'
    when 'us-flag', 'us_flag'
      assign icon_asset = 'us-flag.svg'
    when 'star'
      assign icon_asset = 'star.svg'
    when 'verified'
      assign icon_asset = 'verified.svg'
    when 'verified-2', 'verified2'
      assign icon_asset = 'verified-2.svg'
      assign icon_asset = 'verified.svg'
    when 'verified-3', 'verified3'
      assign icon_asset = 'verified-3.svg'
    when 'quote'
      assign icon_asset = 'quote.svg'
    when 'play'
      assign icon_asset = 'play.svg'
    when 'gift'
      assign icon_asset = 'gift.svg'
    when 'pause'
      assign icon_asset = 'icon-pause.svg'
    when 'moon'
      assign icon_asset = 'moon.svg'
    when 'sun'
      assign icon_asset = 'sun.svg'
    when 'thermometer'
      assign icon_asset = 'thermometer.svg'
    when 'wind'
      assign icon_asset = 'wind.svg'
    when 'instagram'
      assign icon_asset = 'icon-instagram.svg'
    when 'insta', 'insta-color'
      assign icon_asset = 'insta-color.svg'
    when 'search'
      assign icon_asset = 'icon-search.svg'
    when 'usamap'
      assign icon_asset = 'Usa-map.svg'
    when 'moon'
      assign icon_asset = 'moon-icon.svg'
    when 'verified'
      assign icon_asset = 'certified.svg'
    when 'warranty-2'
      assign icon_asset = 'warrenty-icon.svg'
    when 'leaf'
      assign icon_asset = 'leaf-icon.svg'
    when 'breathable'
      assign icon_asset = 'breathable.svg'
    when 'handcrafted'
      assign icon_asset = 'handcrafted.svg'
    when 'guards'
      assign icon_asset = 'guards.svg'
    when 'preserve'
      assign icon_asset = 'preserve.svg'
    when 'silent'
      assign icon_asset = 'silent.svg'
    when 'plus'
      assign icon_asset = 'plus.svg'
  endcase
-%}

{%- if custom_icon != blank -%}
