{% comment %}
  Renders product variant-picker

  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} Id of the product form to which the variant picker is associated.
  Usage:
  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
{% endcomment %}
{%- unless product.has_only_default_variant -%}
  {%- liquid
    assign bedding_size_option_label = block.settings.bedding_size_option_name | strip
    if bedding_size_option_label == blank
      assign bedding_size_option_label = 'Bedding Size'
    endif
    assign bedding_size_option_name = bedding_size_option_label | downcase
  -%}
  {%- capture bedding_size_value_tokens_check -%}
    {%- render 'nw-bedding-size-variant-values',
      product: product,
      bedding_size_option_name: bedding_size_option_label
    -%}
  {%- endcapture -%}
  {%- assign bedding_size_value_tokens_check = bedding_size_value_tokens_check | strip -%}
  {%- liquid
    assign selected_variant = product.selected_or_first_available_variant
    assign select_size_text = selected_variant.metafields.custom.select_size.value | default: selected_variant.metafields.custom.select_size
    assign variant_tag_text = selected_variant.metafields.custom.variant_tag.value | default: selected_variant.metafields.custom.variant_tag
    assign firmness_sub_text_metafield = selected_variant.metafields.custom.firmness_sub_text
    if firmness_sub_text_metafield == blank or firmness_sub_text_metafield.value == blank
      assign firmness_sub_text_metafield = product.metafields.custom.firmness_sub_text
    endif
    assign firmness_option_name = block.settings.firmness_option_name | strip | downcase
    assign loft_option_name = block.settings.loft_option_name | strip | downcase
    assign size_option_name = block.settings.size_option_name | strip | downcase
    assign quantity_option_name = block.settings.quantity_option_name | strip | downcase
    assign option_position_order = block.settings.option_position_order | strip
    assign picker_gap = block.settings.picker_gap | default: 0
    assign picker_gap_mobile = block.settings.picker_gap_mobile | default: 0
    assign show_size_guide = block.settings.show_size_guide
    if show_size_guide == nil
      assign show_size_guide = true
    endif
    assign show_firmness_guide = block.settings.show_firmness_guide
    if show_firmness_guide == nil
      assign show_firmness_guide = true
    endif
    assign firmness_guide_label = block.settings.firmness_guide_label | strip
    if firmness_guide_label == blank
      assign firmness_guide_label = 'Firmness Guide'
    endif

    assign size_guide_modal_id = blank
    assign pillow_size_guide_modal_id = blank
    assign bedding_size_guide_modal_id = blank
    assign firmness_popup_modal_id = blank
    assign show_bedding_size_guide = block.settings.show_bedding_size_guide
    if show_bedding_size_guide == nil
      assign show_bedding_size_guide = false
    endif
    assign bedding_size_guide_label = block.settings.bedding_size_guide_label | strip
    if bedding_size_guide_label == blank
      assign bedding_size_guide_label = 'See Size Guide'
    endif
    assign firmness_popup_ref = block.settings.firmness_popup_modal_id | strip
    if firmness_popup_ref != blank
      if firmness_popup_ref contains 'NwFirmnessPopupModal-'
        assign firmness_popup_modal_id = firmness_popup_ref
      else
        assign firmness_popup_modal_id = 'NwFirmnessPopupModal-' | append: firmness_popup_ref
      endif
    elsif show_firmness_guide
      assign firmness_popup_modal_id = 'NwFirmnessPopupModal-firmness-guide'
    endif
    assign show_pillow_size_guide = block.settings.show_pillow_size_guide
    if show_pillow_size_guide == nil
      assign show_pillow_size_guide = false
    endif
    assign pillow_size_guide_label = block.settings.pillow_size_guide_label | strip
    if pillow_size_guide_label == blank
      assign pillow_size_guide_label = 'Size Guide'
    endif
    if show_pillow_size_guide
      assign pillow_popup_block = blank
      assign pillow_popup_id_setting = block.settings.pillow_size_guide_popup_id | strip
      if pillow_popup_id_setting != blank
        for pillow_popup_candidate in section.blocks
          if pillow_popup_candidate.type == 'nw_pillow_size_popup'
            assign pillow_popup_link_id = pillow_popup_candidate.settings.link_id | strip
            if pillow_popup_link_id == pillow_popup_id_setting or pillow_popup_candidate.id == pillow_popup_id_setting
              assign pillow_popup_block = pillow_popup_candidate
              break
            endif
          endif
        endfor
      else
        assign pillow_popup_block = section.blocks | where: 'type', 'nw_pillow_size_popup' | first
      endif
      if pillow_popup_block != blank
        assign pillow_size_guide_modal_id = 'NwPillowSizePopupModal-' | append: pillow_popup_block.id
      endif
    endif

    if show_size_guide
      assign popup_block = blank
      assign popup_id_setting = block.settings.size_guide_popup_id | strip
      if popup_id_setting != blank
        for popup_candidate in section.blocks
          if popup_candidate.type == 'nw_size_popup'
            assign popup_link_id = popup_candidate.settings.link_id | strip
            if popup_link_id == popup_id_setting or popup_candidate.id == popup_id_setting
              assign popup_block = popup_candidate
              break
            endif
          endif
        endfor
      else
        assign popup_block = section.blocks | where: 'type', 'nw_size_popup' | first
      endif
      if popup_block != blank
        assign size_guide_modal_id = 'NwSizePopupModal-' | append: popup_block.id
      endif
    endif
    assign product_has_bedding_size_option = false
    if bedding_size_value_tokens_check != blank and bedding_size_value_tokens_check != '|'
      assign product_has_bedding_size_option = true
    endif

    if show_bedding_size_guide and product_has_bedding_size_option
      assign bedding_popup_block = blank
      assign bedding_popup_id_setting = block.settings.bedding_size_guide_popup_id | strip
      if bedding_popup_id_setting != blank
        for bedding_popup_candidate in section.blocks
          if bedding_popup_candidate.type == 'nw_bedding_size_popup'
            assign bedding_popup_link_id = bedding_popup_candidate.settings.link_id | strip
            if bedding_popup_link_id == bedding_popup_id_setting or bedding_popup_candidate.id == bedding_popup_id_setting
              assign bedding_popup_block = bedding_popup_candidate
              break
            endif
          endif
        endfor
      else
        assign bedding_popup_block = section.blocks | where: 'type', 'nw_bedding_size_popup' | first
      endif
      if bedding_popup_block != blank
        assign bedding_size_guide_modal_id = 'NwBeddingSizePopupModal-' | append: bedding_popup_block.id
      endif
    else
      assign bedding_size_guide_modal_id = blank
    endif
  -%}
  <variant-selects
    id="variant-selects-{{ section.id }}"
    data-section="{{ section.id }}"
    data-product-handle="{{ product.handle }}"
    data-product-title="{{ product.title | escape }}"
    data-product-id="{{ product.id }}"
    data-currency-code="{{ cart.currency.iso_code }}"
    style="--nw-variant-picker-gap: {{ picker_gap }}px; --nw-variant-picker-gap-mobile: {{ picker_gap_mobile }}px;"
    {% # theme-check-disable %}
    data-selected-price-amount="{{ product.selected_or_first_available_variant.price | default: 0 | money_amount | escape }}"
    {% # theme-check-enable %}
    {{ block.shopify_attributes }}
  >
    {%- if option_position_order != blank -%}
      {%- assign ordered_option_names = option_position_order | split: ',' -%}
      {%- assign rendered_option_names = '|' -%}
      {%- for order_name in ordered_option_names -%}
        {%- assign order_name_clean = order_name | strip | downcase -%}
        {%- if order_name_clean == blank -%}
          {%- continue -%}
        {%- endif -%}
        {%- for option in product.options_with_values -%}
          {%- assign option_name_clean = option.name | strip | downcase -%}
          {%- if option_name_clean == order_name_clean -%}
            {%- assign rendered_option_names = rendered_option_names | append: option_name_clean | append: '|' -%}
            {%- liquid
              assign values_order = ''
              if option.position == 1
                assign values_order = block.settings.option_1_values_order | strip
              elsif option.position == 2
                assign values_order = block.settings.option_2_values_order | strip
              endif
            -%}
            {% render 'nw-variant-picker-option',
              product: product,
              option: option,
              block: block,
              product_form_id: product_form_id,
              firmness_option_name: firmness_option_name,
              loft_option_name: loft_option_name,
              size_option_name: size_option_name,
              bedding_size_option_name: bedding_size_option_name,
              quantity_option_name: quantity_option_name,
              select_size_text: select_size_text,
              variant_tag_text: variant_tag_text,
              values_order: values_order,
              show_size_guide: show_size_guide,
              size_guide_modal_id: size_guide_modal_id,
              show_pillow_size_guide: show_pillow_size_guide,
              pillow_size_guide_label: pillow_size_guide_label,
              pillow_size_guide_modal_id: pillow_size_guide_modal_id,
              show_bedding_size_guide: show_bedding_size_guide,
              bedding_size_guide_label: bedding_size_guide_label,
              bedding_size_guide_modal_id: bedding_size_guide_modal_id,
              show_firmness_guide: show_firmness_guide,
              firmness_guide_label: firmness_guide_label,
              firmness_popup_modal_id: firmness_popup_modal_id,
              firmness_sub_text_metafield: firmness_sub_text_metafield
            %}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}

      {%- for option in product.options_with_values -%}
        {%- assign option_key = '|' | append: option.name | strip | downcase | append: '|' -%}
        {%- unless rendered_option_names contains option_key -%}
          {%- liquid
            assign values_order = ''
            if option.position == 1
              assign values_order = block.settings.option_1_values_order | strip
            elsif option.position == 2
              assign values_order = block.settings.option_2_values_order | strip
            endif
          -%}
          {% render 'nw-variant-picker-option',
            product: product,
            option: option,
            block: block,
            product_form_id: product_form_id,
            firmness_option_name: firmness_option_name,
            loft_option_name: loft_option_name,
            size_option_name: size_option_name,
            bedding_size_option_name: bedding_size_option_name,
            quantity_option_name: quantity_option_name,
            select_size_text: select_size_text,
            variant_tag_text: variant_tag_text,
            values_order: values_order,
            show_size_guide: show_size_guide,
            size_guide_modal_id: size_guide_modal_id,
            show_pillow_size_guide: show_pillow_size_guide,
            pillow_size_guide_label: pillow_size_guide_label,
            pillow_size_guide_modal_id: pillow_size_guide_modal_id,
            show_bedding_size_guide: show_bedding_size_guide,
            bedding_size_guide_label: bedding_size_guide_label,
            bedding_size_guide_modal_id: bedding_size_guide_modal_id,
            show_firmness_guide: show_firmness_guide,
            firmness_guide_label: firmness_guide_label,
            firmness_popup_modal_id: firmness_popup_modal_id,
            firmness_sub_text_metafield: firmness_sub_text_metafield
          %}
        {%- endunless -%}
      {%- endfor -%}
    {%- else -%}
      {%- for option in product.options_with_values -%}
        {%- liquid
          assign values_order = ''
          if option.position == 1
            assign values_order = block.settings.option_1_values_order | strip
          elsif option.position == 2
            assign values_order = block.settings.option_2_values_order | strip
          endif
        -%}
        {% render 'nw-variant-picker-option',
          product: product,
          option: option,
          block: block,
          product_form_id: product_form_id,
          firmness_option_name: firmness_option_name,
          loft_option_name: loft_option_name,
          size_option_name: size_option_name,
          bedding_size_option_name: bedding_size_option_name,
          quantity_option_name: quantity_option_name,
          select_size_text: select_size_text,
          variant_tag_text: variant_tag_text,
          values_order: values_order,
          show_size_guide: show_size_guide,
          size_guide_modal_id: size_guide_modal_id,
          show_pillow_size_guide: show_pillow_size_guide,
          pillow_size_guide_label: pillow_size_guide_label,
          pillow_size_guide_modal_id: pillow_size_guide_modal_id,
          show_bedding_size_guide: show_bedding_size_guide,
          bedding_size_guide_label: bedding_size_guide_label,
          bedding_size_guide_modal_id: bedding_size_guide_modal_id,
          show_firmness_guide: show_firmness_guide,
          firmness_guide_label: firmness_guide_label,
          firmness_popup_modal_id: firmness_popup_modal_id,
          firmness_sub_text_metafield: firmness_sub_text_metafield
        %}
      {%- endfor -%}
    {%- endif -%}

    <script type="application/json" data-selected-variant>
      {{ product.selected_or_first_available_variant | json }}
    </script>
  </variant-selects>
{%- endunless -%}
