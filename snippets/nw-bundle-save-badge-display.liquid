{% doc %}
  Save badge (SAVE $X or SAVE X%) from Shopify variant compare_at_price and price — not kit metafield math.
  @param {object} product
  @param {object} [variant]
  @param {boolean} [for_collection_card]
  @param {boolean} [prefer_percentage]
{% enddoc %}

{%- unless product == blank -%}
{%- liquid
  assign badge_text = blank
  assign save_cents = 0
  assign compare_cents = 0

  if for_collection_card
    for v in product.variants
      assign v_compare = v.compare_at_price | default: 0 | plus: 0
      assign v_price = v.price | default: 0 | plus: 0
      if v_compare > v_price
        assign v_save = v_compare | minus: v_price
        if v_save > save_cents
          assign save_cents = v_save
          assign compare_cents = v_compare
        endif
      endif
    endfor
  else
    assign price_variant = variant | default: product.selected_or_first_available_variant
    assign compare_cents = price_variant.compare_at_price | default: 0 | plus: 0
    assign v_price = price_variant.price | default: 0 | plus: 0
    if compare_cents > v_price
      assign save_cents = compare_cents | minus: v_price
    endif
  endif
-%}

{%- if save_cents > 0 and compare_cents > 0 -%}
  {%- if prefer_percentage -%}
    {%- assign save_pct = save_cents | times: 100.0 | divided_by: compare_cents | round -%}
    {%- assign badge_text = 'SAVE ' | append: save_pct | append: '%' -%}
  {%- else -%}
    {%- assign save_money = save_cents | money_without_trailing_zeros -%}
    {%- assign badge_text = 'SAVE ' | append: save_money -%}
  {%- endif -%}
{%- endif -%}

{{- badge_text -}}
{%- endunless -%}
