{% doc %}
  Renders one product variant option picker.
  @param {object} product - Product object
  @param {object} option - Current product option
  @param {object} block - Variant picker block
  @param {string} product_form_id - Product form element id
  @param {string} [firmness_option_name] - Firmness option name match
  @param {string} [loft_option_name] - Loft option name match
  @param {string} [size_option_name] - Size option name match
  @param {string} [quantity_option_name] - Quantity option name match
  @param {string} [select_size_text] - Size guide link label
  @param {string} [variant_tag_text] - Variant tag label
  @param {string} [values_order] - Comma-separated value order
  @param {boolean} [show_size_guide] - Show size guide trigger
  @param {string} [size_guide_modal_id] - Modal id for size popup
  @param {boolean} [show_firmness_guide] - Show firmness guide trigger
  @param {string} [firmness_guide_label] - Firmness guide link label
  @param {string} [firmness_popup_modal_id] - Modal id for firmness guide popup
  @param {object} [firmness_sub_text_metafield] - Subtext metafield below firmness picker (variant or product)
{% enddoc %}
{%- liquid
  assign swatch_count = option.values | map: 'swatch' | compact | size
  assign picker_type = block.settings.picker_type

  assign current_option_name = option.name | strip | downcase
  assign is_firmness_option = false
  assign is_loft_option = false
  assign is_size_option = false
  assign is_quantity_option = false

  if firmness_option_name != blank and current_option_name == firmness_option_name
    assign is_firmness_option = true
  endif

  if loft_option_name != blank and current_option_name == loft_option_name
    assign is_loft_option = true
  endif

  if size_option_name != blank and current_option_name == size_option_name
    assign is_size_option = true
  endif

  if quantity_option_name != blank and current_option_name == quantity_option_name
    assign is_quantity_option = true
  endif

  assign is_color_option = false
  if current_option_name == 'color' or current_option_name == 'colour' or current_option_name contains 'color' or current_option_name contains 'colour'
    assign is_color_option = true
  endif

  if is_firmness_option or is_loft_option or is_size_option or is_quantity_option
    assign picker_type = 'button'
  elsif swatch_count > 0 and block.settings.swatch_shape != 'none'
    if block.settings.picker_type == 'dropdown'
      assign picker_type = 'swatch_dropdown'
    else
      assign picker_type = 'swatch'
    endif
  elsif is_color_option and block.settings.swatch_shape != 'none'
    if block.settings.picker_type == 'dropdown'
      assign picker_type = 'swatch_dropdown'
    else
      assign picker_type = 'swatch'
    endif
  endif

  assign option_display_name = option.name
  assign display_name_rules = block.settings.option_display_names | newline_to_br | replace: '<br />', '|' | replace: ',', '|' | split: '|'
  for display_rule in display_name_rules
    assign rule_parts = display_rule | split: '='
    if rule_parts.size < 2
      assign rule_parts = display_rule | split: ':'
    endif
    if rule_parts.size > 1
      assign rule_source = rule_parts | first | strip | downcase
      if rule_source == current_option_name
        assign option_display_name = rule_parts | last | strip
        break
      endif
    endif
  endfor
-%}
{%- if picker_type == 'swatch' -%}
  <fieldset class="js product-form__input product-form__input--swatch nw-variant-picker nw-variant-picker--swatch">
    <legend class="visually-hidden">{{ option_display_name | escape }}</legend>
    <div class="nw-variant-picker__header">
      <span class="nw-variant-picker__label">
        {{ option_display_name | escape }}:
        <span data-selected-value>{{ option.selected_value }}</span>
      </span>
    </div>
    <div class="nw-variant-picker__swatches">
      {% render 'product-variant-options',
        product: product,
        option: option,
        block: block,
        picker_type: picker_type,
        values_order: values_order
      %}
    </div>
  </fieldset>
{%- elsif picker_type == 'button' -%}
  <fieldset class="js product-form__input product-form__input--pill nw-variant-picker{% if is_firmness_option %} nw-variant-picker--firmness nw-variant-picker--card{% endif %}{% if is_loft_option %} nw-variant-picker--card nw-variant-picker--card-left{% endif %}{% if is_quantity_option %} nw-variant-picker--quantity{% endif %}{% if is_size_option %} nw-variant-picker--size{% endif %}">
    <legend class="visually-hidden">{{ option_display_name | escape }}</legend>
    <div class="nw-variant-picker__header">
      <span class="nw-variant-picker__label">{{ option_display_name | escape }}:</span>
      {%- if is_firmness_option -%}
        {%- if show_firmness_guide and firmness_popup_modal_id != blank and firmness_guide_label != blank -%}
          <modal-opener
            class="nw-variant-picker__size-guide-opener"
            data-modal="#{{ firmness_popup_modal_id }}"
          >
            <button
              type="button"
              class="nw-variant-picker__size-guide link"
              aria-haspopup="dialog"
            >
              {{ firmness_guide_label | escape }}
            </button>
          </modal-opener>
        {%- endif -%}
      {%- elsif is_size_option -%}
        {%- liquid
          assign size_guide_label = block.settings.size_guide_label | strip
        -%}
        {%- if show_size_guide and size_guide_modal_id != blank and size_guide_label != blank -%}
          <modal-opener
            class="nw-variant-picker__size-guide-opener"
            data-modal="#{{ size_guide_modal_id }}"
          >
            <button
              type="button"
              class="nw-variant-picker__size-guide link"
              aria-haspopup="dialog"
            >
              {{ size_guide_label | escape }}
            </button>
          </modal-opener>
        {%- elsif show_size_guide == false and select_size_text != blank -%}
          <span class="nw-variant-picker__size-desc">{{ select_size_text }}</span>
        {%- endif -%}
      {%- endif -%}
    </div>
    <div
      class="nw-variant-picker__options"
      {% if is_size_option %}
        data-option-count="{{ option.values.size }}"
      {% endif %}
    >
      {%- if is_firmness_option -%}
        {% render 'nw-product-variant-options-firmness',
          product: product,
          option: option,
          block: block,
          values_order: values_order
        %}
      {%- elsif is_loft_option -%}
        {% render 'nw-product-variant-options-loft',
          product: product,
          option: option,
          block: block,
          values_order: values_order
        %}
      {%- elsif is_quantity_option -%}
        {% render 'nw-product-variant-options-quantity',
          product: product,
          option: option,
          block: block,
          values_order: values_order
        %}
      {%- else -%}
        {% render 'product-variant-options',
          product: product,
          option: option,
          block: block,
          picker_type: picker_type,
          values_order: values_order
        %}
      {%- endif -%}
    </div>
    {%- if is_size_option and variant_tag_text != blank -%}
      <p class="nw-variant-picker__tag">{{ variant_tag_text }}</p>
    {%- endif -%}
    {%- if is_firmness_option and firmness_sub_text_metafield != blank and firmness_sub_text_metafield.value != blank -%}
      <div class="nw-variant-picker__tag nw-variant-picker__firmness-sub-text-product-info" data-firmness-sub-text>
        {%- if firmness_sub_text_metafield.type == 'rich_text_field' -%}
          {{ firmness_sub_text_metafield | metafield_tag }}
        {%- else -%}
          {{ firmness_sub_text_metafield.value | default: firmness_sub_text_metafield }}
        {%- endif -%}
      </div>
    {%- endif -%}
  </fieldset>
{%- else -%}
  <div class="product-form__input product-form__input--dropdown">
    <label class="form__label" for="Option-{{ section.id }}-{{ option.position | minus: 1 }}">
      {{ option_display_name | escape }}
    </label>
    <div class="select">
      {%- if picker_type == 'swatch_dropdown' -%}
        <span
          data-selected-value
          class="dropdown-swatch"
        >
          {%- capture selected_fallback_color -%}
            {%- render 'nw-option-swatch-color', name: option.selected_value -%}
          {%- endcapture -%}
          {% render 'swatch',
            swatch: option.selected_value.swatch,
            shape: block.settings.swatch_shape,
            fallback_color: selected_fallback_color
          %}
        </span>
      {%- endif -%}
      <select
        id="Option-{{ section.id }}-{{ option.position | minus: 1 }}"
        class="select__select"
        name="options[{{ option.name | escape }}]"
        form="{{ product_form_id }}"
      >
        {% render 'product-variant-options',
          product: product,
          option: option,
          block: block,
          picker_type: picker_type,
          values_order: values_order
        %}
      </select>
      <span class="svg-wrapper">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
    </div>
  </div>
{%- endif -%}
