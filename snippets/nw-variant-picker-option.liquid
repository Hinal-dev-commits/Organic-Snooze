{% comment %}
  Renders one product variant option picker.

  Accepts:
  - product: {Object}
  - option: {Object}
  - block: {Object}
  - product_form_id: {String}
  - firmness_option_name: {String}
  - loft_option_name: {String}
  - size_option_name: {String}
  - quantity_option_name: {String}
  - select_size_text: {String}
  - variant_tag_text: {String}
  - firmness_tag_text: {String}
  - values_order: {String}
  - show_size_guide: {Boolean}
  - size_guide_image: {Object}
  - size_guide_modal_id: {String}
{% endcomment %}
{%- liquid
  assign swatch_count = option.values | map: 'swatch' | compact | size
  assign picker_type = block.settings.picker_type

  assign current_option_name = option.name | strip | downcase
  assign is_firmness_option = false
  assign is_loft_option = false
  assign is_size_option = false
  assign is_quantity_option = false

  if firmness_option_name != blank and current_option_name == firmness_option_name
    assign is_firmness_option = true
  endif

  if loft_option_name != blank and current_option_name == loft_option_name
    assign is_loft_option = true
  endif

  if size_option_name != blank and current_option_name == size_option_name
    assign is_size_option = true
  endif

  if quantity_option_name != blank and current_option_name == quantity_option_name
    assign is_quantity_option = true
  endif

  if is_firmness_option or is_loft_option or is_size_option or is_quantity_option
    assign picker_type = 'button'
  elsif swatch_count > 0 and block.settings.swatch_shape != 'none'
    if block.settings.picker_type == 'dropdown'
      assign picker_type = 'swatch_dropdown'
    else
      assign picker_type = 'swatch'
    endif
  endif
-%}
{%- if picker_type == 'swatch' -%}
  <fieldset class="js product-form__input product-form__input--swatch nw-variant-picker nw-variant-picker--swatch">
    <legend class="visually-hidden">{{ option.name }}</legend>
    <div class="nw-variant-picker__header">
      <span class="nw-variant-picker__label">
        {{ option.name }}:
        <span data-selected-value>{{ option.selected_value }}</span>
      </span>
    </div>
    <div class="nw-variant-picker__swatches">
      {% render 'product-variant-options',
        product: product,
        option: option,
        block: block,
        picker_type: picker_type,
        values_order: values_order
      %}
    </div>
  </fieldset>
{%- elsif picker_type == 'button' -%}
  <fieldset class="js product-form__input product-form__input--pill nw-variant-picker{% if is_firmness_option %} nw-variant-picker--firmness nw-variant-picker--card{% endif %}{% if is_loft_option %} nw-variant-picker--card nw-variant-picker--card-left{% endif %}{% if is_quantity_option %} nw-variant-picker--quantity{% endif %}">
    <legend class="visually-hidden">{{ option.name }}</legend>
    <div class="nw-variant-picker__header">
      <span class="nw-variant-picker__label">{{ option.name }}:</span>
      {%- if is_firmness_option -%}
        {%- if firmness_tag_text != blank -%}
          <span class="nw-variant-picker__firmness-tag">{{ firmness_tag_text }}</span>
        {%- endif -%}
      {%- elsif is_size_option -%}
        {%- if show_size_guide and size_guide_image != blank -%}
          <modal-opener
            class="nw-variant-picker__size-guide-opener"
            data-modal="#{{ size_guide_modal_id }}"
          >
            <button
              type="button"
              class="nw-variant-picker__size-guide link"
              aria-haspopup="dialog"
            >
              {{ block.settings.size_guide_label | default: 'Size Guide' | escape }}
            </button>
          </modal-opener>
        {%- elsif show_size_guide == false and select_size_text != blank -%}
          <span class="nw-variant-picker__size-desc">{{ select_size_text }}</span>
        {%- endif -%}
      {%- endif -%}
    </div>
    <div class="nw-variant-picker__options">
      {%- if is_firmness_option -%}
        {% render 'nw-product-variant-options-firmness',
          product: product,
          option: option,
          block: block,
          values_order: values_order
        %}
      {%- elsif is_loft_option -%}
        {% render 'nw-product-variant-options-loft',
          product: product,
          option: option,
          block: block,
          values_order: values_order
        %}
      {%- elsif is_quantity_option -%}
        {% render 'nw-product-variant-options-quantity',
          product: product,
          option: option,
          block: block,
          values_order: values_order
        %}
      {%- else -%}
        {% render 'product-variant-options',
          product: product,
          option: option,
          block: block,
          picker_type: picker_type,
          values_order: values_order
        %}
      {%- endif -%}
    </div>
    {%- if is_size_option and variant_tag_text != blank -%}
      <p class="nw-variant-picker__tag">{{ variant_tag_text }}</p>
    {%- endif -%}
  </fieldset>
{%- else -%}
  <div class="product-form__input product-form__input--dropdown">
    <label class="form__label" for="Option-{{ section.id }}-{{ option.position | minus: 1 }}">
      {{ option.name }}
    </label>
    <div class="select">
      {%- if picker_type == 'swatch_dropdown' -%}
        <span
          data-selected-value
          class="dropdown-swatch"
        >
          {% render 'swatch', swatch: option.selected_value.swatch, shape: block.settings.swatch_shape %}
        </span>
      {%- endif -%}
      <select
        id="Option-{{ section.id }}-{{ option.position | minus: 1 }}"
        class="select__select"
        name="options[{{ option.name | escape }}]"
        form="{{ product_form_id }}"
      >
        {% render 'product-variant-options',
          product: product,
          option: option,
          block: block,
          picker_type: picker_type,
          values_order: values_order
        %}
      </select>
      <span class="svg-wrapper">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
    </div>
  </div>
{%- endif -%}
