{% doc %}
  Bundle & Save add-on picker for main product blocks.
  Products load from custom.bundle metafield or a theme editor product list.
  @param {object} block - Block settings
  @param {object} product - Current product
{% enddoc %}

{%- liquid
  assign product_source = block.settings.product_source | default: 'metafield'
  assign bundle_products = blank
  assign bundle_count = 0

  if product_source == 'product_list'
    if block.settings.product_list != blank and block.settings.product_list.size > 0
      assign bundle_products = block.settings.product_list
      assign bundle_count = block.settings.product_list.size
    endif
  else
    assign bundle_products = product.metafields.custom.bundle.value
    if bundle_products != blank
      if bundle_products.id != blank
        assign bundle_count = 1
      else
        assign bundle_count = bundle_products.size
      endif
    endif
  endif
-%}

{%- if bundle_count == 0 -%}
  {%- if request.design_mode -%}
    <div class="nw-bundle-save nw-bundle-save--empty">
      {%- if block.settings.heading != blank -%}
        <div class="nw-bundle-save__heading inline-richtext">{{ block.settings.heading }}</div>
      {%- endif -%}
      {%- if product_source == 'product_list' -%}
        <p class="nw-bundle-save__empty">{{ 'products.bundle_save.empty_product_list' | t }}</p>
      {%- else -%}
        <p class="nw-bundle-save__empty">{{ 'products.bundle_save.empty' | t }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- else -%}
  {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
  {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {{ 'nw-product-bundle-save.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'nw-product-bundle-save.js' | asset_url }}" defer="defer"></script>

  {%- liquid
    assign discount_percent = block.settings.discount_percentage | plus: 0
    if discount_percent < 0
      assign discount_percent = 0
    elsif discount_percent > 100
      assign discount_percent = 100
    endif
    assign bundle_save_panel_id = 'NwBundleSavePanel-' | append: block.id
    assign preview_summary = block.settings.preview_summary
    if preview_summary == blank
      assign preview_summary = 'products.bundle_save.preview_summary_default' | t
    endif
    assign added_summary_template = 'products.bundle_save.added_summary' | t
    assign drawer_title = block.settings.heading | strip_html | strip
    if drawer_title == blank
      assign drawer_title = 'products.bundle_save.drawer_title_default' | t
    endif
    assign optional_subtitle = block.settings.optional_subtitle | strip
    if optional_subtitle == blank
      assign subtitle_default = 'Optional, Bundle & Save ' | append: discount_percent | append: '%'
    else
      assign subtitle_default = optional_subtitle | replace: '[percent]', discount_percent
    endif
  -%}
  <nw-bundle-save
    class="nw-bundle-save nw-bundle-save--collapsible is-collapsed"
    data-discount-percentage="{{ discount_percent }}"
    data-money-format="{{ shop.money_format | escape }}"
    data-subtitle-default="{{ subtitle_default | escape }}"
    data-preview-default="{{ preview_summary | escape }}"
    data-subtitle-selected-template="{{ added_summary_template | escape }}"
    data-bundle-add-template="{{ 'products.bundle_save.add_to_bundle' | t | escape }}"
    data-quick-view-modal="#NwBundleQuickView-{{ block.id }}"
  >
    <div class="nw-bundle-save__header">
      <button
        type="button"
        class="nw-bundle-save__header-toggle"
        data-bundle-collapse-toggle
        aria-expanded="false"
        aria-controls="{{ bundle_save_panel_id }}"
      >
        <span class="nw-bundle-save__header-copy">
          <span class="nw-bundle-save__heading">{{ drawer_title }}</span>
          <span class="nw-bundle-save__subtitle" data-bundle-subtitle>{{ subtitle_default }}</span>
        </span>
        <span class="nw-bundle-save__toggle-btn" aria-hidden="true">
          <span class="nw-bundle-save__toggle-icon svg-wrapper">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
        </span>
      </button>
    </div>

    <div class="nw-bundle-save__closed-preview" data-bundle-closed-preview>
      <div class="nw-bundle-save__divider" aria-hidden="true"></div>
      <div class="nw-bundle-save__preview-row">
        <div class="nw-bundle-save__thumb-stack" data-bundle-thumb-stack>
          {%- if bundle_products.id != blank -%}
            {%- render 'nw-product-bundle-save-preview-thumb', bundle_product: bundle_products, block: block -%}
          {%- else -%}
            {%- for bundle_product in bundle_products -%}
              {%- unless bundle_product == blank or bundle_product.id == blank or bundle_product.id == product.id -%}
                {%- render 'nw-product-bundle-save-preview-thumb',
                  bundle_product: bundle_product,
                  block: block
                -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
        <p class="nw-bundle-save__preview-text" data-bundle-preview-text>{{ preview_summary }}</p>
      </div>
    </div>

    <div
      class="nw-bundle-save__collapsible"
      id="{{ bundle_save_panel_id }}"
      data-bundle-collapse-panel
    >
      <div class="nw-bundle-save__collapsible-inner">
        <ul class="nw-bundle-save__list" role="list">
          {%- if bundle_products.id != blank -%}
            {%- render 'nw-product-bundle-save-item',
              bundle_product: bundle_products,
              block: block
            -%}
          {%- else -%}
            {%- for bundle_product in bundle_products -%}
              {%- unless bundle_product == blank or bundle_product.id == blank or bundle_product.id == product.id -%}
                {%- render 'nw-product-bundle-save-item',
                  bundle_product: bundle_product,
                  block: block
                -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
    </div>

  </nw-bundle-save>
  {%- render 'nw-product-bundle-save-quick-view', block: block -%}
{%- endif -%}
