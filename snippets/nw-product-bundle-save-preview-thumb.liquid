{% doc %}
  Stacked preview thumbnail for closed Bundle & Save drawer.
  @param {object} bundle_product_item - Add-on product (optional if bundle_product set)
  @param {object} bundle_product - Add-on product alias
  @param {object} block - Parent block
{% enddoc %}

{%- liquid
  assign preview_product = bundle_product_item | default: bundle_product
  assign current_variant = preview_product.selected_or_first_available_variant
  assign preview_image = current_variant.featured_media.preview_image | default: current_variant.image | default: preview_product.featured_image
  assign preview_title = preview_product.metafields.custom.product_title.value | default: preview_product.metafields.custom.product_title
  if preview_title == blank
    assign preview_title = preview_product.title
  endif
-%}

<span
  class="nw-bundle-save__preview-thumb"
  data-preview-thumb
  data-product-id="{{ preview_product.id }}"
>
  {%- if preview_image != blank -%}
    <img
      src="{{ preview_image | image_url: width: 72 }}"
      alt="{{ preview_title | escape }}"
      width="36"
      height="36"
      loading="lazy"
    >
  {%- else -%}
    <span class="nw-bundle-save__preview-thumb-placeholder" aria-hidden="true"></span>
  {%- endif -%}
</span>
