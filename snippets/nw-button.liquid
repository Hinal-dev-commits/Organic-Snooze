{% doc %}
Renders a primary, secondary, or outline CTA. Empty links become a button so the markup stays valid.
@param {string} text - Button label
@param {string} [link] - Optional URL. If blank, a button is rendered
@param {string} [style] - primary, secondary, or outline. Default: primary
@param {string} [btn_class] - Extra CSS class
@example
{% render 'nw-button', text: section.settings.button_text, link: section.settings.button_link, style: 'primary' %}
{% enddoc %}

{%- liquid
  assign btn_style = style | default: 'primary'
  assign btn_text = text
  assign btn_link = link | default: '#'
-%}
{%- if btn_text != blank -%}
  <a href="{{ btn_link }}" class="nw-btn nw-btn--{{ btn_style }}{% if btn_class != blank %} {{ btn_class }}{% endif %}">
    <span class="nw-btn__text">{{ btn_text }}</span>
  </a>
{%- endif -%}
