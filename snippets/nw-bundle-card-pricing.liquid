{%- comment -%}
  Card pricing from Shopify variant catalog prices (not bundle-kit metafield math).
{%- endcomment -%}

{%- if product != blank -%}
  {%- liquid
    assign card_price_cents = product.price_min | default: 0 | plus: 0
    assign card_max_pay_cents = product.price_max | default: card_price_cents | plus: 0
    assign card_compare_cents = 0
    assign prefix = class_prefix | default: 'nw-product-card'
    assign from_label = from_text | default: ''

    if card_price_cents > 0
      for v in product.variants
        assign v_price = v.price | default: 0 | plus: 0
        if v_price == card_price_cents
          assign v_compare = v.compare_at_price | default: 0 | plus: 0
          if v_compare > v_price
            assign card_compare_cents = v_compare
          endif
          break
        endif
      endfor
    endif
  -%}

  {%- if card_price_cents > 0 -%}
    {%- liquid
      assign show_from = false
      if card_max_pay_cents > card_price_cents and from_label != blank
        assign show_from = true
      endif
    -%}
    <div class="{{ prefix }}__price">
      {%- if show_from -%}
        <span class="{{ prefix }}__price-from">{{ from_label }}</span>
      {%- endif -%}
      <span class="{{ prefix }}__price-current">{{ card_price_cents | money }}</span>
      {%- if card_compare_cents > card_price_cents -%}
        <span class="{{ prefix }}__price-compare">{{ card_compare_cents | money }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endif -%}
