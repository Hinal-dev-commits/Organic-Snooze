{% doc %}
  Shipping / delivery tag for main product blocks.
  @param {object} block - Block settings
  @param {object} [product] - Product for optional metafield override
{% enddoc %}

{%- liquid
  assign tag_prefix = block.settings.text
  if block.settings.use_product_metafield
    assign metafield_value = product.metafields.custom.shipping_tag.value | default: product.metafields.custom.shipping_tag
    if metafield_value != blank
      assign tag_prefix = metafield_value
    endif
  endif

  if tag_prefix contains 'Est. delivery'
    assign tag_prefix = tag_prefix | split: 'Est. delivery' | first | strip
    if tag_prefix contains '•'
      assign tag_prefix = tag_prefix | split: '•' | first | strip
    endif
  endif

  assign threshold_days = block.settings.delivery_threshold_days | default: 2
  assign seconds_to_add = threshold_days | times: 86400
  assign delivery_timestamp = 'now' | date: '%s' | plus: seconds_to_add
  assign delivery_date = delivery_timestamp | date: '%b %d, %Y' | replace: ' 0', ' '

  if tag_prefix != blank
    assign tag_text = tag_prefix | append: ' • Est. delivery ' | append: delivery_date
  else
    assign tag_text = 'Est. delivery ' | append: delivery_date
  endif
-%}

{%- if tag_text != blank -%}
  <div
    class="nw-product-shipping-tag"
    style="
      --nw-pst-bg: {{ block.settings.bg_color | default: '#E8F0E0' }};
      --nw-pst-text: {{ block.settings.text_color | default: '#613916' }};
      --nw-pst-icon: {{ block.settings.icon_color | default: '#613916' }};
    "
  >
    <span class="nw-product-shipping-tag__icon" aria-hidden="true">
      {%- if block.settings.use_custom_icon and block.settings.custom_icon != blank -%}
        {%- render 'nw-icon', icon: 'custom', custom_icon: block.settings.custom_icon, img_class: 'nw-product-shipping-tag__icon-img' -%}
      {%- else -%}
        {%- render 'nw-icon', icon: block.settings.icon, default: 'truck' -%}
      {%- endif -%}
    </span>
    <span class="nw-product-shipping-tag__text">{{ tag_text }}</span>
  </div>
{%- endif -%}
